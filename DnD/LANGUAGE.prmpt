// what each option adds per tier
DND_ULTIMATUM2_T1    =   "Saw blades periodically spawn and fly towards you after a delay.";
DND_ULTIMATUM2_T2    =   "Saw blades inflict 20% more damage, and 30% extra chance to inflict bleeding.";
DND_ULTIMATUM2_T3    =   "5 additional blades spawn each time and are 25% faster.";
DND_ULTIMATUM2_T4    =   "The saw blades have 100% chance to inflict bleeding.";

DND_ULTIMATUM3_T1    =   "A slow moving cloud of miasma starts chasing after you, dealing constant poison damage while in it.";
DND_ULTIMATUM3_T2    =   "The cloud moves 25% faster.";
DND_ULTIMATUM3_T3    =   "The cloud gets 25% bigger and faster.";
DND_ULTIMATUM3_T4    =   "The cloud gets 33% bigger and slows you if it deals damage for 20%.";

DND_ULTIMATUM5_T1    =   "Random places in the ground get marked, waiting for lightning to strike if stayed in for too long.";
DND_ULTIMATUM5_T2    =   "The lightning takes 25% less time to strike.";
DND_ULTIMATUM5_T3    =   "Twice as many lightning strikes occur when time runs out.";
DND_ULTIMATUM5_T4    =   "3 additional marked grounds appear.";

DND_ULTIMATUM6_T1    =   "Two spirits spawn, throwing waves of flame at you.";
DND_ULTIMATUM6_T2    =   "The spirits fire an additional wave of flame.";
DND_ULTIMATUM6_T3    =   "The flame pierces 15% of your resistance.";
DND_ULTIMATUM6_T4    =   "There is an additional spirit chasing you, and they fire 2 additional projectiles.";

DND_ULTIMATUM7_T1    =   "Frozen pustules will periodically appear, dealing heavy cold damage on contact after a short delay.";
DND_ULTIMATUM7_T2    =   "50% more pustules will appear and deal 33% more damage.";
DND_ULTIMATUM7_T3    =   "Pustules always chill and explode 25% faster.";
DND_ULTIMATUM7_T4    =   "Pustules always freeze.";

