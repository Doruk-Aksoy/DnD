[enu default]

DND_CHALLENGE		=	"CHALLENGE";
DND_ACCEPTED		=	"ACCEPTED";
DND_ACCEPT			=	"Accept";
DND_DECLINE			=	"Decline";

DND_TOVOTE			=	"seconds to vote";	// time left to vote
DND_VOTEPASSED		=	"Vote Passed";
DND_VOTEFAILED		=	"Vote Failed";

DND_WELLDONE		=	"WELL DONE!";
DND_FAILEDIT		=	"YOU'VE FAILED!";

DND_PROMPT1			=	"    Greetings warrior! You have many questions, yes? Amongst them, who I am or why I'm not trying to destroy you probably take precedence.";
DND_PROMPT2			=	"    Many can't see me, those that do see me only briefly. You, however, are different. I sense great power in you. I travel distant worlds, places unimaginable, trying to find the most interesting challenger.";
DND_PROMPT3			=	"    The talents you have put to display here, show promise and entice me. Henceforth, anytime I'm visible to you the random hand of fate will present itself. However these \"opportunities\" may require a sacrifice. Sometimes in blood, sometimes in other ways. That is left to the powers beyond.";
DND_PROMPT4			=	"    We meet once again, great warrior. Tell me, are you ready for another challenge?";
DND_PROMPT5			=	"    Random hand of fate guides me to you, yet again. This time, it may come to pass that you lose.";
DND_PROMPT6			=	"    My masters believe you are ready for another sacrifice. Let's see if you can live up to the challenge.";
DND_PROMPT7			=	"Several monsters have received the mark of my masters, making them immensely powerful. Slay them, and be rewarded. Fail, and leave with nothing.";
DND_PROMPT8			=	"Objects of immense power have been deployed randomly across the land. Their return shall bring great wealth and power to you.";
DND_PROMPT9			=	"A certain very powerful monster roams the land. It has been given further cosmic powers to tip the scales. Destroy it and claim its possessions.";

// ultimatum
DND_PROMPT10		=	"A favorable result, luck seems to be on your side... for now. Will you continue, or is it enough?";
DND_PROMPT11		=	"It seems your luck has not yet run out. Shall we continue, or is this your limit?";
DND_PROMPT12		=	"Playing with chance is a dangerous game, but, it can also prove to be enriching. Do you wish to pursue further greatness, or live to tell the tale?";
DND_PROMPT13        =   "Well done challenger. Now you face another choice: further commit to a more difficult challenge, or balk?";

// DW_ULTIMATUM_INTRO1..3 -- the wanderer's FIRST ultimatum offer, before any wave has run.
DND_PROMPT21		=	"Greetings, challenger. This is the ultimate arena!";
DND_PROMPT22		=	"I see you've proven yourself worthy for this great challenge.";
DND_PROMPT23		=	"Time has come to finally prove your mettle.";

DND_PROMPT24        =   "Face the trials of Chaos and pursue your fate. You might die here, now, or you might someday rival the gods themselves. "
                        "There will be ten waves of enemies surrounding you from every angle. At the start of each wave is a choice you have to make. "
                        "Will you play it safe and go for a meager reward, or risk it all for ungodly riches?";

DND_ULTIMATUM1      =   "Any monster damage dealt also gets a bonus of 30% as that of a random element.";
DND_ULTIMATUM2      =   "Occasional blood-soaked blades fly across the room.";
DND_ULTIMATUM3      =   "A viscious cloud of deadly miasma slowly seeks you.";
DND_ULTIMATUM4      =   "Take x20 of ammo costs as lightning damage each time you fire a weapon.";
DND_ULTIMATUM5      =   "Random places in the ground get marked, waiting for lightning to strike.";
DND_ULTIMATUM6      =   "Vengeful, unstoppable spirits chase after you, throwing flames.";
DND_ULTIMATUM7      =   "Frozen pustules will periodically appear and explode when you approach.";
DND_ULTIMATUM8      =   "Using a flask slows you down by 50% for 4 seconds.";
DND_ULTIMATUM9      =   "Gain no flask charges from monsters.";
DND_ULTIMATUM10     =   "You take 8% increased damage every wave up to 40%.";
DND_ULTIMATUM11     =   "Deal no damage for 2 seconds every 8 seconds.";
DND_ULTIMATUM12     =   "Monsters ignore your armor rating.";
DND_ULTIMATUM13     =   "Monster damage cannot be mitigated.";
DND_ULTIMATUM14     =   "60% less area of effect and projectile speed.";
DND_ULTIMATUM15     =   "Monsters steal 10% of your ammo and energy shield on hits.";
DND_ULTIMATUM16     =   "Your critical strike chance is unlucky and monsters take 50% less damage from critical strikes.";
DND_ULTIMATUM17     =   "Monsters cannot be slowed or stunned.";
DND_ULTIMATUM18     =   "You have 60% reduced recovery rate of life and energy shield.";
DND_ULTIMATUM19     =   "Elite and tough enemies have an additional modifier.";
DND_ULTIMATUM20     =   "You have 50% reduced recovery rate of stamina, and melee cooldowns take thrice as long to recharge.";
DND_ULTIMATUM21     =   "Your ailments are reflected to you.";
DND_ULTIMATUM22     =   "Monsters gain +50% to all resists";

