[enu default]

// Perk names and descriptions. Generated from Perk_Notes/ so the two cannot drift -- if a
// perk is renamed there, regenerate rather than editing here. The same pass writes the key
// table GetPerkLangKey in DnD_Perks.h, which is how the menu reaches these strings.
//
// <ID>      the name shown in the tree
// <ID>_DESC what one point does
// <ID>_PER  what each further point adds, absent for one-point perks
// <ID>_REQ  the Requires clause, absent when there is none

// The archetype names the tree menu heads each page with. Kept beside the perks rather than
// in LANGUAGE.menu because they name tree data, not menu furniture.
PERK_ARCH_ACRO                           = "Acrobacy";
PERK_ARCH_ASSN                           = "Assassination";
PERK_ARCH_CUN                            = "Cunning";
PERK_ARCH_END                            = "Endurance";
PERK_ARCH_MART                           = "Martialist";
PERK_ARCH_PERC                           = "Perception";
PERK_ARCH_TORM                           = "Tormentor";


