[enu default]

// Spell system. DND_SPLNAME<id> is positional -- the id enum in
// acs/Spells/DnD_SpellDefs.h is append only and these must follow it.

DND_MENU_HEAD_SPELLS	=	"SKILLS";
DND_MENU_SPELLPOINTS	=	"Skill Points";

DND_SPELLTREE0		=	"Fire";
DND_SPELLTREE1		=	"Cold";
DND_SPELLTREE2		=	"Lightning";
DND_SPELLTREE3		=	"Earth";
DND_SPELLTREE4		=	"Black";
DND_SPELLTREE5		=	"Arcane";
DND_SPELLTREE6		=	"Chaos";
DND_SPELLTREE7		=	"Combat";

// Fire
DND_SPLNAME0		=	"Blaze";
DND_SPLNAME1		=	"Fireball";
DND_SPLNAME2		=	"Infernal Strike";
DND_SPLNAME3		=	"Warmth";
DND_SPLNAME4		=	"Heat Shield";
DND_SPLNAME5		=	"Incinerate";
DND_SPLNAME6		=	"Boiling Blood";
DND_SPLNAME7		=	"Anger";
DND_SPLNAME8		=	"Pyroblast";
DND_SPLNAME9		=	"Searing Bond";
DND_SPLNAME10		=	"Scorching Ray";
DND_SPLNAME11		=	"Flammability";
DND_SPLNAME12		=	"Immolation";
DND_SPLNAME13		=	"Rain of Fire";
DND_SPLNAME14		=	"Flame Pillar";
DND_SPLNAME15		=	"Fire Jet";
DND_SPLNAME16		=	"Summon: Fire Demon";
DND_SPLNAME17		=	"Molten Boulder";
DND_SPLNAME18		=	"Righteous Fire";
DND_SPLNAME19		=	"Annihilus";
DND_SPLNAME20		=	"Volcano";
DND_SPLNAME21		=	"Heart of Fire";

// Cold
DND_SPLNAME32		=	"Ice Bolt";
DND_SPLNAME33		=	"Freezing Pulse";
DND_SPLNAME34		=	"Glacial Spike";
DND_SPLNAME35		=	"Chilling Breath";
DND_SPLNAME36		=	"Creeping Frost";
DND_SPLNAME37		=	"Ice Shield";
DND_SPLNAME38		=	"Frost Shards";
DND_SPLNAME39		=	"Gust of Frost";
DND_SPLNAME40		=	"Frost Bomb";
DND_SPLNAME41		=	"Ice Nova";
DND_SPLNAME42		=	"Summon: Ice Golem";
DND_SPLNAME43		=	"Hatred";
DND_SPLNAME44		=	"Frostbite";
DND_SPLNAME45		=	"Blizzard";
DND_SPLNAME46		=	"Winter Orb";
DND_SPLNAME47		=	"Ice Spear";
DND_SPLNAME48		=	"Glacial Cascade";
DND_SPLNAME49		=	"Shivering Armor";
DND_SPLNAME50		=	"Avalanche";


// Hover text, straight from the design docs. Positional like the names above.
//
// DND_SPLDESC<id>   what the spell does at rank 1
// DND_SPLPER<id>    what each further rank adds
// DND_SPLR5_<id>    the rank 5 bonus   -- underscored, or DND_SPLR5_10 and DND_SPLR51_0 collide
// DND_SPLR10_<id>   the rank 10 bonus
//
// Damage, cost, cooldown, cast time, requirements and synergies are deliberately NOT here. The
// panel reads those live from SpellDefs and SpellSynergies, so they cannot drift from what the
// spell does.
//
// Damage and cost joined that list when ranks started compounding -- "+60 damage per rank" was
// true while the step was linear and became a lie the moment it was not. A DND_SPLPER lump is
// now only for what the live lines CANNOT express: radius, durations, extra projectiles and the
// like. Several are deliberately empty, and the panel skips the heading when they are.

// ================= FIRE =================

// Blaze
DND_SPLDESC0    = "Sets the target on fire, dealing 8 fire damage every 0.25 seconds for 3 seconds.";
DND_SPLPER0     = "8% faster cooldown recovery rate.";
DND_SPLR5_0     = "Burns for 1 second longer.";
DND_SPLR10_0    = "Also ignites enemies within 96 units of the target.";

// Fireball
DND_SPLDESC1    = "Throws a ball of fire that deals 100 damage on impact.";
DND_SPLPER1     = "";
DND_SPLR5_1     = "Casts an additional fireball to the side.";
DND_SPLR10_1    = "Casts another additional fireball to the side.";

// Infernal Strike
DND_SPLDESC2    = "Your next melee attack deals 50 additional fire damage, with a 25% chance to strike a 128 unit area.";
DND_SPLPER2     = "";
DND_SPLR5_2     = "+25% chance to strike the area.";
DND_SPLR10_2    = "The strike is always a critical hit.";

// Warmth
DND_SPLDESC3    = "Increases your mana regeneration by 50% for 8 seconds.";
DND_SPLPER3     = "10% additional mana regenration, +0.25 flat mana regeneration.";
DND_SPLR5_3     = "Duration becomes 12 seconds.";
DND_SPLR10_3    = "Also affects allies within 192 units.";

// Heat Shield
DND_SPLDESC4    = "Covers your armor or a targeted ally's in fire. Enemies that hit it are ignited, and it grants 100 armor rating for 5 seconds.";
DND_SPLPER4     = "+1 second duration, +25 armor rating.";
DND_SPLR5_4     = "Ignites from this last 100% longer.";
DND_SPLR10_4    = "Ignites from this are guaranteed to spread.";

// Incinerate
DND_SPLDESC5    = "Passive. Your fire damage has a 30% chance to make enemies explode on death for 5% of their maximum health within 128 units.";
DND_SPLPER5     = "+0.25% explosion damage.";
DND_SPLR5_5     = "Radius increases to 192 units.";
DND_SPLR10_5    = "The explosion no longer harms you.";

// Boiling Blood
DND_SPLDESC6    = "Grants 25% increased movement speed and 15% cooldown recovery rate for 10 seconds, at the cost of 5 health per second.";
DND_SPLPER6     = "+1% movement speed, +1 health lost per second.";
DND_SPLR5_6     = "+2 seconds duration.";
DND_SPLR10_6    = "+15% cooldown recovery rate.";

// Anger
DND_SPLDESC7    = "Aura. You and nearby allies within 256 units deal 15% more fire damage and gain 10% base ignite chance.";
DND_SPLPER7     = "+1% more fire damage, +8 unit radius.";
DND_SPLR5_7     = "+5% ignite chance.";
DND_SPLR10_7    = "Ignites on you and affected allies last 50% less.";

// Pyroblast
DND_SPLDESC8    = "Hurls a ball of flame that explodes for 360 damage in a 128 unit radius.";
DND_SPLPER8     = "";
DND_SPLR5_8     = "No longer damages you.";
DND_SPLR10_8    = "The explosion erupts into smaller fireballs dealing an eighth of its damage.";

// Searing Bond
DND_SPLDESC9    = "Lashes out a chain that deals 75 damage and snares an enemy for 2.5 seconds.";
DND_SPLPER9     = "+0.25 seconds snare.";
DND_SPLR5_9     = "+2 seconds snare duration.";
DND_SPLR10_9    = "Also binds enemies within 160 units of the target.";

// Scorching Ray
DND_SPLDESC10   = "Projects a beam of fire dealing 80 damage every 0.2 seconds. After 2.5 seconds of channeling it applies Fire Exposure on hit, giving -25 to fire resistance for 5 seconds.";
DND_SPLPER10    = "+8 beam length.";
DND_SPLR5_10    = "+25% beam width.";
DND_SPLR10_10   = "The beam passes through all enemies.";

// Flammability
DND_SPLDESC11   = "Curse. Enemies in a 256 unit area take -30 to fire resistance for 8 seconds and gain 25% base chance to be ignited.";
DND_SPLPER11    = "-1 further to fire resistance.";
DND_SPLR5_11    = "25% increased area of effect.";
DND_SPLR10_11   = "+4 seconds duration.";

// Immolation
DND_SPLDESC12   = "Surrounds you with fire, dealing 72 damage every second to everything within 96 units. Costs mana for as long as it runs.";
DND_SPLPER12    = "+12 unit radius.";
DND_SPLR5_12    = "Mana cost reduced by 4.";
DND_SPLR10_12   = "The damage also applies Blaze.";

// Rain of Fire
DND_SPLDESC13   = "Marks a location to rain comets over a 320 unit area for 4.5 seconds, each dealing 40 damage in a 72 unit radius.";
DND_SPLPER13    = "+8 comet damage area.";
DND_SPLR5_13    = "Comets fall 20% faster, and rains 15% more comets.";
DND_SPLR10_13   = "Holds two charges, each on its own cooldown.";

// Flame Pillar
DND_SPLDESC14   = "Creates a pillar of flame that advances 30 units per tic for 2 seconds, leaving in its wake flames dealing 24 damage to everything within 96 units every 2 tics for 44 tics.";
DND_SPLPER14    = "";
DND_SPLR5_14    = "Ignores shields.";
DND_SPLR10_14   = "Creates two pillars side by side.";

// Fire Jet
DND_SPLDESC15   = "Shoots a jet of fire that spreads sideways, dealing 180 damage on a direct hit and 36 to the sides.";
DND_SPLPER15    = "";
DND_SPLR5_15    = "A direct hit explodes for half its damage within 128 units.";
DND_SPLR10_15   = "The sideways flames rip through enemies.";

// Summon: Fire Demon
DND_SPLDESC16   = "Summons a fire demon with 500 health to fight for you. It throws fireballs and sets the ground alight. Can have up to 1 Fire Demon active at a time.";
DND_SPLPER16    = "+15% demon health, +10% demon damage.";
DND_SPLR5_16    = "Gains 25% to all resistances.";
DND_SPLR10_16   = "The demon casts Fire Jet at your rank.";

// Molten Boulder
DND_SPLDESC17   = "Calls down a meteor that burns everything it passes for 24 damage and explodes on impact for 256. It shatters on a wall or after 6 seconds.";
DND_SPLPER17    = "";
DND_SPLR5_17    = "Lasts 3 seconds longer.";
DND_SPLR10_17   = "Sends six Pyroblasts outward when it shatters.";

// Righteous Fire
DND_SPLDESC18   = "Engulfs you in flame, burning yourself and enemies within 160 units each second for 50% of your health and energy shield as fire damage. Grants 20% more spell damage to other spells while it burns.";
DND_SPLPER18    = "+2% health as damage, +16 unit radius.";
DND_SPLR5_18    = "You gain 25% additional fire resistance against this spell.";
DND_SPLR10_18   = "You cannot be chilled, frozen or ignited while burning.";

// Annihilus
DND_SPLDESC19   = "Channel to build an explosion at a location up to 512 units away, for up to 2.5 seconds. Every 0.5 seconds adds a charge, starting at 250 damage and growing 30% each time, while the blast widens from 96 units to 512. Cast again to release it early for less damage. You are slowed by 50% while channeling.";
DND_SPLPER19    = "";
DND_SPLR5_19    = "No longer harms you, and maximum range becomes 768 units.";
DND_SPLR10_19   = "Has a 20% chance to trigger explosions at each charge.";

// Volcano
DND_SPLDESC20   = "Conjures a volcano at a location that hurls lava for 10 seconds, each piece dealing 60 damage in an 80 unit area.";
DND_SPLPER20    = "+0.5 seconds duration.";
DND_SPLR5_20    = "Bursting lava deals 30% increased damage.";
DND_SPLR10_20   = "Produces 25% more lava.";

// Heart of Fire
DND_SPLDESC21   = "Passive. Finishing a fire spell's cast gives every OTHER fire spell on your hotbar that is on cooldown a 25% chance to lose 10% of its maximum cooldown.";
DND_SPLPER21    = "+0.75% cooldown removed, +5% chance.";
DND_SPLR5_21    = "A fire spell made ready by this deals 20% more damage if cast within 4 seconds.";
DND_SPLR10_21   = "The chance becomes 100%.";

// ================= COLD =================

// Ice Bolt
DND_SPLDESC32   = "Sends a bolt of ice forward that deals 80 damage and slows an enemy by 30% on impact.";
DND_SPLPER32    = "";
DND_SPLR5_32    = "Slow becomes 75%.";
DND_SPLR10_32   = "Also strikes a 96 unit area around the impact.";

// Freezing Pulse
DND_SPLDESC33   = "Casts a wave of cold along the floor that deals 50 damage and rips through enemies once. Has a 20% base chance to freeze, falling to 0% as it travels.";
DND_SPLPER33    = "";
DND_SPLR5_33    = "Travels 25% further.";
DND_SPLR10_33   = "25% wider.";

// Glacial Spike
DND_SPLDESC34   = "Sends a spike of ice dealing 100 damage that rips through up to 10 enemies and shatters on impact, freezing nearby enemies for 1 second.";
DND_SPLPER34    = "";
DND_SPLR5_34    = "Freeze lasts 2 seconds.";
DND_SPLR10_34   = "Rips through enemies with Hardened Skin.";

// Chilling Breath
DND_SPLDESC35   = "Breathe a cone of cold winds in front of you, each dealing 25 damage. Channeled.";
DND_SPLPER35    = "";
DND_SPLR5_35    = "Slows enemies by 50%.";
DND_SPLR10_35   = "The cone becomes 30% wider.";

// Creeping Frost
DND_SPLDESC36   = "Fires an icy projectile that bursts on impact for 30 damage and creeps along the floor toward nearby targets for 5 seconds, dealing 200 damage per second. Cannot stagger enemies.";
DND_SPLPER36    = "";
DND_SPLR5_36    = "Lasts 4 seconds longer.";
DND_SPLR10_36   = "Can crawl 64 units higher.";

// Ice Shield
DND_SPLDESC37   = "Creates 8 rotating ice barriers around you that block enemy attacks. Each has 200 health and lasts 5 seconds.";
DND_SPLPER37    = "+25 barrier health, +0.5 seconds duration.";
DND_SPLR5_37    = "+2.5 seconds duration.";
DND_SPLR10_37   = "Blocks ripper attacks.";

// Frost Shards
DND_SPLDESC38   = "Creates 5 frost shards in front of you every 0.5 seconds over 1.5 seconds, each dealing 30 damage.";
DND_SPLPER38    = "";
DND_SPLR5_38    = "2 more shards every 0.5 seconds.";
DND_SPLR10_38   = "Shards rip through enemies.";

// Gust of Frost
DND_SPLDESC39   = "Unleashes a chilling wind that pushes enemies away and slows them by 30%.";
DND_SPLPER39    = "10% faster cooldown recovery rate.";
DND_SPLR5_39    = "Slow becomes 60%.";
DND_SPLR10_39   = "Tosses enemies aside at the end of its range. Those thrown into walls take damage in proportion to their mass.";

// Frost Bomb
DND_SPLDESC40   = "Places a pulsing ice crystal that deals 60 damage in a 128 unit radius every 0.5 seconds for 5 seconds, and stops enemies regenerating life for 5 seconds.";
DND_SPLPER40    = "";
DND_SPLR5_40    = "Pulses apply Cold Exposure, reducing cold resistance by 15%.";
DND_SPLR10_40   = "Radius increases to 180 units.";

// Ice Nova
DND_SPLDESC41   = "Conjures a nova of ice dealing 250 damage that expands outward from you in a ring up to 320 units. Enemies can only be hurt once per cast.";
DND_SPLPER41    = "+18 unit radius.";
DND_SPLR5_41    = "The ring expands 20% faster.";
DND_SPLR10_41   = "Enemies hit near the outer edge deal 15% less damage for 3 seconds.";

// Summon: Ice Golem
DND_SPLDESC42   = "Summons a golem of ice with 500 health to fight for you. It has a melee attack dealing 50 damage and a dash attack dealing 150. Can have up to 1 Ice Golem active at a time.";
DND_SPLPER42    = "+50 golem health, +5 golem damage.";
DND_SPLR5_42    = "Grants you 50% increased mana regeneration.";
DND_SPLR10_42   = "The golem casts Ice Bolt at your rank.";

// Hatred
DND_SPLDESC43   = "Aura. You and nearby allies within 256 units deal 15% more cold damage.";
DND_SPLPER43    = "+1.5% more cold damage.";
DND_SPLR5_43    = "Radius is doubled.";
DND_SPLR10_43   = "Grants 5% additional critical strike chance to cold spells and attacks.";

// Frostbite
DND_SPLDESC44   = "Curse. Enemies in a 256 unit area take -30 to cold resistance for 8 seconds and gain 25% base chance to be chilled.";
DND_SPLPER44    = "-1 further to cold resistance.";
DND_SPLR5_44    = "25% increased area of effect.";
DND_SPLR10_44   = "+4 seconds duration.";

// Blizzard
DND_SPLDESC45   = "Calls a storm that rains ice over a 256 unit area every second for 5 seconds, each piece dealing 90 damage in a 64 unit radius.";
DND_SPLPER45    = "";
DND_SPLR5_45    = "+128 unit radius.";
DND_SPLR10_45   = "Ice falls 30% faster, and 30% more of it.";

// Winter Orb
DND_SPLDESC46   = "Releases a slow orb dealing 100 damage that slows enemies by 30% for 0.75 seconds, throwing Ice Bolts in a spiral as it travels. The bolts scale with your Ice Bolt rank.";
DND_SPLPER46    = "";
DND_SPLR5_46    = "The orb freezes enemies it passes through for 0.75 seconds instead.";
DND_SPLR10_46   = "The orb also throws Frost Shards.";

// Ice Spear
DND_SPLDESC47   = "Hurls a spear of ice a short distance for 50 damage, then evolves it into a faster, stronger form dealing 250 that rips through 10 enemies with 10% added critical strike chance and 50% added critical multiplier.";
DND_SPLPER47    = "";
DND_SPLR5_47    = "+2% added critical strike chance.";
DND_SPLR10_47   = "+50% added critical strike multiplier.";

// Glacial Cascade
DND_SPLDESC48   = "An advancing wave of ice crashes forward in four bursts of 200 damage, each 20% stronger than the last. The final burst deals 100% more damage. Knocks enemies back once.";
DND_SPLPER48    = "";
DND_SPLR5_48    = "25% increased range.";
DND_SPLR10_48   = "Each burst is 20% wider than the last.";

// Shivering Armor
DND_SPLDESC49   = "Enchants your armor, or a targeted ally's, to reduce damage taken by 15% for 5 seconds. Enemies that hit it have a 20% chance to be frozen for 1 second.";
DND_SPLPER49    = "+1.5% damage reduction.";
DND_SPLR5_49    = "Targeting an ally also grants the effect to you. Targeting nobody grants it to the nearest ally.";
DND_SPLR10_49   = "The armor stops ripping attacks.";

// Avalanche
DND_SPLDESC50   = "After a brief delay, rains 75 pieces of ice behind you and forward in the direction you face, each dealing 16 damage.";
DND_SPLPER50    = "+2 more ice thrown.";
DND_SPLR5_50    = "Thrown ice has a 15% chance to freeze enemies for 1 second.";
DND_SPLR10_50   = "Ice gains a 25% chance to rip through enemies.";


// Field names for the synergy lines the panel builds from SpellSynergies. Positional on SPELLVAL_*.
DND_SPLFIELD0   = "damage";
DND_SPLFIELD1   = "secondary damage";
DND_SPLFIELD2   = "mana cost";
DND_SPLFIELD3   = "cooldown";
DND_SPLFIELD4   = "cast time";
DND_SPLFIELD5   = "duration";
DND_SPLFIELD6   = "radius";
DND_SPLFIELD7   = "amount";
DND_SPLFIELD8   = "cooldown recovery rate";

DND_SPLPANEL_PERRANK   = "Per Rank:";
DND_SPLPANEL_RANK5     = "Rank 5:";
DND_SPLPANEL_RANK10    = "Rank 10:";
DND_SPLPANEL_COST      = "Cost:";
DND_SPLPANEL_RESERVE   = "Reserves:";
DND_SPLPANEL_COOLDOWN  = "Cooldown:";
DND_SPLPANEL_CASTTIME  = "Cast Time:";
DND_SPLPANEL_REQUIRES  = "Requires:";
DND_SPLPANEL_SYNERGY   = "Synergy";
DND_SPLPANEL_LEVEL     = "Level";
DND_SPLPANEL_NEXTRANK  = "Next rank:";
DND_SPLPANEL_INSTANT   = "Instant";
DND_SPLPANEL_STATE     = "State:";
DND_SPLPANEL_ON        = "ON";
DND_SPLPANEL_OFF       = "OFF";
DND_SPLPANEL_TOGGLEHINT = "Right click the icon to switch it.";
DND_SPLPANEL_NONE      = "None";

// Board headings, positional on DND_SKILLTREE_*.

DND_SPELLTREETITLE0  = "Fire Spells";
DND_SPELLTREETITLE1  = "Cold Spells";
DND_SPELLTREETITLE2  = "Lightning Spells";
DND_SPELLTREETITLE3  = "Earth Spells";
DND_SPELLTREETITLE4  = "Black Spells";
DND_SPELLTREETITLE5  = "Arcane Spells";
DND_SPELLTREETITLE6  = "Chaos Spells";
DND_SPELLTREETITLE7  = "Combat Spells";

DND_SPLPANEL_DETAILS = "DETAILS";

DND_SPELLTREE_HOTBAR   = "Hotbar Assignments";
DND_SPLPANEL_PICKSLOT  = "Click a slot to assign a skill to it.";
DND_SPLPANEL_PICKSPELL = "Pick a skill, or click away to cancel.";
