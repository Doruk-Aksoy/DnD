DND_SPLNAME80		=	"Charged Bolt";
DND_SPLNAME81		=	"Spark";
DND_SPLNAME82		=	"Lightning Spear";
DND_SPLNAME83		=	"Shock";
DND_SPLNAME84		=	"Telekinesis";
