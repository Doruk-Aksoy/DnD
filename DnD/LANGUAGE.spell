// Hover text, straight from the design docs. Positional like the names above.
//
// DND_SPLDESC<id>   what the spell does at rank 1
// DND_SPLPER<id>    what each further rank adds
// DND_SPLR5_<id>    the rank 5 bonus   -- underscored, or DND_SPLR5_10 and DND_SPLR51_0 collide
// DND_SPLR10_<id>   the rank 10 bonus
//
// Damage, cost, cooldown, cast time, requirements and synergies are deliberately NOT here. The
// panel reads those live from SpellDefs and SpellSynergies, so they cannot drift from what the
// spell does.
//
// Damage and cost joined that list when ranks started compounding -- "+60 damage per rank" was
// true while the step was linear and became a lie the moment it was not. A DND_SPLPER lump is
// now only for what the live lines CANNOT express: radius, durations, extra projectiles and the
// like. Several are deliberately empty, and the panel skips the heading when they are.

// ================= FIRE =================

// Blaze
DND_SPLDESC0    = "Set the target on fire, dealing 8 fire damage every 0.25 seconds for 3 seconds.";
DND_SPLPER0     = "8% faster cooldown recovery rate.";
DND_SPLR5_0     = "Burns for 1 second longer.";
DND_SPLR10_0    = "Also ignites enemies within 96 units of the target.";

// Fireball
DND_SPLDESC1    = "Throw a ball of fire that deals 100 damage on impact.";
DND_SPLPER1     = "";
DND_SPLR5_1     = "Casts an additional fireball to the side.";
DND_SPLR10_1    = "Casts another additional fireball to the side.";

// Infernal Strike
DND_SPLDESC2    = "Your next melee attack deals 50 additional fire damage, with a 25% chance to strike a 128 unit area.";
DND_SPLPER2     = "";
DND_SPLR5_2     = "+25% chance to strike the area.";
DND_SPLR10_2    = "The strike is always a critical hit.";

// Warmth
DND_SPLDESC3    = "Increase your mana regeneration by 50% for 8 seconds.";
DND_SPLPER3     = "10% additional mana regeneration, +0.25 flat mana regeneration.";
DND_SPLR5_3     = "Duration becomes 12 seconds.";
DND_SPLR10_3    = "Also affects allies within 192 units.";

// Heat Shield
DND_SPLDESC4    = "Cover your armor or a targeted ally's in fire. Enemies that hit it are ignited, and it grants 100 armor rating for 5 seconds.";
DND_SPLPER4     = "+1 second duration, +25 armor rating.";
DND_SPLR5_4     = "Ignites from this last 100% longer.";
DND_SPLR10_4    = "Ignites from this are guaranteed to spread.";

// Incinerate
DND_SPLDESC5    = "Passive. Your fire damage has a 30% chance to make enemies explode on death for 5% of their maximum health within 128 units.";
DND_SPLPER5     = "+0.25% explosion damage.";
DND_SPLR5_5     = "Radius increases to 192 units.";
DND_SPLR10_5    = "The explosion no longer harms you.";

// Boiling Blood
DND_SPLDESC6    = "Grants 25% increased movement speed and 15% cooldown recovery rate for 10 seconds, at the cost of 5 health per second.";
DND_SPLPER6     = "+1% movement speed, +1 health lost per second.";
DND_SPLR5_6     = "+2 seconds duration.";
DND_SPLR10_6    = "+15% cooldown recovery rate.";

// Anger
DND_SPLDESC7    = "Aura. You and nearby allies within 256 units deal 15% more fire damage and gain 10% base ignite chance.";
DND_SPLPER7     = "+1% more fire damage, +8 unit radius.";
DND_SPLR5_7     = "+5% ignite chance.";
DND_SPLR10_7    = "Ignites on you and affected allies last 50% less.";

// Pyroblast
DND_SPLDESC8    = "Hurl a ball of flame that explodes for 360 damage in a 128 unit radius.";
DND_SPLPER8     = "";
DND_SPLR5_8     = "No longer damages you.";
DND_SPLR10_8    = "The explosion erupts into smaller fireballs dealing an eighth of its damage.";

// Searing Bond
DND_SPLDESC9    = "Lash out a flame that deals 75 damage and snares an enemy for 2.5 seconds.";
DND_SPLPER9     = "+0.25 seconds snare.";
DND_SPLR5_9     = "+2 seconds snare duration.";
DND_SPLR10_9    = "Also binds enemies within 160 units of the target.";

// Scorching Ray
DND_SPLDESC10   = "Project a beam of fire dealing 80 damage every 0.2 seconds. After 2.5 seconds of channeling it applies Fire Exposure on hit, giving -25 to fire resistance for 5 seconds.";
DND_SPLPER10    = "+8 beam length.";
DND_SPLR5_10    = "+25% beam width.";
DND_SPLR10_10   = "The beam passes through all enemies.";

// Flammability
DND_SPLDESC11   = "Curse. Enemies in a 256 unit area take -30 to fire resistance for 8 seconds and gain 25% base chance to be ignited.";
DND_SPLPER11    = "-1 further to fire resistance.";
DND_SPLR5_11    = "25% increased area of effect.";
DND_SPLR10_11   = "+4 seconds duration.";

// Immolation
DND_SPLDESC12   = "Surround yourself with fire, dealing 72 damage every second to everything within 96 units. Costs mana for as long as it runs.";
DND_SPLPER12    = "+12 unit radius.";
DND_SPLR5_12    = "Mana cost reduced by 4.";
DND_SPLR10_12   = "The damage also applies Blaze.";

// Rain of Fire
DND_SPLDESC13   = "Mark a location to rain comets over a 320 unit area for 4.5 seconds, each dealing 40 damage in a 72 unit radius.";
DND_SPLPER13    = "+8 comet damage area.";
DND_SPLR5_13    = "Comets fall 20% faster, and rains 15% more comets.";
DND_SPLR10_13   = "Holds two charges, each on its own cooldown.";

// Flame Pillar
DND_SPLDESC14   = "Create a pillar of flame that advances 30 units per tic for 2 seconds, leaving in its wake flames dealing 24 damage to everything within 96 units every 2 tics for 44 tics.";
DND_SPLPER14    = "";
DND_SPLR5_14    = "Ignores shields.";
DND_SPLR10_14   = "Creates two pillars side by side.";

// Fire Jet
DND_SPLDESC15   = "Cast a jet of fire that throws flames to both sides as it flies, dealing 180 damage on a direct hit. Each side flame bursts for 36 damage in a 48 unit radius on impact.";
DND_SPLPER15    = "";
DND_SPLR5_15    = "The jet itself also explodes on hit for the same hit damage within 128 units.";
DND_SPLR10_15   = "The side flames rip through enemies once.";

// Summon: Fire Demon
DND_SPLDESC16   = "Summon a fire demon to fight for you. It throws fireballs and sets the ground alight. Can have up to 1 Fire Demon active at a time.";
DND_SPLPER16    = "";
DND_SPLR5_16    = "Gains 25% to all resistances.";
DND_SPLR10_16   = "The demon casts Fire Jet at your rank.";

// Molten Boulder
DND_SPLDESC17   = "Call down a meteor that burns everything it passes for 24 damage and explodes on impact for 256. It shatters on a wall or after 6 seconds.";
DND_SPLPER17    = "";
DND_SPLR5_17    = "Lasts 3 seconds longer.";
DND_SPLR10_17   = "Sends six Pyroblasts outward when it shatters.";

// Righteous Fire
DND_SPLDESC18   = "Engulf yourself in flame, burning yourself and enemies within 160 units each second for 50% of your maximum health and energy shield as fire damage. Grants 20% more spell damage to other spells while it burns.";
DND_SPLPER18    = "+2% health as damage, +16 unit radius.";
DND_SPLR5_18    = "You gain 25% additional fire resistance against this spell.";
DND_SPLR10_18   = "You cannot be chilled, frozen or ignited while burning.";

// Annihilus
DND_SPLDESC19   = "Channel to build an explosion at a location up to 512 units away, for up to 2.5 seconds. Every 0.5 seconds adds a charge, starting at 250 damage and growing 30% each time, while the blast widens from 96 units to 512. Cast again to release it early for less damage, and its cooldown recovers 8% faster for each charge not built, up to 32%. You are slowed by 50% while channeling.";
DND_SPLPER19    = "";
DND_SPLR5_19    = "No longer harms you, and maximum range becomes 768 units.";
DND_SPLR10_19   = "Has a 20% chance to trigger explosions at each charge.";

// Volcano
DND_SPLDESC20   = "Conjure a volcano at a location that hurls lava for 10 seconds, each piece dealing 80 damage in an 80 unit area.";
DND_SPLPER20    = "+0.5 seconds duration.";
DND_SPLR5_20    = "Bursting lava deals 30% increased damage.";
DND_SPLR10_20   = "Produces 25% more lava.";

// Heart of Fire
DND_SPLDESC21   = "Passive. Finishing a fire spell's cast gives every OTHER fire spell on your hotbar that is on cooldown a 25% chance to lose 10% of its maximum cooldown.";
DND_SPLPER21    = "+0.75% cooldown removed, +5% chance.";
DND_SPLR5_21    = "A fire spell made ready by this deals 20% more damage if cast within 4 seconds.";
DND_SPLR10_21   = "The chance becomes 100%.";

// ================= COLD =================

// Ice Bolt
DND_SPLDESC40   = "Send a bolt of ice forward that deals 80 damage and slows an enemy by 30% on impact.";
DND_SPLPER40    = "";
DND_SPLR5_40    = "Slow becomes 75%.";
DND_SPLR10_40   = "Also strikes a 96 unit area around the impact.";

// Freezing Pulse
DND_SPLDESC41   = "Cast a wave of cold along the floor that deals 50 damage and rips through enemies once. Has a 20% base chance to freeze, falling to 0% as it travels.";
DND_SPLPER41    = "";
DND_SPLR5_41    = "Travels 25% further.";
DND_SPLR10_41   = "25% wider.";

// Glacial Spike
DND_SPLDESC42   = "Send a spike of ice dealing 180 damage that rips through up to 10 enemies and shatters on impact, freezing nearby enemies for 1 second.";
DND_SPLPER42    = "";
DND_SPLR5_42    = "Freeze lasts 2 seconds.";
DND_SPLR10_42   = "Rips through enemies with Hardened Skin.";

// Chilling Breath
DND_SPLDESC43   = "Breathe a cone of cold winds in front of you, each dealing 25 damage. Channeled.";
DND_SPLPER43    = "";
DND_SPLR5_43    = "Slows enemies by 50%.";
DND_SPLR10_43   = "The cone becomes 30% wider.";

// Creeping Frost
DND_SPLDESC44   = "Fire an icy projectile that bursts on impact for 30 damage and creeps along the floor toward nearby targets for 5 seconds, dealing 200 damage per second. Cannot stagger enemies.";
DND_SPLPER44    = "";
DND_SPLR5_44    = "Lasts 4 seconds longer.";
DND_SPLR10_44   = "Can crawl 64 units higher.";

// Ice Shield
DND_SPLDESC45   = "Create 8 rotating ice barriers around you that block enemy attacks. Each has 200 health and lasts 5 seconds.";
DND_SPLPER45    = "+25 barrier health, +0.5 seconds duration.";
DND_SPLR5_45    = "+2.5 seconds duration.";
DND_SPLR10_45   = "Blocks ripper attacks.";

// Frost Shards
DND_SPLDESC46   = "Create 5 frost shards in front of you every 0.5 seconds over 2 seconds, each dealing 60 damage.";
DND_SPLPER46    = "";
DND_SPLR5_46    = "2 more shards every 0.5 seconds.";
DND_SPLR10_46   = "Shards rip through enemies.";

// Gust of Frost
DND_SPLDESC47   = "Unleash a chilling wind that pushes enemies away and slows them by 30%. Enemies slammed into walls or each other take up to 620 physical damage, more the heavier they are.";
DND_SPLPER47    = "10% faster cooldown recovery rate and push strength, +5% slam damage.";
DND_SPLR5_47    = "Slow becomes 60%.";
DND_SPLR10_47   = "Slammed enemies also take 10% of their maximum health as added base physical damage. This bonus is capped at the slam's base damage with at most double.";

// Frost Bomb
DND_SPLDESC48   = "Place a pulsing ice crystal that deals 60 damage in a 128 unit radius every 0.5 seconds for 5 seconds, and stops enemies regenerating life for 5 seconds.";
DND_SPLPER48    = "";
DND_SPLR5_48    = "Pulses apply Cold Exposure, reducing cold resistance by 15%.";
DND_SPLR10_48   = "Radius increases to 256 units.";

// Ice Nova
DND_SPLDESC49   = "Conjure a nova of ice dealing 250 damage that expands outward from you in a ring up to 320 units. Enemies can only be hurt once per cast.";
DND_SPLPER49    = "+18 unit radius.";
DND_SPLR5_49    = "The ring expands 20% faster.";
DND_SPLR10_49   = "Enemies hit near the outer edge deal 15% less damage for 3 seconds.";

// Summon: Ice Golem
DND_SPLDESC50   = "Summon a golem of ice to fight for you. It has a melee attack and a dash attack that hits three times as hard. Can have up to 1 Ice Golem active at a time.";
DND_SPLPER50    = "";
DND_SPLR5_50    = "Grants you 50% increased mana regeneration.";
DND_SPLR10_50   = "The golem casts Ice Bolt at your rank.";

// Hatred
DND_SPLDESC51   = "Aura. You and nearby allies within 256 units deal 15% more cold damage.";
DND_SPLPER51    = "+1.5% more cold damage.";
DND_SPLR5_51    = "Radius is doubled.";
DND_SPLR10_51   = "Grants 5% additional critical strike chance to cold spells and attacks.";

// Frostbite
DND_SPLDESC52   = "Curse. Enemies in a 256 unit area take -30 to cold resistance for 8 seconds and gain 25% base chance to be chilled.";
DND_SPLPER52    = "-1 further to cold resistance.";
DND_SPLR5_52    = "25% increased area of effect.";
DND_SPLR10_52   = "+4 seconds duration.";

// Blizzard
DND_SPLDESC53   = "Call a storm over a 256 unit area for 5 seconds, dropping a volley of 16 icicles every 0.66 seconds. Each deals 90 damage in a 48 unit radius.";
DND_SPLPER53    = "";
DND_SPLR5_53    = "+128 unit radius, and each icicle's blast grows with it to 72 units.";
DND_SPLR10_53   = "Volleys fall 30% more often, each with 30% more ice.";

// Winter Orb
DND_SPLDESC54   = "Release a slow orb ripping once dealing 100 damage that slows enemies by 30% for 0.75 seconds, throwing Ice Bolts in a spiral as it travels. The bolts scale with your Ice Bolt rank. Serpent and Hydra do not work on the orb; the bolts it throws chain and fork with Ice Bolt's own gems.";
DND_SPLPER54    = "+10% more damage on the bolts and shards it throws.";
DND_SPLR5_54    = "The orb freezes enemies it passes through for 0.75 seconds instead.";
DND_SPLR10_54   = "The orb also throws Frost Shards.";

// Ice Spear
DND_SPLDESC55   = "Hurl a spear of ice a short distance for 50 damage, then evolves it into a faster, stronger form dealing 250 damage that rips through 10 enemies with 10% added critical strike chance and 50% added critical multiplier.";
DND_SPLPER55    = "";
DND_SPLR5_55    = "+2% added critical strike chance.";
DND_SPLR10_55   = "+50% added critical strike multiplier.";

// Glacial Cascade
DND_SPLDESC56   = "An advancing wave of ice crashes forward in four bursts of 200 damage, each 20% stronger and 10% wider than the last. The final burst deals 100% more damage. Knocks enemies back once.";
DND_SPLPER56    = "";
DND_SPLR5_56    = "25% increased range, and one more burst.";
DND_SPLR10_56   = "Each burst is 25% wider than the last, instead of 10%.";

// Shivering Armor
DND_SPLDESC57   = "Enchant your armor, or a targeted ally's, to reduce damage taken by 15% for 5 seconds. Enemies that hit it have a 20% chance to be frozen for 1 second.";
DND_SPLPER57    = "+1.5% damage reduction.";
DND_SPLR5_57    = "Targeting an ally also grants the effect to you. Targeting nobody grants it to the nearest ally.";
DND_SPLR10_57   = "The armor stops ripping attacks.";

// Avalanche
DND_SPLDESC58   = "After a brief delay, rain 180 pieces of ice over 2.25 seconds behind you towards the direction you face, each dealing 50 damage. Enemies on the ground it covers are slowed by 50%.";
DND_SPLPER58    = "+9 additional ice thrown.";
DND_SPLR5_58    = "Thrown ice has a 15% chance to freeze enemies for 1 second.";
DND_SPLR10_58   = "Ice gains a 25% chance to rip through enemies.";

// ================= LIGHTNING =================

// Charged Bolt
DND_SPLDESC80   = "Launch a bolt that wanders towards where you face, bouncing off surfaces for 3 seconds and dealing 10-120 damage.";
DND_SPLPER80    = "+1 bolt at every even rank.";
DND_SPLR5_80    = "Bolts last 5 seconds.";
DND_SPLR10_80   = "Bolts also bounce off enemies.";

// Spark
DND_SPLDESC81   = "Zap an area up to 128 units in front of you, dealing 1-30 damage in a 96 unit radius every 0.15 seconds for 1.5 seconds.";
DND_SPLPER81    = "";
DND_SPLR5_81    = "The area grows to a 160 unit radius.";
DND_SPLR10_81   = "Zaps for 3 seconds.";

// Lightning Spear
DND_SPLDESC82   = "Throw a spear of lightning dealing 25-300 damage that bounces 6 times, each bounce dealing 5-60 damage in a 72 unit radius. When it meets an enemy it tries to pass through, up to 3 times.";
DND_SPLPER82    = "+1 bounce at every even rank.";
DND_SPLR5_82    = "+2 pass attempts.";
DND_SPLR10_82   = "Pass attempts also deal the bounce damage.";

// Shock
DND_SPLDESC83   = "Electrocute a target enemy, making it take 25% more lightning damage for 5 seconds.";
DND_SPLPER83    = "+2.5% damage taken.";
DND_SPLR5_83    = "Lasts 8 seconds.";
DND_SPLR10_83   = "Applies to all elemental damage, not only lightning.";

// Telekinesis
DND_SPLDESC84   = "Push a target enemy within 640 units away from you with magnetic force.";
DND_SPLPER84    = "10% further push, -0.5 seconds cooldown.";
DND_SPLR5_84    = "Casting makes you reflective for 2 seconds: reflectable enemy projectiles that hit you are reflected back.";
DND_SPLR10_84   = "The pushed enemy takes 10% of its maximum health as lightning damage, capped at 870 base damage.";

// Static Field
DND_SPLDESC85   = "Aura. Zaps a random enemy within 128 units for 75 damage every 5 seconds.";
DND_SPLPER85    = "+16 radius.";
DND_SPLR5_85    = "Zaps every 2.5 seconds.";
DND_SPLR10_85   = "Zaps apply Shock.";

// Forked Lightning
DND_SPLDESC86   = "Strike the enemy you face with lightning for 20-375 damage, forking to up to 5 enemies behind it.";
DND_SPLPER86    = "+1 fork at every even rank.";
DND_SPLR5_86    = "-3 seconds cooldown.";
DND_SPLR10_86   = "+5 forks.";

// Crackling Lance
DND_SPLDESC87   = "Release a beam of lightning 512 units long and 192 wide, dealing 60-240 damage, with smaller beams branching along it. Casting again builds intensity, up to 3 stacks: each grants 10% more length and 35% more damage, and cuts the branching by 33%. Loses 1 intensity every 0.5 seconds while moving, or 1 at once if you teleport; pausing the cast does not lose any.";
DND_SPLPER87    = "";
DND_SPLR5_87    = "The beam is 20% wider.";
DND_SPLR10_87   = "+1 maximum intensity.";

// Blink
DND_SPLDESC88   = "Dash 128 units forward in an instant, through enemies.";
DND_SPLPER88    = "+16 distance, -0.5 seconds cooldown.";
DND_SPLR5_88    = "Enemies you dash through are Shocked.";
DND_SPLR10_88   = "While Overcharge charges or holds its charge, the dash adds charge as if you had run its distance.";

// Overcharge
DND_SPLDESC89   = "Charge up for 3 seconds, building charge the faster you move. Your next weapon attack unleashes it for 15 damage per charge, up to 100 charges. Standing still for over a second slowly bleeds the charge away.";
DND_SPLPER89    = "";
DND_SPLR5_89    = "25% faster charge generation.";
DND_SPLR10_89   = "Charges for 2 more seconds.";

// Energy Blade
DND_SPLDESC90   = "You have 50% less maximum energy shield, and your melee weapons deal added lightning damage from 2% to 25% of what remains.";
DND_SPLPER90    = "+1% of energy shield on the maximum.";
DND_SPLR5_90    = "The minimum becomes 5%.";
DND_SPLR10_90   = "Only 40% less energy shield.";

// Conductivity
DND_SPLDESC91   = "Curse. Enemies in a 256 unit area take -30 to lightning resistance for 8 seconds and gain 25% base chance to be overloaded.";
DND_SPLPER91    = "-1 further to lightning resistance.";
DND_SPLR5_91    = "25% increased area of effect.";
DND_SPLR10_91   = "+4 seconds duration.";

// Chain Lightning
DND_SPLDESC92   = "Unleash a bolt that chains 5 times to the nearest enemy within 384 units, dealing 10-275 damage to the first and 5% less per chain, to at most 75% less. Each hit deals 15% more damage for every chain still to come. An enemy can be chained to again only after two other chains. Every chain also forks to one more nearby enemy at that chain's damage but it does not chain further.";
DND_SPLPER92    = "+1 chain at every even rank.";
DND_SPLR5_92    = "Only 4% less damage per chain.";
DND_SPLR10_92   = "30% chance to apply Shock on each hit.";

// Storm Brand
DND_SPLDESC93   = "Place a brand that attaches to an enemy within 96 units, waiting for one if none is near and moving on when its host dies. Attached, it beams its host and up to 3 more enemies within 128 units every 0.5 seconds for 9-90 damage, for 6 seconds. Beams deal 80% more damage to the branded enemy. Spell haste also speeds up the beams.";
DND_SPLPER93    = "";
DND_SPLR5_93    = "Beams one more enemy.";
DND_SPLR10_93   = "An enemy can carry 2 brands.";

// Wrath
DND_SPLDESC94   = "Aura. You and nearby allies within 256 units deal 15% more lightning damage and gain 10% base chance to overload.";
DND_SPLPER94    = "+1% more lightning damage, +8 radius.";
DND_SPLR5_94    = "+5% overload chance.";
DND_SPLR10_94   = "Overload on you and affected allies lasts 50% less.";

// Galvanic Surge
DND_SPLDESC95   = "Grant yourself a jolt of energy, instantly recovering the cooldown of the last spell you put on cooldown.";
DND_SPLPER95    = "-1 mana cost.";
DND_SPLR5_95    = "Also removes all ailments on you.";
DND_SPLR10_95   = "Grants 25% spell haste for 5 seconds.";

// Monsoon
DND_SPLDESC96   = "Call a storm that follows a target enemy: after a second, clouds gather in a 320 unit radius around it for 10 seconds, striking enemies every 0.25 to 0.75 seconds for 225 damage in an 80 unit radius. An enemy is struck at most once a second.";
DND_SPLPER96    = "";
DND_SPLR5_96    = "Lasts 5 seconds longer.";
DND_SPLR10_96   = "Strikes have a 10% chance to apply Shock.";

// Thunder Clap
DND_SPLDESC97   = "Slam the ground for a shockwave ring of 192 units that expands 3 times, each 30% wider and dealing 30% more damage. Deals 180 damage, plus 40% of your equipped melee weapon's damage as lightning when you hold one.";
DND_SPLPER97    = "";
DND_SPLR5_97    = "Stuns enemies hit for 1.5 seconds.";
DND_SPLR10_97   = "One more expansion.";

// Storm Call
DND_SPLDESC98   = "Mark a 192 unit area for lightning to strike after 1.6 seconds for 80-720 damage. A strike sets off every other pending Storm Call in turn.";
DND_SPLPER98    = "";
DND_SPLR5_98    = "The radius becomes 320.";
DND_SPLR10_98   = "25% chance to strike at once.";

// Surgecast
DND_SPLDESC99   = "Gain Surgecast for 5 seconds: your next spell with a cast time casts instantly, with a 20% chance to refund its mana.";
DND_SPLPER99    = "-1 mana cost.";
DND_SPLR5_99    = "40% chance to refund.";
DND_SPLR10_99   = "Holds two charges. Casting it while Surgecast is up refreshes the buff.";

// ================= EARTH =================

// Shrapnel
DND_SPLDESC120  = "Unearth a shard of rock and throws it, dealing 60 damage and ripping through up to 10 enemies.";
DND_SPLPER120   = "+1 rip at every even rank.";
DND_SPLR5_120   = "Rips through enemies with Hardened Skin.";
DND_SPLR10_120  = "Throws three shards instead of one.";

// Noxious Blast
DND_SPLDESC121  = "Target a spot within 512 units. After 0.4 seconds it bursts in a 96 unit radius, poisoning enemies caught for 50 damage a second for 3 seconds.";
DND_SPLPER121   = "";
DND_SPLR5_121   = "The poison lasts 1 second longer.";
DND_SPLR10_121  = "The radius becomes 160.";

// Rockslide
DND_SPLDESC122  = "Raise a massive boulder and tosses it forward in an arc. Enemies within 96 units of where it lands take 250 damage, full within 48 units and less further out, and are stunned for 1.5 seconds.";
DND_SPLPER122   = "-0.5 seconds cooldown.";
DND_SPLR5_122   = "The boulder flies 50% faster.";
DND_SPLR10_122  = "The radius becomes 180 and the stun lasts 2.5 seconds.";

// Blockade
DND_SPLDESC123  = "Raise a slanted wall of rock up to 384 units in front of you that blocks enemies and their attacks. The wall is 96 units long, withstands 250 damage and stands for 10 seconds. A new wall replaces your old one.";
DND_SPLPER123   = "+16 wall length, +75 wall health, +1 second.";
DND_SPLR5_123   = "You, your allies and your pets can shoot through the wall.";
DND_SPLR10_123  = "When the wall breaks, it sends a volley of 8 Shrapnels lined up side by side.";

// Baleful Infusion
DND_SPLDESC124  = "Enchant your next melee attack within 10 seconds: 50% of its damage is converted to poison, and it always poisons.";
DND_SPLPER124   = "+5% damage converted.";
DND_SPLR5_124   = "The enchanted attack pierces 20 poison resistance.";
DND_SPLR10_124  = "Enemies killed within 2 seconds of the hit spread the same poison to enemies within 192 units.";

// Toxic Trap
DND_SPLDESC125  = "Lay a trap that bursts into toxic gas when a monster touches it. The gas deals 32 damage every 0.25 seconds in a 72 unit radius for 5 seconds, and poisons each enemy it reaches once. Traps last 30 seconds, and 2 can be out at once.";
DND_SPLPER125   = "";
DND_SPLR5_125   = "+2 traps out at once.";
DND_SPLR10_125  = "The gas lasts 1 second longer and traps last 15 seconds longer.";

// Venom Gyre
DND_SPLDESC126  = "Throw a bouncing toxic disc that rips through up to 5 enemies once each for 150 damage, with a 50% chance to poison for 300 damage over 3 seconds. After 5 seconds, or out of rips, it flies back to you, hitting each enemy once more on the way. Catch it for 10% more poison damage for 5 seconds; catch it during a dash to throw a fresh one at double damage that flies straight and never bounces.";
DND_SPLPER126   = "";
DND_SPLR5_126   = "Rips through up to 10 enemies.";
DND_SPLR10_126  = "Throws 2 more.";

// Rock Armor
DND_SPLDESC127  = "Cover yourself in rock that absorbs 80 damage for 8 seconds. It absorbs everything, but magic damage only at 50% effectiveness.";
DND_SPLPER127   = "+40 damage absorbed.";
DND_SPLR5_127   = "Lasts 2 seconds longer.";
DND_SPLR10_127  = "When the armor shatters, it throws 8 Shrapnels around you in a circle.";

// Upheaval
DND_SPLDESC128  = "Crack open rifts that branch and spread up to 480 units ahead of you, widening to 256 units. After 1.5 seconds they explode for 100 damage, throwing enemies into the air and stunning them for 2 seconds. Thrown enemies take 100 damage when they land, plus up to 500 more by their mass. The broken ground explodes again 2 seconds later for 300 damage.";
DND_SPLPER128   = "+16 reach and width.";
DND_SPLR5_128   = "An additional branch is created.";
DND_SPLR10_128  = "The second explosion repeats 2 more times, a second apart.";

// Threaded Volley
DND_SPLDESC129  = "Draw 5 rocks from the ground and hurl them where you face in a quickening volley, each dealing 80 damage on impact and 40 in an 80 unit radius. The ground within 256 units of you is energized for 15 seconds: casting inside it launches one rock instead, dealing 450 damage in a 160 unit radius and bursting into chunks that rip through up to 4 enemies for 16 damage. Casts inside an energized area have 75% cooldown recovery rate and cost 30% less.";
DND_SPLPER129   = "";
DND_SPLR5_129   = "Each energized area past the first that you cast inside grants this spell 20% more damage.";
DND_SPLR10_129  = "Energized areas cover 384 units.";

// Vines of Torment
DND_SPLDESC130  = "Whip a line of vines forward out of the ground, dealing 100 poison damage and snaring enemies caught for 3 seconds. Allies they touch are healed for 100 instead. The vines last 2.5 seconds.";
DND_SPLPER130   = "+0.5 seconds snare at every even rank, +25 ally heal.";
DND_SPLR5_130   = "Vines are 25% wider.";
DND_SPLR10_130  = "Vines travel 100% farther.";

// Corrosive Breath
DND_SPLDESC131  = "Build up a deadly stench and releases it over 1.5 seconds as toxic fumes in a 60 degree cone, poisoning for 600 damage over 5 seconds. For 3 seconds afflicted enemies are slowed by 25% and take 10% more poison damage, and fortified enemies lose up to 50% of their fortification.";
DND_SPLPER131   = "";
DND_SPLR5_131   = "Afflicted enemies take 25% more poison damage instead.";
DND_SPLR10_131  = "The cone widens to 90 degrees and releases 33% more fumes, which reach 33% farther.";

// Agony
DND_SPLDESC132  = "Aura. You and allies within 256 units deal 18% more damage over time.";
DND_SPLPER132   = "+1% more damage over time, +16 radius.";
DND_SPLR5_132   = "Enemies in the aura gain a base 10% chance to be poisoned and to bleed.";
DND_SPLR10_132  = "Poison on you and allies in the aura lasts 25% less.";

// Summon: Rock Golem
DND_SPLDESC133  = "Summon a very durable rock golem that fights for you with melee attacks. It also grants you 10% less physical damage taken.";
DND_SPLPER133   = "";
DND_SPLR5_133   = "The golem can cast Rockslide.";
DND_SPLR10_133  = "The golem is immune to elemental damage and resists explosions.";

// Vulnerability
DND_SPLDESC134  = "Curse. Enemies in a 256 unit area take -30 to physical resistance for 8 seconds and gain 25% base chance to bleed.";
DND_SPLPER134   = "-1 further to physical resistance.";
DND_SPLR5_134   = "25% increased area of effect.";
DND_SPLR10_134  = "+4 seconds duration.";

// Crushing Rocks
DND_SPLDESC135  = "Raise two huge rocks beside a target enemy that try to crush it 5 times for 270 damage each.";
DND_SPLPER135   = "";
DND_SPLR5_135   = "Each crush hits everything in a 96 unit radius.";
DND_SPLR10_135  = "7 crushes.";

// Despair
DND_SPLDESC136  = "Curse. Enemies in a 256 unit area take -30 to poison resistance for 10 seconds and gain 25% base chance to be poisoned.";
DND_SPLPER136   = "-1 further to poison resistance.";
DND_SPLR5_136   = "25% increased area of effect.";
DND_SPLR10_136  = "Cursed enemies cannot regenerate health.";

// Poison Nova
DND_SPLDESC137  = "Release a nova of 6 poison projectiles that pass through enemies for 4 seconds, dealing 50 damage on contact and poisoning for 900 damage over 4 seconds.";
DND_SPLPER137   = "";
DND_SPLR5_137   = "+4 projectiles.";
DND_SPLR10_137  = "Projectiles last 50% longer.";

// Unleash Earth
DND_SPLDESC138  = "Raise a pillar of rock under where you aim, up to 640 units away, then channel: each attack raises another, at most one every 0.33 seconds and 5 pillars in all. Each erupts in a 96 unit radius for 800 damage and flings enemies up and aside; they crash down for up to 1200 damage by their mass and how high they flew. An enemy flung again takes 25% more. Bosses barely fly. Each pillar costs its mana. The channel ends after the fifth pillar, when you cast this again, after 5 seconds without a pillar, or when you cannot pay for one; the cooldown starts then.";
DND_SPLPER138   = "+400 pillar damage, +400 crash landing cap.";
DND_SPLR5_138   = "Cast a pillar under yourself to launch yourself without taking damage.";
DND_SPLR10_138  = "Flung enemies that hit a wall or another enemy mid flight take extra damage, half the most a crash landing deals.";

// Geyser
DND_SPLDESC139  = "Split the ground ahead of you into 10 geysers of acid that spit 8-12 drops a second for 5 seconds in random directions. Each drop deals 90 damage in a 48 unit radius and always poisons.";
DND_SPLPER139   = "+35 damage per drop.";
DND_SPLR5_139   = "Drops hit twice the radius.";
DND_SPLR10_139  = "50% more geysers.";

// Rejuvenation
DND_SPLDESC140  = "You or the ally you target recover 180 health over 4 seconds. Ends early if the target is injured. Does not stack: a new cast replaces the old one.";
DND_SPLPER140   = "+30 health recovered, +3 mana cost.";
DND_SPLR5_140   = "No longer ends when the target is injured.";
DND_SPLR10_140  = "Cleanses the target's ailments when cast.";

// ================= BLACK =================

// Plague
DND_SPLDESC160  = "Unleash a plague on the target enemy, dealing 50 magic damage every 0.5 seconds for 2.5 seconds. If the enemy dies with it, the plague spreads to the nearest unplagued enemy within 128 units with 10% more damage, stacking with each spread up to twice the damage. Contagion can spread it to more enemies.";
DND_SPLPER160   = "";
DND_SPLR5_160   = "Each spread carries 30% more damage.";
DND_SPLR10_160  = "A death spreads the plague to up to two enemies at once.";

// Summon: Zombie
DND_SPLDESC161  = "Raise a zombie from an organic corpse to do your bidding for 10 seconds. Needs an organic corpse near where you aim, which it consumes.";
DND_SPLPER161   = "+1 second duration.";
DND_SPLR5_161   = "Zombies attack 50% faster.";
DND_SPLR10_161  = "Zombies gain 15% to all resistances.";

// Nox
DND_SPLDESC162  = "Curse. Blind enemies in a 128 unit area for 5 seconds. Blinded enemies attack in random directions instead of at you.";
DND_SPLPER162   = "+1 second duration, +8 radius.";
DND_SPLR5_162   = "Cursed enemies become more aggressive.";
DND_SPLR10_162  = "Cursed enemies deal 15% less damage to players.";

// Temporal Chains
DND_SPLDESC163  = "Curse. Slow enemies in a 160 unit area by 30% for 5 seconds.";
DND_SPLPER163   = "+1 second duration, +8 radius.";
DND_SPLR5_163   = "Projectiles of cursed enemies are slowed by half as much.";
DND_SPLR10_163  = "The slow becomes 50%, and cursed enemies are less likely to attack.";

// Dark Wind
DND_SPLDESC164  = "Unleash a wind of darkness that deals 64 magic damage in an 80 unit radius every 0.15 seconds as it travels. Lasts 4 seconds, or until it hits a wall.";
DND_SPLPER164   = "+0.5 seconds duration.";
DND_SPLR5_164   = "Bounces off walls.";
DND_SPLR10_164  = "The damage radius is 30% larger.";

// Essence Theft
DND_SPLDESC165  = "Launch a fast unholy missile that deals 450 magic damage over 3 seconds and returns 20% of the damage dealt to you as health. Contagion can spread it to more enemies.";
DND_SPLPER165   = "-1.5 seconds cooldown.";
DND_SPLR5_165   = "Returns 33% of the damage as health.";
DND_SPLR10_165  = "The enemy hit is pacified for 3 seconds, unable to attack. Does not work on dungeon bosses.";

// Summon: Knight
DND_SPLDESC166  = "Summon an undead knight from a corpse to do your bidding for 20 seconds. Knights have 300 health and hit for 52-64 melee damage. Needs an organic corpse near where you aim, which it consumes.";
DND_SPLPER166   = "+150 health, +32 melee damage, +2.5 seconds duration.";
DND_SPLR5_166   = "Knights also throw a spectral axe for 75% of their melee damage as magic. It cannot hit ghosts.";
DND_SPLR10_166  = "Knights have a 25% chance to throw a red axe instead, dealing 50% more than their melee damage.";

// Legion Mastery
DND_SPLDESC167  = "Passive. Your Knights, Death Knights and Slayer Knights have 5% more health and deal 10% more damage.";
DND_SPLPER167   = "+5% more knight health, +10% more knight damage.";
DND_SPLR5_167   = "Knights no longer have a duration. Death Knights leech 5% of the melee damage they deal as life.";
DND_SPLR10_167  = "Every knight attack can hit ghosts, and Slayer Knight flames ignore immunity to radius damage.";

// Delirium
DND_SPLDESC168  = "Curse. The target enemy falls into psychosis for 5 seconds, attacking a random enemy nearby, even its own kind. Does not work on dungeon bosses.";
DND_SPLPER168   = "+1 second duration.";
DND_SPLR5_168   = "Costs 20% less mana.";
DND_SPLR10_168  = "The cursed enemy deals 100% more damage while it lasts.";

// Enfeeble
DND_SPLDESC169  = "Curse. Enemies in a 128 unit area deal 30% less damage for 8 seconds.";
DND_SPLPER169   = "+1% less damage dealt.";
DND_SPLR5_169   = "The radius is doubled.";
DND_SPLR10_169  = "Lasts 4 seconds longer.";

// Finger of Death
DND_SPLDESC170  = "Project a bolt of red lightning ahead of you that deals 600 magic damage to the first enemy it hits.";
DND_SPLPER170   = "-1 second cooldown.";
DND_SPLR5_170   = "The bolt damages every enemy in its line instead of only one.";
DND_SPLR10_170  = "Ignores enemy resistances and immunities.";

// Contagion
DND_SPLDESC171  = "Mark a 192 unit area where enemies take 240 magic damage over 5 seconds. An enemy that dies with magic damage over time on it passes those effects, at full strength, to enemies within the same radius.";
DND_SPLPER171   = "";
DND_SPLR5_171   = "The radius is 20% larger.";
DND_SPLR10_171  = "Damage over time it carries ignores shields and fortification.";

// Implosion
DND_SPLDESC172  = "Target an organic corpse up to 384 units away. After a short delay it explodes for 50 damage plus 4% of the corpse's maximum health as fire damage in a 96 unit radius, destroying the corpse. Increases to spell damage do not affect the explosion.";
DND_SPLPER172   = "+25 damage, +0.25% of the corpse's maximum health, +16 range.";
DND_SPLR5_172   = "33% increased explosion radius.";
DND_SPLR10_172  = "25% chance to also detonate another corpse near the target, which can chain on to further corpses.";

// Summon: Dark Portal
DND_SPLDESC173  = "Open a portal for 10 seconds that empowers your summoning. Minions you summon or raise within 256 units of it have 10% more health, duration and damage. The portal has 300 health and benefits from minion modifiers, but does not count against your pet cap.";
DND_SPLPER173   = "+10% more minion health and damage, +1 second duration.";
DND_SPLR5_173   = "Minions summoned near it also gain 25% increased movement speed.";
DND_SPLR10_173  = "Minions summoned near it also gain 25% to all resistances.";

// Summon: Ghast
DND_SPLDESC174  = "Summon a ghostly minion with 100 health that casts your Dark Wind, at rank 1 if you have not learned it. It casts up to two Dark Winds, then rests for 8 seconds. Counts as 2 against your pet cap.";
DND_SPLPER174   = "+100 health.";
DND_SPLR5_174   = "When hurt, the Ghast shifts out of existence and cannot be targeted for 0.5 seconds, at most once every 3 seconds.";
DND_SPLR10_174  = "Rests only 5 seconds between attacks.";

// Subjugate
DND_SPLDESC175  = "Curse. Launch a ball that forces the enemy it hits to kneel in submission for 8 seconds: it cannot move, attack or cast spells. Any damage it takes breaks the submission early. Lasts half as long on bosses, and does not work on dungeon bosses.";
DND_SPLPER175   = "+1 second duration.";
DND_SPLR5_175   = "Also curses enemies within 128 units of the target.";
DND_SPLR10_175  = "50% chance to turn cursed enemies to your side as temporary minions while it lasts, instead of making them kneel.";

// Penetrate
DND_SPLDESC176  = "Curse. Pierce the imbued skin of enemies in a 160 unit area for 5 seconds, so projectiles rip through them, Hardened Skin included.";
DND_SPLPER176   = "+1 second duration, +8 radius.";
DND_SPLR5_176   = "The radius is doubled.";
DND_SPLR10_176  = "Attacks and spells that pass through cursed enemies deal 25% more damage.";

// Pain Amp
DND_SPLDESC177  = "Curse. Enemies in a 128 unit area take 25% more damage for 5 seconds.";
DND_SPLPER177   = "+2.5% more damage taken.";
DND_SPLR5_177   = "The radius is doubled.";
DND_SPLR10_177  = "Lasts 5 seconds longer.";

// Soulstorm
DND_SPLDESC178  = "After a brief delay, raise a storm at the target spot that drifts towards you, blasting enemies with magic damage every 0.35 seconds for 8 seconds, plus more for each Soul you carry. Each blast drains 5 of your Souls. Damage is highest within 160 units of its centre and lowest at its 320 unit edge. Recast while it rages to send it slowly towards where you point, at no cost.";
DND_SPLPER178   = "+0.5 seconds duration.";
DND_SPLR5_178   = "Each blast drains 25% fewer Souls.";
DND_SPLR10_178  = "Pulls enemies towards its centre as it blasts them. Enemies it kills are swallowed, leaving no corpse.";

// Carrion Crows
DND_SPLDESC179  = "Summon a whirl of 5 flesh eating undead crows that circle you for 10 seconds, darting out to tear at enemies within 256 units for 40 damage in very short intervals.";
DND_SPLPER179   = "";
DND_SPLR5_179   = "Crows fly 25% faster.";
DND_SPLR10_179  = "Crows heal you for 5% of the damage they deal.";

// Nether Walk
DND_SPLDESC180  = "Travel 384 units towards where you are looking, unhittable on the way, dealing 225 magic damage to enemies you pass through.";
DND_SPLPER180   = "";
DND_SPLR5_180   = "Your energy shield starts recovering at once when you cast it, if it has not already.";
DND_SPLR10_180  = "Explodes for the same damage in a 256 unit radius where you start and where you end.";

// Summon Mastery
DND_SPLDESC181  = "Passive. Your summons last 1 second longer and have 2.5% increased health and damage. Every 3 ranks, +1 pet cap.";
DND_SPLPER181   = "+1 second summon duration, +2.5% increased health and damage.";
DND_SPLR5_181   = "Your minions no longer have a duration.";
DND_SPLR10_181  = "Your minions gain Hardened Skin.";

// Summon: Slayer Knight
DND_SPLDESC182  = "Summon an undead slayer knight with 1000 health to do your bidding. It strikes for 72-96 physical melee damage, or hurls a diagonal slash of 6 dark flames that each deal 60 fire damage in a 96 unit radius. The flames pass through ghosts. Counts as 3 against your pet cap. Can have up to two Slayer Knights. Needs an organic corpse near where you aim, which it consumes.";
DND_SPLPER182   = "+350 health, +40 melee damage, +30 flame damage.";
DND_SPLR5_182   = "Gains Counter Attack: when hurt, it retaliates at once and is briefly invulnerable.";
DND_SPLR10_182  = "Its melee becomes a slashing wave that hits an area.";

// Transmogrify
DND_SPLDESC183  = "Curse. Launch a cursed fireball that turns a monster weaker than a Baron into a random pickup.";
DND_SPLPER183   = "-5 mana cost, -3 seconds cooldown.";
DND_SPLR5_183   = "25% increased chance to drop a health pickup.";
DND_SPLR10_183  = "Enemies it fails to transform take -10 to all resistances for 10 seconds.";

// Remove Resist
DND_SPLDESC184  = "Curse. Strip the resistance traits of a nearby target monster for 3 seconds.";
DND_SPLPER184   = "+1 second duration.";
DND_SPLR5_184   = "Also curses enemies within 128 units of the target.";
DND_SPLR10_184  = "Cursed monsters also take 25% more damage from the damage types they resist.";

// Life Tap
DND_SPLDESC185  = "Curse. Launch a cursed ball that afflicts enemies in a 160 unit radius for 10 seconds. Hitting a cursed enemy has a 25% chance to heal you for 10 health, and a cursed enemy that dies heals you for 2.5% of your missing health.";
DND_SPLPER185   = "+10 health healed on hit.";
DND_SPLR5_185   = "A cursed death heals 5% of your missing health instead.";
DND_SPLR10_185  = "The radius is doubled.";

// Death and Decay
DND_SPLDESC186  = "Channel at a target spot for up to 10 seconds, creating a 192 unit zone of pure death. Enemies inside lose 5% of their life as magic damage every second, bosses half as much. Spell and damage over time modifiers first make up for the enemy's resistances; anything beyond only adds half its usual effect, up to 2.5 times. You are slowed by 33% while channeling. Costs mana every second it runs.";
DND_SPLPER186   = "+0.25% of life lost a second.";
DND_SPLR5_186   = "The radius is doubled.";
DND_SPLR10_186  = "The cooldown is halved.";

// Summon: Doomguard
DND_SPLDESC187  = "Summon a mighty undead general from the great beyond with 2000 health. It cleaves in an arc for 250 physical melee damage, and casts your Finger of Death at your rank (rank 1 if you have not learned it) with 30% of its cooldown. When it flinches it blocks every hit for 2 seconds, with a 25% chance to answer one with its melee or a spell. Counts as 5 against your pet cap. Can have up to one Doomguard.";
DND_SPLPER187   = "+1000 health, +80 melee damage, 3% increased Finger of Death cooldown recovery rate.";
DND_SPLR5_187   = "Leaps at enemies within 384 units once every 8 seconds, landing to deal its melee damage within 256 units and stun those enemies for 2.5 seconds.";
DND_SPLR10_187  = "Casts a random curse you have learned, except Transmogrify and Banish, once every 30 seconds.";

// Banish
DND_SPLDESC188  = "Curse. Fire a cursed ball that removes the enemy it hits from this realm for 3 seconds. Does not work on Dungeon Bosses.";
DND_SPLPER188   = "+1 second duration.";
DND_SPLR5_188   = "When the enemy returns, it is afflicted by a random curse you have learned.";
DND_SPLR10_188  = "When the enemy returns, you gain one of its properties, if it has any, for half the duration.";

// Break Immunity
DND_SPLDESC189  = "Curse. Remove a random immunity from the target enemy for 15 seconds. Does nothing to an enemy without one.";
DND_SPLPER189   = "-4 seconds cooldown.";
DND_SPLR5_189   = "Affects enemies in a 192 unit radius.";
DND_SPLR10_189  = "Removes all of its immunities instead of one.";

// Silence
DND_SPLDESC190  = "Curse. The target monster cannot cast its spells for 4 seconds. Does not work on dungeon bosses.";
DND_SPLPER190   = "+0.5 seconds duration, -5 seconds cooldown.";
DND_SPLR5_190   = "Costs 100 less mana.";
DND_SPLR10_190  = "Affects enemies in a 192 unit radius.";

// Mark Prey
DND_SPLDESC191  = "Mark the target enemy for 10 seconds. Every one of your minions attacks it for as long as the mark lasts, whatever else is around.";
DND_SPLPER191   = "+0.5 seconds duration, -1 mana cost.";
DND_SPLR5_191   = "The marked enemy deals 10% less damage to your minions.";
DND_SPLR10_191  = "Your minions leech 2% of the damage they deal to the marked enemy as life over 4 seconds.";

// Summon: Death Knight
DND_SPLDESC192  = "Summon an undead death knight with 800 health to protect you. It throws homing skulls that deal 125 fire damage and may set enemies on fire, and strikes slowly for 60-80 magic melee damage. When hurt, it has a 25% chance to raise its shield and block every attack for 2 seconds. Counts as 2 against your pet cap. Can have up to two Death Knights. Needs an organic corpse near where you aim, which it consumes.";
DND_SPLPER192   = "+275 health, +40 melee damage, +50 skull damage.";
DND_SPLR5_192   = "Its raised shield also reflects projectiles.";
DND_SPLR10_192  = "Its melee becomes a slashing wave that hits an area.";

// Grave Grasp
DND_SPLDESC193  = "Target an area up to 480 units away where restless undead grasp at every enemy within 240 units for 6 seconds, slowing them by 33% and dealing 100 magic damage every 0.5 seconds.";
DND_SPLPER193   = "+60 damage, +0.5 seconds duration, +12 radius.";
DND_SPLR5_193   = "The slow becomes 66%.";
DND_SPLR10_193  = "Enemies slain within the area give 1-2 soul ammo, and their bodies rest in peace.";

// Dark Pact
DND_SPLDESC194  = "Sacrifice the minion you target to recover 4% of its maximum life as your own life over 4 seconds.";
DND_SPLPER194   = "+0.1% life recovered, -1 second cooldown.";
DND_SPLR5_194   = "Also recovers energy shield for the same amount.";
DND_SPLR10_194  = "Your next Black spell within 5 seconds deals 33% more damage.";

// Vampirism
DND_SPLDESC195  = "Aura. Your minions within 256 units leech 2.5% of the damage they deal as life. Reserves 30% of your mana.";
DND_SPLPER195   = "+0.15% leech, +24 radius.";
DND_SPLR5_195   = "Minions deal 10% more damage while they leech.";
DND_SPLR10_195  = "The aura also covers you and nearby allies, who leech the same share of their damage as life.";

// Soul Siphon
DND_SPLDESC196  = "Drain the souls of the organic corpses within 256 units, gaining 3 soul ammo from each. For every 5 souls drained, your next Black spell within 10 seconds deals 8% more damage and has 8% more area of effect, up to 40%.";
DND_SPLPER196   = "25% increased souls gained from each target.";
DND_SPLR5_196   = "Also steals the souls of up to 5 living enemies, who take 20% more magic damage for 10 seconds.";
DND_SPLR10_196  = "Killing 5 enemies whose souls you stole recovers 75% of Soul Siphon's remaining cooldown.";

// Desecrate
DND_SPLDESC197  = "Create 3 organic corpses at a spot up to 384 units away. They last 10 seconds and are level 13 monsters up to Hell Knights, mostly weaker ones.";
DND_SPLPER197   = "+2 seconds duration, +7 corpse level, +16 range. Every 3 ranks, +2 corpses.";
DND_SPLR5_197   = "Enemies near your desecrated corpses cannot regenerate life.";
DND_SPLR10_197  = "The corpses are Hell Knights and Barons, mostly Hell Knights.";

// ================= ARCANE =================

// Arcane Bolt
DND_SPLDESC200  = "Fire a bolt of arcane energy at the nearest enemy within 512 units, dealing 80 magic damage. Enemies hit take 15% more damage from Arcane spells for 5 seconds.";
DND_SPLPER200   = "Every even rank adds a target.";
DND_SPLR5_200   = "Each enemy hit has a 10% chance to grant a Power Charge.";
DND_SPLR10_200  = "30% chance to launch another set of bolts.";

// Holy Light
DND_SPLDESC201  = "Fire a beam of holy light. An ally hit is healed for 50; an enemy hit takes 50 magic damage, doubled against undead and demons. Aimed at the ground beneath your feet, it heals you.";
DND_SPLPER201   = "+25 healing.";
DND_SPLR5_201   = "Stuns undead and demons hit for 2 seconds.";
DND_SPLR10_201  = "Also heals 5% of the target's maximum health.";

// Blessing
DND_SPLDESC202  = "Heal yourself or a target ally for 10% of their missing health.";
DND_SPLPER202   = "+1% of missing health healed.";
DND_SPLR5_202   = "Heals everyone within 128 units of the target.";
DND_SPLR10_202  = "Healing can overfill health by up to 25% of maximum health.";

// Power Globe
DND_SPLDESC203  = "Hurl a globe of pure energy that passes through enemies and explodes on walls. Cast again to detonate it, or it detonates by itself after 3 seconds, dealing 200 magic damage in a 160 unit radius. Enemies it slays grant a Power Charge.";
DND_SPLPER203   = "";
DND_SPLR5_203   = "The globe bounces off surfaces up to 4 times before detonating.";
DND_SPLR10_203  = "Pulls enemies within 1.25 times the radius in before exploding, and slows them by 25% for 5 seconds.";

// Spectral Blades
DND_SPLDESC204  = "Summon six blades of energy that surge up to 144 units forward, ripping through enemies for 24 magic damage each, up to 8 times. Each blade flies at a random angle and cuts only along its edge.";
DND_SPLPER204   = "+1 rip count every two ranks, +1 blade every third rank.";
DND_SPLR5_204   = "Blades travel 25% farther.";
DND_SPLR10_204  = "Blades become 20% wider.";

// Death Seeker
DND_SPLDESC205  = "Cast a homing bolt of light that hunts down undead and magical enemies, dealing 300 magic damage to them.";
DND_SPLPER205   = "";
DND_SPLR5_205   = "Enemies hit have a 25% chance to be silenced for 5 seconds.";
DND_SPLR10_205  = "Enemies it slays rest in peace.";

// Purify
DND_SPLDESC206  = "Target an ally or a demon. An ally is cleansed of all ailments and curses; a demon takes 200 magic damage.";
DND_SPLPER206   = "";
DND_SPLR5_206   = "Demons hit have a 50% chance to be stunned for 2.5 seconds.";
DND_SPLR10_206  = "Cleansed allies gain 50% movement speed for 1.5 seconds.";

// Invigorate
DND_SPLDESC207  = "Increase the life regeneration, armor rating and mana regeneration of yourself or a target ally by 25% for 5 seconds. Costs no mana.";
DND_SPLPER207   = "+2.5% to each increase.";
DND_SPLR5_207   = "+5 seconds duration.";
DND_SPLR10_207  = "Also affects players within 192 units of the target.";

// Might
DND_SPLDESC208  = "Aura. You and allies within 256 units gain 10% of melee attack damage as extra magic damage.";
DND_SPLPER208   = "+0.75% damage gained.";
DND_SPLR5_208   = "+128 radius.";
DND_SPLR10_208  = "Applies to every attack of a melee weapon.";

// Mana Burn
DND_SPLDESC209  = "Release an arcane bolt of lightning at the target enemy, dealing 100 magic damage plus 8% of your maximum mana.";
DND_SPLPER209   = "+0.2% of maximum mana as damage.";
DND_SPLR5_209   = "Hitting an enemy that can cast spells recovers the mana spent over 4 seconds.";
DND_SPLR10_209  = "The enemy hit is silenced for 2.5 seconds.";

// Disintegrate
DND_SPLDESC210  = "Channel a ray of destruction from your hands, dealing 75 magic damage every 0.25 seconds along a 160 unit line. Costs mana every 0.25 seconds; the cooldown starts when the channel stops.";
DND_SPLPER210   = "+12 beam length.";
DND_SPLR5_210   = "Costs half the mana while you stand still.";
DND_SPLR10_210  = "Deals 10% more damage for each second channelled, up to 100%.";

// Shadow Split
DND_SPLDESC211  = "Project a shadow image of yourself that wanders in random directions and taunts nearby enemies to attack it. It has 30% of your maximum life and lasts 10 seconds. Counts as a minion.";
DND_SPLPER211   = "+2% of your maximum life.";
DND_SPLR5_211   = "+10 seconds duration.";
DND_SPLR10_211  = "The clone explodes when it dies or expires, dealing 25% of its maximum life as magic damage in a 192 unit radius.";

// Summon: Familiar
DND_SPLDESC212  = "Summon a familiar that flies over your shoulder and attacks nearby enemies on its own, firing projectiles that deal 60 magic damage in quick succession. It cannot be attacked. Lasts 10 seconds.";
DND_SPLPER212   = "+30 projectile damage, +1 second duration.";
DND_SPLR5_212   = "Projectiles explode in a 64 unit radius for half damage.";
DND_SPLR10_212  = "Projectiles cannot be deflected and ignore shields.";

// Arcane Trap
DND_SPLDESC213  = "Place a magical trap where you stand. Alone it is a proximity mine dealing 300 magic damage in a 144 unit radius. Traps 96 to 256 units apart link, and their links are trip-wires. When one goes off, the rest follow 0.25 seconds apart, and linked traps open a black hole at their centre that pulls enemies in and deals 150 magic damage per trap. Traps last 30 seconds, 4 at most.";
DND_SPLPER213   = "+4.8 longest link.";
DND_SPLR5_213   = "+1 trap.";
DND_SPLR10_213  = "Traps last 15 seconds longer. +1 trap.";

// Divine Judgement
DND_SPLDESC214  = "Call a holy sword of justice down from the sky on the target spot, dealing 300 magic damage in a 192 unit radius. This damage can inflict bleeding. Shortly after it lands, 8 Holy Lights burst from it in every direction.";
DND_SPLPER214   = "+12 unit radius.";
DND_SPLR5_214   = "Enemies within 80 units of the middle take 50% more damage and always bleed.";
DND_SPLR10_214  = "The sword's strike ignores immunities and shields.";

// Purge
DND_SPLDESC215  = "Launch a magical tendril at an organic enemy within 512 units, dealing 180 magic damage. Demons hit are stunned for 2.5 seconds, undead are silenced for 2.5 seconds. It chains to 3 more organic enemies within 192 units.";
DND_SPLPER215   = "+1 chain every even rank.";
DND_SPLR5_215   = "Deals 25% more damage each time it chains.";
DND_SPLR10_215  = "It can also chain to hurt allies or you, healing for 60% of the damage it would deal.";

// Enchant Weapon
DND_SPLDESC216  = "Enchant your weapon or a target ally's: weapon base damage is increased by 30% for 8 seconds.";
DND_SPLPER216   = "+0.5 seconds duration.";
DND_SPLR5_216   = "+7 seconds duration.";
DND_SPLR10_216  = "The weapon converts 50% of its damage to energy and gains +20 energy pierce.";

// Holy Prayers
DND_SPLDESC217  = "Aura. You and allies within 256 units gain +10 life regeneration. Each being healed costs 5 mana, and that cost cannot be reduced.";
DND_SPLPER217   = "+2.5 life regeneration.";
DND_SPLR5_217   = "Also regenerate 1% of maximum life.";
DND_SPLR10_217  = "Each being healed costs 3 mana.";

// Blessed Aim
DND_SPLDESC218  = "Aura. Non-magical ranged attacks of you and allies within 256 units deal 15% more damage and gain 10% more accuracy rating.";
DND_SPLPER218   = "+1.5% more damage, +1% more accuracy rating.";
DND_SPLR5_218   = "Radius becomes 384.";
DND_SPLR10_218  = "Affected ranged attacks gain +1.5% critical strike chance.";

// Purity of Elements
DND_SPLDESC219  = "Aura. Elemental damage of you and allies within 256 units is 15% more.";
DND_SPLPER219   = "+1.5% more damage.";
DND_SPLR5_219   = "Affected elemental damage gains +10% chance to inflict its ailment.";
DND_SPLR10_219  = "Also grants +10 elemental pierce.";

// Arcanery
DND_SPLDESC220  = "Aura. Magical attacks and spells of you and allies within 256 units deal 15% more damage, and cooldowns recover 15% faster.";
DND_SPLPER220   = "+1.5% more damage, +0.5% cooldown recovery rate.";
DND_SPLR5_220   = "Also grants 10% spell haste.";
DND_SPLR10_220  = "Radius is doubled.";

// Arcane Comet
DND_SPLDESC221  = "Mark a spot up to 1024 units away; after a brief delay a comet of immense arcane power falls on it, dealing 750 magic damage in a 224 unit radius. Half a second later the impact zone burns for 5 seconds, dealing 100 magic damage every 0.25 seconds.";
DND_SPLPER221   = "-1 second cooldown.";
DND_SPLR5_221   = "Enemies in the burning zone lose 5 to all resistances every second, up to 25.";
DND_SPLR10_221  = "The burning zone lasts 4 seconds longer.";

// Arcane Barrage
DND_SPLDESC222  = "Channel for up to 5 seconds, storing three missiles every second. When you let go, the missiles fly upward unpredictably, about five every 0.3 seconds, then converge on where you point, each dealing 160 magic damage in an 80 unit radius. Costs mana every 0.5 seconds channelled.";
DND_SPLPER222   = "";
DND_SPLR5_222   = "Missiles cannot be deflected and ignore shields.";
DND_SPLR10_222  = "Missiles pierce 25% of the enemy's magic resistance.";

// Shadow Twin
DND_SPLDESC223  = "Summon a shadow twin of yourself sharing your life, resistances and the weapon you held when you cast it, which it fires every few seconds. It deals 50% less damage and loses 5% of its life every second, fading when its life runs out.";
DND_SPLPER223   = "-3 seconds cooldown.";
DND_SPLR5_223   = "Loses 3% of its life every second instead.";
DND_SPLR10_223  = "Deals only 35% less damage, and has a 20% chance to cast a spell from your hotbar instead of attacking.";

// Temporal Rift
DND_SPLDESC224  = "Reserve mana for a buff that remembers your life, mana, energy shield and position over the last 4 seconds. Cast again to travel back through time to that spot with those values. Spell haste never shortens its cast.";
DND_SPLPER224   = "-2 seconds cooldown.";
DND_SPLR5_224   = "Also puts your buffs and curses back as they were: gained since gone, lost since back, each with the time it had then.";
DND_SPLR10_224  = "Also puts the cooldowns of your other spells back as they were, ready or not.";

// Energized Armor
DND_SPLDESC225  = "Imbue your armor or a target ally's for 10 seconds: it counts as fully negating magic damage and has 15% more armor rating. When it ends, it explodes in a 192 unit radius for 100 magic damage plus 2.5 times the target's armor.";
DND_SPLPER225   = "+0.5% more armor rating.";
DND_SPLR5_225   = "Lasts 5 seconds longer.";
DND_SPLR10_225  = "Grants maximum energy shield equal to 20% of the armor rating while it lasts.";

// Ethereal Body
DND_SPLDESC226  = "Turn into a ghost for 20 seconds, letting most non-magical projectiles pass through you.";
DND_SPLPER226   = "+1.5 seconds duration.";
DND_SPLR5_226   = "100% increased mana regeneration while active.";
DND_SPLR10_226  = "20% more movement speed while in this form.";

// Salvation
DND_SPLDESC227  = "Echo a holy prayer for 10 seconds that redeems enemy corpses within 512 units: each has a 25% chance a second to be redeemed and vanish, and you recover 5% of your life and energy shield over 4 seconds for each. 10 corpses at most.";
DND_SPLPER227   = "+1.5% redeem chance, +0.25 seconds duration.";
DND_SPLR5_227   = "+5 corpses at most.";
DND_SPLR10_227  = "Allies within 192 units recover the same life and energy shield.";

// Summon: Angel
DND_SPLDESC228  = "Summon an angel from the heavens with 875 health. It casts Blessing on injured allies, can cast Death Seeker and Purge, and its melee deals 100 magic damage that splashes within 96 units. It stays until slain, but each time you are hurt it loses 0.5% of its maximum health plus 10% of the damage you took. Takes three pet slots.";
DND_SPLPER228   = "+300 health, +50 melee damage.";
DND_SPLR5_228   = "The angel can fly.";
DND_SPLR10_228  = "The angel carries a random aura you have learned.";

// Holy Wrath
DND_SPLDESC229  = "Project an image of yourself to the target spot, dealing 250 magic damage plus 5% of your maximum life to enemies near it. The image then bursts into light, blinding nearby enemies for 5 seconds.";
DND_SPLPER229   = "+0.5% of maximum life as damage.";
DND_SPLR5_229   = "The burst stuns instead of blinding.";
DND_SPLR10_229  = "The image glides slowly to the spot, dealing its damage once to each enemy it passes through, on top of the burst at the end.";

// Empowering Faith
DND_SPLDESC230  = "Aura. You and allies within 160 units gain +40 energy shield and 25% faster energy shield recharge.";
DND_SPLPER230   = "+24 energy shield, +1% faster recharge.";
DND_SPLR5_230   = "+96 radius.";
DND_SPLR10_230  = "Also grants 8% more energy shield.";

// Iron Maiden
DND_SPLDESC231  = "Aura. Any enemy that damages you or allies within 256 units takes 50 magic damage back.";
DND_SPLPER231   = "";
DND_SPLR5_231   = "Returned damage adds 0.5% of the attacker's maximum health.";
DND_SPLR10_231  = "Returned damage has a 15% chance to stun for 1.5 seconds, at most once every 4 seconds.";

// Conviction
DND_SPLDESC232  = "Aura. Every 4 seconds, enemies within 192 units are marked, exposed to energy and magic damage. A hit of energy or magic damage from you or an ally consumes the mark, deals 20% more damage and sets off a magical explosion of 250 damage within 96 units.";
DND_SPLPER232   = "+16 radius.";
DND_SPLR5_232   = "The consuming hit deals 33% more damage.";
DND_SPLR10_232  = "The mark also gives -15 to the resistance of the consuming hit's damage type for 5 seconds.";

// Ascension
DND_SPLDESC233  = "Ascend to a form of pure magic for 10 seconds. All damage you take is converted to magic damage, and your spells are 25% more potent and cost 25% less mana.";
DND_SPLPER233   = "+2 seconds duration, -5 mana cost.";
DND_SPLR5_233   = "Also grants 25% more spell haste for other spells.";
DND_SPLR10_233  = "Each kill while ascended recovers 0.5% to 1.5% of Ascension's cooldown.";

// Summon: Avenger
DND_SPLDESC234  = "Summon a holy spirit for 60 seconds with 1000 health and 1500 fortification, which fully recovers 15 seconds after it breaks. It melees for 300 damage and throws a ripping spear that deals 200 damage. If a monster drops you below 50% health, the Avenger enrages: 50% haste, hunting that monster alone until it dies. Enrage has a 40 second cooldown. Takes three pet slots.";
DND_SPLPER234   = "+250 health, +300 fortification, +150 melee damage, +100 spear damage.";
DND_SPLR5_234   = "Slaying the monster it enraged at heals you for 15% of your missing health.";
DND_SPLR10_234  = "Each time its fortification breaks, it deals 400 magic damage within 160 units, and you recover 2% of your energy shield over 4 seconds for each enemy hit.";

// Defiance
DND_SPLDESC235  = "Store the damage your spells deal, up to 2500. Channel for 2.5 seconds to release it around you as a nova of holy light and darkness: five holy and five dark projectiles that travel for 3 seconds, each carrying 30% of the stored damage. Holy projectiles also heal allies as Holy Light would, at 30% of the effect. Dark projectiles can hurt any organic enemy.";
DND_SPLPER235   = "+1000 damage stored.";
DND_SPLR5_235   = "The channel takes only 1 second.";
DND_SPLR10_235  = "The projectiles rip through enemies.";

// Divine Shield
DND_SPLDESC236  = "Raise a bubble of holy light with a 192 unit radius around you that absorbs enemy projectiles with its own barrier of 1500 health, taking 20% more damage from magic. It lasts up to 10 seconds. You and allies can shoot out through it.";
DND_SPLPER236   = "+250 bubble health, +1 second duration, +8 radius.";
DND_SPLR5_236   = "+128 radius.";
DND_SPLR10_236  = "Consecrates the ground inside: you and allies in it regenerate 2% of life a second, and curses expire 60% faster.";

// Righteous Cause
DND_SPLDESC237  = "Inspire allies within 256 units, increasing their STR, DEX and INT by 33% for 18 seconds. Cannot affect you.";
DND_SPLPER237   = "+16 radius.";
DND_SPLR5_237   = "The stat increase becomes 60%.";
DND_SPLR10_237  = "Lasts 30 seconds.";

// Haste
DND_SPLDESC238  = "Aura. You and allies within 192 units gain 20% more movement speed and spell haste.";
DND_SPLPER238   = "+16 radius.";
DND_SPLR5_238   = "Enemies in the radius are slowed by the same amount.";
DND_SPLR10_238  = "Radius is doubled.";

// Retribution
DND_SPLDESC239  = "Gain a stack every 15 seconds, up to 10, recovering faster with cooldown recovery rate. Cast to spend every stack on a holy hammer dealing 200 magic damage that rips through enemies. Hammers last 10 seconds, orbiting you while swinging outward and back.";
DND_SPLPER239   = "";
DND_SPLR5_239   = "Holds up to 20 stacks.";
DND_SPLR10_239  = "Hammers returning to you recover a third of a stack's time instead.";


// Field names for the synergy lines the panel builds from SpellSynergies. Positional on SPELLVAL_*.
DND_SPLFIELD0   = "damage";
DND_SPLFIELD1   = "secondary damage";
DND_SPLFIELD2   = "mana cost";
DND_SPLFIELD3   = "cooldown";
DND_SPLFIELD4   = "cast time";
DND_SPLFIELD5   = "duration";
DND_SPLFIELD6   = "radius";
DND_SPLFIELD7   = "amount";
DND_SPLFIELD8   = "cooldown recovery rate";
DND_SPLFIELD9   = "minimum damage";
DND_SPLFIELD10  = "minimum secondary damage";
DND_SPLFIELD11  = "secondary amount";
DND_SPLFIELD_VOLLEYRATE = "increased volley rate";
DND_SPLFIELD_COMETS = "comet per volley";
DND_SPLFIELD_POISONTIME = "seconds of poison";
DND_SPLFIELD_POISONPS = "poison per second";
DND_SPLFIELD_POISON = "poison damage";
DND_SPLFIELD_THROW = "throw damage";
DND_SPLFIELD_ENERGIZED = "energized rock damage";
DND_SPLFIELD_HEAL = "ally heal";
DND_SPLFIELD_WALLHP = "wall health";
DND_SPLFIELD_WALLLEN = "wall length";
DND_SPLFIELD_CRASH = "crash landing cap";
DND_SPLFIELD_MINIONHP = "minion health";
DND_SPLFIELD_CROWS = "crow";
DND_SPLFIELD_PERSOUL = "damage per soul";
DND_SPLFIELD_SIDES = "side flame damage";
