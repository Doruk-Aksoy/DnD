// Hover text, straight from the design docs. Positional like the names above.
//
// DND_SPLDESC<id>   what the spell does at rank 1
// DND_SPLPER<id>    what each further rank adds
// DND_SPLR5_<id>    the rank 5 bonus   -- underscored, or DND_SPLR5_10 and DND_SPLR51_0 collide
// DND_SPLR10_<id>   the rank 10 bonus
//
// Damage, cost, cooldown, cast time, requirements and synergies are deliberately NOT here. The
// panel reads those live from SpellDefs and SpellSynergies, so they cannot drift from what the
// spell does.
//
// Damage and cost joined that list when ranks started compounding -- "+60 damage per rank" was
// true while the step was linear and became a lie the moment it was not. A DND_SPLPER lump is
// now only for what the live lines CANNOT express: radius, durations, extra projectiles and the
// like. Several are deliberately empty, and the panel skips the heading when they are.

// ================= FIRE =================

// Blaze
DND_SPLDESC0    = "Set the target on fire, dealing 8 fire damage every 0.25 seconds for 3 seconds.";
DND_SPLPER0     = "8% faster cooldown recovery rate.";
DND_SPLR5_0     = "Burns for 1 second longer.";
DND_SPLR10_0    = "Also ignites enemies within 96 units of the target.";

// Fireball
DND_SPLDESC1    = "Throw a ball of fire that deals 100 damage on impact.";
DND_SPLPER1     = "";
DND_SPLR5_1     = "Casts an additional fireball to the side.";
DND_SPLR10_1    = "Casts another additional fireball to the side.";

// Infernal Strike
DND_SPLDESC2    = "Your next melee attack deals 50 additional fire damage, with a 25% chance to strike a 128 unit area.";
DND_SPLPER2     = "";
DND_SPLR5_2     = "+25% chance to strike the area.";
DND_SPLR10_2    = "The strike is always a critical hit.";

// Warmth
DND_SPLDESC3    = "Increase your mana regeneration by 50% for 8 seconds.";
DND_SPLPER3     = "10% additional mana regeneration, +0.25 flat mana regeneration.";
DND_SPLR5_3     = "Duration becomes 12 seconds.";
DND_SPLR10_3    = "Also affects allies within 192 units.";

// Heat Shield
DND_SPLDESC4    = "Cover your armor or a targeted ally's in fire. Enemies that hit it are ignited, and it grants 100 armor rating for 5 seconds.";
DND_SPLPER4     = "+1 second duration, +25 armor rating.";
DND_SPLR5_4     = "Ignites from this last 100% longer.";
DND_SPLR10_4    = "Ignites from this are guaranteed to spread.";

// Incinerate
DND_SPLDESC5    = "Passive. Your fire damage has a 30% chance to make enemies explode on death for 5% of their maximum health within 128 units.";
DND_SPLPER5     = "+0.25% explosion damage.";
DND_SPLR5_5     = "Radius increases to 192 units.";
DND_SPLR10_5    = "The explosion no longer harms you.";

// Boiling Blood
DND_SPLDESC6    = "Grants 25% increased movement speed and 15% cooldown recovery rate for 10 seconds, at the cost of 5 health per second.";
DND_SPLPER6     = "+1% movement speed, +1 health lost per second.";
DND_SPLR5_6     = "+2 seconds duration.";
DND_SPLR10_6    = "+15% cooldown recovery rate.";

// Anger
DND_SPLDESC7    = "Aura. You and nearby allies within 256 units deal 15% more fire damage and gain 10% base ignite chance.";
DND_SPLPER7     = "+1% more fire damage, +8 unit radius.";
DND_SPLR5_7     = "+5% ignite chance.";
DND_SPLR10_7    = "Ignites on you and affected allies last 50% less.";

// Pyroblast
DND_SPLDESC8    = "Hurl a ball of flame that explodes for 360 damage in a 128 unit radius.";
DND_SPLPER8     = "";
DND_SPLR5_8     = "No longer damages you.";
DND_SPLR10_8    = "The explosion erupts into smaller fireballs dealing an eighth of its damage.";

// Searing Bond
DND_SPLDESC9    = "Lash out a flame that deals 75 damage and snares an enemy for 2.5 seconds.";
DND_SPLPER9     = "+0.25 seconds snare.";
DND_SPLR5_9     = "+2 seconds snare duration.";
DND_SPLR10_9    = "Also binds enemies within 160 units of the target.";

// Scorching Ray
DND_SPLDESC10   = "Project a beam of fire dealing 80 damage every 0.2 seconds. After 2.5 seconds of channeling it applies Fire Exposure on hit, giving -25 to fire resistance for 5 seconds.";
DND_SPLPER10    = "+8 beam length.";
DND_SPLR5_10    = "+25% beam width.";
DND_SPLR10_10   = "The beam passes through all enemies.";

// Flammability
DND_SPLDESC11   = "Curse. Enemies in a 256 unit area take -30 to fire resistance for 8 seconds and gain 25% base chance to be ignited.";
DND_SPLPER11    = "-1 further to fire resistance.";
DND_SPLR5_11    = "25% increased area of effect.";
DND_SPLR10_11   = "+4 seconds duration.";

// Immolation
DND_SPLDESC12   = "Surround yourself with fire, dealing 72 damage every second to everything within 96 units. Costs mana for as long as it runs.";
DND_SPLPER12    = "+12 unit radius.";
DND_SPLR5_12    = "Mana cost reduced by 4.";
DND_SPLR10_12   = "The damage also applies Blaze.";

// Rain of Fire
DND_SPLDESC13   = "Mark a location to rain comets over a 320 unit area for 4.5 seconds, each dealing 40 damage in a 72 unit radius.";
DND_SPLPER13    = "+8 comet damage area.";
DND_SPLR5_13    = "Comets fall 20% faster, and rains 15% more comets.";
DND_SPLR10_13   = "Holds two charges, each on its own cooldown.";

// Flame Pillar
DND_SPLDESC14   = "Create a pillar of flame that advances 30 units per tic for 2 seconds, leaving in its wake flames dealing 24 damage to everything within 96 units every 2 tics for 44 tics.";
DND_SPLPER14    = "";
DND_SPLR5_14    = "Ignores shields.";
DND_SPLR10_14   = "Creates two pillars side by side.";

// Fire Jet
DND_SPLDESC15   = "Shoot a jet of fire that spreads sideways, dealing 180 damage on a direct hit and 36 to the sides.";
DND_SPLPER15    = "";
DND_SPLR5_15    = "A direct hit explodes for half its damage within 128 units.";
DND_SPLR10_15   = "The sideways flames rip through enemies.";

// Summon: Fire Demon
DND_SPLDESC16   = "Summon a fire demon with 500 health to fight for you. It throws fireballs and sets the ground alight. Can have up to 1 Fire Demon active at a time.";
DND_SPLPER16    = "+15% demon health, +10% demon damage.";
DND_SPLR5_16    = "Gains 25% to all resistances.";
DND_SPLR10_16   = "The demon casts Fire Jet at your rank.";

// Molten Boulder
DND_SPLDESC17   = "Call down a meteor that burns everything it passes for 24 damage and explodes on impact for 256. It shatters on a wall or after 6 seconds.";
DND_SPLPER17    = "";
DND_SPLR5_17    = "Lasts 3 seconds longer.";
DND_SPLR10_17   = "Sends six Pyroblasts outward when it shatters.";

// Righteous Fire
DND_SPLDESC18   = "Engulf yourself in flame, burning yourself and enemies within 160 units each second for 50% of your maximum health and energy shield as fire damage. Grants 20% more spell damage to other spells while it burns.";
DND_SPLPER18    = "+2% health as damage, +16 unit radius.";
DND_SPLR5_18    = "You gain 25% additional fire resistance against this spell.";
DND_SPLR10_18   = "You cannot be chilled, frozen or ignited while burning.";

// Annihilus
DND_SPLDESC19   = "Channel to build an explosion at a location up to 512 units away, for up to 2.5 seconds. Every 0.5 seconds adds a charge, starting at 250 damage and growing 30% each time, while the blast widens from 96 units to 512. Cast again to release it early for less damage. You are slowed by 50% while channeling.";
DND_SPLPER19    = "";
DND_SPLR5_19    = "No longer harms you, and maximum range becomes 768 units.";
DND_SPLR10_19   = "Has a 20% chance to trigger explosions at each charge.";

// Volcano
DND_SPLDESC20   = "Conjure a volcano at a location that hurls lava for 10 seconds, each piece dealing 60 damage in an 80 unit area.";
DND_SPLPER20    = "+0.5 seconds duration.";
DND_SPLR5_20    = "Bursting lava deals 30% increased damage.";
DND_SPLR10_20   = "Produces 25% more lava.";

// Heart of Fire
DND_SPLDESC21   = "Passive. Finishing a fire spell's cast gives every OTHER fire spell on your hotbar that is on cooldown a 25% chance to lose 10% of its maximum cooldown.";
DND_SPLPER21    = "+0.75% cooldown removed, +5% chance.";
DND_SPLR5_21    = "A fire spell made ready by this deals 20% more damage if cast within 4 seconds.";
DND_SPLR10_21   = "The chance becomes 100%.";

// ================= COLD =================

// Ice Bolt
DND_SPLDESC40   = "Send a bolt of ice forward that deals 80 damage and slows an enemy by 30% on impact.";
DND_SPLPER40    = "";
DND_SPLR5_40    = "Slow becomes 75%.";
DND_SPLR10_40   = "Also strikes a 96 unit area around the impact.";

// Freezing Pulse
DND_SPLDESC41   = "Cast a wave of cold along the floor that deals 50 damage and rips through enemies once. Has a 20% base chance to freeze, falling to 0% as it travels.";
DND_SPLPER41    = "";
DND_SPLR5_41    = "Travels 25% further.";
DND_SPLR10_41   = "25% wider.";

// Glacial Spike
DND_SPLDESC42   = "Send a spike of ice dealing 180 damage that rips through up to 10 enemies and shatters on impact, freezing nearby enemies for 1 second.";
DND_SPLPER42    = "";
DND_SPLR5_42    = "Freeze lasts 2 seconds.";
DND_SPLR10_42   = "Rips through enemies with Hardened Skin.";

// Chilling Breath
DND_SPLDESC43   = "Breathe a cone of cold winds in front of you, each dealing 25 damage. Channeled.";
DND_SPLPER43    = "";
DND_SPLR5_43    = "Slows enemies by 50%.";
DND_SPLR10_43   = "The cone becomes 30% wider.";

// Creeping Frost
DND_SPLDESC44   = "Fire an icy projectile that bursts on impact for 30 damage and creeps along the floor toward nearby targets for 5 seconds, dealing 200 damage per second. Cannot stagger enemies.";
DND_SPLPER44    = "";
DND_SPLR5_44    = "Lasts 4 seconds longer.";
DND_SPLR10_44   = "Can crawl 64 units higher.";

// Ice Shield
DND_SPLDESC45   = "Create 8 rotating ice barriers around you that block enemy attacks. Each has 200 health and lasts 5 seconds.";
DND_SPLPER45    = "+25 barrier health, +0.5 seconds duration.";
DND_SPLR5_45    = "+2.5 seconds duration.";
DND_SPLR10_45   = "Blocks ripper attacks.";

// Frost Shards
DND_SPLDESC46   = "Create 5 frost shards in front of you every 0.5 seconds over 2 seconds, each dealing 60 damage.";
DND_SPLPER46    = "";
DND_SPLR5_46    = "2 more shards every 0.5 seconds.";
DND_SPLR10_46   = "Shards rip through enemies.";

// Gust of Frost
DND_SPLDESC47   = "Unleash a chilling wind that pushes enemies away and slows them by 30%. Enemies slammed into walls or each other take up to 620 physical damage, more the heavier they are.";
DND_SPLPER47    = "10% faster cooldown recovery rate and push strength, +5% slam damage.";
DND_SPLR5_47    = "Slow becomes 60%.";
DND_SPLR10_47   = "Slammed enemies also take 10% of their maximum health as added base physical damage. This bonus is capped at the slam's base damage with at most double.";

// Frost Bomb
DND_SPLDESC48   = "Place a pulsing ice crystal that deals 60 damage in a 128 unit radius every 0.5 seconds for 5 seconds, and stops enemies regenerating life for 5 seconds.";
DND_SPLPER48    = "";
DND_SPLR5_48    = "Pulses apply Cold Exposure, reducing cold resistance by 15%.";
DND_SPLR10_48   = "Radius increases to 256 units.";

// Ice Nova
DND_SPLDESC49   = "Conjure a nova of ice dealing 250 damage that expands outward from you in a ring up to 320 units. Enemies can only be hurt once per cast.";
DND_SPLPER49    = "+18 unit radius.";
DND_SPLR5_49    = "The ring expands 20% faster.";
DND_SPLR10_49   = "Enemies hit near the outer edge deal 15% less damage for 3 seconds.";

// Summon: Ice Golem
DND_SPLDESC50   = "Summon a golem of ice with 500 health to fight for you. It has a melee attack dealing 50 damage and a dash attack dealing 150 damage. Can have up to 1 Ice Golem active at a time.";
DND_SPLPER50    = "+50 golem health, +5 golem damage.";
DND_SPLR5_50    = "Grants you 50% increased mana regeneration.";
DND_SPLR10_50   = "The golem casts Ice Bolt at your rank.";

// Hatred
DND_SPLDESC51   = "Aura. You and nearby allies within 256 units deal 15% more cold damage.";
DND_SPLPER51    = "+1.5% more cold damage.";
DND_SPLR5_51    = "Radius is doubled.";
DND_SPLR10_51   = "Grants 5% additional critical strike chance to cold spells and attacks.";

// Frostbite
DND_SPLDESC52   = "Curse. Enemies in a 256 unit area take -30 to cold resistance for 8 seconds and gain 25% base chance to be chilled.";
DND_SPLPER52    = "-1 further to cold resistance.";
DND_SPLR5_52    = "25% increased area of effect.";
DND_SPLR10_52   = "+4 seconds duration.";

// Blizzard
DND_SPLDESC53   = "Call a storm over a 256 unit area for 5 seconds, dropping a volley of 16 icicles every 0.66 seconds. Each deals 90 damage in a 48 unit radius.";
DND_SPLPER53    = "";
DND_SPLR5_53    = "+128 unit radius, and each icicle's blast grows with it to 72 units.";
DND_SPLR10_53   = "Volleys fall 30% more often, each with 30% more ice.";

// Winter Orb
DND_SPLDESC54   = "Release a slow orb ripping once dealing 100 damage that slows enemies by 30% for 0.75 seconds, throwing Ice Bolts in a spiral as it travels. The bolts scale with your Ice Bolt rank.";
DND_SPLPER54    = "+10% more damage on the bolts and shards it throws.";
DND_SPLR5_54    = "The orb freezes enemies it passes through for 0.75 seconds instead.";
DND_SPLR10_54   = "The orb also throws Frost Shards.";

// Ice Spear
DND_SPLDESC55   = "Hurl a spear of ice a short distance for 50 damage, then evolves it into a faster, stronger form dealing 250 damage that rips through 10 enemies with 10% added critical strike chance and 50% added critical multiplier.";
DND_SPLPER55    = "";
DND_SPLR5_55    = "+2% added critical strike chance.";
DND_SPLR10_55   = "+50% added critical strike multiplier.";

// Glacial Cascade
DND_SPLDESC56   = "An advancing wave of ice crashes forward in four bursts of 200 damage, each 20% stronger and 10% wider than the last. The final burst deals 100% more damage. Knocks enemies back once.";
DND_SPLPER56    = "";
DND_SPLR5_56    = "25% increased range, and one more burst.";
DND_SPLR10_56   = "Each burst is 25% wider than the last, instead of 10%.";

// Shivering Armor
DND_SPLDESC57   = "Enchant your armor, or a targeted ally's, to reduce damage taken by 15% for 5 seconds. Enemies that hit it have a 20% chance to be frozen for 1 second.";
DND_SPLPER57    = "+1.5% damage reduction.";
DND_SPLR5_57    = "Targeting an ally also grants the effect to you. Targeting nobody grants it to the nearest ally.";
DND_SPLR10_57   = "The armor stops ripping attacks.";

// Avalanche
DND_SPLDESC58   = "After a brief delay, rain 180 pieces of ice over 2.25 seconds behind you towards the direction you face, each dealing 50 damage. Enemies on the ground it covers are slowed by 50%.";
DND_SPLPER58    = "+9 additional ice thrown.";
DND_SPLR5_58    = "Thrown ice has a 15% chance to freeze enemies for 1 second.";
DND_SPLR10_58   = "Ice gains a 25% chance to rip through enemies.";

// ================= LIGHTNING =================

// Charged Bolt
DND_SPLDESC80   = "Launch a bolt that wanders towards where you face, bouncing off surfaces for 3 seconds and dealing 10-120 damage.";
DND_SPLPER80    = "+1 bolt at every even rank.";
DND_SPLR5_80    = "Bolts last 5 seconds.";
DND_SPLR10_80   = "Bolts also bounce off enemies.";

// Spark
DND_SPLDESC81   = "Zap an area up to 128 units in front of you, dealing 1-30 damage in a 96 unit radius every 0.15 seconds for 1.5 seconds.";
DND_SPLPER81    = "";
DND_SPLR5_81    = "The area grows to a 160 unit radius.";
DND_SPLR10_81   = "Zaps for 3 seconds.";

// Lightning Spear
DND_SPLDESC82   = "Throw a spear of lightning dealing 25-300 damage that bounces 6 times, each bounce dealing 5-60 damage in a 72 unit radius. When it meets an enemy it tries to pass through, up to 3 times.";
DND_SPLPER82    = "+1 bounce at every even rank.";
DND_SPLR5_82    = "+2 pass attempts.";
DND_SPLR10_82   = "Pass attempts also deal the bounce damage.";

// Shock
DND_SPLDESC83   = "Electrocute a target enemy, making it take 25% more lightning damage for 5 seconds.";
DND_SPLPER83    = "+2.5% damage taken.";
DND_SPLR5_83    = "Lasts 8 seconds.";
DND_SPLR10_83   = "Applies to all elemental damage, not only lightning.";

// Telekinesis
DND_SPLDESC84   = "Push a target enemy within 640 units away from you with magnetic force.";
DND_SPLPER84    = "10% further push, -0.5 seconds cooldown.";
DND_SPLR5_84    = "The pushed enemy is stunned for 1 second.";
DND_SPLR10_84   = "The pushed enemy takes 10% of its maximum health as lightning damage, capped at 870 base damage.";

// Static Field
DND_SPLDESC85   = "Aura. Zaps a random enemy within 128 units for 75 damage every 5 seconds.";
DND_SPLPER85    = "+16 radius.";
DND_SPLR5_85    = "Zaps every 2.5 seconds.";
DND_SPLR10_85   = "Zaps apply Shock.";

// Forked Lightning
DND_SPLDESC86   = "Strike the enemy you face with lightning for 15-325 damage, forking to up to 5 enemies behind it.";
DND_SPLPER86    = "+1 fork at every even rank.";
DND_SPLR5_86    = "-3 seconds cooldown.";
DND_SPLR10_86   = "+5 forks.";

// Crackling Lance
DND_SPLDESC87   = "Release a beam of lightning 512 units long and 192 wide, dealing 60-240 damage, with smaller beams branching along it. Casting again builds intensity, up to 3 stacks: each grants 10% more length and 35% more damage, and cuts the branching by 33%. Loses 1 intensity every 0.5 seconds while moving, or 1 at once if you teleport; pausing the cast does not lose any.";
DND_SPLPER87    = "";
DND_SPLR5_87    = "The beam is 20% wider.";
DND_SPLR10_87   = "+1 maximum intensity.";

// Blink
DND_SPLDESC88   = "Dash 128 units forward in an instant, through enemies.";
DND_SPLPER88    = "+16 distance, -0.5 seconds cooldown.";
DND_SPLR5_88    = "Enemies you dash through are Shocked.";
DND_SPLR10_88   = "While Overcharge charges or holds its charge, the dash adds charge as if you had run its distance.";

// Overcharge
DND_SPLDESC89   = "Charge up for 3 seconds, building charge the faster you move. Your next weapon attack unleashes it for 15 damage per charge, up to 100 charges. Standing still for over a second slowly bleeds the charge away.";
DND_SPLPER89    = "";
DND_SPLR5_89    = "25% faster charge generation.";
DND_SPLR10_89   = "Charges for 2 more seconds.";

// Energy Blade
DND_SPLDESC90   = "You have 50% less maximum energy shield, and your melee weapons deal added lightning damage from 2% to 25% of what remains.";
DND_SPLPER90    = "+1% of energy shield on the maximum.";
DND_SPLR5_90    = "The minimum becomes 5%.";
DND_SPLR10_90   = "Only 40% less energy shield.";

// Conductivity
DND_SPLDESC91   = "Curse. Enemies in a 256 unit area take -30 to lightning resistance for 8 seconds and gain 25% base chance to be overloaded.";
DND_SPLPER91    = "-1 further to lightning resistance.";
DND_SPLR5_91    = "25% increased area of effect.";
DND_SPLR10_91   = "+4 seconds duration.";

// Chain Lightning
DND_SPLDESC92   = "Unleash a bolt that chains 5 times to the nearest enemy within 384 units, dealing 20-400 damage to the first and 5% less per chain, to at most 75% less. An enemy can be chained to again only after two other chains. Every chain also forks to one more nearby enemy at that chain's damage but it does not chain further.";
DND_SPLPER92    = "+1 chain at every even rank.";
DND_SPLR5_92    = "Only 4% less damage per chain.";
DND_SPLR10_92   = "30% chance to apply Shock on each hit.";

// Storm Brand
DND_SPLDESC93   = "Place a brand that attaches to an enemy within 96 units, waiting for one if none is near and moving on when its host dies. Attached, it beams its host and up to 3 more enemies within 128 units every 0.5 seconds for 9-90 damage, for 6 seconds. Beams deal 80% more damage to the branded enemy. Spell haste also speeds up the beams.";
DND_SPLPER93    = "";
DND_SPLR5_93    = "Beams one more enemy.";
DND_SPLR10_93   = "An enemy can carry 2 brands.";

// Wrath
DND_SPLDESC94   = "Aura. You and nearby allies within 256 units deal 15% more lightning damage and gain 10% base chance to overload.";
DND_SPLPER94    = "+1% more lightning damage, +8 radius.";
DND_SPLR5_94    = "+5% overload chance.";
DND_SPLR10_94   = "Overload on you and affected allies lasts 50% less.";

// Galvanic Surge
DND_SPLDESC95   = "Grant yourself a jolt of energy, instantly recovering the cooldown of the most recently used spell.";
DND_SPLPER95    = "-1 mana cost.";
DND_SPLR5_95    = "Usable under any ailment, removing them all.";
DND_SPLR10_95   = "Grants 25% spell haste for 5 seconds.";

// Monsoon
DND_SPLDESC96   = "Call a storm that follows a target enemy: after a second, clouds gather in a 320 unit radius around it for 10 seconds, striking enemies every 0.25 to 0.75 seconds for 225 damage in an 80 unit radius. An enemy is struck at most once a second.";
DND_SPLPER96    = "";
DND_SPLR5_96    = "Lasts 5 seconds longer.";
DND_SPLR10_96   = "Strikes have a 10% chance to apply Shock.";

// Thunder Clap
DND_SPLDESC97   = "Slam the ground for a shockwave ring of 192 units that expands 3 times, each 30% wider and dealing 30% more damage. Deals 180 damage, plus 40% of your equipped melee weapon's damage as lightning when you hold one.";
DND_SPLPER97    = "";
DND_SPLR5_97    = "Stuns enemies hit for 1.5 seconds.";
DND_SPLR10_97   = "One more expansion.";

// Storm Call
DND_SPLDESC98   = "Mark a 192 unit area for lightning to strike after 1.6 seconds for 80-720 damage. A strike sets off every other pending Storm Call in turn.";
DND_SPLPER98    = "";
DND_SPLR5_98    = "The radius becomes 320.";
DND_SPLR10_98   = "25% chance to strike at once.";

// Surgecast
DND_SPLDESC99   = "Gain Surgecast for 5 seconds: your next spell with a cast time casts instantly, with a 20% chance to refund its mana.";
DND_SPLPER99    = "-1 mana cost.";
DND_SPLR5_99    = "40% chance to refund.";
DND_SPLR10_99   = "Holds two charges. Casting it while Surgecast is up refreshes the buff.";

// ================= EARTH =================

// Shrapnel
DND_SPLDESC120  = "Unearth a shard of rock and throws it, dealing 60 damage and ripping through up to 10 enemies.";
DND_SPLPER120   = "+1 rip at every even rank.";
DND_SPLR5_120   = "Rips through enemies with Hardened Skin.";
DND_SPLR10_120  = "Throws three shards instead of one.";

// Noxious Blast
DND_SPLDESC121  = "Target a spot within 512 units. After 0.4 seconds it bursts in a 96 unit radius, poisoning enemies caught for 50 damage a second for 3 seconds.";
DND_SPLPER121   = "";
DND_SPLR5_121   = "The poison lasts 1 second longer.";
DND_SPLR10_121  = "The radius becomes 160.";

// Rockslide
DND_SPLDESC122  = "Raise a massive boulder and tosses it forward in an arc. Enemies within 96 units of where it lands take 250 damage, full within 48 units and less further out, and are stunned for 1.5 seconds.";
DND_SPLPER122   = "-0.5 seconds cooldown.";
DND_SPLR5_122   = "The boulder flies 50% faster.";
DND_SPLR10_122  = "The radius becomes 180 and the stun lasts 2.5 seconds.";

// Blockade
DND_SPLDESC123  = "Raise a slanted wall of rock up to 384 units in front of you that blocks enemies and their attacks. The wall is 96 units long, withstands 250 damage and stands for 10 seconds. A new wall replaces your old one.";
DND_SPLPER123   = "+16 wall length, +75 wall health, +1 second.";
DND_SPLR5_123   = "You, your allies and your pets can shoot through the wall.";
DND_SPLR10_123  = "When the wall breaks, it sends a volley of 8 Shrapnels lined up side by side.";

// Baleful Infusion
DND_SPLDESC124  = "Enchant your next melee attack within 10 seconds: 50% of its damage is converted to poison, and it always poisons.";
DND_SPLPER124   = "+5% damage converted.";
DND_SPLR5_124   = "The enchanted attack pierces 20 poison resistance.";
DND_SPLR10_124  = "Enemies killed within 2 seconds of the hit spread the same poison to enemies within 192 units.";

// Toxic Trap
DND_SPLDESC125  = "Lay a trap that bursts into toxic gas when a monster touches it. The gas deals 32 damage every 0.25 seconds in a 72 unit radius for 5 seconds, and poisons each enemy it reaches once. Traps last 30 seconds, and 2 can be out at once.";
DND_SPLPER125   = "";
DND_SPLR5_125   = "+2 traps out at once.";
DND_SPLR10_125  = "The gas lasts 1 second longer and traps last 15 seconds longer.";

// Venom Gyre
DND_SPLDESC126  = "Throw a bouncing toxic disc that rips through up to 5 enemies once each for 150 damage, with a 50% chance to poison for 300 damage over 3 seconds. After 5 seconds, or out of rips, it flies back to you, hitting each enemy once more on the way. Catch it for 10% more poison damage for 5 seconds; catch it during a dash to throw a fresh one at double damage that flies straight and never bounces.";
DND_SPLPER126   = "";
DND_SPLR5_126   = "Rips through up to 10 enemies.";
DND_SPLR10_126  = "Throws 2 more.";

// Rock Armor
DND_SPLDESC127  = "Cover yourself in rock that absorbs 80 damage for 8 seconds. It absorbs everything, but magic damage only at 50% effectiveness.";
DND_SPLPER127   = "+40 damage absorbed.";
DND_SPLR5_127   = "Lasts 2 seconds longer.";
DND_SPLR10_127  = "When the armor shatters, it throws 8 Shrapnels around you in a circle.";

// Upheaval
DND_SPLDESC128  = "Crack open rifts that branch and spread up to 480 units ahead of you, widening to 256 units. After 1.5 seconds they explode for 100 damage, throwing enemies into the air and stunning them for 2 seconds. Thrown enemies take 100 damage when they land, plus up to 500 more by their mass. The broken ground explodes again 2 seconds later for 300 damage.";
DND_SPLPER128   = "+16 reach and width.";
DND_SPLR5_128   = "An additional branch is created.";
DND_SPLR10_128  = "The second explosion repeats 2 more times, a second apart.";

// Threaded Volley
DND_SPLDESC129  = "Draw 5 rocks from the ground and hurl them where you face in a quickening volley, each dealing 80 damage on impact and 40 in an 80 unit radius. The ground within 256 units of you is energized for 15 seconds: casting inside it launches one rock instead, dealing 450 damage in a 160 unit radius and bursting into chunks that rip through up to 4 enemies for 16 damage. Casts inside an energized area have 75% cooldown recovery rate and cost 30% less.";
DND_SPLPER129   = "";
DND_SPLR5_129   = "Each energized area past the first that you cast inside grants this spell 20% more damage.";
DND_SPLR10_129  = "Energized areas cover 384 units.";

// Vines of Torment
DND_SPLDESC130  = "Whip a line of vines forward out of the ground, dealing 100 poison damage and snaring enemies caught for 3 seconds. Allies they touch are healed for 100 instead. The vines last 2.5 seconds.";
DND_SPLPER130   = "+0.5 seconds snare at every even rank, +25 ally heal.";
DND_SPLR5_130   = "Vines are 25% wider.";
DND_SPLR10_130  = "Vines travel 50% farther.";

// Corrosive Breath
DND_SPLDESC131  = "Build up a deadly stench and releases it over 1.5 seconds as toxic fumes in a 60 degree cone, poisoning for 600 damage over 5 seconds. For 3 seconds afflicted enemies are slowed by 25% and take 10% more poison damage, and fortified enemies lose up to 50% of their fortification.";
DND_SPLPER131   = "";
DND_SPLR5_131   = "Afflicted enemies take 25% more poison damage instead.";
DND_SPLR10_131  = "The cone widens to 90 degrees and releases 33% more fumes, which reach 33% farther.";

// Agony
DND_SPLDESC132  = "Aura. You and allies within 256 units deal 18% more damage over time.";
DND_SPLPER132   = "+1% more damage over time, +16 radius.";
DND_SPLR5_132   = "Enemies in the aura gain a base 10% chance to be poisoned and to bleed.";
DND_SPLR10_132  = "Poison on you and allies in the aura lasts 25% less.";

// Summon: Rock Golem
DND_SPLDESC133  = "Summon a very durable rock golem with 750 health that fights for you with 100 damage melee attacks. It also grants you 10% less physical damage taken.";
DND_SPLPER133   = "+250 health, +25 melee damage.";
DND_SPLR5_133   = "The golem can cast Rockslide.";
DND_SPLR10_133  = "The golem is immune to elemental damage and resists explosions.";

// Vulnerability
DND_SPLDESC134  = "Curse. Enemies in a 256 unit area take -30 to physical resistance for 8 seconds and gain 25% base chance to bleed.";
DND_SPLPER134   = "-1 further to physical resistance.";
DND_SPLR5_134   = "25% increased area of effect.";
DND_SPLR10_134  = "+4 seconds duration.";

// Crushing Rocks
DND_SPLDESC135  = "Raise two huge rocks beside a target enemy that try to crush it 5 times for 270 damage each.";
DND_SPLPER135   = "";
DND_SPLR5_135   = "Each crush hits everything in a 96 unit radius.";
DND_SPLR10_135  = "7 crushes.";

// Despair
DND_SPLDESC136  = "Curse. Enemies in a 256 unit area take -30 to poison resistance for 10 seconds and gain 25% base chance to be poisoned.";
DND_SPLPER136   = "-1 further to poison resistance.";
DND_SPLR5_136   = "25% increased area of effect.";
DND_SPLR10_136  = "Cursed enemies cannot regenerate health.";

// Poison Nova
DND_SPLDESC137  = "Release a nova of 6 poison projectiles that pass through enemies for 4 seconds, dealing 50 damage on contact and poisoning for 900 damage over 4 seconds.";
DND_SPLPER137   = "";
DND_SPLR5_137   = "+4 projectiles.";
DND_SPLR10_137  = "Projectiles last 50% longer.";

// Unleash Earth
DND_SPLDESC138  = "Raise a pillar of rock under where you aim, up to 640 units away, then channel: each attack raises another, at most one every 0.33 seconds and 5 pillars in all. Each erupts in a 96 unit radius for 800 damage and flings enemies up and aside; they crash down for up to 1200 damage by their mass and how high they flew. An enemy flung again takes 25% more. Bosses barely fly. Each pillar costs its mana. The channel ends after the fifth pillar, when you cast this again, after 5 seconds without a pillar, or when you cannot pay for one; the cooldown starts then.";
DND_SPLPER138   = "+400 pillar damage, +400 crash landing cap.";
DND_SPLR5_138   = "Cast a pillar under yourself to launch yourself without taking damage.";
DND_SPLR10_138  = "Flung enemies that hit walls or each other mid flight take 600 more damage.";

// Geyser
DND_SPLDESC139  = "Split the ground ahead of you into 10 geysers of acid that spit 8-12 drops a second for 5 seconds in random directions. Each drop deals 90 damage in a 48 unit radius and always poisons.";
DND_SPLPER139   = "+35 damage per drop.";
DND_SPLR5_139   = "Drops hit twice the radius.";
DND_SPLR10_139  = "50% more geysers.";

// Rejuvenation
DND_SPLDESC140  = "You or the ally you target recover 180 health over 4 seconds. Ends early if the target is injured. Does not stack: a new cast replaces the old one.";
DND_SPLPER140   = "+30 health recovered, +3 mana cost.";
DND_SPLR5_140   = "No longer ends when the target is injured.";
DND_SPLR10_140  = "Cleanses the target's ailments when cast.";


// Field names for the synergy lines the panel builds from SpellSynergies. Positional on SPELLVAL_*.
DND_SPLFIELD0   = "damage";
DND_SPLFIELD1   = "secondary damage";
DND_SPLFIELD2   = "mana cost";
DND_SPLFIELD3   = "cooldown";
DND_SPLFIELD4   = "cast time";
DND_SPLFIELD5   = "duration";
DND_SPLFIELD6   = "radius";
DND_SPLFIELD7   = "amount";
DND_SPLFIELD8   = "cooldown recovery rate";
DND_SPLFIELD9   = "minimum damage";
DND_SPLFIELD10  = "minimum secondary damage";
DND_SPLFIELD11  = "secondary amount";
DND_SPLFIELD_VOLLEYRATE = "increased volley rate";
DND_SPLFIELD_COMETS = "comet per volley";
DND_SPLFIELD_POISONTIME = "seconds of poison";
DND_SPLFIELD_POISONPS = "poison per second";
DND_SPLFIELD_POISON = "poison damage";
DND_SPLFIELD_THROW = "throw damage";
DND_SPLFIELD_ENERGIZED = "energized rock damage";
DND_SPLFIELD_HEAL = "ally heal";
DND_SPLFIELD_WALLHP = "wall health";
DND_SPLFIELD_WALLLEN = "wall length";
DND_SPLFIELD_CRASH = "crash landing cap";

DND_SPLPANEL_PERRANK   = "Per Rank:";
DND_SPLPANEL_RANK5     = "Rank 5:";
DND_SPLPANEL_RANK10    = "Rank 10:";
DND_SPLPANEL_COST      = "Cost:";
DND_SPLPANEL_RESERVE   = "Reserves:";
DND_SPLPANEL_COOLDOWN  = "Cooldown:";
DND_SPLPANEL_CASTTIME  = "Cast Time:";
DND_SPLPANEL_REQUIRES  = "Requires:";
DND_SPLPANEL_SYNERGY   = "Synergy";
DND_SPLPANEL_LEVEL     = "Level";
DND_SPLPANEL_NEXTRANK  = "Next rank:";
DND_SPLPANEL_INSTANT   = "Instant";
DND_SPLPANEL_STATE     = "State:";
DND_SPLPANEL_ON        = "ON";
DND_SPLPANEL_OFF       = "OFF";
DND_SPLPANEL_TOGGLEHINT = "Right click the icon to switch it.";
DND_SPLPANEL_NONE      = "None";

// Board headings, positional on DND_SKILLTREE_*.

DND_SPELLTREETITLE0  = "Fire Spells";
DND_SPELLTREETITLE1  = "Cold Spells";
DND_SPELLTREETITLE2  = "Lightning Spells";
DND_SPELLTREETITLE3  = "Earth Spells";
DND_SPELLTREETITLE4  = "Black Spells";
DND_SPELLTREETITLE5  = "Arcane Spells";
DND_SPELLTREETITLE6  = "Chaos Spells";
DND_SPELLTREETITLE7  = "Combat Spells";

DND_SPLPANEL_DETAILS = "DETAILS";

DND_SPELLTREE_HOTBAR   = "Hotbar Assignments";
DND_SPELLTREE_GEMS     = "Gem Sockets";
DND_SPLPANEL_PICKSLOT  = "Click a slot to assign a skill to it.";
DND_SPLPANEL_PICKSPELL = "Pick a skill, or click away to cancel.";
