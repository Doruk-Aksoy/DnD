Actor DnD_ChillGainCooldown : PowerProtection {
	damagefactor "normal", 1.0
	powerup.duration 7
}

// Display-only tokens for the SBARINFO buff icons. SBARINFO can only test inventory,
// so buff state is projected onto these. The BUFF remains the source of truth: unlike
// the ElementPower_* / RavagerPower actors they replace, these carry no powerup base
// and no damagefactor, so they cannot affect damage on their own.
// Driven by SyncBuffDisplayItems() in acs/DnD_Buffs.h -- do not give or take them by hand.
Actor DnD_BuffIcon_SigilFire : DnD_Boolean { }
Actor DnD_BuffIcon_SigilIce : DnD_Boolean { }
Actor DnD_BuffIcon_SigilLightning : DnD_Boolean { }
Actor DnD_BuffIcon_SigilPoison : DnD_Boolean { }
Actor DnD_BuffIcon_Ravager : DnD_Boolean { }

