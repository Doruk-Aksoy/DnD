enum {
    BTI_KILLSTORM,
    BTI_MINIGUN,
    BTI_MPPB,
    BTI_RIOTGUN,
    BTI_HAMMER,
    BTI_DEVASTATOR,

    // all buffs below this one
    BTI_PHASING,
    BTI_AMPHETAMINE,
    BTI_FRENZYCHARGE,
    BTI_ENDURANCECHARGE,
    BTI_POWERCHARGE,
    // flask sourced buffs
    BTI_ARMOR_FLASK,
    BTI_MOREARMOR_FLASK,
    BTI_ELEMENTALRES_FLASK,
    BTI_ENERGYRES_FLASK,
    BTI_PHYSRES_FLASK,
    BTI_MAGICRES_FLASK,
    BTI_CRITINCREASE_FLASK,
    BTI_SILVERIMBUE_FLASK,
    BTI_DMGINCREASE_FLASK,
    BTI_MOVESPEED_FLASK,
    BTI_MITIGATION_FLASK,

    // powerup-sourced "more" damage buffs -- MUST match acs/DnD_BuffTable.h exactly,
    // these indices are passed numerically from DECORATE
    BTI_DOOMGUY_ORB,
    BTI_TRIPLEDAMAGE,
    BTI_RAVAGER_POWER,
    BTI_RALLY,
    BTI_RALLY_SPEED,
    BTI_LEECHINGDAMAGE,
    BTI_PUNISHER_DAMAGE,
    BTI_MARINE_DAMAGEREDUCTION,

    // sigil element powers -- keep contiguous and in DND_DAMAGECATEGORY order
    // (that order is the conversion ladder, so poison precedes lightning)
    BTI_ELEMENTPOWER_ICE,
    BTI_ELEMENTPOWER_POISON,
    BTI_ELEMENTPOWER_LIGHTNING,
    BTI_ELEMENTPOWER_FIRE,

    // Spell sourced buffs. Above the debuff marker so Wanderer perk 1 does not cut their duration,
    // and appended rather than inserted -- DECORATE passes these indices numerically, so
    // DnD/Actors/BuffIndex.dec has to match this list entry for entry.
    BTI_SPELL_WARMTH,
    BTI_SPELL_WARMTH_FLAT,
    BTI_SPELL_HEATSHIELD,
    BTI_SPELL_BOILINGBLOOD,
    BTI_SPELL_BOILINGBLOOD_CDR,
    BTI_SPELL_ANGER,
    BTI_SPELL_ANGER_IGNITE,
    BTI_SPELL_RIGHTEOUSFIRE,
    BTI_SPELL_ANNIHILUS_SLOW,
    BTI_SPELL_ICEGOLEM_MANA,
    BTI_SPELL_HATRED,
    BTI_SPELL_HATRED_CRIT,
    BTI_SPELL_SHIVERINGARMOR,
    BTI_SPELL_SHIVERINGARMOR_ARMOR,
    BTI_SPELL_WRATH,
    BTI_SPELL_WRATH_OVERLOAD,
    BTI_SPELL_WRATH_GROUNDED,
    BTI_SPELL_GALVANICSURGE_HASTE,
    BTI_SPELL_AGONY,
    BTI_SPELL_AGONY_POISONLESS,
    BTI_SPELL_VENOMGYRE,
    BTI_SPELL_ROCKGOLEM_PHYSLESS,
    BTI_SPELL_ANGER_IGNITELESS,
    BTI_SPELL_BANISH_PHYS,
    BTI_SPELL_BANISH_ELE,
    BTI_SPELL_BANISH_ENERGY,
    BTI_SPELL_BANISH_MAGIC,
    BTI_SPELL_VAMPIRISM,
    BTI_SPELL_INVIGORATE_REGEN,
    BTI_SPELL_INVIGORATE_ARMOR,
    BTI_SPELL_INVIGORATE_MANA,
    BTI_SPELL_PURIFY_SPEED,
    BTI_SPELL_HOLYPRAYERS_FLAT,
    BTI_SPELL_HOLYPRAYERS_PCT,
    BTI_SPELL_EMPFAITH_FLAT,
    BTI_SPELL_EMPFAITH_RECHARGE,
    BTI_SPELL_EMPFAITH_MORE,
    BTI_SPELL_HASTE_SPEED,
    BTI_SPELL_HASTE_CAST,
    BTI_SPELL_PURITY_ICE,
    BTI_SPELL_PURITY_POISON,
    BTI_SPELL_PURITY_LIGHTNING,
    BTI_SPELL_PURITY_FIRE,
    BTI_SPELL_PURITY_IGNITE,
    BTI_SPELL_PURITY_OVERLOAD,
    BTI_SPELL_ARCANERY,
    BTI_SPELL_ARCANERY_CDR,
    BTI_SPELL_ARCANERY_HASTE,
    BTI_SPELL_MIGHT,
    BTI_SPELL_MIGHT_ANY,
    BTI_SPELL_BLESSEDAIM,
    BTI_SPELL_BLESSEDAIM_ACC,
    BTI_SPELL_BLESSEDAIM_CRIT,
    BTI_SPELL_ARCANERY_MAGIC,
    BTI_SPELL_PURITY_CHILL,
    BTI_SPELL_PURITY_PIERCE,
    BTI_SPELL_ENCHANT,
    BTI_SPELL_ENCHANT_CONVERT,
    BTI_SPELL_ENCHANT_PIERCE,
    BTI_SPELL_ETHEREAL_MANA,
    BTI_SPELL_ETHEREAL_SPEED,
    BTI_SPELL_ENERGARMOR_NEG,
    BTI_SPELL_ENERGARMOR,
    BTI_SPELL_ENERGARMOR_ES,
