// A burst of the rifts: grit thrown up and a dust column.
Actor Spell_Upheaval_Burst : DnD_SpecialFX {
	+NOINTERACTION
	+CLIENTSIDEONLY
	States {
		Spawn:
			TNT1 A 0
			TNT1 AAAA 0 A_SpawnItemEx("Spell_Shrapnel_Piece", 0, 0, 4, frandom(-3, 3), frandom(-3, 3), frandom(4, 9), frandom(0, 360), SXF_CLIENTSIDE)
			TNT1 AAA 0 A_SpawnItemEx("Spell_Rockslide_Dust", frandom(-12, 12), frandom(-12, 12), frandom(4, 24), frandom(-0.5, 0.5), frandom(-0.5, 0.5), frandom(0.5, 1.5), 0, SXF_CLIENTSIDE)
			TNT1 A 0 A_SpawnItemEx("StoneBitsSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
		Stop
	}
}

// A segment of a rift's crack, laid end to end by "DnD Upheaval Rift FX"; UPCRACK glows through UpheavalCrack.fp.
// The script picks its look by state (M middles, T ends converging at +x, B pointed both ways) and sets user_life,
// the tics it stands before fading; a new look keeps the fade where it was.
Actor Spell_Upheaval_Crack : DnD_SpecialFX {
	RenderStyle Translucent
	Alpha 0
	var int user_life;
	States {
		Spawn:
			UPCR A 0
		Grow:
			"####" "#" 1 A_FadeIn(0.25)
			"####" "#" 0 A_JumpIf(alpha >= 1.0, "Live")
		Loop
		Live:
			"####" "#" 3 A_SetUserVar("user_life", user_life - 3)
			"####" "#" 0 A_JumpIf(user_life <= 0, "Fade")
		Loop
		Fade:
			"####" "#" 1 A_FadeOut(0.04)
		Wait
		M1:
			UPCR A 0 A_JumpIf(alpha >= 1.0, "Live")
		Goto Grow
		M2:
			UPCR B 0 A_JumpIf(alpha >= 1.0, "Live")
		Goto Grow
		M3:
			UPCR C 0 A_JumpIf(alpha >= 1.0, "Live")
		Goto Grow
		M4:
			UPCR D 0 A_JumpIf(alpha >= 1.0, "Live")
		Goto Grow
		M5:
			UPCR E 0 A_JumpIf(alpha >= 1.0, "Live")
		Goto Grow
		M6:
			UPCR F 0 A_JumpIf(alpha >= 1.0, "Live")
		Goto Grow
		T1:
			UPCR G 0 A_JumpIf(alpha >= 1.0, "Live")
		Goto Grow
		T2:
			UPCR H 0 A_JumpIf(alpha >= 1.0, "Live")
		Goto Grow
		T3:
			UPCR I 0 A_JumpIf(alpha >= 1.0, "Live")
		Goto Grow
		T4:
			UPCR J 0 A_JumpIf(alpha >= 1.0, "Live")
		Goto Grow
		B1:
			UPCR K 0 A_JumpIf(alpha >= 1.0, "Live")
		Goto Grow
		B2:
			UPCR L 0 A_JumpIf(alpha >= 1.0, "Live")
		Goto Grow
	}
}
