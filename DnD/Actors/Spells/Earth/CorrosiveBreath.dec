// On an afflicted enemy: whole percent more poison damage taken, and its clock.
Actor DnD_Corroded : DnD_Info { }
Actor DnD_CorrodedTimer : DnD_Info { }

// Set while the fumes eat a fortified enemy's fortification, so a second breath does not start another eater.
Actor DnD_CorrosionDecay : DnD_Info { }

// A puff of the fumes, thrown along the cone by "DnD Corrosive Breath FX": DB58 A-Z once over user_t, its tics to the
// cone's end, each frame its share (0 skips one), swelling on A-U and fading out on V-Z so it ends where the cone does.
Actor Spell_CorrosiveBreath_Fume : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.5
	Scale 0.3
	var int user_t;
	States {
		Spawn:
			TNT1 A 0
			DB58 A 0 A_SetScale(0.300)
			DB58 A 1 A_SetTics(1 * user_t / 26 - 0 * user_t / 26)
			DB58 B 0 A_SetScale(0.327)
			DB58 B 1 A_SetTics(2 * user_t / 26 - 1 * user_t / 26)
			DB58 C 0 A_SetScale(0.354)
			DB58 C 1 A_SetTics(3 * user_t / 26 - 2 * user_t / 26)
			DB58 D 0 A_SetScale(0.381)
			DB58 D 1 A_SetTics(4 * user_t / 26 - 3 * user_t / 26)
			DB58 E 0 A_SetScale(0.408)
			DB58 E 1 A_SetTics(5 * user_t / 26 - 4 * user_t / 26)
			DB58 F 0 A_SetScale(0.435)
			DB58 F 1 A_SetTics(6 * user_t / 26 - 5 * user_t / 26)
			DB58 G 0 A_SetScale(0.462)
			DB58 G 1 A_SetTics(7 * user_t / 26 - 6 * user_t / 26)
			DB58 H 0 A_SetScale(0.489)
			DB58 H 1 A_SetTics(8 * user_t / 26 - 7 * user_t / 26)
			DB58 I 0 A_SetScale(0.516)
			DB58 I 1 A_SetTics(9 * user_t / 26 - 8 * user_t / 26)
			DB58 J 0 A_SetScale(0.543)
			DB58 J 1 A_SetTics(10 * user_t / 26 - 9 * user_t / 26)
			DB58 K 0 A_SetScale(0.570)
			DB58 K 1 A_SetTics(11 * user_t / 26 - 10 * user_t / 26)
			DB58 L 0 A_SetScale(0.597)
			DB58 L 1 A_SetTics(12 * user_t / 26 - 11 * user_t / 26)
			DB58 M 0 A_SetScale(0.624)
			DB58 M 1 A_SetTics(13 * user_t / 26 - 12 * user_t / 26)
			DB58 N 0 A_SetScale(0.651)
			DB58 N 1 A_SetTics(14 * user_t / 26 - 13 * user_t / 26)
			DB58 O 0 A_SetScale(0.678)
			DB58 O 1 A_SetTics(15 * user_t / 26 - 14 * user_t / 26)
			DB58 P 0 A_SetScale(0.705)
			DB58 P 1 A_SetTics(16 * user_t / 26 - 15 * user_t / 26)
			DB58 Q 0 A_SetScale(0.732)
			DB58 Q 1 A_SetTics(17 * user_t / 26 - 16 * user_t / 26)
			DB58 R 0 A_SetScale(0.759)
			DB58 R 1 A_SetTics(18 * user_t / 26 - 17 * user_t / 26)
			DB58 S 0 A_SetScale(0.786)
			DB58 S 1 A_SetTics(19 * user_t / 26 - 18 * user_t / 26)
			DB58 T 0 A_SetScale(0.813)
			DB58 T 1 A_SetTics(20 * user_t / 26 - 19 * user_t / 26)
			DB58 U 0 A_SetScale(0.840)
			DB58 U 1 A_SetTics(21 * user_t / 26 - 20 * user_t / 26)
			DB58 V 0 A_FadeOut(0.09)
			DB58 V 1 A_SetTics(22 * user_t / 26 - 21 * user_t / 26)
			DB58 W 0 A_FadeOut(0.09)
			DB58 W 1 A_SetTics(23 * user_t / 26 - 22 * user_t / 26)
			DB58 X 0 A_FadeOut(0.09)
			DB58 X 1 A_SetTics(24 * user_t / 26 - 23 * user_t / 26)
			DB58 Y 0 A_FadeOut(0.09)
			DB58 Y 1 A_SetTics(25 * user_t / 26 - 24 * user_t / 26)
			DB58 Z 0 A_FadeOut(0.09)
			DB58 Z 1 A_SetTics(26 * user_t / 26 - 25 * user_t / 26)
		Stop
	}
}
