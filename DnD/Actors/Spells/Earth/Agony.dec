// Agony's aura, carried as inventory like Anger's (see acs/DnD_Attachments.h). The marker's presence is the aura.
Actor DnD_AgonyAuraActive : DnD_Boolean {}

Actor Spell_AgonyAura_FXSpawner : DnD_Activator {
	States {
		Pickup:
			TNT1 A 1 ACS_NamedExecuteWithResult("DnD Spawn Player Aura", PLAYERFX_AGONYAURA)
		Stop
	}
}

// The ring, on AURA Q in MODELDEF.aura, shaded by Agony.fp: thorns, heartbeat veins, bruising. Follows its owner while the marker holds.
Actor Spell_AgonyAuraFX {
	Renderstyle Add
	Alpha 0.5
	// Anger's fixed 144 units.
	Scale 10.5
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOTONAUTOMAP
	States {
		Spawn:
			TNT1 A 1 NoDelay A_JumpIfInTargetInventory("DnD_AgonyAuraActive", 1, "Active")
		Stop

		Active:
			TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DnD Auras Hidden"), "Hidden")
			AURA Q 1 Bright A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_JumpIfInTargetInventory("DnD_AgonyAuraActive", 1, "Active")
		Stop

		Hidden:
			TNT1 A 1 A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_JumpIfInTargetInventory("DnD_AgonyAuraActive", 1, "Active")
		Stop
	}
}
