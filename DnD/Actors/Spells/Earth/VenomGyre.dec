// On a gyre that has already turned for home, so its watcher and its Death state never both send one back.
Actor DnD_GyreTurned : DnD_Boolean { }

// A bouncing toxic disc ripping each enemy once. 65536 | 32768 | 32 -- ISSPELL | RIPSONCE | NOPOISONSTACK: its poison
// is its own 50% roll, not the usual one of a poison hit.
Actor Spell_VenomGyre : DnD_Spell {
	PROJECTILE
	+RIPPER
	+DONTBLAST
	+BLOODLESSIMPACT
	// A sky deletes a projectile without its Death state; this sends it there, so it still turns for home.
	+SKYEXPLODE
	BounceType "Hexen"
	BounceFactor 1.0
	WallBounceFactor 1.0
	BounceSound "VenomGyre/Bounce"
	Stamina 98336
	Speed 20
	Radius 10
	Height 12
	// EVGY carries the crescent model, spun flat in MODELDEF.
	// A backstop on its life; the watcher turns it back long before, duration gear included.
	ReactionTime 400
	Damage(ACS_NamedExecuteWithResult("DnD Spell Damage", SPELLVAL_DAMAGE))
	States {
		SpawnState:
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Venom Gyre Setup")
		Fly:
			EVGY A 2 Bright A_CountDown
			EVGY A 0 Bright A_SpawnItemEx("Spell_VenomGyre_Mist", 0, 0, 0, frandom(-0.4, 0.4), frandom(-0.4, 0.4), frandom(-0.2, 0.3), 0, SXF_CLIENTSIDE, 96)
		Loop
		Death:
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Venom Gyre Turn")
		Splash:
			TNT1 A 0 A_SpawnItemEx("Spell_VenomGyre_Splash", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
			TNT1 A 8
		Stop
	}
}

// Flying home: steered by ACS, a fresh ripper so each enemy can be hit once more. A wall ends it.
Actor Spell_VenomGyre_Return : Spell_VenomGyre {
	BounceType "None"
	ReactionTime 0
	States {
		SpawnState:
			TNT1 A 0
		Fly:
			EVGY A 2 Bright
			EVGY A 0 Bright A_SpawnItemEx("Spell_VenomGyre_Mist", 0, 0, 0, frandom(-0.4, 0.4), frandom(-0.4, 0.4), frandom(-0.2, 0.3), 0, SXF_CLIENTSIDE, 96)
		Loop
		Death:
			TNT1 A 0
		Goto Splash
	}
}

// Thrown by a catch during a dash: straight, no bounce, no return, double damage through user_dmgmult.
Actor Spell_VenomGyre_Fresh : Spell_VenomGyre {
	BounceType "None"
	ReactionTime 105
	var int user_dmgmult;
	States {
		SpawnState:
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Venom Gyre Fresh Setup")
		Fly:
			EVGY A 2 Bright A_CountDown
			EVGY A 0 Bright A_SpawnItemEx("Spell_VenomGyre_Mist", 0, 0, 0, frandom(-0.4, 0.4), frandom(-0.4, 0.4), frandom(-0.2, 0.3), 0, SXF_CLIENTSIDE, 96)
		Loop
		Death:
			TNT1 A 0
		Goto Splash
	}
}

// A wisp of venom shed by a spinning gyre.
Actor Spell_VenomGyre_Mist : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.35
	Scale 0.14
	States {
		Spawn:
			D5FX GHIJKL 3 Bright A_FadeOut(0.05)
		Stop
	}
}

// The burst a gyre leaves where a wall stops it.
Actor Spell_VenomGyre_Splash : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.9
	Scale 0.45
	States {
		Spawn:
			D5FX GHIJKL 2 Bright
			D5FX L 2 Bright A_FadeOut(0.3)
		Wait
	}
}
