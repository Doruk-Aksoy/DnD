// A geyser's vent, client side: GEYSER.md3, a rock pile round a pool of acid, raised and sunk by "DnD Geyser FX".
Actor Spell_Geyser_Vent : DnD_SpecialFX {
	States {
		Spawn:
			GYSR A 1
			GYSR A 1 A_PlaySound("Geyser/Rise")
		SpawnWait:
			GYSR A -1
		Stop
		// GEYSER.md3 frames 1-14: the rim rocks tumble off, the pile slumps and drains, the rubble settles under the floor.
		Crumble:
			GYSR BCDEFGHIJKLMNO 2
			TNT1 A -1
		Stop
	}
}

// One drop of acid, client side, thrown on the server's dice; the server lands its damage. GYDROP.md3 in flight.
Actor Spell_Geyser_Drop {
	+CLIENTSIDEONLY
	PROJECTILE
	-NOGRAVITY
	+THRUACTORS
	+DONTSPLASH
	Gravity 0.6
	Radius 2
	Height 2
	RenderStyle Add
	Alpha 0.95
	States {
		Spawn:
			GYDR A -1 Bright
		Stop
		Death:
			TNT1 A 0 A_SpawnItemEx("Spell_Geyser_Splash", 0, 0, 7, 0, 0, 0, 0, SXF_CLIENTSIDE)
		Stop
	}
}

// Dirt kicked out round a vent's foot as it opens or slumps: the gray smoke tinted to dirt, small and slow for a vent.
Actor Spell_Geyser_Dust : VeryGraySmoke {
	Scale 0.22
	Alpha 0.6
	Translation "0:255=%[0.0,0.0,0.0]:[1.25,1.0,0.72]"
	States {
		Spawn:
			TNT1 A 0 NoDelay A_ChangeVelocity(frandom(0.8, 2.0), frandom(-0.4, 0.4), frandom(0.2, 0.7), CVF_REPLACE | CVF_RELATIVE)
		Goto Super::Spawn
	}
}

// An acid bubble out of a vent's pool while it spits: AcidFX's glow swelling as it rises slowly, then bursting.
Actor Spell_Geyser_Bubble : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.85
	+FORCEXYBILLBOARD
	States {
		Spawn:
			TNT1 A 0 NoDelay A_ChangeVelocity(frandom(-0.25, 0.25), frandom(-0.25, 0.25), frandom(0.5, 1.1), CVF_REPLACE)
			TNT1 A 0 A_SetScale(frandom(0.6, 1.0))
			ACFX AAAAAA 1 Bright A_SetScale(ScaleX + 0.08)
			ACFX A 0 A_Jump(128, "Burst")
			ACFX AAAA 1 Bright A_SetScale(ScaleX + 0.05)
		Burst:
			ACFX BCDE 2 Bright
		Stop
	}
}

// Where a drop lands, raised so the floor does not cut the puff in half.
Actor Spell_Geyser_Splash : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.9
	Scale 0.35
	States {
		Spawn:
			FXPG ABCD 2 Bright
		Stop
	}
}
