// Rockslide's boulder, tossed in an arc. It bursts where it lands and stuns what the blast catches.
Actor Spell_Rockslide : DnD_SpellExplosive {
	-NOGRAVITY
	Gravity 0.35
	Radius 14
	Height 24
	SeeSound "EarthLich/Rock"
	DeathSound "Rockslide/Hit"
	States {
		// ERSL carries ROCKSLID.md3.
		// No trail near the caster, where it would fill their view.
		SpawnState:
			ERSL A 3
			ERSL A 0 A_JumpIfCloser(128, "SpawnState")
			ERSL A 0 A_SpawnItemEx("Spell_Shrapnel_Dust", 0, 0, 0, frandom(-0.5, 0.5), frandom(-0.5, 0.5), frandom(0, 0.5), 0, SXF_CLIENTSIDE)
		Loop
		ContinueFromExplosion:
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Rockslide Stun")
			TNT1 A 0 A_Quake(2, 12, 0, 384, "")
			TNT1 AA 0 A_SpawnItemEx("StoneBitsSpawner", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
			TNT1 AAAAAAAAAA 0 A_SpawnItemEx("Spell_Shrapnel_Piece", 0, 0, 4, frandom(-5, 5), frandom(-5, 5), frandom(3, 9), frandom(0, 360), SXF_CLIENTSIDE)
			TNT1 AAAAA 0 A_SpawnItemEx("Spell_Rockslide_Dust", frandom(-20, 20), frandom(-20, 20), 4, frandom(-1, 1), frandom(-1, 1), frandom(0.3, 1), 0, SXF_CLIENTSIDE)
			TNT1 A 12
		Goto FinishExplosion
	}
}

Actor Spell_Rockslide_Dust : Spell_Shrapnel_Dust {
	Alpha 0.45
	Scale 1.2
}
