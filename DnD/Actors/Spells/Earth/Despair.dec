// Despair's curse marker: frame E of the curse row (FlammabilityFXMarker).
Actor DespairFXMarker : FlammabilityFXMarker {
	States {
		SpawnLoop:
			CM1O E 0
		Goto CurseJoin
	}
}

// The ring drawn where the curse lands, in poison puffs.
Actor DespairAreaMarkerFX : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.8
	Scale 0.35
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NOGRAVITY
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 Thing_ChangeTID(0, SPECIAL_FX_TID)
			OGLP P 1 Bright A_FadeOut(0.06)
		Wait
	}
}
