// we will cast the spell through this for now
Actor CastRally : CustomInventory {
	inventory.icon "SK_RALLY"
	+INVENTORY.UNDROPPABLE
	+INVENTORY.INVBAR
	States {
		Use:
			TNT1 A 0 A_JumpIfInventory("RallyCooldown", 1, "Failed")
			TNT1 A 0 A_GiveInventory("RallyCooldown", 1)
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Cast Spell", 0, DND_SPELL_RALLY, 1) // wait 8 seconds before cooldown script
		Fail
		Failed:
			TNT1 A 0
		Fail
	}
}

Actor RallyCooldown : DnD_Boolean { }
Actor RallyCooldownCounter : CooldownCounter { }

// Rally_DamageBuff is gone -- it is BTI_RALLY in the buff system now, which handles
// cross-player casting and keeps only the strongest caster's effect.










// The Rally_Speed_Lvl* PowerSpeed actors are gone -- the speed bonus is BTI_RALLY_SPEED
// in the buff system now, issued by BTI_RALLY so both halves share one lifetime, one
// strongest-caster-wins rule, and one expiry. Their per-level values live in
// RallySpeedBonus[] in acs/DnD_SkillDef.h.
