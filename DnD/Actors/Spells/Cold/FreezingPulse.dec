// One of the fan the cast spawns; the crescent is the union of their boxes.
Actor Spell_FreezingPulse_Part : DnD_Spell {
	PROJECTILE
	+RIPPER
	+DONTBLAST
	+NoExplodeFloor
	+BloodlessImpact
	+DONTSPLASH
	+STEPMISSILE
	// 65536 | 32768 -- ISSPELL | RIPSONCE.
	Stamina 98304
	MaxStepHeight 128
	Speed 26
	Radius 14
	Height 20
	Scale 1.1
	RenderStyle Add
	Alpha 0.85
	Damage(ACS_NamedExecuteWithResult("DnD Spell Damage", SPELLVAL_DAMAGE))
	DamageType "P_Ice"
	States {
		// One shot, ahead of the loop. The owner is on APROP_SCORE by now.
		SpawnState:
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Freezing Pulse Claim")
		Wave:
			// One tic a frame, so A_CountDown spends REACTIONTIME at one a tic.
			TNT1 A 1 A_CountDown
		Loop
		Death:
			TNT1 A 3
		Stop
	}
}

Actor Spell_FreezingPulse : DnD_Spell {
	PROJECTILE
	Damage 0
	Renderstyle Add
	Alpha 0.95
	Scale 2
	SeeSound "FreezingPulse/Fire"
	MaxStepHeight 128
	+RIPPER
	+DONTBLAST
	+NoExplodeFloor
	+BloodlessImpact
	+DONTSPLASH
	+STEPMISSILE
	States {
		SpawnState:
			// Sized to the fan it stands in for, before a frame is drawn. One shot, ahead of the loop.
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Freezing Pulse Scale")
		// Bright: the shader ends on rgb * color.rgb, so a dark sector would black it out.
		Fly:
			FPUL A 1 Bright A_CountDown
		Loop
		Death:
			TNT1 A 0 A_PlaySound("FreezingPulse/End")
		DeathLoop:
			FPUL A 1 Bright A_FadeOut(0.1)
		Loop
	}
}