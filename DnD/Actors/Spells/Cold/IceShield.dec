// Spell-system Ice Shield, beside the legacy skill one. Its own fade token, so the two never clash.
Actor Spell_IceShieldBarrier : Hittable_Spell_Object {
	Health 100
	Height 64
	Radius 12
	Renderstyle Add
	Alpha 0.01
	Scale 0.475
	+NOGRAVITY
	+NOBLOOD
	+CANTSEEK

	var int user_angle;
	const int tspeed = 9;
	const int r = 40;

	States {
		Spawn:
			TNT1 A 0 NoDelay A_SetUserVar("user_angle", angle)
		FadeIn:
			S000 A 1 A_Warp(AAPTR_TRACER, r, 0, 8, user_angle, WARPF_ABSOLUTEANGLE | WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
			TNT1 A 0 A_SetUserVar("user_angle", user_angle + tspeed)
			TNT1 A 0 A_FadeIn(0.03)
			// Loops on alpha rather than ten copied frames, which is what the legacy one needed.
			TNT1 A 0 A_JumpIf(alpha < 0.3, "FadeIn")
		Orbit:
			S000 A 1 A_Warp(AAPTR_TRACER, r, 0, 8, user_angle, WARPF_ABSOLUTEANGLE | WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
			TNT1 A 0 A_SetUserVar("user_angle", user_angle + tspeed)
			TNT1 A 0 A_JumpIfInventory("Spell_IceShieldFade", 1, "Fade", AAPTR_TRACER)
		Loop
		Death:
			TNT1 A 0 A_PlaySound("Spell/IceShieldBreak")
			TNT1 AAAAAAAAAAAAA 0 A_SpawnItemEx("IceShield_ShatterFX", frandom(-4, 4), frandom(-8, 8), frandom(8, 64), 0, 0, frandom(-4, 10), frandom(0, 360))
			TNT1 A 1
		Stop
		Fade:
			TNT1 A 0 A_Stop
			S000 AAAAAAAAAAAAAAA 1 A_FadeOut(0.075)
		Stop
	}
}

// Rank 10, "blocks ripper attacks": DONTRIP on the barrier is what stops a ripper passing through.
Actor Spell_IceShieldHarden : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_ChangeFlag("DONTRIP", 1)
		Stop
	}
}

// Carried by the CASTER; the barriers watch it through AAPTR_TRACER.
Actor Spell_IceShieldFade : DnD_Boolean { }
