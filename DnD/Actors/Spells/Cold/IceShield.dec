// Spell-system Ice Shield, beside the legacy skill one. Its own fade token, so the two never clash.
Actor Spell_IceShieldBarrier : Hittable_Spell_Object {
	Health 100
	Height 64
	Radius 12
	Renderstyle Add
	Alpha 0.01
	Scale 0.475
	+NOGRAVITY
	+NOBLOOD
	+CANTSEEK

	var int user_angle;
	const int tspeed = 9;
	const int r = 40;

	States {
		Spawn:
			TNT1 A 0 NoDelay A_SetUserVar("user_angle", angle)
		FadeIn:
			S000 A 1 A_Warp(AAPTR_TRACER, r, 0, 8, user_angle, WARPF_ABSOLUTEANGLE | WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
			TNT1 A 0 A_SetUserVar("user_angle", user_angle + tspeed)
			TNT1 A 0 A_FadeIn(0.03)
			// Loops on alpha rather than ten copied frames, which is what the legacy one needed.
			TNT1 A 0 A_JumpIf(alpha < 0.3, "FadeIn")
		Orbit:
			S000 A 1 A_Warp(AAPTR_TRACER, r, 0, 8, user_angle, WARPF_ABSOLUTEANGLE | WARPF_NOCHECKPOSITION | WARPF_INTERPOLATE)
			TNT1 A 0 A_SetUserVar("user_angle", user_angle + tspeed)
			TNT1 A 0 A_JumpIfInventory("Spell_IceShieldFade", 1, "Fade", AAPTR_TRACER)
		Loop
		Death:
			TNT1 A 0 A_PlaySound("Spell/IceShieldBreak")
			TNT1 AAAAAAAAAAAAA 0 A_SpawnItemEx("IceShield_ShatterFX", frandom(-4, 4), frandom(-8, 8), frandom(8, 64), 0, 0, frandom(-4, 10), frandom(0, 360))
			TNT1 A 1
		Stop
		Fade:
			TNT1 A 0 A_Stop
			S000 AAAAAAAAAAAAAAA 1 A_FadeOut(0.075)
		Stop
	}
}

// Rank 10, "blocks ripper attacks": DONTRIP on the barrier is what stops a ripper passing through.
Actor Spell_IceShieldHarden : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_ChangeFlag("DONTRIP", 1)
		Stop
	}
}

// Carried by the CASTER; the barriers watch it through AAPTR_TRACER.
Actor Spell_IceShieldFade : DnD_Boolean { }

// Shatter shards: the white set, and the blue set the Cold spells spawn.
Actor IceShield_ShatterFX {
	PROJECTILE
	Height 6
	Radius 3
	Renderstyle Add
	Alpha 0.85
	BounceType Doom
	BounceCount 4
	const float spd = 16.0;
	Scale 0.825
	+ALLOWBOUNCEONACTORS
	+CLIENTSIDEONLY
	-NOGRAVITY
	States {
		Spawn:
			TNT1 A 0 NoDelay A_ChangeVelocity(spd * cos(angle), spd * sin(angle), velz, CVF_REPLACE)
			TNT1 A 0 A_Jump(256, "Pick")
		// One of eight shards at random; Spell_IceShatterFX overrides this label for its blue set.
		Pick:
			TNT1 A 0 A_Jump(256, "1", "2", "3", "4", "5", "6", "7", "8")
		1:
			S000 B 0
		Goto SpawnLoop
		2:
			S000 C 0 A_Jump(256, "SpawnLoop")
		Goto SpawnLoop
		3:
			S000 D 0 A_Jump(256, "SpawnLoop")
		Goto SpawnLoop
		4:
			S000 E 0 A_Jump(256, "SpawnLoop")
		Goto SpawnLoop
		5:
			S000 F 0 A_Jump(256, "SpawnLoop")
		Goto SpawnLoop
		6:
			S000 G 0 A_Jump(256, "SpawnLoop")
		Goto SpawnLoop
		7:
			S000 H 0 A_Jump(256, "SpawnLoop")
		Goto SpawnLoop
		8:
			S000 I 0 A_Jump(256, "SpawnLoop")
		Goto SpawnLoop
		SpawnLoop:
			"####" "#" 1
		Loop
		Death:
			"####" "#" 1
		Stop
	}
}

Actor Spell_IceShatterFX : IceShield_ShatterFX {
	States {
		Pick:
			TNT1 A 0 A_Jump(256, "1", "2", "3", "4", "5", "6", "7", "8")
		1:
			S016 A 0
		Goto SpawnLoop
		2:
			S016 B 0
		Goto SpawnLoop
		3:
			S016 C 0
		Goto SpawnLoop
		4:
			S016 D 0
		Goto SpawnLoop
		5:
			S016 E 0
		Goto SpawnLoop
		6:
			S016 F 0
		Goto SpawnLoop
		7:
			S016 G 0
		Goto SpawnLoop
		8:
			S016 H 0
		Goto SpawnLoop
	}
}
