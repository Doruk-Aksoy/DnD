// Hatred's aura, Anger's cold twin. Carried as inventory for the reasons in acs/DnD_Attachments.h.

// The marker. Its PRESENCE is the aura: ACS gives it while the aura is on and takes it when it goes off.
Actor DnD_HatredAuraActive : DnD_Boolean {}

// Raises the effect on every machine that receives it. WithResult, so the player stays the activator.
Actor Spell_HatredAura_FXSpawner : DnD_Activator {
    States {
        Pickup:
            TNT1 A 1 ACS_NamedExecuteWithResult("DnD Spawn Player Aura", PLAYERFX_HATREDAURA)
        Stop
    }
}

// The ring, on AURA K in MODELDEF.aura, shaded by Hatred.fp. Follows its owner while the marker holds.
Actor Spell_HatredAuraFX {
    Renderstyle Add
    Alpha 0.5
    // Anger's scale: a marker under the player, not a measurement of the 256 unit reach.
    Scale 7.0
    +CLIENTSIDEONLY
    +NOINTERACTION
    +NOTONAUTOMAP
    States {
        // One tic, not zero, so it survives to the first Tick that NoDelay needs.
        Spawn:
            TNT1 A 1 NoDelay A_JumpIfInTargetInventory("DnD_HatredAuraActive", 1, "Active")
        Stop

        Active:
            AURA K 1 Bright A_Warp(AAPTR_TARGET, 0, 0, 0, 0,
                WARPF_INTERPOLATE | WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
            TNT1 A 0 A_JumpIfInTargetInventory("DnD_HatredAuraActive", 1, "Active")
        Stop
    }
}
