// Planted at the aim point and pulses in place. The frame run below is what PACES the pulses --
// 5 frames of 3 plus the 2 tic step is 17, which must stay in step with DND_FROSTBOMB_PULSE.
Actor Spell_FrostBomb : DnD_Spell {
	+NOGRAVITY
	+NOBLOCKMAP
	+DONTBLAST
	+NOTELEPORT
	Radius 12
	Height 40
	Scale 1.25
	RenderStyle Add
	Alpha 0.85
	DamageType "P_Ice"

	// Written by "DnD Spell Explosion Setup", read by A_Explode below.
	var int user_expdmg;
	var int user_expradius;
	var int user_fullexpradius;
	var int user_expflags;

	States {
		SpawnState:
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Frost Bomb Setup")
			// Once, not per pulse: the blast never changes over the crystal's life.
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Spell Explosion Setup", SPELLVAL_DAMAGE)
			TNT1 A 0 A_SetUserVar("user_fullexpradius", user_expradius / 2)
		Pulse:
			S013 ABCDE 3 Bright
			TNT1 A 0 A_PlaySound("IceBolt/Hit", CHAN_BODY)
			TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, 128)
			TNT1 A 2 A_Explode(100, user_expradius, 1, 0, user_fullexpradius)
			TNT1 A 0 A_CountDown
		Loop
		Death:
			S013 EDCBA 3 Bright A_FadeOut(0.12)
		Stop
	}
}
