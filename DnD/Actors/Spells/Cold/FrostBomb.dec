// Planted at the aim point and pulses in place. The FBMB run below is what paces the pulses --
// 17 tics, one per baked model frame, matching DND_FROSTBOMB_PULSE.
Actor Spell_FrostBomb : DnD_Spell {
	+NOGRAVITY
	+NOBLOCKMAP
	+DONTBLAST
	+NOTELEPORT
	+FORCERADIUSDMG
	Radius 12
	Height 40
	Scale 1.25
	RenderStyle Add
	Alpha 0.85
	DamageType "P_Ice"

	// Written by "DnD Spell Explosion Setup", read by A_Explode below.
	var int user_expdmg;
	var int user_expradius;
	var int user_fullexpradius;
	var int user_expflags;

	States {
		SpawnState:
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Frost Bomb Setup")
			// Once, not per pulse: the blast never changes over the crystal's life.
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Spell Explosion Setup", SPELLVAL_DAMAGE)
			TNT1 A 0 A_SetUserVar("user_fullexpradius", user_expradius / 2)
		// The blast lands on A and the crystal is at full swell by C, then settles through Q.
		// Bright, or a dark sector multiplies the skin away.
		Pulse:
			TNT1 A 0 A_PlaySound("FrostBomb/Pulse", CHAN_BODY)
			TNT1 AA 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, 128)
			TNT1 AAAAA 0 A_SpawnItemEx("Spell_FrostBomb_Smoke", frandom(-4, 4), frandom(-4, 4), frandom(-3, 3), frandom(-2.5, 2.5), frandom(-2.5, 2.5), frandom(-2.5, 2.5), 0, 128)
			TNT1 A 0 A_SpawnItemEx("Spell_FrostBomb_Flare", 0, 0, 0)
			FBMB A 1 Bright A_Explode(100, user_expradius, 1, 0, user_fullexpradius)
			FBMB BCDEFGHIJKLMNOPQ 1 Bright
			TNT1 A 0 A_CountDown
		Loop
		Death:
			FBMB AAAAAAAA 1 Bright A_FadeOut(0.13)
		Stop
	}
}

Actor Spell_FrostBomb_Flare : OverloadZap {
	Scale 0.35
}

Actor Spell_FrostBomb_Smoke : Spell_GlacialSpike_Smoke {
	Scale 1.15
}