// One actor, two phases. It evolves in flight rather than dying and spawning a successor, so the
// owner, the rip bookkeeping and the spell id all carry across instead of resetting.
Actor Spell_IceSpear : DnD_Spell {
	PROJECTILE
	+DONTBLAST
	+BloodlessImpact
	Speed 20
	Radius 8
	Height 12
	Scale 1.0
	RenderStyle Add
	Alpha 1.0
	SeeSound "IceSpear/Fire"
	DeathSound "IceSpear/Hit"
	DamageType "P_Ice"

	// The evolved form prices itself off its own field. Read per contact, so the change is live.
	var int user_evolved;
	// Its own added crit, set on evolving and read off it by the damage event.
	var int user_critchance;
	var int user_critmult;
	Damage(ACS_NamedExecuteWithResult("DnD Spell Damage", user_evolved ? SPELLVAL_DAMAGE2 : SPELLVAL_DAMAGE))

	States {
		SpawnState:
			// Unseen while it clears the hand; the forming spear is drawn there until it arrives.
			TNT1 A 2
		// A fixed run, NOT A_CountDown: an impact also ends in Death, so a countdown could not tell
		// the two apart. 2 + 6 x 2 tics must equal DND_ICESPEAR_PHASE1 in acs/Spells/DnD_Spells.h.
		Slow:
			ISPR AAAAAA 2 Bright A_SpawnItemEx("Spell_IceBolt_Trail", -60, 0, 0, 0, 0, 0, 0, 128)
		Evolve:
			TNT1 A 0 A_SetUserVar("user_evolved", 1)
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Ice Spear Evolve")
			TNT1 A 0 A_PlaySound("IceSpear/Transition", CHAN_BODY)
			TNT1 AAAAAA 0 A_SpawnItemEx("BlueParticleSpawner", frandom(-40.0, 20.0), 0, 0, 0, 0, 0, 0, 128)
			TNT1 AAAAAAAA 0 A_SpawnItemEx("Spell_GlacialSpike_Smoke", frandom(-50.0, 10.0), frandom(-8.0, 8.0), frandom(-6.0, 6.0), 0, frandom(-2.0, 2.0), frandom(-1.0, 2.0), 0, 128)
		// The thickening: barbs flare and the loose shards break off. ISPP / ISPQ draw the primed skin.
		Prime:
			TNT1 A 0 A_SpawnItemEx("Spell_IceSpear_Trail", -60, 0, 0, 0, 0, 0, 0, 128)
			ISPP A 1 Bright
			TNT1 A 0 A_SpawnItemEx("Spell_IceSpear_Trail", -60, 0, 0, 0, 0, 0, 0, 128)
			ISPP B 1 Bright
			TNT1 A 0 A_SpawnItemEx("Spell_IceSpear_Trail", -60, 0, 0, 0, 0, 0, 0, 128)
			ISPP C 1 Bright
			TNT1 A 0 A_SpawnItemEx("Spell_IceSpear_Trail", -60, 0, 0, 0, 0, 0, 0, 128)
			ISPP D 1 Bright
			TNT1 A 0 A_SpawnItemEx("Spell_IceSpear_Trail", -60, 0, 0, 0, 0, 0, 0, 128)
			ISPP E 1 Bright
			TNT1 A 0 A_SpawnItemEx("Spell_IceSpear_Trail", -60, 0, 0, 0, 0, 0, 0, 128)
			ISPP F 1 Bright
			TNT1 A 0 A_SpawnItemEx("Spell_IceSpear_Trail", -60, 0, 0, 0, 0, 0, 0, 128)
			ISPP G 1 Bright
			TNT1 A 0 A_SpawnItemEx("Spell_IceSpear_Trail", -60, 0, 0, 0, 0, 0, 0, 128)
			ISPP H 1 Bright
		// The primed loop: the loose shards helix down the spear. Only this phase counts down, so
		// Death is unambiguous from here on.
		Fast:
			TNT1 A 0 A_SpawnItemEx("Spell_IceSpear_Trail", -60, 0, 0, 0, 0, 0, 0, 128)
			ISPQ A 1 Bright A_CountDown
			TNT1 A 0 A_SpawnItemEx("Spell_GlacialSpike_ParticleTrail", frandom(-50.0, 0.0), frandom(-6.0, 6.0), frandom(-4.0, 4.0), frandom(-3.0, -1.0), frandom(-2.5, 2.5), frandom(-1.5, 1.5), 0, 128)
			ISPQ B 1 Bright A_CountDown
			TNT1 A 0 A_SpawnItemEx("Spell_IceSpear_Trail", -60, 0, 0, 0, 0, 0, 0, 128)
			ISPQ C 1 Bright A_CountDown
			TNT1 A 0 A_SpawnItemEx("Spell_GlacialSpike_Smoke", -60, 0, 0, 0, frandom(-1.5, 1.5), frandom(0.5, 1.25), 0, 128)
			ISPQ D 1 Bright A_CountDown
			TNT1 A 0 A_SpawnItemEx("Spell_IceSpear_Trail", -60, 0, 0, 0, 0, 0, 0, 128)
			ISPQ E 1 Bright A_CountDown
			TNT1 A 0 A_SpawnItemEx("Spell_GlacialSpike_ParticleTrail", frandom(-50.0, 0.0), frandom(-6.0, 6.0), frandom(-4.0, 4.0), frandom(-3.0, -1.0), frandom(-2.5, 2.5), frandom(-1.5, 1.5), 0, 128)
			ISPQ F 1 Bright A_CountDown
			TNT1 A 0 A_SpawnItemEx("Spell_IceSpear_Trail", -60, 0, 0, 0, 0, 0, 0, 128)
			ISPQ G 1 Bright A_CountDown
			TNT1 A 0 A_SpawnItemEx("Spell_GlacialSpike_Smoke", -60, 0, 0, 0, frandom(-1.5, 1.5), frandom(0.5, 1.25), 0, 128)
			ISPQ H 1 Bright A_CountDown
		Loop
		Death:
			TNT1 A 0 A_JumpIf(!user_evolved, "Shatter")
			// The primed spear breaks into the same chunks the Ice Shield barriers do.
			TNT1 AAAAAAAA 0 A_SpawnItemEx("IceShield_ShatterFX", frandom(-24.0, 8.0), frandom(-6.0, 6.0), frandom(-4.0, 8.0), 0, 0, frandom(-2.0, 6.0), frandom(0.0, 360.0), 128)
		Shatter:
			S012 BCDEFG 2 Bright
		Stop
	}
}

// The primed spear's trail: Ice Bolt's, larger.
Actor Spell_IceSpear_Trail : Spell_IceBolt_Trail {
	Scale 1.4
}

// The spear taking shape at the caster's right. Client side, warped to them every tic so it rides
// their movement; "DnD Ice Spear Form" feeds it their pitch, which A_Warp cannot copy.
Actor Spell_IceSpear_Form {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 1.0

	States {
		Spawn:
			TNT1 A 0
		// 40 out, 16 right and 26 up. A_Warp's +y is RIGHT, the opposite of SpawnSpellProjectile's side_off.
		// ISPF A-N must last DND_ICESPEAR_FORMTICS; O is the finished spear, held for the hand-off.
		Form:
			ISPF A 0 Bright A_PlaySound("IceSpear/Appear", CHAN_VOICE)
			ISPF A 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF B 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF C 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF D 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF E 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF F 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF G 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF H 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF I 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF J 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF K 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF L 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF M 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF N 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF O 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF O 1 Bright A_Warp(AAPTR_TARGET, 40.0, 16.0, 26.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			ISPF O 0 Bright A_StopSound(CHAN_VOICE)
		Stop
	}
}
