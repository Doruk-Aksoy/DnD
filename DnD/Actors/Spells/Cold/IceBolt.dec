// Slow comes from the cold on-hit seam in "DnD Damage Accumulate", not from here.
// On DnD_SpellExplosive for the rank 10 splash alone, as Fire Jet is.
Actor Spell_IceBolt : DnD_SpellExplosive {
	PROJECTILE
	Speed 25
	Radius 6
	Height 12
	Scale 2.0
	RenderStyle Add
	Alpha 1.0
	SeeSound "IceBolt/Fire"
	DeathSound "IceBolt/Hit"
	Damage(ACS_NamedExecuteWithResult("DnD Spell Damage", SPELLVAL_DAMAGE))
	DamageType "P_Ice"

	// The spell that threw it, plus one; 0 when cast. Winter Orb's throws hit harder per orb rank.
	var int user_parent;

	States {
		// S012 A carries ICEBOLT.md3 (MODELDEF.spell). Bright, or a dark sector blacks it out through the shader.
		SpawnState:
			S012 A 2 Bright A_SpawnItemEx("Spell_IceBolt_Trail", -8, 0, 0, 0, 0, 0, 0, 128)
		Loop
		Death:
			// Rank 10 only. The splash's victims are slowed by the same seam the direct hit uses,
			// because to them it is simply another cold spell hit.
			TNT1 A 0 A_JumpIf(user_spellrank < DND_SPELL_THRESH_HIGH, "ContinueFromExplosion")
			TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DnD Spell Explosion Setup"), "DoExplosionDamage")
		Goto ContinueFromExplosion
		ContinueFromExplosion:
			TNT1 A 0 A_SpawnItemEx("BlueParticleSpawner", 0, 0, 0, 0, 0, 0, 0, 128)
			TNT1 A 0 A_SpawnItemEx("Spell_IceImpactLight", 0, 0, 0, 0, 0, 0, 0, 128)
			S012 BCDEFG 3 Bright
		Goto FinishExplosion
	}
}

Actor Spell_IceBolt_Trail {
	+CLIENTSIDEONLY
	+NOINTERACTION
	RenderStyle Add
	Alpha 1.0
	States {
		Spawn:
			TNT1 A 1
			S012 HIJK 2 Bright
		Stop
	}
}

// A cold flash where ice lands: it swells for 2 tics, then spreads and fades over 12. Lights in GlDefs/Spells.txt.
Actor Spell_IceImpactLight {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle None
	States {
		Spawn:
			TNT1 A 1 Light("IceImpact1")
			TNT1 A 1 Light("IceImpact2")
			TNT1 A 2 Light("IceImpact3")
			TNT1 A 2 Light("IceImpact4")
			TNT1 A 2 Light("IceImpact5")
			TNT1 A 2 Light("IceImpact6")
			TNT1 A 2 Light("IceImpact7")
			TNT1 A 2 Light("IceImpact8")
		Stop
	}
}
