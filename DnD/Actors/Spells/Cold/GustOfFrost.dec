// Rides one ray of the wave for the rest of its run, shedding Frost Bomb's smoke along the way.
Actor Spell_GustOfFrost_SmokeRider : Spell_GustOfFrost_Piece {
	RenderStyle None
	States {
		Spawn:
			TNT1 AAAAAAAAAAAAAA 2 NoDelay A_SpawnItemEx("Spell_FrostBomb_Smoke", 0, frandom(-12.0, 12.0), frandom(-8.0, 8.0), velx * 0.85, vely * 0.85, frandom(0.0, 0.5), 0, SXF_ABSOLUTEVELOCITY | SXF_NOCHECKPOSITION | SXF_CLIENTSIDE)
		Stop
	}
}
