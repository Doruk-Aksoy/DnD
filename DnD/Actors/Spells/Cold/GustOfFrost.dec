// One wind piece, flown out on its own ray so a wall or a rising floor stops it. Client side only.
Actor Spell_GustOfFrost_Piece {
	+MISSILE
	+NOGRAVITY
	+NOBLOCKMAP
	+THRUACTORS
	+NOTELEPORT
	+DONTSPLASH
	+NOTONAUTOMAP
	+CLIENTSIDEONLY
	+PAINLESS
	+BLOODLESSIMPACT
	Damage 0
	Radius 4
	Height 4
	RenderStyle Add
	Alpha 0.15
	States {
		// A puff where it struck, rather than popping out of existence.
		Death:
			TNT1 AA 0 A_SpawnItemEx("Spell_FrostBomb_Smoke", -6, frandom(-16.0, 16.0), frandom(-4.0, 24.0), 0, frandom(-1.0, 1.0), frandom(0.0, 1.0), 0, SXF_NOCHECKPOSITION | SXF_CLIENTSIDE)
		Stop
	}
}

Actor Spell_GustOfFrost_WispL : Spell_GustOfFrost_Piece {
	States {
		Spawn:
			TNT1 A 1 NoDelay A_Jump(128, "Alt")
			// Bright, or a dark sector multiplies the skin away.
			GWNA ABC 2 Bright A_FadeIn(0.15)
			GWNA DEFGHIJ 2 Bright
			GWNA KLMN 2 Bright A_FadeOut(0.12)
		Stop
		Alt:
			TNT1 A 1
			GWNC ABC 2 Bright A_FadeIn(0.15)
			GWNC DEFGHIJ 2 Bright
			GWNC KLMN 2 Bright A_FadeOut(0.12)
		Stop
	}
}

