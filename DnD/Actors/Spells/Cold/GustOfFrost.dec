// Pure FX: "DnD Gust Of Frost" steps the push and the slow out in time with these pieces.

// The planted origin. Draws nothing: it scatters the wind pieces, and is the wave's CheckSight source.
Actor Spell_GustOfFrost_Wind : DnD_Spell {
	+NOINTERACTION
	+NOGRAVITY
	+NOBLOCKMAP
	+NOTONAUTOMAP
	Radius 1
	Height 1
	RenderStyle None
	States {
		Spawn:
			// A tic first, so the script's scale reaches clients before scalex is read.
			TNT1 A 1
			// scalex is reach / 72, so 2.5714 * scalex is reach / 28 a tic -- the hit front's pace.
			// zandro complained about this many things being in a 0 tic user variable loop... soo...
			TNT1 A 0 A_SpawnItemEx("Spell_GustOfFrost_WispR", 8, 0, frandom(0.0, 36.0), scalex * 2.5714, 0, 0, -39.1 + frandom(-2.0, 2.0), SXF_CLIENTSIDE | SXF_TRANSFERSCALE)
			TNT1 A 0 A_SpawnItemEx("Spell_GustOfFrost_WispR", 8, 0, frandom(0.0, 36.0), scalex * 2.5714, 0, 0, -32.6 + frandom(-2.0, 2.0), SXF_CLIENTSIDE | SXF_TRANSFERSCALE)
			TNT1 A 0 A_SpawnItemEx("Spell_GustOfFrost_WispR", 8, 0, frandom(0.0, 36.0), scalex * 2.5714, 0, 0, -26.0 + frandom(-2.0, 2.0), SXF_CLIENTSIDE | SXF_TRANSFERSCALE)
			TNT1 A 0 A_SpawnItemEx("Spell_GustOfFrost_WispR", 8, 0, frandom(0.0, 36.0), scalex * 2.5714, 0, 0, -19.5 + frandom(-2.0, 2.0), SXF_CLIENTSIDE | SXF_TRANSFERSCALE)
			TNT1 A 0 A_SpawnItemEx("Spell_GustOfFrost_WispR", 8, 0, frandom(0.0, 36.0), scalex * 2.5714, 0, 0, -13.0 + frandom(-2.0, 2.0), SXF_CLIENTSIDE | SXF_TRANSFERSCALE)
			TNT1 A 0 A_SpawnItemEx("Spell_GustOfFrost_WispR", 8, 0, frandom(0.0, 36.0), scalex * 2.5714, 0, 0, -6.5 + frandom(-2.0, 2.0), SXF_CLIENTSIDE | SXF_TRANSFERSCALE)
			TNT1 A 0 A_SpawnItemEx("Spell_GustOfFrost_WispR", 8, 0, frandom(0.0, 36.0), scalex * 2.5714, 0, 0, 0.0 + frandom(-2.0, 2.0), SXF_CLIENTSIDE | SXF_TRANSFERSCALE)
			TNT1 A 0 A_SpawnItemEx("Spell_GustOfFrost_WispL", 8, 0, frandom(0.0, 36.0), scalex * 2.5714, 0, 0, 6.5 + frandom(-2.0, 2.0), SXF_CLIENTSIDE | SXF_TRANSFERSCALE)
			TNT1 A 0 A_SpawnItemEx("Spell_GustOfFrost_WispL", 8, 0, frandom(0.0, 36.0), scalex * 2.5714, 0, 0, 13.0 + frandom(-2.0, 2.0), SXF_CLIENTSIDE | SXF_TRANSFERSCALE)
