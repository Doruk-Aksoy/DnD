			GWNB ABC 2 Bright A_FadeIn(0.15)
			GWNB DEFGHIJ 2 Bright
			GWNB KLMN 2 Bright A_FadeOut(0.12)
		Stop
		Alt:
			TNT1 A 1
			GWND ABC 2 Bright A_FadeIn(0.15)
			GWND DEFGHIJ 2 Bright
			GWND KLMN 2 Bright A_FadeOut(0.12)
		Stop
	}
}

