// Templates for the spell system. Inherit from the one that matches how the effect moves; the
// spawner fills the variables through SpawnSpellActor, so nothing here is set per spell.
//
// user_spellid   which spell this belongs to. Damage is NOT stored on the actor -- the impact script
//                resolves it from this id and the owner, so synergies and +levels stay live for a
//                projectile that is already in the air.
// user_spellrank the caster's effective rank, cached so DECORATE can branch on the rank 5 and rank
//                10 behaviours with A_JumpIf instead of an ACS round trip per frame.
// user_extra     per spell scratch. Ice Spear uses it for its phase, Annihilus for channel ticks.
//
// The owner is already on APROP_SCORE by the time these run -- "DnD Projectile Checks" puts it
// there, and every base below runs that first.

Actor DnD_Spell : DnD_BaseProjectile {
	// Stamina is where the damage handler reads its flags from, off whatever actor inflicted the hit.
	// Without ISSPELL it takes the "regular weapon dmg" branch and unpacks the word PackSpellDamage
	// built as a weapon id plus a damage cache id -- which is why a 100 damage Fireball landed as 4.
	//
	// 65536 is DND_DAMAGEFLAG_ISSPELL. Spelled as a literal because this property will not take the
	// name, which is why every Stamina in the mod is a bare number; grep the enum in DamageTypes.dec.
	Stamina 65536

	var int user_spellid;
	var int user_spellrank;
	var int user_extra;

	States {
		Spawn:
			TNT1 A 0 NoDelay ACS_NamedExecuteWithResult("DnD Projectile Checks")
			TNT1 A 35 A_Jump(256, "SpawnState")
		Wait
	}
}

// The first TNT1 A 0 is needed, NoDelay does not work properly with fastprojectiles -- same reason
// DnD_BaseFastProjectile carries one.
Actor DnD_SpellFast : DnD_BaseFastProjectile {
	// Stamina is where the damage handler reads its flags from, off whatever actor inflicted the hit.
	// Without ISSPELL it takes the "regular weapon dmg" branch and unpacks the word PackSpellDamage
	// built as a weapon id plus a damage cache id -- which is why a 100 damage Fireball landed as 4.
	//
	// 65536 is DND_DAMAGEFLAG_ISSPELL. Spelled as a literal because this property will not take the
	// name, which is why every Stamina in the mod is a bare number; grep the enum in DamageTypes.dec.
	Stamina 65536

	var int user_spellid;
	var int user_spellrank;
	var int user_extra;

	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Projectile Checks")
			TNT1 A 35 A_Jump(256, "SpawnState")
		Wait
	}
}

// A ruler for TraceSpellAim, read by tid on the tic it spawns. The one frame is only so it is still
// alive for that read; nothing looks at it afterwards.
Actor DnD_SpellAimPuff {
	+NOBLOCKMAP
	+NOGRAVITY
	+NOINTERACTION
	+DONTSPLASH
	+ALWAYSPUFF
	+PUFFONACTORS
	RenderStyle None
	Radius 1
	Height 1
	States {
		Spawn:
			TNT1 A 1
		Stop
	}
}

// What a spell's ACS traces are fired from, since a trace always leaves its own actor's centre and
// a spell needs to offset them. Subclassed rather than using ProjectileHelper directly so THRUSPECIES
// is added for spells only -- the weapons share that actor and their shots are supposed to be able to
// hit players.
Actor Spell_TraceHelper : ProjectileHelper {
	+THRUSPECIES
}

// Spell projectiles that burst on impact -- Pyroblast, Molten Boulder, Fire Jet's direct hit. Built
// on DnD_ExplosiveBase, so it inherits that whole contract: the PROJECTILE flags, the user_exp* vars,
// A_Explode at a flat 100 with the real number extracted afterwards, and the DoExplosionDamage /
// ContinueFromExplosion / FinishExplosion state machine.
//
// What this adds is the spell identity and, unlike the weapon bases, the explosion's NUMBERS. Every
// spell explosion resolves them the same two ways -- damage from SPELLVAL_DAMAGE priced as area, and
// radius from SPELLVAL_RADIUS -- both keyed off user_spellid at the moment of impact, so a synergy or
// a +level that landed mid flight still counts. A derived spell therefore writes no numbers at all.
//
// A spell using this supplies two states and nothing else:
//
//   SpawnState             the flight frames, ending in Loop
//   ContinueFromExplosion  the burst visuals, ending in Goto FinishExplosion
//
// Override Death only for a spell whose burst is not its plain SPELLVAL_DAMAGE -- a second damage
// field, say, or a radius it does not keep in its row. Override DamageType to the element: the
// inherited "PlayerExplosive" is the weapon default, and the legacy Molten Boulder uses "FireExp".
Actor DnD_SpellExplosive : DnD_ExplosiveBase {
	// ISSPELL so the packed word is read as a spell's rather than a weapon's, ISEXPLOSIVE because it is
	// one -- the two are independent. 65536 | 4194304. "DnD Prep Explosion" adds ISRADIUSDMG itself at
	// explode time, so it does not belong here.
	Stamina 4259840

	var int user_spellid;
	var int user_spellrank;
	var int user_extra;

	States {
		Death:
			TNT1 A 0 A_SetUserVar("user_expdmg",
				ACS_NamedExecuteWithResult("DnD Spell Damage", SPELLVAL_DAMAGE, DND_WDMG_ISRADIUSDMG))
			TNT1 A 0 A_SetUserVar("user_expradius",
				ACS_NamedExecuteWithResult("DnD Spell Radius", SPELLVAL_RADIUS))
			TNT1 A 0 A_SetUserVar("user_fullexpradius", 0)
			TNT1 A 0 A_SetUserVar("user_expflags", 0)
		Goto DoExplosionDamage

		// Deliberately NOT the inherited repeat check. "DnD Check Explosion Repeat" is gated on
		// GetExplosiveRepeatChance, a player-wide stat rather than a weapon one, so a spell WOULD enter
		// it -- and the repeat path re-packs user_expdmg in the WEAPON layout, reading a damage percent
		// out of bits 20+. PackSpellDamage puts the damage type at bit 19 and the spell id at 24, so the
		// two overlap and a repeated spell explosion would come back as noise.
		//
		// Whether explosive spells should repeat at all is a design call, not something to switch on by
		// accident. Making them able to means teaching that path both packings first.
		FinishExplosion:
			"####" "#" 1
		Stop
	}
}

// Anchors that sit still and do their work over time: Immolation's ring, Frost Bomb's crystal,
// Blizzard's storm, Volcano. NOCLIP so a spawn point inside geometry does not eject it, and
// NOINTERACTION because the damage comes from its own script rather than from touching anything.
Actor DnD_SpellAnchor {
	// Stamina is where the damage handler reads its flags from, off whatever actor inflicted the hit.
	// Without ISSPELL it takes the "regular weapon dmg" branch and unpacks the word PackSpellDamage
	// built as a weapon id plus a damage cache id -- which is why a 100 damage Fireball landed as 4.
	//
	// 65536 is DND_DAMAGEFLAG_ISSPELL. Spelled as a literal because this property will not take the
	// name, which is why every Stamina in the mod is a bare number; grep the enum in DamageTypes.dec.
	Stamina 65536

	+NOBLOCKMAP
	+NOGRAVITY
	+NOCLIP
	+NOINTERACTION
	+DONTSPLASH
	+AMBUSH
	Radius 1
	Height 1
	RenderStyle None

	var int user_spellid;
	var int user_spellrank;
	var int user_extra;

	States {
		Spawn:
			TNT1 A -1
		Stop
	}
}
