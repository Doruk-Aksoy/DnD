// The soft lock marker. Raised on an ally while a SPLF_ALLYTARGET spell is being cast at them, and
// dropped the moment the cast bar ends -- see the ally lock section in acs/Spells/DnD_SpellCast.h.
//
// Drawn as a WORLD actor rather than a screen overlay on purpose. There is no world to screen
// projection in the mod and ACS cannot read the player's FOV, so a HUD box would be an approximation
// that drifts for anyone off the default. A sprite standing on the ally is exact, and perspective
// scales it with distance for free -- which is the behaviour wanted anyway.
Actor DnD_AllyLockActive : DnD_Boolean {}

// The token that raises it. A CustomInventory, so its Pickup state runs with the PLAYER as self on
// every machine that receives the item.
//
// WithResult, not Always: the former runs inline and keeps the player as activator, which is the only
// thing the spawner has to aim the marker at. Always starts a detached script and loses it.
Actor Spell_AllyLock_FXSpawner : DnD_Activator {
    States {
        Pickup:
            TNT1 A 1 ACS_NamedExecuteWithResult("DnD Spawn Player Aura", PLAYERFX_ALLYLOCK)
        Stop
    }
}

// PLACEHOLDER ART: CMRK is the stun marker's sprite, borrowed so the box renders. Swap the sprite
// when the real selection art lands -- nothing else here needs to change.
//
// Sits at head height so it reads as a tag on the player rather than something on the floor, and
// pulses so it stands out against a moving fight.
Actor Spell_AllyLockFX {
    Renderstyle Add
    Alpha 0.9
    Scale 0.8
    +CLIENTSIDEONLY
    +NOINTERACTION
    +NOTONAUTOMAP
    +FORCEXYBILLBOARD

    const float lift = 48.0;

    States {
        // One tic, not zero. The actor has to survive to its first Tick for NoDelay to fire, and a
        // zero length spawn frame that does not jump is gone before anything sees it.
        Spawn:
            TNT1 A 1 NoDelay A_JumpIfInTargetInventory("DnD_AllyLockActive", 1, "Active")
        Stop

        Active:
            CMRK A 2 Bright A_Warp(AAPTR_TARGET, 0, 0, lift, 0,
                WARPF_INTERPOLATE | WARPF_ABSOLUTEANGLE | WARPF_NOCHECKPOSITION)
            CMRK B 2 Bright A_Warp(AAPTR_TARGET, 0, 0, lift, 0,
                WARPF_INTERPOLATE | WARPF_ABSOLUTEANGLE | WARPF_NOCHECKPOSITION)
            TNT1 A 0 A_JumpIfInTargetInventory("DnD_AllyLockActive", 1, "Active")
        Stop
    }
}
