Actor Spell_Pyroblast : DnD_SpellExplosive {
    PROJECTILE
    Speed 24
    Radius 10
    Height 20
    Scale 1.15
    SeeSound "Traps/Firejet"
    DeathSound "MeteorLauncher/HitSmall"
    // This contains all the packed information necessary for the spell's damage
    // A quarter, through the script's own div argument -- NOT by dividing what it returns. That
    // return is a PACKED word carrying the damage, the element and the spell id together, so
    // dividing it corrupts all three. div is applied after the scale, inside the packing.
    Damage(ACS_NamedExecuteWithResult("DnD Spell Damage", SPELLVAL_DAMAGE, 0, 4))
    DamageType "Fire"
    States {
        SpawnState:
            T000 A 0 A_PlaySound("Avatar/SoulFire", CHAN_5)
        SpawnStateLoop:
            T000 AB 3 Bright
        Loop
        // The threshold check belongs at the TOP of ContinueFromExplosion, not behind
        // FinishExplosion: the base jumps straight here from DoExplosionDamage, so a check sitting
        // in FinishExplosion was never reached and the rank 10 burst never fired.
        //
        // The visuals end in Goto FinishExplosion as the base contract asks, and MaxRankBlast
        // rejoins them at BlastVisuals rather than at the top -- re-entering the top would test the
        // threshold again and burst forever.
        ContinueFromExplosion:
            TNT1 A 0 A_JumpIf(user_spellrank >= DND_SPELL_THRESH_HIGH, "MaxRankBlast")
        BlastVisuals:
            TNT1 A 0 A_CustomMissile("ExplosionFX10", 0, 0, random(0,360), 2, random(0,360))
            TNT1 AAAAAA 0 A_CustomMissile("RocketSmoke", 0, 0, random(0, 360), 2, random(0, 180))
            TNT1 AAAAAAAA 0 A_CustomMissile ("ExplosionParticleHeavy", 0, 0, random (0, 360), 2, random (0, 180))
            TNT1 A 0 A_Quake(3, 17, 0, 192, "")
            T000 CDEFGH 3 Bright
        Goto FinishExplosion
        MaxRankBlast:
            TNT1 A 0 ACS_NamedExecuteWithResult("DnD Pyroblast Burst")
        Goto BlastVisuals
    }
}

// the script manages the necessary id data to give, the 8 is the divisor
Actor Spell_Pyroblast_TinyFireballs : Spell_Fireball {
    Speed 18
    Scale 0.6
    Height 9
    Radius 4
    Damage(ACS_NamedExecuteWithResult("DnD Spell Damage", SPELLVAL_DAMAGE, 0, 8))
}