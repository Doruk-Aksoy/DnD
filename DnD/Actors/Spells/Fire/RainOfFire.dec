Actor Spell_RainOfFire : DnD_SpellExplosive {
    PROJECTILE
    Speed 40
    Radius 8
    Height 16
    Scale 1.15
    SeeSound "RainOfFire/Spawn"
    DeathSound "RainOfFire/Hit"
    // This contains all the packed information necessary for the spell's damage
    // A quarter, through the script's own div argument -- NOT by dividing what it returns. That
    // return is a PACKED word carrying the damage, the element and the spell id together, so
    // dividing it corrupts all three. div is applied after the scale, inside the packing.
    Damage(ACS_NamedExecuteWithResult("DnD Spell Damage", SPELLVAL_DAMAGE, 0, 4))
    DamageType "Fire"
    +NOCLIP
    States {
        SpawnState:
            RW6G E 2 Bright
            RW6G E 1 Bright A_ChangeFlag("NOCLIP", 0)
            TNT1 A 0 A_PlaySound("RainOfFire/Whoosh")
        SpawnStateLoop:
            RW6G FGE 3 Bright
        Loop
        ContinueFromExplosion:
            TNT1 AAAA 0 A_CustomMissile("RocketSmoke", 0, 0, random(0, 360), 2, random(0, 180))
            TNT1 AAAAA 0 A_CustomMissile ("ExplosionParticleHeavy", 0, 0, random (0, 360), 2, random (0, 180))
            RW6F IJKL 3 Bright
        Stop
    }
}

// The ring that marks where the comets will fall. Short lived and redrawn each second by
// "DnD Rain Of Fire Mark", so the mark lasts the whole rain without needing a duration of its own.
//
// PLACEHOLDER ART: S004 is the sheet Flammability's ring uses, borrowed so the mark renders. Swap the
// sprite when the real one lands.
Actor Spell_RainOfFireMarkerFX : DnD_SpecialFX {
    RenderStyle Add
    Alpha 0.01
    Scale 0.7
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOGRAVITY
    States {
        Spawn:
            TNT1 A 0
            TNT1 A 0 Thing_ChangeTID(0, SPECIAL_FX_TID)
            S004 FFFFGGGG 1 Bright A_FadeIn(0.0875)
            S004 FGFGFGFG 4 Bright
            S004 FFFFGGGG 1 Bright A_Fadeout(0.0875)
        Stop
    }
}
