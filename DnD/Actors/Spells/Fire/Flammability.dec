// Every curse marker's base, and Flammability's (frame A): a row over the head that "DnD Curse Row" re-centres as curses
// come and go. Sprites CM00-CM1K (TEXTURES.spl, base 36) are its positions, Pos28 the middle; it slides a position a tic to user_target.
Actor FlammabilityFXMarker : DnD_AttachedFXBase {
	Renderstyle Add
	Alpha 0.85
	ReactionTime 28
	Scale 0.5
	var int user_cursemark;
	var int user_target;
	States {
		SpawnLoop:
			CM0S A 0
		Goto CurseJoin
		CurseJoin:
			"####" "#" 0 A_SetUserVar("user_target", 28)
			"####" "#" 0 A_SetUserVar("user_cursemark", 1)
			"####" "#" 0 ACS_NamedExecuteWithResult("DnD Curse Row")
		Goto Pos28
		Pos0:
			CM00 "#" 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass + 24.0, 0, WARPF_INTERPOLATE | WARPF_ABSOLUTEANGLE | WARPF_NOCHECKPOSITION)
			"####" "#" 0 A_JumpIf(user_target > 0, "Pos1")
		Loop
		Pos1:
			CM01 "#" 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass + 24.0, 0, WARPF_INTERPOLATE | WARPF_ABSOLUTEANGLE | WARPF_NOCHECKPOSITION)
			"####" "#" 0 A_JumpIf(user_target > 1, "Pos2")
			"####" "#" 0 A_JumpIf(user_target < 1, "Pos0")
		Loop
		Pos2:
