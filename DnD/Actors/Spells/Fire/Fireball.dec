Actor Spell_Fireball : DnD_Spell {
    PROJECTILE
    Speed 30
    Radius 8
    Height 16
    Scale 1.15
    SeeSound "Beast/Attack"
    DeathSound "weapons/phoenixhit"
    // This contains all the packed information necessary for the spell's damage
    Damage(ACS_NamedExecuteWithResult("DnD Spell Damage", SPELLVAL_DAMAGE))
    DamageType "Fire"
    States {
        SpawnState:
            FX14 ABC 3 Bright
        Loop
        Death:
            TNT1 A 0 A_CustomMissile("ExplosionFX10", 0, 0, random(0,360), 2, random(0,360))
            TNT1 AAAA 0 A_CustomMissile("RocketSmoke", 0, 0, random(0, 360), 2, random(0, 180))
            TNT1 AAAAA 0 A_CustomMissile ("ExplosionParticleHeavy", 0, 0, random (0, 360), 2, random (0, 180))
            FX14 DEFGH 3 Bright
        Stop
    }
}