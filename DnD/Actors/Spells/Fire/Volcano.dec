 Actor Spell_Volcano : DnD_SpellObject {
	Height 52
	Radius 32
	Mass 2048
	DamageType "FireExp"
	+NOCLIP
	+INVULNERABLE
	+SOLID
	-SHOOTABLE
	+DONTBLAST
	+NOTELESTOMP
	+DONTSPLASH
    Scale 0.05
	ReactionTime 12    // calculated so its lifetime is 10 seconds
    const float f = 1.21875;
    States {
        Spawn:
            TNT1 A 0
            TNT1 A 0 A_PlaySound("Volcano/Rise", CHAN_BODY)
            UP26 FFFFFGGGGGHHHHHAAAA 1 A_SetScale(scalex * f, scaley * f)
            TNT1 A 0 A_PlaySound("Volcano/Loop", CHAN_5)
        SpawnStuff:
            // sum tics below, /35 * 10
            // Thrown from ACS, not from this frame. User variables do NOT transfer on a DECORATE
            // spawn, so a bit made by A_SpawnItemEx would carry no spell id and price itself as
            // Blaze. WithResult runs inline, which keeps this actor as the activator.
            TNT1 A 0 A_PlaySound("Volcano/BigBurst", CHAN_VOICE)
            TNT1 A 0 A_PlaySound("Volcano/RegularBoom", CHAN_6)
            UP26 E 4 Bright ACS_NamedExecuteWithResult("DnD Volcano Erupt")
            TNT1 A 0 A_Quake(3, 24, 0, 256, "")
            UP26 A 4
            TNT1 A 0 A_PlaySound("Volcano/RegularBoom", CHAN_6)
            UP26 E 5 Bright ACS_NamedExecuteWithResult("DnD Volcano Erupt")
            UP26 A 5
            TNT1 A 0 A_PlaySound("Volcano/RegularBoom", CHAN_6)
            UP26 E 5 Bright ACS_NamedExecuteWithResult("DnD Volcano Erupt")
            UP26 E 4 Bright ACS_NamedExecuteWithResult("DnD Volcano Erupt")
            // below here: 16
            UP26 BC 3
            UP26 DB 2
            UP26 CDBCD 1
            UP26 A 1 A_CountDown
        Loop
        Death:
            TNT1 A 0 A_StopSound(CHAN_5)
            TNT1 A 0 A_PlaySound("Volcano/Lower", CHAN_BODY)
            UP26 HHHHHGGGGGFFFFF 1 A_SetScale(scalex / f, scaley / f)
        Stop
    }
}

Actor Spell_VolcanoBit : DnD_SpellExplosive {
    radius 9
	height 8
	speed 15
    Gravity 0.666
    DamageType "FireExp"
    -NOGRAVITY
    +FORCERADIUSDMG
    States {
        SpawnState:
			TNT1 A 0 bright A_CustomMissile ("wraithfx2",0,0)
			VFBL A 4 bright A_SpawnItemEx("PuffyC", random2[BeastPuff]()*0.015625, random2[BeastPuff]()*0.015625, random2[BeastPuff]()*0.015625, 
											0,0,0,0,SXF_ABSOLUTEPOSITION, 64)
			VFBL B 4 bright A_SpawnItemEx("PuffyC", random2[BeastPuff]()*0.015625, random2[BeastPuff]()*0.015625, random2[BeastPuff]()*0.015625, 
											0,0,0,0,SXF_ABSOLUTEPOSITION, 64)
		loop
        ContinueFromExplosion:
            TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
            TNT1 A 0 A_Stop
            TNT1 A 0 A_PlaySound("Volcano/Explode", CHAN_BODY)
            TNT1 A 0 A_PlaySound("Volcano/ExplodeAdd", CHAN_VOICE)
			TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, 128)
			TNT1 A 0 A_SpawnItemEx("ExplosionFX2", 0, 0, 0, frandom(-1, 1), frandom(-1, 1), frandom(-1, 1))
			TNT1 AAA 0 A_CustomMissile("FireballSmoke", 0, 0, random(0,360), 2, random(0,360))
			XPL1 A 4 BRIGHT
			XPL1 BCDEF 4 bright
		stop
    }
}