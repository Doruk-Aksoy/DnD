 Actor Spell_Volcano : DnD_SpellObject {
	Height 52
	Radius 32
	Mass 2048
	DamageType "FireExp"
	+NOCLIP
	+INVULNERABLE
	+SOLID
	-SHOOTABLE
	+DONTBLAST
	+NOTELESTOMP
	+DONTSPLASH
	ReactionTime 12    // calculated so its lifetime is 10 seconds
    States {
        Spawn:
            TNT1 A 0
            TNT1 A 0 A_PlaySound("Volcano/Rise", CHAN_BODY)
            VLCN CDEFGHIJKLMNOPQRST 1
            VLCN A 1
            TNT1 A 0 A_PlaySound("Volcano/Loop", CHAN_5)
        SpawnStuff:
            // 43 tics a pass (DND_VOLCANO_LOOPTICS). Lava is thrown from ACS: a DECORATE spawn carries no spell id
            // (it would price itself as Blaze); WithResult runs inline, keeping this actor the activator.
            TNT1 A 0 A_PlaySound("Volcano/BigBurst", CHAN_VOICE)
            TNT1 A 0 A_PlaySound("Volcano/RegularBoom", CHAN_6)
            TNT1 A 0 A_SpawnItemEx("Spell_Volcano_BigBurst", 0, 0, 52)
            VLCN B 4 ACS_NamedExecuteWithResult("DnD Volcano Erupt")
            TNT1 A 0 A_Quake(3, 24, 0, 256, "")
            VLCN A 4
            TNT1 A 0 A_PlaySound("Volcano/RegularBoom", CHAN_6)
            TNT1 A 0 A_SpawnItemEx("Spell_Volcano_Burst", 0, 0, 52)
            VLCN B 5 ACS_NamedExecuteWithResult("DnD Volcano Erupt")
            VLCN A 5
            TNT1 A 0 A_PlaySound("Volcano/RegularBoom", CHAN_6)
            TNT1 A 0 A_SpawnItemEx("Spell_Volcano_Burst", 0, 0, 52)
            VLCN B 5 ACS_NamedExecuteWithResult("DnD Volcano Erupt")
            VLCN B 4 ACS_NamedExecuteWithResult("DnD Volcano Erupt")
            VLCN A 15
            VLCN A 1 A_CountDown
        Loop
        Death:
            TNT1 A 0 A_StopSound(CHAN_5)
            TNT1 A 0 A_PlaySound("Volcano/Lower", CHAN_BODY)
            VLCN SQONMLKJIHGFEDC 1
        Stop
    }
}

Actor Spell_VolcanoBit : DnD_SpellExplosive {
    radius 9
	height 8
	speed 15
    Gravity 0.666
    DamageType "FireExp"
    -NOGRAVITY
    +FORCERADIUSDMG
    // Off ceilings rather than bursting on them, so a low room does not eat the throw; floors and walls still burst it.
    +BOUNCEONCEILINGS
    BounceFactor 0.5
    // Through actors until clear of the mouth, so whatever stands in the cone is not struck by every piece as it leaves.
    +THRUACTORS
    // Bursts by itself after about 3.5 seconds aloft: a piece must never hang in the air.
    ReactionTime 13
    States {
        SpawnState:
			TNT1 A 0 bright A_CustomMissile ("wraithfx2",0,0)
			VFBL A 4 bright A_SpawnItemEx("PuffyC", random2[BeastPuff]()*0.015625, random2[BeastPuff]()*0.015625, random2[BeastPuff]()*0.015625, 
											0,0,0,0,SXF_ABSOLUTEPOSITION, 64)
			VFBL B 4 bright A_SpawnItemEx("PuffyC", random2[BeastPuff]()*0.015625, random2[BeastPuff]()*0.015625, random2[BeastPuff]()*0.015625, 
											0,0,0,0,SXF_ABSOLUTEPOSITION, 64)
			TNT1 A 0 A_ChangeFlag("THRUACTORS", 0)
		Fly:
			TNT1 A 0 bright A_CustomMissile ("wraithfx2",0,0)
			VFBL A 4 bright A_SpawnItemEx("PuffyC", random2[BeastPuff]()*0.015625, random2[BeastPuff]()*0.015625, random2[BeastPuff]()*0.015625, 
											0,0,0,0,SXF_ABSOLUTEPOSITION, 64)
			VFBL B 4 bright A_SpawnItemEx("PuffyC", random2[BeastPuff]()*0.015625, random2[BeastPuff]()*0.015625, random2[BeastPuff]()*0.015625, 
											0,0,0,0,SXF_ABSOLUTEPOSITION, 64)
			TNT1 A 0 A_CountDown
		loop
        ContinueFromExplosion:
            TNT1 A 0 A_ChangeFlag("NOGRAVITY", 1)
            TNT1 A 0 A_Stop
            TNT1 A 0 A_PlaySound("Volcano/Explode", CHAN_BODY)
            TNT1 A 0 A_PlaySound("Volcano/ExplodeAdd", CHAN_VOICE)
			TNT1 A 0 A_SpawnItemEx("OrangeParticleSpawner", 0, 0, 0, 0, 0, 0, 0, 128)
			TNT1 A 0 A_SpawnItemEx("ExplosionFX2", 0, 0, 0, frandom(-1, 1), frandom(-1, 1), frandom(-1, 1))
			TNT1 AAA 0 A_CustomMissile("FireballSmoke", 0, 0, random(0,360), 2, random(0,360))
			XPL1 A 4 BRIGHT
			XPL1 BCDEF 4 bright
		stop
    }
}

// An eruption out of the crater: a flash, flame jets, an ash plume and embers flung up. Spawned per eruption frame.
Actor Spell_Volcano_Burst : DnD_SpecialFX {
	States {
		Spawn:
			TNT1 A 0 NoDelay A_SpawnItemEx("Spell_Volcano_Flash", 0, 0, 5)
			TNT1 A 0 A_SpawnItemEx("Spell_Volcano_Jet", frandom(-1.5, 1.5), frandom(-1.5, 1.5), 0)
			TNT1 AA 0 A_SpawnItemEx("Spell_Volcano_Jet", frandom(-4, 4), frandom(-4, 4), 0, 0, 0, 0, 0, 0, 96)
			TNT1 AAAAAAAAAA 0 A_SpawnItemEx("Spell_Volcano_Ember", frandom(-5, 5), frandom(-5, 5), 2, frandom(1, 3.5), 0, frandom(4, 7.5), random(0, 359))
		// Ash let out over a few tics at different climbs, so it stacks into a column instead of one ball.
		Plume:
			TNT1 AA 0 A_SpawnItemEx("Spell_Volcano_Ash", frandom(-5, 5), frandom(-5, 5), 3, frandom(0.4, 2.0), 0, frandom(1.4, 5.0), random(0, 359))
			TNT1 A 2
			TNT1 AA 0 A_SpawnItemEx("Spell_Volcano_Ash", frandom(-5, 5), frandom(-5, 5), 3, frandom(0.4, 2.0), 0, frandom(1.4, 5.0), random(0, 359))
			TNT1 A 2
			TNT1 AA 0 A_SpawnItemEx("Spell_Volcano_Ash", frandom(-5, 5), frandom(-5, 5), 3, frandom(0.4, 2.0), 0, frandom(1.4, 5.0), random(0, 359))
			TNT1 A 2
		Stop
	}
}

// The first eruption of a pass, with the quake: twice the ash.
Actor Spell_Volcano_BigBurst : Spell_Volcano_Burst {
	States {
		Spawn:
			TNT1 AAA 0 NoDelay A_SpawnItemEx("Spell_Volcano_Ash", frandom(-7, 7), frandom(-7, 7), 3, frandom(0.8, 2.4), 0, frandom(1.2, 3.6), random(0, 359))
			TNT1 A 0 A_SpawnItemEx("Spell_Volcano_Burst", 0, 0, 0)
			TNT1 A 6
			Goto Super::Plume
	}
}

Actor Spell_Volcano_Flash : ExplosionFX1 {
	Scale 0.55
}

// Flame Pillar's burst, quick and upright out of the mouth.
Actor Spell_Volcano_Jet : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.9
	Scale 0.7
	States {
		Spawn:
			TNT1 A 0 NoDelay Thing_ChangeTID(0, SPECIAL_FX_TID)
			DGFL ABCDEFGHIJKLMNOP 1 Bright
		Stop
	}
}

// Dark ash rolling up out of the crater, slowing and spreading as it climbs.
Actor Spell_Volcano_Ash : DnD_SpecialFX {
	RenderStyle Translucent
	Alpha 0.5
	Scale 0.5
	+FORCEXYBILLBOARD
	Translation "0:255=%[0.00,0.00,0.00]:[0.8,0.74,0.7]"
	States {
		Spawn:
			TNT1 A 0 NoDelay Thing_ChangeTID(0, SPECIAL_FX_TID)
			SMK3 B 4 A_SetScale(scalex * 1.06)
			SMK3 B 0 A_ScaleVelocity(0.86)
			SMK3 C 4 A_SetScale(scalex * 1.06)
			SMK3 C 0 A_ScaleVelocity(0.86)
			SMK3 D 4 A_SetScale(scalex * 1.06)
			SMK3 D 0 A_ScaleVelocity(0.86)
			SMK3 E 4 A_SetScale(scalex * 1.06)
			SMK3 E 0 A_ScaleVelocity(0.86)
			SMK3 F 5 A_SetScale(scalex * 1.06)
			SMK3 F 0 A_ScaleVelocity(0.86)
			SMK3 G 5 A_SetScale(scalex * 1.06)
			SMK3 G 0 A_ScaleVelocity(0.86)
			SMK3 H 5 A_SetScale(scalex * 1.06)
			SMK3 H 0 A_ScaleVelocity(0.86)
			SMK3 I 5 A_SetScale(scalex * 1.06)
			SMK3 I 0 A_ScaleVelocity(0.86)
			SMK3 J 5 A_SetScale(scalex * 1.06)
			SMK3 J 0 A_ScaleVelocity(0.86)
			SMK3 K 5 A_SetScale(scalex * 1.06)
			SMK3 K 0 A_ScaleVelocity(0.86)
			SMK3 L 5 A_SetScale(scalex * 1.06)
			SMK3 L 0 A_ScaleVelocity(0.86)
			SMK3 M 5 A_SetScale(scalex * 1.06)
			SMK3 M 0 A_ScaleVelocity(0.86)
		Stop
	}
}

Actor Spell_Volcano_Ember : ExplosionParticleHeavy {
	Scale 0.25
}
