// Incinerate's burst, given to the corpse the proc fired on. A token rather than a direct spawn from
// the burst script: the FX below is CLIENTSIDEONLY, and the script that decides the proc runs on the
// server, where such an actor never appears. Inventory crosses, and the Pickup state runs on every
// machine that receives it -- the same route Blaze's hit FX takes.
Actor Spell_Incinerate_BurstFXSpawner : DnD_Activator {
    States {
        Pickup:
            TNT1 A 0 A_PlaySound("CrematorExplosion", CHAN_7)
            TNT1 A 0 A_SpawnItemEx("IncinerateBurstFX", 0, 0, height / 2, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
            TNT1 AAAAAA 0 A_SpawnItemEx("IncinerateBurstEmber", frandom(-radius, radius), frandom(-radius, radius), frandom(height / 4, height), frandom(-2.0, 2.0), frandom(-2.0, 2.0), frandom(1.0, 4.0), 0, SXF_NOCHECKPOSITION)
        Stop
    }
}

Actor IncinerateBurstFX {
    Renderstyle Add
    Alpha 0.9
    Scale 1.8
    +FORCEXYBILLBOARD
    +NOINTERACTION
    +CLIENTSIDEONLY
    States {
        Spawn:
            TNT1 A 0 NoDelay A_Jump(128, "Flip")
            X007 KLMNOPQRST 1 Bright A_FadeOut(0.04)
        Stop
        Flip:
            X007 ABCDEFGHIJ 1 Bright A_FadeOut(0.04)
        Stop
    }
}

// Thrown outward from the burst so it reads as a blast rather than a flat decal.
Actor IncinerateBurstEmber : DnD_SpecialFX {
    RenderStyle Add
    Alpha 0.95
    Scale 0.65
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOGRAVITY
    States {
        Spawn:
            TNT1 A 0
			TNT1 A 0 Thing_ChangeTID(0, SPECIAL_FX_TID)
            FIRR AAAAAA 1 Bright A_FadeIn(0.06)
            FIRR BCDEFGH 3 Bright A_FadeOut(0.08)
        Stop
    }
}
