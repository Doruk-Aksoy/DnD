// Molten Boulder, carried over from the pre-tree system (Actors/Spells/MoltenBoulder.dec).
// The boulder itself is UNCHANGED: same flags, speeds, frame cycling, push, bump and shatter.
// What changed is only how it looks damage up, and the two actors that deal that damage.
//
// Self contained by design. Every helper is duplicated under a Spell_ name rather than shared with
// the old file, because that file is slated for deletion once the trees are done -- and the
// renames keep the two sets from colliding while both are still included.

// ---- the boulder ----------------------------------------------------------------------------
// DnD_SpellObject carries the identity contract -- Stamina, Species, THRUSPECIES and the three
// user_spell* vars that SetupSpellActor stamps and "DnD Molten Boulder Damage" reads back. The old
// file restated all of that inline because there was no base to put it in.
// CastMoltenBoulder overwrites APROP_ReactionTime from SPELLVAL_DURATION. The old file hardcoded
// 210 tics plus a dead _Longer variant at 252; rank 5 getting 3 more seconds now comes off the
// table instead of needing a second actor.
Actor Spell_MoltenBoulder : DnD_SpellObject {
	Height 64
	Radius 32
	Mass 2048
	DamageType "FireExp"
	+NOCLIP
	+INVULNERABLE
	+SOLID
	-SHOOTABLE
	+DONTBLAST
	+NOTELESTOMP
	+NOBLOCKMONST
	+DONTSPLASH
	+FORCERADIUSDMG
	+PAINLESS
	ReactionTime 210		// fallback only; the cast overwrites it from the table
	const int r = 36;
	const int spd = 12;
	const int spd2 = 16;
	const float mprj_vel1 = 13.5;
	const float mprj_vel2 = 18.0;
	Scale 0.8
	MaxStepHeight 40
	States {
		Spawn:
			S002 A 4 Light("MoltenBoulderLight")
			"####" "#" 0 A_PlaySound("Spell/MoltenBoulderFall", 5, 1.0, 1)
			"####" "#" 0 A_ChangeFlag("NOCLIP", 0)
		SpawnLoop:
			"####" "#" 0 A_JumpIf(z - floorz <= 6, "FloorBump")
			"####" "####" 0 A_SpawnItemEx("Spell_BoulderFireFX", frandom(-r, r), frandom(-r ,r), frandom(0, 2 * r), frandom(-2, 2), frandom(-2, 2), frandom(-2, 2))
			"####" "#" 0 ACS_NamedExecuteWithResult("DnD Molten Boulder Damage", 0)
			"####" "#" 0 A_ChangeVelocity(spd * cos(angle), spd * sin(angle), velz, CVF_REPLACE)
			"####" "#" 1 Light("MoltenBoulderLight") A_SpawnItemEx("Spell_BoulderFireFX", frandom(-r, r), frandom(-r ,r), frandom(0, 2 * r), frandom(-2, 2), frandom(-2, 2), frandom(-2, 2))
			"####" "#" 0 A_GiveInventory("Spell_BoulderPusher", 1)
			"####" "#" 0 A_JumpIfInventory("Spell_MoltenBoulderStall", 1, "Shatter")
			"####" "#" 0 A_GiveInventory("Spell_BoulderFrameSetter", 1)
			"####" "#" 0 A_CountDown
			// frame setting
			"####" "#" 0 A_JumpIfInventory("Spell_BoulderFrame", 3, "FrameD")
			"####" "#" 0 A_JumpIfInventory("Spell_BoulderFrame", 2, "FrameC")
			"####" "#" 0 A_JumpIfInventory("Spell_BoulderFrame", 1, "FrameB")
		Goto FrameA
		FloorBump:
			"####" "#" 0 A_playSound("Spell/MoltenBoulderBump")
			"####" "######" 0 A_SpawnItemEx("ExplosionFX2", frandom(-20, 20), frandom(-20, 20), 0, frandom(-4, 4), frandom(-4, 4), frandom(0, 2))
			"####" "#######" 0 A_SpawnItemEx("Spell_BoulderFireFX", frandom(-r, r), frandom(-r ,r), frandom(0, 2 * r), frandom(-2, 2), frandom(-2, 2), frandom(-2, 2))
			"####" "#" 0 ACS_NamedExecuteWithResult("DnD Molten Boulder Damage", 1)
			"####" "#" 0 A_ChangeVelocity(spd2 * cos(angle), spd2 * sin(angle), velz, CVF_REPLACE)
			"####" "#" 0 ThrustThingZ(0, 32, 0, 0)
			"####" "#" 0 A_playSound("Spell/MoltenBoulderRoll", 5, 1.0, 1)
			"####" "#" 0 A_Quake(4, 12, 0, 384)
		Goto SpawnLoopNoBump
		SpawnLoopNoBump:
		Idle:
			"####" "#" 0 A_GiveInventory("Spell_BoulderFrameSetter2", 1)
			"####" "#" 0 A_TakeInventory("Spell_MoltenBoulderStall_Actor", 1)
			"####" "#" 0 A_TakeInventory("Spell_MoltenBoulderStall", 1)
			"####" "####" 0 A_SpawnItemEx("Spell_BoulderFireFX", frandom(-r, r), frandom(-r ,r), frandom(r / 2, 2 * r), frandom(-2, 2), frandom(-2, 2), frandom(-2, 2))
			"####" "#" 0 ACS_NamedExecuteWithResult("DnD Molten Boulder Damage", 0)
			"####" "#" 0 A_ChangeVelocity(spd2 * cos(angle), spd2 * sin(angle), velz, CVF_REPLACE)
			"####" "#" 0 A_CountDown
			"####" "#" 1 Light("MoltenBoulderLight") A_SpawnItemEx("Spell_BoulderFireFX", frandom(-r, r), frandom(-r ,r), frandom(r / 2, 2 * r), frandom(-2, 2), frandom(-2, 2), frandom(-2, 2))
			"####" "#" 0 A_GiveInventory("Spell_BoulderPusher", 1)
			"####" "#" 0 A_SpawnItemEx("Spell_MoltenBoulderActorCheck", 0, 0, 0, CMF_TRACKOWNER | CMF_AIMDIRECTION)
			"####" "#" 0 ACS_NamedExecuteAlways("DnD Spell Boulder Stall")
			"####" "####" 0 A_SpawnItemEx("Spell_BoulderFireFX", frandom(-r, r), frandom(-r ,r), frandom(r / 2, 2 * r), frandom(-2, 2), frandom(-2, 2), frandom(-2, 2))
			"####" "#" 0 ACS_NamedExecuteWithResult("DnD Molten Boulder Damage", 0)
			"####" "#" 0 A_ChangeVelocity(spd2 * cos(angle), spd2 * sin(angle), velz, CVF_REPLACE)
			"####" "#" 0 A_CountDown
			"####" "#" 1 Light("MoltenBoulderLight") A_SpawnItemEx("Spell_BoulderFireFX", frandom(-r, r), frandom(-r ,r), frandom(r / 2, 2 * r), frandom(-2, 2), frandom(-2, 2), frandom(-2, 2))
			"####" "#" 0 A_GiveInventory("Spell_BoulderPusher", 1)
			"####" "####" 0 A_SpawnItemEx("Spell_BoulderFireFX", frandom(-r, r), frandom(-r ,r), frandom(r / 2, 2 * r), frandom(-2, 2), frandom(-2, 2), frandom(-2, 2))
			"####" "#" 0 ACS_NamedExecuteWithResult("DnD Molten Boulder Damage", 0)
			"####" "#" 0 A_ChangeVelocity(spd2 * cos(angle), spd2 * sin(angle), velz, CVF_REPLACE)
			"####" "#" 0 A_CountDown
			"####" "#" 1 Light("MoltenBoulderLight") A_SpawnItemEx("Spell_BoulderFireFX", frandom(-r, r), frandom(-r ,r), frandom(r / 2, 2 * r), frandom(-2, 2), frandom(-2, 2), frandom(-2, 2))
			"####" "#" 0 A_GiveInventory("Spell_BoulderPusher", 1)
			"####" "#" 0 A_JumpIfInventory("Spell_MoltenBoulderStall", 1, "ShatterCheck")
			"####" "#" 0 A_JumpIf(z - floorz > 64, "SpawnLoop")
			// frame setting
			"####" "#" 0 A_JumpIfInventory("Spell_BoulderFrame", 3, "FrameD2")
			"####" "#" 0 A_JumpIfInventory("Spell_BoulderFrame", 2, "FrameC2")
			"####" "#" 0 A_JumpIfInventory("Spell_BoulderFrame", 1, "FrameB2")
		Goto FrameA2
		ShatterCheck:
			"####" "#" 0 A_JumpIfInventory("Spell_MoltenBoulderStall_Actor", 1, "Shatter")
		goto SpawnLoopNoBump
		Shatter:
		Death:
			TNT1 A 0 A_Stop
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Molten Boulder Damage", 1)
			// Rank 10. Called unconditionally and gated inside the script, so this state keeps
			// the exact shape it had rather than growing a branch through its FX run.
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Molten Boulder Shards")
			TNT1 A 0 A_StopSound(5)
			TNT1 A 0 A_PlaySound("Spell/MoltenBoulderShatter", 7)
			TNT1 A 0 A_PlaySound("MeteorLauncher/HitSmall", 6)
			TNT1 AAAAAAAA 0 A_SpawnItemEx("Spell_BoulderFireFX", frandom(-r, r), frandom(-r ,r), frandom(0, 2 * r), frandom(-2, 2), frandom(-2, 2), frandom(-2, 2))
			TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("Spell_MoltenBoulderParts_1", frandom(-16.0, 16.0), frandom(-16.0, 16.0), frandom(0, 56), frandom(-mprj_vel1, mprj_vel1), frandom(-mprj_vel1, mprj_vel1), frandom(0, mprj_vel1))
			TNT1 AAAAAAAAAAA 0 A_SpawnItemEx("Spell_MoltenBoulderParts_2", frandom(-16.0, 16.0), frandom(-16.0, 16.0), frandom(0, 56), frandom(-mprj_vel2, mprj_vel2), frandom(-mprj_vel2, mprj_vel2), frandom(0, mprj_vel2))
			TNT1 AAAAA 0 A_CustomMissile("RocketSmoke", 0, 0, random(0, 360), 2, random(0, 180))
			TNT1 AAAAAAAA 0 A_CustomMissile("RocketSmoke", 0, 0, random(0, 360), 2, random(0, 360))
			TNT1 A 1 A_Quake(6, 17, 0, 384)
		Stop
		
		// frame management
		FrameA:
			S002 A 0
		Goto SpawnLoop
		FrameB:
			S002 B 0
		Goto SpawnLoop
		FrameC:
			S002 C 0
		Goto SpawnLoop
		FrameD:
			S002 D 0
		Goto SpawnLoop
		
		FrameA2:
			S002 A 0
		Goto SpawnLoopNoBump
		FrameB2:
			S002 B 0
		Goto SpawnLoopNoBump
		FrameC2:
			S002 C 0
		Goto SpawnLoopNoBump
		FrameD2:
			S002 D 0
		Goto SpawnLoopNoBump
		
	}
}

Actor Spell_BoulderFrame : Inventory {
	inventory.maxamount 4
}

Actor Spell_BoulderFrameTimer : Inventory {
	inventory.maxamount 3
}

Actor Spell_BoulderFrameSetter : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_GiveInventory("Spell_BoulderFrameTimer", 1)
			TNT1 A 0 A_JumpIfInventory("Spell_BoulderFrameTimer", 0, "FrameUp")
		Stop
		FrameUp:
			TNT1 A 0 A_TakeInventory("Spell_BoulderFrameTimer", 0)
			TNT1 A 0 A_GiveInventory("Spell_BoulderFrame", 1)
			TNT1 A 0 A_JumpIfInventory("Spell_BoulderFrame", 0, "FrameReset")
		Stop
		FrameReset:
			TNT1 A 0 A_TakeInventory("Spell_BoulderFrame", 0)
		Stop
	}
}

Actor Spell_BoulderFrameSetter2 : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_TakeInventory("Spell_BoulderFrameTimer", 0)
			TNT1 A 0 A_GiveInventory("Spell_BoulderFrame", 1)
			TNT1 A 0 A_JumpIfInventory("Spell_BoulderFrame", 0, "FrameReset")
		Stop
		FrameReset:
			TNT1 A 0 A_TakeInventory("Spell_BoulderFrame", 0)
		Stop
	}
}

Actor Spell_BoulderPushCounter : Inventory {
	inventory.maxamount 5
}

Actor Spell_BoulderPusher : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_GiveInventory("Spell_BoulderPushCounter", 1)
			TNT1 A 0 A_JumpIfInventory("Spell_BoulderPushCounter", 0, "Push")
		Stop
		Push:
			TNT1 A 0 A_TakeInventory("Spell_BoulderPushCounter", 0)
			TNT1 A 0 A_RadiusThrust(256, 128, RTF_NOIMPACTDAMAGE)
		Stop
	}
}

Actor Spell_BoulderFireFX {
	+CLIENTSIDEONLY
	+NOINTERACTION 
	+NOTONAUTOMAP
	+FORCEXYBILLBOARD
	RenderStyle Add
	Alpha 0.625
	Scale 0.275
	States {
		Spawn:
			TNT1 A 2 NoDelay Thing_ChangeTID(0, SPECIAL_FX_TID)
			TNT1 A 0 A_Jump(256, "One", "Two")
		One:
			X007 CDE 1 Bright 
			X007 FGHIJ 1 Bright 
		Stop
		Two:
			X007 MNO 1 Bright 
			X007 PQRST 1 Bright 
		Stop		
	}
}

Actor Spell_MoltenBoulderStall : DnD_Boolean { }

Actor Spell_MoltenBoulderStall_Actor : DnD_Boolean { }

// The wall-ahead probe. Flies forward from the boulder and, if it strikes geometry within its two
// tics, hands the boulder its stall token so the next ShatterCheck shatters it. THRUACTORS and
// Damage 0 so only geometry stops it; Radius/Height match the boulder, so it only catches what the
// boulder itself would hit.
//
// A_GiveToTarget reaches the BOULDER: InitSpawnedItem sets a non-TRANSFERPOINTERS spawn's target to
// the spawner, and only walks it up to the spawner's own target when the spawner is a missile,
// which the boulder is not.
//
// The fourth argument is A_CustomMissile's flag slot, not A_SpawnItemEx's -- here it is xvel, so
// CMF_TRACKOWNER | CMF_AIMDIRECTION lands as a forward speed of 6. Left exactly as it was: it
// works, but the reach is only ~12 units against a boulder moving 12-16 a tic.
Actor Spell_MoltenBoulderActorCheck {
	PROJECTILE
	Speed 32
	Radius 36
	Height 64
	Damage 0
	+DONTBLAST
	+THRUACTORS
	States {
		Spawn:
			TNT1 A 2
		Stop
		Death:
			TNT1 A 1 A_GiveToTarget("Spell_MoltenBoulderStall_Actor", 1)
		Stop
	}
}

Actor Spell_MoltenBoulderParts_1 {
	PROJECTILE
	Height 14
	Radius 7
	Speed 25
	Damage (0)
	BounceSound "MeteorLauncher/Bounce"
	BounceType Doom
	BounceCount 4
	Gravity 0.66
	-NOGRAVITY
	+THRUACTORS
	+CLIENTSIDEONLY
	States {
		Spawn:
			TNT1 A 0 NoDelay A_Jump(256, "1", "2", "3")
		1:
			S002 E 1
		Loop
		2:
			S002 F 1
		Loop
		3:
			S002 G 1
		Loop
		Death:
			"####" "#" 0 A_ChangeVelocity(0, 0, 0)
			"####" "#" 0 A_ChangeFlag("NOGRAVITY", 1)
			"####" "###################" 1 A_FadeOut(0.05)
		Stop
	}
}

Actor Spell_MoltenBoulderParts_2 : Spell_MoltenBoulderParts_1 {
	Height 8
	Radius 4
	Speed 18
	States {
		Spawn:
			TNT1 A 0 NoDelay A_Jump(256, "1", "2")
		1:
			S002 H 1
		Loop
		2:
			S002 I 1
		Loop
		Death:
			"####" "#" 0 A_ChangeVelocity(0, 0, 0)
			"####" "#" 0 A_ChangeFlag("NOGRAVITY", 1)
			"####" "###################" 1 A_FadeOut(0.05)
		Stop
	}
}

// ---- the two damagers -----------------------------------------------------------------------
// DnD_SpellExplosive now, so they inherit the whole user_exp* contract and resolve their numbers
// from the spell table. The old file packed 24 / 256 damage and 96 / 192 radius in by hand; those
// are SPELLVAL_DAMAGE, SPELLVAL_DAMAGE2 and SPELLVAL_RADIUS on SPL_MOLTENBOULDER_S.
//
// Speed 0 and THRUACTORS so a damager sits where the boulder dropped it and hits nothing by
// contact -- every point of its damage is the radius blast.

// Zero tic SpawnState into the INHERITED Death, which is where "DnD Spell Explosion Setup" runs.
// No arguments means SPELLVAL_DAMAGE at the full radius. Jumped explicitly rather than fallen
// through: fallthrough only reaches the next state in THIS block, not an inherited one.
Actor Spell_MoltenBoulder_Roll : DnD_SpellExplosive {
	Speed 0
	+THRUACTORS
	States {
		SpawnState:
			TNT1 A 0
		Goto Death
		ContinueFromExplosion:
			TNT1 A 1
		Stop
	}
}

// The impact blast: DAMAGE2, and 200% of the radius. That is the same relationship the old file
// spelled out as 256 over 192 units against the roll damager's 24 over 96.
Actor Spell_MoltenBoulder_Bump : Spell_MoltenBoulder_Roll {
	// Death ONLY. SpawnState and ContinueFromExplosion are inherited unchanged, and the parent's
	// "Goto Death" resolves to this override because DECORATE binds labels in the derived class.
	States {
		Death:
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Spell Explosion Setup", SPELLVAL_DAMAGE2, 200)
		Goto DoExplosionDamage
	}
}

// Rank 10's six: real Pyroblasts, priced at the caster's own Pyroblast rank. The burst script
// floors that at 1 and writes it to user_rankat, which is the only thing this actor adds -- the
// damage expression, the burst and the visuals are all inherited unchanged.
//
// ContinueFromExplosion is overridden to swallow Pyroblast's own rank 10 cascade. These ARE that burst,
// and they carry a Pyroblast rank, so without this each of the six would throw eight tiny
// fireballs of its own -- 48 extra projectiles from one shatter.
Actor Spell_MoltenBoulder_Shard : Spell_Pyroblast {
	var int user_rankat;
	States {
		// ContinueFromExplosion, NOT FinishExplosion: the threshold jump that starts the cascade
		// sits at the top of this state. Same visuals, without the jump, then out through the
		// inherited FinishExplosion as the base contract asks.
		ContinueFromExplosion:
			T000 CDEFGH 3 Bright
		Goto FinishExplosion
	}
}
