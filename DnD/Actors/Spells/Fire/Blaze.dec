// What the Blaze trace leaves at the impact point. It draws nothing -- the visible hit is
// Spell_Blaze_HitFXSpawner, given to whatever was struck -- and exists only so the cast has something
// with a tid to measure from. ALWAYSPUFF so a trace that hits nothing still produces one at max range
// rather than leaving that tid unfilled, and PUFFONACTORS so a hit on a monster lands it on the
// monster instead of carrying through to the wall behind.
Actor Spell_BlazePuff {
    // The inflictor of a hitscan is its puff, so both of these have to be here -- see DnD_Spell.
    // 65536 is DND_DAMAGEFLAG_ISSPELL.
    Stamina 65536

    // The element. LineAttack is called with a damage type of "None", which means "use the puff's
    // own", so this is what a fire resistance or immunity on the target actually meets.
    DamageType "Fire"
    +NOBLOCKMAP
    +NOGRAVITY
    +NOINTERACTION
    +DONTSPLASH
    +ALWAYSPUFF
    +PUFFONACTORS
    RenderStyle None
    Radius 1
    Height 1
    States {
        Spawn:
            TNT1 A 1
        Stop
    }
}

Actor Spell_Blaze_HitFXSpawner : DnD_Activator {
    States {
        Pickup:
            TNT1 A 0 A_SpawnItemEx("BlazeHitFX1", radius / 2, 0, height / 2)
        Stop
    }
}

Actor Spell_Blaze_HitFXSpawner_Tic : DnD_Activator {
    States {
        Pickup:
            TNT1 AAAA 0 A_SpawnItemEx("BlazeHitFX2", frandom(-radius / 2, radius / 2), frandom(-radius / 2, radius / 2), frandom(height / 2, height * 4 / 5), frandom(-1.25, 1.25), frandom(-1.25, 1.25), frandom(0.5, 1.5))
        Stop
    }
}

Actor BlazeHitFX1 {
    Alpha 0.95
    Renderstyle Add
    +NOINTERACTION
    +CLIENTSIDEONLY
    States {
        Spawn:
            TNT1 A 1
            TNT1 A 0 A_PlaySound("MagicExplosion")
            D4FX GHI 4 Bright
            D4FX JK 3 Bright
            D4FX L 2 Bright
        Stop
    }
}

Actor BlazeHitFX2 {
    RenderStyle Add
    Alpha 0.95
	+NOINTERACTION
    +CLIENTSIDEONLY
	States {
		Spawn:
			TNT1 A 0 NoDelay A_PlaySound("vile/firecrkl", CHAN_WEAPON)
			FIRR AAAAAAAAAAAAAA 1 Bright A_FadeIn(0.07)
			FIRR BCDEFGH 3 Bright
		Stop
	}
}