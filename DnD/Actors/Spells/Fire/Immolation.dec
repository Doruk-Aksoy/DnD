// Immolation's fire. Surrounds the player for as long as the spell is running.

// The marker. Its PRESENCE is the effect -- whatever turns Immolation on gives it, whatever turns it
// off takes it, and the attachment below stops the moment it goes.
Actor DnD_ImmolationActive : DnD_Boolean {}

// The token that raises it. A CustomInventory, so its Pickup state runs with the PLAYER as self on
// every machine that receives the item.
//
// WithResult, not Always: the former runs inline and keeps the player as activator, which is the only
// thing the spawner has to aim the effect at. Always starts a detached script and loses it.
Actor Spell_Immolation_FXSpawner : DnD_Activator {
    States {
        Pickup:
            TNT1 A 1 ACS_NamedExecuteWithResult("DnD Spawn Player Aura", PLAYERFX_IMMOLATION)
        Stop
    }
}

// One flame. Built exactly like Ultimatum_RagingDead_FireFX -- four sheets picked at random so a
// cluster does not animate in lockstep -- at a slightly smaller scale, since this rings a player
// rather than engulfing a raging dead.
Actor Spell_ImmolationFireFX {
    Scale 0.45
    Renderstyle Add
    Alpha 0.9
    +NOINTERACTION
    +CLIENTSIDEONLY
    +NOTONAUTOMAP
    States {
        Spawn:
            TNT1 A 0 NoDelay A_Jump(256, "1", "2", "3", "4")
        1:
            X052 ABCDEFGHIJKLMNOPQRS 2 Bright
        Stop
        2:
            X053 ABCDEFGHIJKLMNOPQRSTU 2 Bright
        Stop
        3:
            X054 ABCDEFGHIJKLMNOPQRS 2 Bright
        Stop
        4:
            X056 ABCDEFGHIJKLMNOPQR 2 Bright
        Stop
    }
}

// Invisible itself -- it rides the player and throws the flames.
//
// One every 4 tics against their own ~40 tic life keeps roughly ten burning at a time, which is the
// "surrounded with fire" the spell describes and deliberately denser than Boiling Blood's spheres.
// The consts are the knobs: rate for how many, spread for how wide, lo/hi for how tall.
//
// spread TRACKS the radius: "DnD Immolation Spread" returns it in units, keeping the same share of
// the radius that this fallback has of the base 96, so ranking up widens the field the player is
// standing in instead of only reaching further to deal damage. The const is the fallback for when
// that script cannot resolve a caster, and must stay equal to DND_IMMOLATION_SPREAD.
Actor Spell_ImmolationFX {
    var int user_spread;
    +CLIENTSIDEONLY
    +NOINTERACTION
    +NOTONAUTOMAP

    const float spread = 40.0;
    const float lo = 0.0;
    const float hi = 44.0;

    States {
        // One tic, not zero. The actor has to survive to its first Tick for NoDelay to fire, and a
        // zero length spawn frame that does not jump is gone before anything sees it.
        Spawn:
            TNT1 A 1 NoDelay A_JumpIfInTargetInventory("DnD_ImmolationActive", 1, "Active")
        Stop

        Active:
            // Re-read every cycle rather than once, so a rank or gear change widens the field
            // without having to toggle the spell off and on.
            TNT1 A 0 A_SetUserVar("user_spread",
                ACS_NamedExecuteWithResult("DnD Immolation Spread"))
            TNT1 A 4 A_Warp(AAPTR_TARGET, 0, 0, 0, 0,
                WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
            TNT1 A 0 A_SpawnItemEx("Spell_ImmolationFireFX",
                frandom(-user_spread, user_spread), frandom(-user_spread, user_spread),
                frandom(lo, hi), 0, 0, 0, 0, SXF_NOCHECKPOSITION)
            TNT1 A 0 A_JumpIfInTargetInventory("DnD_ImmolationActive", 1, "Active")
        Stop
    }
}
