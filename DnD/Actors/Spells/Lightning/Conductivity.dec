// Conductivity's curse marker: frame C of the curse row (FlammabilityFXMarker).
Actor ConductivityFXMarker : FlammabilityFXMarker {
	States {
		SpawnLoop:
			CM1O C 0
		Goto CurseJoin
	}
}

// The ring drawn where the curse lands, in crackles.
Actor ConductivityAreaMarkerFX : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.9
	Scale 0.35
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NOGRAVITY
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 Thing_ChangeTID(0, SPECIAL_FX_TID)
			FAXE STUVWX 2 Bright
		Stop
	}
}
