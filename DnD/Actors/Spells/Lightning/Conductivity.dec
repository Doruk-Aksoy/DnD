// Conductivity's curse marker over a cursed enemy, on Flammability's warp loop.
Actor ConductivityFXMarker : FlammabilityFXMarker {
	States {
		SpawnLoop:
			S211 A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass + 24.0, 0, WARPF_INTERPOLATE | WARPF_ABSOLUTEANGLE | WARPF_NOCHECKPOSITION)
		Loop
	}
}

// The ring drawn where the curse lands, in crackles.
Actor ConductivityAreaMarkerFX : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.9
	Scale 0.35
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NOGRAVITY
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 Thing_ChangeTID(0, SPECIAL_FX_TID)
			FAXE STUVWX 2 Bright
		Stop
	}
}
