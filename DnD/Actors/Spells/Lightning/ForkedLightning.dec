// A Forked Lightning beam: ACS aims and stretches it, the shader draws the curving bolt and its branches.
Actor Spell_ForkedLightning_Beam {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 1.0
	States {
		Spawn:
			FKBM A 5 Bright
		Fade:
			FKBM A 1 Bright A_FadeOut(0.2)
		Loop
	}
}

// Where a Forked Lightning beam lands.
Actor Spell_ForkedLightning_Hit {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 0.9
	Scale 0.6
	States {
		Spawn:
			FAXE R 2 Bright Light("ForkedLightningHit1")
			FAXE S 2 Bright Light("ForkedLightningHit2")
			FAXE TUVWX 2 Bright
		Stop
	}
}
