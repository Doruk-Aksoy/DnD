// The caster's size and solid like them: it fails to spawn where an actor would overlap them. Players pass through it.
Actor DnD_BlinkProbe {
	Radius 16
	Height 56
	Species "Player"
	+THRUSPECIES
	+SOLID
	+CANPASS
	+NOGRAVITY
	+DONTSPLASH
	+NOTONAUTOMAP
	+SERVERSIDEONLY
	States {
		Spawn:
			TNT1 A 1
		Stop
	}
}

// Blink's streak along the dash: ACS aims and stretches it, the shader draws the curving bolt.
Actor Spell_Blink_Beam {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 1.0
	States {
		Spawn:
			BLKB A 3 Bright
		Fade:
			BLKB A 1 Bright A_FadeOut(0.2)
		Loop
	}
}

// Where Blink leaves and arrives: a crackle with a flash.
Actor Spell_Blink_Burst {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 0.9
	Scale 0.7
	States {
		Spawn:
			FAXE R 2 Bright Light("BlinkFlash1")
			FAXE S 2 Bright Light("BlinkFlash2")
			FAXE TUVWX 2 Bright
		Stop
	}
}
