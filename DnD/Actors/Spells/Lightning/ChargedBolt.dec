// Wanders toward where it was thrown, re-aimed every few tics. Walls, floors and ceilings bounce it; rank 10 adds enemies.
Actor Spell_ChargedBolt : DnD_Spell {
	Speed 10
	Radius 8
	Height 16
	Scale 0.36
	RenderStyle Add
	Alpha 1.0
	DamageType "Lightning"
	BounceSound "ChargedBolt/Bounce"
	DeathSound "ChargedBolt/Hit"
	Damage(ACS_NamedExecuteWithResult("DnD Spell Damage", SPELLVAL_DAMAGE))
	BounceFactor 1.0
	WallBounceFactor 1.0
	+BOUNCEONWALLS
	+BOUNCEONFLOORS
	+BOUNCEONCEILINGS
	+CANBOUNCEWATER
	+FORCEXYBILLBOARD
	+DONTSPLASH

	States {
		SpawnState:
			TNT1 A 0 A_JumpIf(user_spellrank < DND_SPELL_THRESH_HIGH, "Fly")
			TNT1 A 0 A_ChangeFlag("BOUNCEONACTORS", true)
			TNT1 A 0 A_ChangeFlag("ALLOWBOUNCEONACTORS", true)
			TNT1 A 0 A_PlaySound("ChargedBolt/Loop", CHAN_5, 1.0, true)
		// Each step drifts the heading, then throws it sideways off it; the frame letter is the shader's seed.
		Fly:
			TNT1 A 0 A_SetAngle(angle + frandom(-14.0, 14.0))
			TNT1 A 0 A_ChangeVelocity(frandom(8.0, 12.0), frandom(-8.0, 8.0), velz * 0.6 + frandom(-1.5, 1.5), CVF_RELATIVE | CVF_REPLACE)
			TNT1 A 0 A_SpawnItemEx("Spell_ChargedBolt_Spark", 0, 0, 0, frandom(-4.0, 4.0), frandom(-4.0, 4.0), frandom(0.0, 4.0), 0, 128, 96)
			TNT1 A 0 A_Jump(256, "FA", "FB", "FC", "FD", "FE", "FF", "FG", "FH")
		FA:
			LGCB A 3 Bright
		Goto Turn
		FB:
			LGCB B 3 Bright
		Goto Turn
		FC:
			LGCB C 3 Bright
		Goto Turn
		FD:
			LGCB D 3 Bright
		Goto Turn
		FE:
			LGCB E 3 Bright
		Goto Turn
		FF:
			LGCB F 3 Bright
		Goto Turn
		FG:
			LGCB G 3 Bright
		Goto Turn
		FH:
			LGCB H 3 Bright
		Goto Turn
		Turn:
			TNT1 A 0 A_CountDown
		Goto Fly
		Death:

			TNT1 A 0 A_StopSound(CHAN_5)
			TNT1 A 0 A_SpawnItemEx("Spell_ChargedBolt_Burst", 0, 0, 0, 0, 0, 0, 0, 128)
			TNT1 A 1
		Stop
	}
}

// Flecks the bolt spits as it crackles, white and blue in turn, gone in a few tics.
Actor Spell_ChargedBolt_Spark : WhiteMagicSpark {
	Scale 0.016
	Gravity 0.3
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 Thing_ChangeTID(0, SPECIAL_FX_TID)
		SpawnLoop:
			OGLP F 1 Bright A_FadeOut(0.14)
			OGLP D 1 Bright A_FadeOut(0.14)
		Loop
	}
}

// Where a bolt ends: its crackle swells and fades under a flash, throwing sparks.
Actor Spell_ChargedBolt_Burst {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+FORCEXYBILLBOARD
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 1.0
	Scale 0.42
	States {
		Spawn:
			TNT1 A 0 NoDelay A_SpawnItemEx("Spell_ChargedBolt_Spark", 0, 0, 0, frandom(-5.0, 5.0), frandom(-5.0, 5.0), frandom(1.0, 5.0))
			TNT1 A 0 A_SpawnItemEx("Spell_ChargedBolt_Spark", 0, 0, 0, frandom(-5.0, 5.0), frandom(-5.0, 5.0), frandom(1.0, 5.0))
			TNT1 A 0 A_SpawnItemEx("Spell_ChargedBolt_Spark", 0, 0, 0, frandom(-5.0, 5.0), frandom(-5.0, 5.0), frandom(1.0, 5.0))
			TNT1 A 0 A_SpawnItemEx("Spell_ChargedBolt_Spark", 0, 0, 0, frandom(-5.0, 5.0), frandom(-5.0, 5.0), frandom(1.0, 5.0))
			LGCB C 2 Bright Light("ChargedBoltBurst1")
			TNT1 A 0 A_SetScale(0.52)
			LGCB F 2 Bright Light("ChargedBoltBurst2")
			TNT1 A 0 A_SetScale(0.6)
			TNT1 A 0 A_SetTranslucent(0.6, 1)
			LGCB B 2 Bright Light("ChargedBoltBurst3")
			TNT1 A 0 A_SetTranslucent(0.3, 1)
			LGCB H 2 Bright Light("ChargedBoltBurst4")
		Stop
	}
}
