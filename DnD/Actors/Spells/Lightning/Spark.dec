// The burst on each enemy a zap hits.
Actor Spell_Spark_Hit {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 1.0
	Scale 0.2275
	States {
		Spawn:
			TNT1 A 0 NoDelay A_SetAngle(random(0, 359))
			TNT1 A 0 A_Jump(256, "O1", "O2", "O3")
		O1:
			SPZB A 1 Bright
			TNT1 A 0 A_SetScale(0.455)
			SPZB C 1 Bright
			TNT1 A 0 A_SetScale(0.65)
			SPZB E 1 Bright
			TNT1 A 0 A_SetScale(0.637)
