// On one enemy: its resist traits stripped (2 at rank 10, more damage from the types it resisted) and the clock.
Actor DnD_ResistStripped : DnD_Info {}
Actor DnD_ResistStrippedTimer : DnD_Info {}

// Remove Resist's swirl round a stripped enemy's feet (S028), off the curse row: score units toward this client's player, mass up.
// "DnD Attachment Face Viewer" keeps its angle on that player; it warps along its own angle.
Actor RemoveResistFXMarker : DnD_AttachedFXBase {
	RenderStyle Add
	Alpha 0.9
	Scale 0.7
	States {
		SpawnLoop:
			S028 AABBCCDDEEFFGGHHIIJJKKLLMMNNOOPP 1 Bright A_Warp(AAPTR_TARGET, score, 0, mass, 0, WARPF_INTERPOLATE | WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
		Loop
	}
}

// The ring drawn round the target from rank 5, in amber sparks.
Actor RemoveResistAreaMarkerFX : NoxAreaMarkerFX {
	Translation "80:111=%[0.00,0.00,0.00]:[1.70,1.10,0.30]"
}
