// On one enemy: Contagion's tick, its caster + 1 and the half seconds left.
Actor DnD_ContagionBase : DnD_Info {}
Actor DnD_ContagionOwner : DnD_Info {}
Actor DnD_ContagionTimer : DnD_Info {}
// Rank 10: Timer() until which the DoTs it carried onto an enemy ignore shields and fortification.
Actor DnD_ContagionPierce : DnD_Info {}

// The rune circle under the zone and round a dead host: flat2.md3 under CONTAGRN (Contagion.fp). ACS sizes it by ScaleX
// and spreads it by its alpha (0.1 whole).
Actor ContagionRuneCircle {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Translucent
	Alpha 0
	States {
		Spawn:
			CTGR A -1 Bright
		Stop
	}
}

// Client side, on an enemy under Contagion or Essence Theft: how long its purple smoke still rises.
Actor DnD_DotSmokeTimer : DnD_Info {}

// Purple smoke seeping off an enemy wasting under Contagion or Essence Theft.
Actor DnD_DotSmokeFX : DnD_SpecialFX {
	RenderStyle Translucent
	Alpha 0
	Scale 0.3
	+FORCEXYBILLBOARD
	Translation "0:255=%[0.00,0.00,0.00]:[1.10,0.30,1.70]"
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_ChangeVelocity(frandom(-0.3, 0.3), frandom(-0.3, 0.3), frandom(0.6, 1.2), CVF_REPLACE)
			SMOK ABC 2 A_FadeIn(0.16)
			SMOK DEFGHIJKLNOPQ 2 A_FadeOut(0.036)
		Stop
	}
}

// Motes rising off the zone's floor.
Actor ContagionMoteFX : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.7
	Scale 0.3
	Translation "0:255=%[0.00,0.00,0.00]:[1.17,0.10,1.87]"
	+NOGRAVITY
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_ChangeVelocity(0, 0, frandom(0.5, 1.2), CVF_REPLACE)
			D5FX GHIJKL 4 Bright A_FadeOut(0.06)
		Stop
	}
}
