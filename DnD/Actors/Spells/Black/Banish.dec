// On one enemy: tics left out of this realm and its banisher + 1.
Actor DnD_BanishedTimer : DnD_Info {}
Actor DnD_BanishOwner : DnD_Info {}

// Gone and back: unshootable and unsolid while away. ACS cannot set flags in Zandronum, so items do.
Actor DnD_BanishOut : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_ChangeFlag("SHOOTABLE", 0)
			TNT1 A 0 A_ChangeFlag("SOLID", 0)
		Stop
	}
}

Actor DnD_BanishIn : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_ChangeFlag("SHOOTABLE", 1)
			TNT1 A 0 A_ChangeFlag("SOLID", 1)
		Stop
	}
}

Actor Spell_Banish_Poof : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.9
	Scale 0.9
	Translation "0:255=%[0.00,0.00,0.00]:[0.30,0.50,1.90]"
	States {
		Spawn:
			TNT1 A 0
			D4FX GHIJKL 3 Bright
		Stop
	}
}
