// The plague on one enemy: its tick before potency, potency in percent, half seconds left, the caster + 1, the ticker refcount.
Actor DnD_PlagueBase : DnD_Info {}
Actor DnD_PlaguePotency : DnD_Info {}
Actor DnD_PlagueTimer : DnD_Info {}
Actor DnD_PlagueOwner : DnD_Info {}
Actor DnD_PlagueScripts : DnD_Info {}
// Client side: tics its motes keep rising.
Actor DnD_PlagueFXTimer : DnD_Info {}

// A mote of sickness drifting up off a plagued enemy, or along a spread's trail.
Actor Spell_Plague_Mote : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0
	Scale 0.22
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_ChangeVelocity(frandom(-0.3, 0.3), frandom(-0.3, 0.3), frandom(0.4, 1.0), CVF_REPLACE)
			D5FX GGGG 1 Bright A_FadeIn(0.15)
			D5FX HHIIJJKKLL 2 Bright A_FadeOut(0.05)
		Wait
	}
}

// The puff of plague as it takes hold.
Actor Spell_Plague_Burst : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.15
	Scale 0.75
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_ChangeVelocity(0, 0, frandom(0.2, 0.85), CVF_REPLACE)
			TNT1 A 0 A_PlaySound("Plague/Burst")
			S022 AAAABB 1 Bright A_FadeIn(0.15)
			S022 B 2 Bright
			S022 CD 4 Bright
			S022 EEEEFFFF 1 Bright A_FadeOut(0.05)
		Wait
	}
}
