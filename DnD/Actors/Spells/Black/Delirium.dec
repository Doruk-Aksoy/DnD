// On one enemy: delirious (2 at rank 10, double damage to other monsters), its clock, and its curser + 1.
Actor DnD_Delirious : DnD_Info {}
Actor DnD_DeliriousTimer : DnD_Info {}
Actor DnD_DeliriumOwner : DnD_Info {}

// Delirium's wisps on a delirious enemy, off the curse row: rising from score units toward this client's player, mass up.
// "DnD Attachment Face Viewer" keeps its angle on that player; it warps along its own angle.
Actor DeliriumFXMarker : DnD_AttachedFXBase {
	RenderStyle Add
	Alpha 0.9
	Scale 0.35
	States {
		SpawnLoop:
			S025 AABBCCDDEEFFGGHHIIJJKKLLMMNNOOPPQQRRSSTT 1 Bright A_Warp(AAPTR_TARGET, score, 0, mass, 0, WARPF_INTERPOLATE | WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
		Loop
	}
}

// While delirious its kin may hurt it and its splash may hurt them; ACS gives back each flag it had (Off items).
Actor DnD_DeliriumKinOn : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_ChangeFlag("DOHARMSPECIES", 1)
			TNT1 A 0 A_ChangeFlag("DONTHARMSPECIES", 0)
			TNT1 A 0 A_ChangeFlag("DONTHURTSPECIES", 0)
		Stop
	}
}

Actor DnD_DeliriumKinOffDo : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_ChangeFlag("DOHARMSPECIES", 0)
		Stop
	}
}

Actor DnD_DeliriumKinOffDont : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_ChangeFlag("DONTHARMSPECIES", 1)
		Stop
	}
}

Actor DnD_DeliriumKinOffClass : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_ChangeFlag("DONTHURTSPECIES", 1)
		Stop
	}
}
