// The curse balls of Subjugate, Transmogrify, Life Tap and Banish. No hit damage: "DnD Curse Ball Hit" reads the spell off the
// ball, and the enemy it struck off its tracer (HITTRACER, from DnD_BaseProjectile).
Actor Spell_CurseBall : DnD_Spell {
	PROJECTILE
	Speed 24
	Radius 8
	Height 12
	Damage 0
	RenderStyle Add
	Alpha 0.9
	Scale 0.5
	SeeSound "UndeadSoul/See"
	DeathSound "UndeadSoul/Die"
	States {
		SpawnState:
			D5FX G 2 Bright A_SpawnItemEx("Spell_CurseBall_Trail", -8, 0, 0, 0, 0, 0, 0, 129)
		Loop
		Death:
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Curse Ball Hit")
			D4FX GHIJKL 2 Bright
		Stop
	}
}

// Its trail takes the ball's colour (SXF_TRANSFERTRANSLATION with the clientside flag).
Actor Spell_CurseBall_Trail : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.6
	Scale 0.25
	States {
		Spawn:
			TNT1 A 0
			D5FX GHIJKL 2 Bright A_FadeOut(0.08)
		Stop
	}
}

// The Arch-Vile's curse orb, tinted red.
Actor Spell_LifeTapBall : Spell_CurseBall {
	Translation "0:255=%[0.00,0.00,0.00]:[1.80,0.20,0.30]"
	Scale 0.75
	DeathSound "LifeTap/Hit"
	States {
		SpawnState:
			HCRS ABCD 2 Bright A_SpawnItemEx("Spell_CurseBall_Trail", -8, 0, 0, 0, 0, 0, 0, 129)
		Loop
		Death:
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Curse Ball Hit")
			HCRS EFGHI 3 Bright
		Stop
	}
}

// The Arch-Vile's fireball in its own orange (its mark's embers are orange too); it carries its tail, so no trail.
Actor Spell_SubjugateBall : Spell_CurseBall {
	Scale 1.0
	States {
		SpawnState:
			GURP AB 3 Bright
		Loop
		Death:
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Curse Ball Hit")
			GURP CDEF 3 Bright
		Stop
	}
}

// The Blood Lich's curse orb, tinted purple.
Actor Spell_BanishBall : Spell_CurseBall {
	Translation "0:255=%[0.00,0.00,0.00]:[1.25,0.35,1.90]"
	Scale 0.6
	DeathSound "Banish/Hit"
	States {
		SpawnState:
			CURS ABCDEF 2 Bright A_SpawnItemEx("Spell_CurseBall_Trail", -8, 0, 0, 0, 0, 0, 0, 129)
		Loop
		Death:
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Curse Ball Hit")
			CURS GHIJKL 3 Bright
		Stop
	}
}
