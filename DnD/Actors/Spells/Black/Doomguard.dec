// Summon: Doomguard (S044): an arc cleave ("DnD Minion Cleave"), its owner's Finger of Death, a shield raised when it flinches.
ACTOR Spell_Doomguard : PetMonsterBase {
	Health 2000
	GibHealth -100
	Radius 26
	Height 76
	Speed 8
	PainChance 40
	Mass 1000
	Scale 0.6
	Stamina 1
	SeeSound "Doomguard/See"
	PainSound "Doomguard/Pain"
	DeathSound "Doomguard/Die"
	ActiveSound "Doomguard/See"
	Obituary "%o was crushed by a Doomguard."
	Tag "Doomguard"
	MeleeRange 96
	var int user_leap;
	var int user_finger;
	var int user_answered;
	var int user_air;
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Pet Monster Scale", 0, DND_PET_DOOMGUARDID, -1, -1)
			// Room to leap: it may stray 896 from its owner before it is brought back.
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Pet Distance Move", 0, 896)
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Doomguard Curse", 0)
			// It rises: the death frames backwards.
			S044 TSRQP 3
		SpawnLoop:
			S044 A 10 A_Look
		Goto See
		See:
			S044 BBCCDDEE 2 A_Chase
		Loop
		Melee:
			TNT1 A 0 A_AlertMonsters(0, AMF_TARGETNONPLAYER)
			// A war cry on half its swings.
			TNT1 A 0 A_Jump(128, 2)
			TNT1 A 0 A_PlaySound("Doomguard/Attack", CHAN_VOICE)
			TNT1 A 0 A_Jump(128, "MeleeWide")
			S044 J 6 A_FaceTarget
			S044 K 5 A_FaceTarget
			TNT1 A 0 A_PlaySound("Sword/Swing", CHAN_WEAPON)
			S044 L 6 ACS_NamedExecuteWithResult("DnD Minion Cleave", MINIONHIT_DOOMMELEE)
			S044 L 4
		Goto See
		MeleeWide:
			S044 M 6 A_FaceTarget
			TNT1 A 0 A_PlaySound("Sword/SWave", CHAN_WEAPON)
			S044 N 4 A_FaceTarget
			S044 O 6 ACS_NamedExecuteWithResult("DnD Minion Cleave", MINIONHIT_DOOMMELEE)
			S044 O 4
		Goto See
		// Rank 5's leap when it is ready and the target in reach, else its Finger of Death when that is ready.
		Missile:
			TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DnD Doomguard Leap"), "Leap")
			TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DnD Doomguard Finger", 1), "Cast")
		Goto See
		Cast:
			TNT1 A 0 A_AlertMonsters(0, AMF_TARGETNONPLAYER)
			S044 V 6 A_FaceTarget
			S044 W 6 A_FaceTarget
			S044 X 8 Bright ACS_NamedExecuteWithResult("DnD Doomguard Finger", 0)
			S044 X 4
		Goto See
		Leap:
			TNT1 A 0 A_AlertMonsters(0, AMF_TARGETNONPLAYER)
			S044 F 6 A_FaceTarget
			S044 F 1 ACS_NamedExecuteWithResult("DnD Doomguard Launch")
			TNT1 A 0 A_ChangeFlag("NOPAIN", 1)
			TNT1 A 0 A_SetUserVar("user_air", 0)
			S044 G 2
		LeapAir:
			S044 G 1 A_CheckFloor("Land")
			S044 G 0 A_SetUserVar("user_air", user_air + 1)
			S044 G 0 A_JumpIf(user_air > 60, "Land")
		Loop
		Land:
			S044 H 4 A_Stop
			TNT1 A 0 A_PlaySound("Doomguard/Land", CHAN_ITEM)
			TNT1 A 0 A_ChangeFlag("NOPAIN", 0)
			S044 H 0 ACS_NamedExecuteWithResult("DnD Doomguard Land")
			S044 H 10
		Goto See
		Pain:
			S044 I 4 A_Pain
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Doomguard Block", 0)
		Block:
			S044 U 66
		Goto See
		Death:
			"####" "#" 0 ACS_NamedExecuteAlways("DnD On Summon Death Check", 0, DND_PET_DOOMGUARDID)
			S044 P 6 A_Scream
			S044 Q 5 A_NoBlocking
			S044 R 5
			S044 S 5
			S044 T 35
			S044 T 1 A_FadeOut(0.05)
		Wait
	}
}

// The landing's ring of dust and fire.
Actor Spell_Doomguard_StompFX : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.8
	Scale 0.7
	Translation "0:255=%[0.00,0.00,0.00]:[1.60,0.70,0.20]"
	States {
		Spawn:
			TNT1 A 0
			D4FX GHIJKL 3 Bright
		Stop
	}
}

// Blocking after a flinch ("DnD Doomguard Block").
Actor DnD_DoomguardBlocking : DnD_Boolean {}
