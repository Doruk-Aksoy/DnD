// The bolt: ACS aims and stretches it, FingerBolt.fp draws the crackling red lightning; its alpha strobes it in and out.
Actor Spell_FingerOfDeath_Beam {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 0.5
	States {
		Spawn:
			FDBM A 1 Bright
			FDBM A 2 Bright A_SetTranslucent(1.0, 1)
			FDBM A 1 Bright A_SetTranslucent(0.3, 1)
			FDBM A 1 Bright A_SetTranslucent(0.95, 1)
			FDBM A 1 Bright A_SetTranslucent(0.55, 1)
			FDBM A 1 Bright A_SetTranslucent(0.15, 1)
			FDBM A 1 Bright A_SetTranslucent(0.45, 1)
			FDBM A 1 Bright A_SetTranslucent(0.08, 1)
		Stop
	}
}

// Where the bolt ends.
Actor Spell_FingerOfDeath_Burst : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.95
	Scale 0.8
	States {
		Spawn:
			TNT1 A 0
			FXPR ABCDEFGHIJKLM 2 Bright
		Stop
	}
}
