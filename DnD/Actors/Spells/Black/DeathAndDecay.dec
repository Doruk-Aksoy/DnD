// The channelled zone's anchor; the wisps across it are client side, while it stands.
Actor Spell_DeathAndDecayZone {
	Radius 8
	Height 8
	RenderStyle None
	+NOINTERACTION
	+NOGRAVITY
	+NOBLOCKMAP
	+DONTSPLASH
	States {
		Spawn:
			TNT1 A 0
			TNT1 A -1
		Stop
		Vanish:
			TNT1 A 2 A_FadeOut(0.25)
		Loop
	}
}

Actor Spell_DeathAndDecayWisp : DnD_SpecialFX {
	RenderStyle Translucent
	Alpha 0.7
	Scale 0.45
	Translation "0:255=%[0.00,0.00,0.00]:[0.35,0.55,0.30]"
	+NOGRAVITY
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_ChangeVelocity(0, 0, frandom(0.8, 1.6), CVF_REPLACE)
			D5FX GHIJKL 4 A_FadeOut(0.05)
		Stop
	}
}
