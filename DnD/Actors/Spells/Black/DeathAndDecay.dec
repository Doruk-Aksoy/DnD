// The channelled zone's anchor; its flames and smoke are client side, while it stands.
Actor Spell_DeathAndDecayZone {
	Radius 8
	Height 8
	RenderStyle None
	+NOINTERACTION
	+NOGRAVITY
	+NOBLOCKMAP
	+DONTSPLASH
	States {
		Spawn:
			TNT1 A 0
			TNT1 A -1
		Stop
		Vanish:
			TNT1 A 2 A_FadeOut(0.25)
		Loop
	}
}

// Its rotting ground: flat2.md3 under DDROT (DeathRot.fp); the FX script sizes it by ScaleX and spreads it by its alpha.
Actor Spell_DeathAndDecayRot {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Translucent
	Alpha 0
	States {
		Spawn:
			DDRT A -1
		Stop
	}
}

// Its fire, rising at random across the zone while channelled: a soft violet flame, a magenta one or a sharp jet.
Actor Spell_DeathAndDecayFlame : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.05
	+NOGRAVITY
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_Jump(256, "Soft", "Soft", "Pink", "Pink", "Sharp")
		Soft:
			TNT1 A 0 A_SetScale(frandom(0.28, 0.4))
			S037 AB 2 Bright A_FadeIn(0.4)
			S037 CDEFGHIJ 2 Bright
		SoftBurn:
			S037 ABCDE 2 Bright
			TNT1 A 0 A_Jump(56, "SoftDie5")
			S037 FGHIJ 2 Bright
			TNT1 A 0 A_Jump(56, "SoftDie0")
		Loop
		SoftDie5:
			S037 FGHIJABCDE 2 Bright A_FadeOut(0.25)
		Loop
		SoftDie0:
			S037 ABCDEFGHIJ 2 Bright A_FadeOut(0.25)
		Loop
		Pink:
			TNT1 A 0 A_SetScale(frandom(0.3, 0.45))
			S038 AB 2 Bright A_FadeIn(0.4)
			S038 CDEFGHIJKLMNO 2 Bright
		PinkBurn:
			S038 ABCDE 2 Bright
			TNT1 A 0 A_Jump(56, "PinkDie5")
			S038 FGHIJ 2 Bright
			TNT1 A 0 A_Jump(56, "PinkDie10")
			S038 KLMNO 2 Bright
			TNT1 A 0 A_Jump(56, "PinkDie0")
		Loop
		PinkDie5:
			S038 FGHIJKLMNOABCDE 2 Bright A_FadeOut(0.25)
		Loop
		PinkDie10:
			S038 KLMNOABCDEFGHIJ 2 Bright A_FadeOut(0.25)
		Loop
		PinkDie0:
			S038 ABCDEFGHIJKLMNO 2 Bright A_FadeOut(0.25)
		Loop
		Sharp:
			TNT1 A 0 A_SetScale(frandom(0.3, 0.5))
			S039 AB 2 Bright A_FadeIn(0.4)
			S039 CDEFGHIJKLMNO 2 Bright
		SharpBurn:
			S039 ABCDE 2 Bright
			TNT1 A 0 A_Jump(56, "SharpDie5")
			S039 FGHIJ 2 Bright
			TNT1 A 0 A_Jump(56, "SharpDie10")
			S039 KLMNO 2 Bright
			TNT1 A 0 A_Jump(56, "SharpDie0")
		Loop
		SharpDie5:
			S039 FGHIJKLMNOABCDE 2 Bright A_FadeOut(0.25)
		Loop
		SharpDie10:
			S039 KLMNOABCDEFGHIJ 2 Bright A_FadeOut(0.25)
		Loop
		SharpDie0:
			S039 ABCDEFGHIJKLMNO 2 Bright A_FadeOut(0.25)
		Loop
	}
}

// Its thick dark smoke, drifting up and swelling as it thins.
Actor Spell_DeathAndDecaySmoke : DnD_SpecialFX {
	RenderStyle Translucent
	Alpha 0.05
	+NOGRAVITY
	var int user_s;
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_SetUserVar("user_s", random(600, 850))
			TNT1 A 0 A_ChangeVelocity(frandom(-0.3, 0.3), frandom(-0.3, 0.3), frandom(0.5, 1.0), CVF_REPLACE)
			S040 A 0 A_FadeIn(0.15)
			S040 A 4 A_SetScale(user_s * 0.0005)
			S040 B 0 A_FadeIn(0.15)
			S040 B 4 A_SetScale(user_s * 0.00052)
			S040 C 0 A_FadeIn(0.15)
			S040 C 4 A_SetScale(user_s * 0.00054)
			S040 D 0 A_FadeIn(0.15)
			S040 D 4 A_SetScale(user_s * 0.00056)
			S040 E 0 A_FadeIn(0.15)
			S040 E 4 A_SetScale(user_s * 0.00058)
			S040 F 4 A_SetScale(user_s * 0.0006)
			S040 G 4 A_SetScale(user_s * 0.00062)
			S040 H 4 A_SetScale(user_s * 0.00064)
			S040 I 4 A_SetScale(user_s * 0.00066)
			S040 J 4 A_SetScale(user_s * 0.00068)
			S040 K 4 A_SetScale(user_s * 0.0007)
			S040 L 4 A_SetScale(user_s * 0.00072)
			S040 M 4 A_SetScale(user_s * 0.00074)
			S040 N 4 A_SetScale(user_s * 0.00076)
			S040 O 4 A_SetScale(user_s * 0.00078)
		Thin:
			S040 A 0 A_FadeOut(0.05)
			S040 A 4 A_SetScale(user_s * 0.0008)
			S040 B 0 A_FadeOut(0.05)
			S040 B 4 A_SetScale(user_s * 0.00082)
			S040 C 0 A_FadeOut(0.05)
			S040 C 4 A_SetScale(user_s * 0.00084)
			S040 D 0 A_FadeOut(0.05)
			S040 D 4 A_SetScale(user_s * 0.00086)
			S040 E 0 A_FadeOut(0.05)
			S040 E 4 A_SetScale(user_s * 0.00088)
			S040 F 0 A_FadeOut(0.05)
			S040 F 4 A_SetScale(user_s * 0.0009)
			S040 G 0 A_FadeOut(0.05)
			S040 G 4 A_SetScale(user_s * 0.00092)
			S040 H 0 A_FadeOut(0.05)
			S040 H 4 A_SetScale(user_s * 0.00094)
			S040 I 0 A_FadeOut(0.05)
			S040 I 4 A_SetScale(user_s * 0.00096)
			S040 J 0 A_FadeOut(0.05)
			S040 J 4 A_SetScale(user_s * 0.00098)
			S040 K 0 A_FadeOut(0.05)
			S040 K 4 A_SetScale(user_s * 0.001)
			S040 L 0 A_FadeOut(0.05)
			S040 L 4 A_SetScale(user_s * 0.00102)
			S040 M 0 A_FadeOut(0.05)
			S040 M 4 A_SetScale(user_s * 0.00104)
			S040 N 0 A_FadeOut(0.05)
			S040 N 4 A_SetScale(user_s * 0.00106)
			S040 O 0 A_FadeOut(0.05)
			S040 O 4 A_SetScale(user_s * 0.00108)
		Stop
	}
}
