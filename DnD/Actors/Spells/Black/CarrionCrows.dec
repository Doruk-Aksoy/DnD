// A crow, flown by "DnD Carrion Crows" through its velocity; it passes through everything.
Actor Spell_CarrionCrow {
	Radius 6
	Height 8
	Scale 0.6
	RenderStyle Translucent
	Alpha 0.9
	+NOINTERACTION
	+NOGRAVITY
	+NOBLOCKMAP
	+DONTSPLASH
	States {
		// a full wingbeat: up, rising, level, down, level, rising
		Spawn:
			S026 ABDCDB 2
		Loop
		Vanish:
			S026 ABDCDB 2 A_FadeOut(0.08)
		Loop
	}
}

// On the caster: which cast's crows fly; a recast bumps it and the old flock stops.
Actor DnD_CrowsCast : DnD_Info {}
