// Mirrors DND_DARKWIND_PULSE in acs/Spells/DnD_Spells.h.
const int DARKWIND_PULSE = 5;

// The wind: no hit of its own, it passes through enemies and blasts round itself every pulse until a wall stops it.
// REACTIONTIME is its life in pulses. ISSPELL | ISRADIUSDMG: each blast is a hit, so it can crit.
Actor Spell_DarkWind : DnD_Spell {
	PROJECTILE
	+THRUACTORS
	+DONTSPLASH
	+BLOODLESSIMPACT
	+FORCERADIUSDMG
	Stamina 65538
	Speed 12
	Radius 8
	Height 16
	Damage 0
	DamageType "Magic"
	RenderStyle Translucent
	Translation "0:255=%[0.00,0.00,0.00]:[0.65,0.70,0.95]"
	SeeSound "Ambience/Windgust"

	// Written by "DnD Spell Explosion Setup", read by A_Explode below.
	var int user_expdmg;
	var int user_expradius;
	var int user_fullexpradius;
	var int user_expflags;
	// A Ghast's casts price at rank 1 when its owner never learned Dark Wind.
	var int user_rankat;

	States {
		SpawnState:
			// Once, not per pulse; flat over the whole radius.
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Spell Explosion Setup", SPELLVAL_DAMAGE, 0, 0)
			TNT1 A 0 A_SetUserVar("user_fullexpradius", user_expradius)
			TNT1 A 0 A_PlaySound("Ambience/Wind1", CHAN_BODY, 0.6, true)
		Blow:
			TNT1 A 0 A_SpawnItemEx("Spell_DarkWind_Puff", 0, random (-4, 4), random (-4, 4), 0, random (-2, 2), random (-2, 2), 0, 160)
			D5FX G 1 A_Explode(100, user_expradius, 1, 0, user_fullexpradius)
			D5FX GGGG 1 A_SpawnItemEx("Spell_DarkWind_Puff", 0, random (-4, 4), random (-4, 4), 0, random (-2, 2), random (-2, 2), 0, 160)
			TNT1 A 0 A_CountDown
		Loop
		Death:
			TNT1 A 0 A_StopSound(CHAN_BODY)
			TNT1 AAAAA 0 A_SpawnItemEx("Spell_DarkWind_Puff", 0, random (-4, 4), random (-4, 4), 0, random (-8, 8), random (-8, 8), frandom(-4, 4), 160)
			TNT1 A 5
		Stop
	}
}

// Rank 5: off the walls instead of into them.
Actor Spell_DarkWind_Bounce : Spell_DarkWind {
	BounceType "Hexen"
	BounceFactor 1.0
	WallBounceFactor 1.0
}

// A wisp of the dark cloud it leaves as it goes.
Actor Spell_DarkWind_Puff : DnD_SpecialFX {
	Radius 2
	Height 2
	+NOINTERACTION
	+CLIENTSIDEONLY
	PROJECTILE
	RenderStyle Translucent
	Scale 1.5
	Alpha 0.5
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_Jump (256, "Blot1", "Blot2", "Blot3", "Blot4")
		Blot1:
			BLOT A 2 
			BLOT B 2 A_SetTranslucent (0.4, 0)
			BLOT C 2 A_SetTranslucent (0.3, 0)
			BLOT D 2 A_SetTranslucent (0.2, 0)
			BLOT E 2 A_SetTranslucent (0.1, 0)
		stop
		Blot2:
			BLOT F 2 
			BLOT G 2 A_SetTranslucent (0.4, 0)
			BLOT H 2 A_SetTranslucent (0.3, 0)
			BLOT I 2 A_SetTranslucent (0.2, 0)
			BLOT J 2 A_SetTranslucent (0.1, 0)
		stop
		Blot3:
			BLOT K 2 
			BLOT L 2 A_SetTranslucent (0.4, 0)
			BLOT M 2 A_SetTranslucent (0.3, 0)
			BLOT N 2 A_SetTranslucent (0.2, 0)
			BLOT O 2 A_SetTranslucent (0.1, 0)
		stop
		Blot4:
			BLOT P 2 
			BLOT Q 2 A_SetTranslucent (0.4, 0)
			BLOT R 2 A_SetTranslucent (0.3, 0)
			BLOT S 2 A_SetTranslucent (0.2, 0)
			BLOT T 2 A_SetTranslucent (0.1, 0)
		stop
	}
}
