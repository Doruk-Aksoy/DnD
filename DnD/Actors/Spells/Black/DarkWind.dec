// Mirrors DND_DARKWIND_PULSE in acs/Spells/DnD_Spells.h.
const int DARKWIND_PULSE = 5;

// The wind: no hit of its own, it passes through enemies and blasts round itself every pulse until a wall stops it.
// REACTIONTIME is its life in pulses. ISSPELL | ISRADIUSDMG: each blast is a hit, so it can crit.
Actor Spell_DarkWind : DnD_Spell {
	PROJECTILE
	+THRUACTORS
	+DONTSPLASH
	+BLOODLESSIMPACT
	+FORCERADIUSDMG
	Stamina 65538
	Speed 12
	Radius 8
	Height 16
	Damage 0
	DamageType "Magic"
	// Drawn as DWIND.md3's fog (DarkWind.fp): the alpha only sets the model's alpha test, and fading it fades the fog.
	RenderStyle Translucent
	Alpha 0.02
	SeeSound "DarkWind/Cast"

	// Written by "DnD Spell Explosion Setup", read by A_Explode below.
	var int user_expdmg;
	var int user_expradius;
	var int user_fullexpradius;
	var int user_expflags;
	// A Ghast's casts price at rank 1 when its owner never learned Dark Wind.
	var int user_rankat;

	States {
		SpawnState:
			// Once, not per pulse; flat over the whole radius.
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Spell Explosion Setup", SPELLVAL_DAMAGE, 0, 0)
			TNT1 A 0 A_SetUserVar("user_fullexpradius", user_expradius)
			// Its fog's look, one of eight, read back from the scale by DarkWind.fp.
			TNT1 A 0 A_SetScale(1.0 + random(0, 7) * 0.004)
		Blow:
			TNT1 A 0 A_SpawnItemEx("Spell_DarkWind_Bat", 0, random(-12, 12), random(-4, 12), frandom(10, 15), 0, frandom(-0.3, 0.5), frandom(-10, 10), 0, 170)
			D5FX G 1 A_Explode(100, user_expradius, 1, 0, user_fullexpradius)
			D5FX G 4
			TNT1 A 0 A_CountDown
		Loop
		Death:
			TNT1 AAAAA 0 A_SpawnItemEx("Spell_DarkWind_Puff", 0, random (-4, 4), random (-4, 4), 0, random (-8, 8), random (-8, 8), frandom(-4, 4), 160)
			D5FX GGGGGGGGGG 1 A_FadeOut(0.002)
		Stop
	}
}

// Rank 5: off the walls instead of into them.
Actor Spell_DarkWind_Bounce : Spell_DarkWind {
	BounceType "Hexen"
	BounceFactor 1.0
	WallBounceFactor 1.0
}

// A bat flying with the wind, a little off its line; cosmetic, through enemies, gone soon after the first wall.
Actor Spell_DarkWind_Bat {
	PROJECTILE
	+CLIENTSIDEONLY
	+NOTONAUTOMAP
	+THRUACTORS
	+DONTSPLASH
	Radius 4
	Height 8
	Damage 0
	RenderStyle Translucent
	Alpha 1.0
	States {
		Spawn:
			TNT1 A 0
			S024 ABCABCABCABCABCABCABCABC 3
		Fade:
			S024 ABC 2 A_FadeOut(0.1)
		Loop
		Death:
			S024 A 0 A_PlaySound("DarkWind/Damage", CHAN_BODY, 0.6)
			S024 A 1 A_FadeOut(0.2)
		Wait
	}
}

// A wisp of the dark cloud it leaves as it goes.
Actor Spell_DarkWind_Puff : DnD_SpecialFX {
	Radius 2
	Height 2
	+NOINTERACTION
	+CLIENTSIDEONLY
	PROJECTILE
	RenderStyle Translucent
	Scale 1.5
	Alpha 0.5
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_Jump (256, "Blot1", "Blot2", "Blot3", "Blot4")
		Blot1:
			S019 A 2 
			S019 B 2 A_SetTranslucent (0.4, 0)
			S019 C 2 A_SetTranslucent (0.3, 0)
			S019 D 2 A_SetTranslucent (0.2, 0)
			S019 E 2 A_SetTranslucent (0.1, 0)
		stop
		Blot2:
			S019 F 2 
			S019 G 2 A_SetTranslucent (0.4, 0)
			S019 H 2 A_SetTranslucent (0.3, 0)
			S019 I 2 A_SetTranslucent (0.2, 0)
			S019 J 2 A_SetTranslucent (0.1, 0)
		stop
		Blot3:
			S019 K 2 
			S019 L 2 A_SetTranslucent (0.4, 0)
			S019 M 2 A_SetTranslucent (0.3, 0)
			S019 N 2 A_SetTranslucent (0.2, 0)
			S019 O 2 A_SetTranslucent (0.1, 0)
		stop
		Blot4:
			S019 P 2 
			S019 Q 2 A_SetTranslucent (0.4, 0)
			S019 R 2 A_SetTranslucent (0.3, 0)
			S019 S 2 A_SetTranslucent (0.2, 0)
			S019 T 2 A_SetTranslucent (0.1, 0)
		stop
	}
}
