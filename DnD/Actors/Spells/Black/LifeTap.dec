// On one enemy: tapped, its clock, and the caster + 1 whose hits it heals.
Actor DnD_LifeTapped : DnD_Info {}
Actor DnD_LifeTappedTimer : DnD_Info {}
Actor DnD_LifeTapOwner : DnD_Info {}

// Life Tap's drops on a tapped enemy, off the curse row: score units ahead along its facing, mass up.
Actor LifeTapFXMarker : DnD_AttachedFXBase {
	RenderStyle Add
	Alpha 0.9
	Scale 0.45
	States {
		SpawnLoop:
			S030 AABBCCDDEEFFGGHHIIJJKKLLMM 1 Bright A_Warp(AAPTR_TARGET, score, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			S030 NNOOPPQQRRSSTTUUVVWWXXYYZZ 1 Bright A_Warp(AAPTR_TARGET, score, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			S031 AABBCC 1 Bright A_Warp(AAPTR_TARGET, score, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
		Loop
	}
}

// The ring drawn where the ball bursts, in blood red sparks.
Actor LifeTapAreaMarkerFX : NoxAreaMarkerFX {
	Translation "80:111=%[0.00,0.00,0.00]:[1.90,0.15,0.20]"
}
