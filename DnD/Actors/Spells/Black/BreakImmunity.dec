// On one enemy: the immunities broken, a bit each (DND_IMMUNEBIT_*), and the clock.
Actor DnD_ImmunityBroken : DnD_Info {}
Actor DnD_ImmunityBrokenTimer : DnD_Info {}

// Its explosive immunity (NORADIUSDMG) broken; MakeExplosiveHighResist puts it back.
Actor DnD_TakeExplosiveImmunity : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_ChangeFlag("NORADIUSDMG", 0)
		Stop
	}
}

// Break Immunity's sparks near a broken enemy's chest, off the curse row: score units ahead along its facing, mass up.
Actor BreakImmunityFXMarker : DnD_AttachedFXBase {
	RenderStyle Add
	Alpha 0.9
	Scale 0.35
	States {
		SpawnLoop:
			S035 AABBCCDDEEFFGGHHIIJJKKLL 1 Bright A_Warp(AAPTR_TARGET, score, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			S035 MMNNOOPPQQRRSSTTUUVVWWXX 1 Bright A_Warp(AAPTR_TARGET, score, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
		Loop
	}
}

// The ring drawn round the target from rank 5, in white gold sparks.
Actor BreakImmunityAreaMarkerFX : NoxAreaMarkerFX {
	Translation "80:111=%[0.00,0.00,0.00]:[1.80,1.60,0.90]"
}
