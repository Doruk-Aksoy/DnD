// Rank 5: a stolen soul's mark, in tics left.
Actor DnD_SoulStolenTimer : DnD_Info {}

// A wailing soul torn out of a body; "DnD Siphoned Soul FX" steers it onto the caster, its face turned the way it flies.
Actor Spell_SoulSiphon_Soul : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0
	Scale 0.9
	Translation "0:255=%[0.00,0.00,0.00]:[0.30,0.95,1.10]"
	+NOGRAVITY
	States {
		Spawn:
			TNT1 A 0
		Rise:
			SRV1 K 1 Bright A_FadeIn(0.15)
			SRV1 K 0 Bright A_SpawnItemEx("Spell_SoulSiphon_Trail", -12, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE | SXF_TRANSFERTRANSLATION)
			SRV1 K 0 Bright A_JumpIf(alpha < 0.9, "Rise")
		// Its trail is left a little behind, so the face stays clear of it.
		Fly:
			SRV1 K 1 Bright A_SpawnItemEx("Spell_SoulSiphon_Trail", -12, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE | SXF_TRANSFERTRANSLATION)
			SRV1 K 1 Bright
		Loop
		// A soul that never reached its caster thins away.
		Fade:
			SRV1 K 1 Bright A_FadeOut(0.1)
			SRV1 K 0 Bright A_SpawnItemEx("Spell_SoulSiphon_Trail", -12, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE | SXF_TRANSFERTRANSLATION)
		Loop
	}
}

// A lesser wisp of the same soul following it in.
Actor Spell_SoulSiphon_Wisp : Spell_SoulSiphon_Soul {
	Scale 0.5
	States {
		Rise:
			SPIR A 1 Bright A_FadeIn(0.15)
			SPIR A 0 Bright A_SpawnItemEx("Spell_SoulSiphon_Mote", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
			SPIR B 1 Bright A_FadeIn(0.15)
			SPIR B 0 Bright A_SpawnItemEx("Spell_SoulSiphon_Mote", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
			SPIR B 0 Bright A_JumpIf(alpha < 0.8, "Rise")
		Fly:
			SPIR A 1 Bright A_SpawnItemEx("Spell_SoulSiphon_Mote", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
			SPIR B 1 Bright A_SpawnItemEx("Spell_SoulSiphon_Mote", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
		Loop
		Fade:
			SPIR A 1 Bright A_FadeOut(0.1)
			SPIR B 1 Bright A_FadeOut(0.1)
		Loop
	}
}

// The soul leaving its body: the Harvester's ghost stretching up out of it, in teal.
Actor Spell_SoulSiphon_Emerge : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.85
	Scale 1.6
	Translation "0:255=%[0.00,0.00,0.00]:[0.40,1.30,1.50]"
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_ChangeVelocity(0, 0, 0.5, CVF_REPLACE)
			SHGH ABCDEFG 3 Bright
		Stop
	}
}

// The wisp a soul leaves where it passed.
Actor Spell_SoulSiphon_Trail : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.35
	Scale 0.8
	States {
		Spawn:
			TNT1 A 1
			SRV1 DEFGHIJ 1 Bright
		Stop
	}
}

Actor Spell_SoulSiphon_Mote : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.6
	Scale 0.22
	Translation "80:111=%[0.00,0.00,0.00]:[0.40,1.30,1.50]"
	States {
		Spawn:
			TNT1 A 0
			SPFX A 1 Bright A_FadeOut(0.06)
		Wait
	}
}

// A soul sinking into its caster: a brief teal flare.
Actor Spell_SoulSiphon_Absorb : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.7
	Scale 0.35
	Translation "0:255=%[0.00,0.00,0.00]:[0.40,1.30,1.50]"
	States {
		Spawn:
			TNT1 A 0
			D4FX GHIJKL 2 Bright
		Stop
	}
}
