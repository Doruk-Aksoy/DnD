// Nox on one enemy: blinded, its clock, the caster + 1, and rank 5's wish for its aggression flags.
Actor DnD_Blinded : DnD_Info {}
Actor DnD_BlindedTimer : DnD_Info {}
Actor DnD_BlindCaster : DnD_Info {}
Actor DnD_NoxAggroWanted : DnD_Info {}

// Rank 5's flags, on and back off; "DnD Nox Timer" only hands back the ones the enemy did not already have.
Actor Nox_MissileMoreOn : DnD_Activator { States { Pickup: TNT1 A 0 A_ChangeFlag("MISSILEMORE", 1) Stop } }
Actor Nox_MissileMoreOff : DnD_Activator { States { Pickup: TNT1 A 0 A_ChangeFlag("MISSILEMORE", 0) Stop } }
Actor Nox_MissileEvenMoreOn : DnD_Activator { States { Pickup: TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 1) Stop } }
Actor Nox_MissileEvenMoreOff : DnD_Activator { States { Pickup: TNT1 A 0 A_ChangeFlag("MISSILEEVENMORE", 0) Stop } }

// What a blinded enemy chases and attacks instead of you. Off the blockmap, so no shot, splash or autoaim finds it.
// No RenderStyle None: sight checks miss an unseeable target 80% of the time, and online A_Chase then halts.
Actor DnD_BlindDecoy {
	Health 1000
	Radius 4
	Height 16
	+SHOOTABLE
	+NOBLOCKMAP
	+NOGRAVITY
	+INVULNERABLE
	+NODAMAGE
	+NORADIUSDMG
	+NOTELEPORT
	+DONTSPLASH
	+SERVERSIDEONLY
	States {
		Spawn:
			TNT1 A -1
		Stop
	}
}

// Nox's mark on a blinded enemy's face, off the curse row: score units toward this client's player, mass up.
// "DnD Attachment Face Viewer" keeps its angle on that player; it warps along its own angle.
Actor NoxFXMarker : DnD_AttachedFXBase {
	RenderStyle Add
	Alpha 0.9
	Scale 0.5
	States {
		SpawnLoop:
			S023 AABBCCDDEEFFGGHHIIJJKKLLMMNNOOPPQQRRSSTTUUVVWWXX 1 Bright A_Warp(AAPTR_TARGET, score, 0, mass, 0, WARPF_INTERPOLATE | WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
		Loop
	}
}

// The ring drawn where the curse lands, in dark violet sparks.
Actor NoxAreaMarkerFX : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.9
	Scale 0.5
	Translation "80:111=%[0.00,0.00,0.00]:[1.17,0.10,1.87]"
	+NOINTERACTION
	+CLIENTSIDEONLY
	+NOGRAVITY
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 Thing_ChangeTID(0, SPECIAL_FX_TID)
			SPFX A 1 Bright A_FadeOut(0.04)
		Wait
	}
}
