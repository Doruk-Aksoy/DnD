// On one enemy: penetrated (2 at rank 10, more damage from a hit ripping through) and its clock.
Actor DnD_Penetrated : DnD_Info {}
Actor DnD_PenetratedTimer : DnD_Info {}

// Given to the penetrated enemy every tic by its curse timer: player projectiles near it are handed DnD_PenetrateTouch.
Actor DnD_PenetratePulse : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_RadiusGive("DnD_PenetrateTouch", radius + 64, RGF_MISSILES | RGF_NOSIGHT, 1)
		Stop
	}
}

// On a projectile: near a penetrated enemy for two more tics; "DnD Penetrate Missile" makes it rip while it is.
Actor DnD_PenetrateTouch : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_GiveInventory("DnD_PenetrateNear", 2)
			TNT1 A 0 A_JumpIfInventory("DnD_Penetrating", 1, "Done")
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Penetrate Missile", 0)
		Done:
			TNT1 A 0
		Stop
	}
}

Actor DnD_PenetrateNear : DnD_Info {}
Actor DnD_Penetrating : DnD_Boolean {}

// The curse marker over a penetrated enemy: frame P of the curse row (FlammabilityFXMarker).
Actor PenetrateFXMarker : FlammabilityFXMarker {
	States {
		SpawnLoop:
			CM1O P 0
		Goto CurseJoin
	}
}

// The ring drawn where the curse lands, in steel blue sparks.
Actor PenetrateAreaMarkerFX : NoxAreaMarkerFX {
	Translation "80:111=%[0.00,0.00,0.00]:[0.60,0.90,1.50]"
}

// Its Hardened Skin is off while penetrated; MakeHardenedSkin puts DONTRIP back.
Actor DnD_PenetrateSkinOff : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_ChangeFlag("DONTRIP", 0)
		Stop
	}
}
