// Summon: Skeleton's warrior, the Draugr's look; health, melee and its clock come off the spell row.
ACTOR Spell_Skeleton : PetMonsterBase {
	Health 300
	GibHealth 20
	Radius 20
	Height 56
	Speed 10
	PainChance 96
	Stamina 1
	SeeSound "Draugr/See"
	PainSound "Draugr/Pain"
	DeathSound "Widowmaker/Death"
	ActiveSound "Draugr/Act"
	Obituary "%o was cut down by a skeleton."
	Tag "Skeleton"
	MeleeRange 72
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Pet Monster Scale", 0, DND_PET_SKELETONID, DND_SILVER_WEAKNESS, -1)
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Minion Life", 0, DND_PET_SKELETONID)
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Pet Distance Move", 0)
			SKE2 RQPON 4
		SpawnLoop:
			SKE2 AB 10 A_Look
		Goto See
		See:
			SKE2 AABBCCDDEEFF 2 A_Chase
		Loop
		Melee:
			TNT1 A 0 A_AlertMonsters(0, AMF_TARGETNONPLAYER)
			SKE2 J 5 A_FaceTarget
			SKE2 K 4 A_FaceTarget
			SKE2 L 4 A_CustomMeleeAttack(ACS_NamedExecuteWithResult("DnD Spell Minion Hit", MINIONHIT_SKELETON, 0), "skeleton/melee")
			SKE2 L 3
		Goto See
		Pain:
			SKE2 M 4
			SKE2 M 4 A_Pain
		Goto See
		Death:
			"####" "#" 0 ACS_NamedExecuteAlways("DnD On Summon Death Check", 0, DND_PET_SKELETONID)
			SKE2 NO 6
			SKE2 P 6 A_Scream
			SKE2 Q 6 A_NoBlocking
			SKE2 R 6
			SKE2 S 35
			SKE2 S 1 A_FadeOut(0.05)
		Wait
	}
}

// Rank 10's caster: the Skull Wizard's look, 25% less health; its own bolt, or with Skeleton Mastery rank 10 its owner's tier 1 spell.
ACTOR Spell_SkeletonMage : PetMonsterBase {
	Health 225
	GibHealth 20
	Radius 20
	Height 60
	Speed 8
	PainChance 96
	Stamina 1
	SeeSound "H2SkullWizard/Sight"
	PainSound "H2SkullWizard/Pain"
	DeathSound "H2SkullWizard/Death"
	ActiveSound "H2SkullWizard/Sight"
	Obituary "%o was hexed by a skeleton mage."
	Tag "Skeleton Mage"
	+MISSILEMORE
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Pet Monster Scale", 0, DND_PET_SKELETONMAGEID, DND_SILVER_WEAKNESS, -1)
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Minion Life", 0, DND_PET_SKELETONMAGEID)
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Pet Distance Move", 0)
			SKWZ A 4
		SpawnLoop:
			SKWZ A 10 A_Look
		Goto See
		See:
			SKWZ AAAABBBB 2 A_Chase
		Loop
		Missile:
			TNT1 A 0 A_AlertMonsters(0, AMF_TARGETNONPLAYER)
			SKWZ C 8 Bright A_FaceTarget
			SKWZ D 4 Bright A_FaceTarget
			TNT1 A 0 A_PlaySound("H2SkullWizard/Fire", CHAN_WEAPON)
			// The script rolls AND casts, so a true return means its owner's spell is already away.
			TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DnD Skeleton Mage Spell"), "CastDone")
			SKWZ D 4 Bright A_CustomMissile("Spell_SkeletonMageBolt", 40)
			SKWZ C 6
		Goto See
		CastDone:
			SKWZ D 4 Bright
			SKWZ C 6
		Goto See
		Pain:
			SKWZ A 3
			SKWZ A 3 A_Pain
		Goto See
		Death:
			"####" "#" 0 ACS_NamedExecuteAlways("DnD On Summon Death Check", 0, DND_PET_SKELETONMAGEID)
			SKWZ G 5 A_Scream
			SKWZ HIJK 5 Bright
			SKWZ LM 5 Bright
			SKWZ N 5 A_NoBlocking
			SKWZ O 35
			SKWZ O 1 A_FadeOut(0.05)
		Wait
	}
}

Actor Spell_SkeletonMageBolt : DnD_BaseProjectile_ForPets {
	Speed 22
	Radius 6
	Height 8
	Damage(ACS_NamedExecuteWithResult("DnD Spell Minion Hit", MINIONHIT_SKELETON, DND_USETARGET))
	DamageType "Magic"
	RenderStyle Add
	SeeSound "H2SkullWizard/Fire"
	DeathSound "H2SkullWizard/Hit"
	States {
		SpawnState:
			IFX1 AB 2 Bright
		Loop
		Death:
			D4FX GHIJKL 2 Bright
		Stop
	}
}

// Rank 5: what a skeleton's block looks like on its body.
Actor Spell_Skeleton_BlockFX : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.9
	Scale 0.4
	Translation "0:255=%[0.00,0.00,0.00]:[1.40,1.40,1.60]"
	States {
		Spawn:
			TNT1 A 0
			D4FX GHIJKL 2 Bright
		Stop
	}
}

// Rank 5: the next hit on it is blocked.
Actor DnD_SkeletonBlock : DnD_Boolean {}
