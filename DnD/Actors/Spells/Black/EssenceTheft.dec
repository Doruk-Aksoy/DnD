// On one enemy: its tick, half seconds left, the caster + 1, the ticker refcount; client side, how long its motes rise.
Actor DnD_EssenceTick : DnD_Info {}
Actor DnD_EssenceTimer : DnD_Info {}
Actor DnD_EssenceOwner : DnD_Info {}
Actor DnD_EssenceScripts : DnD_Info {}
Actor DnD_EssenceFXTimer : DnD_Info {}

// The unholy missile. No hit damage: its tracer (HITTRACER, from DnD_BaseProjectile) names the enemy for the theft.
Actor Spell_EssenceTheft : DnD_Spell {
	PROJECTILE
	Speed 40
	Radius 6
	Height 10
	Damage 0
	// Flies as ETHEFT.md3's smoke (EssenceTheft.fp): alpha 0.02 is the shader's reference, scale 1 + k x 0.004 its look.
	RenderStyle Translucent
	Alpha 0.02
	Translation "0:255=%[0.00,0.00,0.00]:[1.17,0.10,1.87]"
	DeathSound "EssenceTheft/Hit"
	States {
		SpawnState:
			TNT1 A 0 A_SetScale(1.0 + random(0, 7) * 0.004)
			TNT1 A 0 A_PlaySound("EssenceTheft/Fly", CHAN_5, 1.0, true)
		Fly:
			RFX0 AB 3 Bright
		Loop
		Death:
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Essence Theft Hit")
			// The burst is the old additive sprite.
			TNT1 A 0 A_SetScale(0.6)
			TNT1 A 0 A_SetTranslucent(0.9, 1)
			TNT1 A 0 A_StopSound(CHAN_5)
			RFX0 GHI 3 Bright
			RFX0 JJJ 2 Bright A_FadeOut(0.25)
		Stop
	}
}

Actor Spell_Essence_Trail : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.7
	Scale 0.35
	Translation "80:111=%[0.00,0.00,0.00]:[1.17,0.10,1.87]"
	States {
		Spawn:
			TNT1 A 0
			SPFX A 1 Bright A_FadeOut(0.07)
		Wait
	}
}

// A dark mote drawn up off a drained enemy.
Actor Spell_Essence_Mote : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0
	Scale 0.3
	Translation "80:111=%[0.00,0.00,0.00]:[1.17,0.10,1.87]"
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_ChangeVelocity(frandom(-0.2, 0.2), frandom(-0.2, 0.2), frandom(0.8, 1.6), CVF_REPLACE)
			SPFX AAAA 1 Bright A_FadeIn(0.2)
			SPFX A 1 Bright A_FadeOut(0.04)
		Wait
	}
}
