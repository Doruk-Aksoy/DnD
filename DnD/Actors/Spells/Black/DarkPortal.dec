// Summon: Dark Portal. It stands where it opens and never attacks; minions summoned near it get its boon (ApplyPortalBoon).
ACTOR Spell_DarkPortal : PetMonsterBase {
	Health 300
	GibHealth -100
	Radius 20
	Height 48
	Speed 0
	PainChance 0
	Mass 100000
	Stamina 1
	Obituary "%o walked into a portal."
	Tag "Dark Portal"
	// Drawn as PORTAL.md3 (DarkPortal.fp), opaque; its death turns it translucent to fade it.
	RenderStyle Normal
	+NOGRAVITY
	+NOBLOOD
	+DONTBLAST
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Pet Monster Scale", 0, DND_PET_DARKPORTALID, -1, -1)
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Minion Life", 0, DND_PET_DARKPORTALID)
			TNT1 A 0 A_PlaySound("DarkPortal/Cast", CHAN_VOICE)
			TNT1 A 0 A_PlaySound("DarkPortal/Loop", CHAN_BODY, 0.6, true)
		Idle:
			PRTL ABCDE 3 Bright
		Loop
		Death:
			"####" "#" 0 ACS_NamedExecuteAlways("DnD On Summon Death Check", 0, DND_PET_DARKPORTALID)
			TNT1 A 0 A_StopSound(CHAN_BODY)
			TNT1 A 0 A_NoBlocking
			PRTL A 0 A_SetTranslucent(1.0, 0)
			PRTL ABCDEABCDE 2 Bright A_FadeOut(0.1)
		Stop
	}
}

// A minion summoned near the portal: the boon's motes on it.
Actor Spell_DarkPortal_Boon : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.9
	Scale 0.6
	Translation "0:255=%[0.00,0.00,0.00]:[0.90,0.25,1.60]"
	States {
		Spawn:
			TNT1 A 0
			D4FX GHIJKL 3 Bright
		Stop
	}
}

// On the minion: percent more health and damage, percent more duration, and the rank 5 and 10 bits.
Actor DnD_PortalMore : DnD_Info {}
Actor DnD_PortalLonger : DnD_Info {}
Actor DnD_PortalBoon : DnD_Info {}
