// Summon: Slayer Knight (S027): physical melee, or a diagonal slash of six dark flames that burst for fire.
ACTOR Spell_SlayerKnight : PetMonsterBase {
	Health 1000
	GibHealth -100
	Radius 24
	Height 56
	Speed 9
	PainChance 24
	Mass 500
	Scale 1.1
	Stamina 1
	SeeSound "DreadKnight/See"
	PainSound "DreadKnight/Pain"
	DeathSound "DreadKnight/Die"
	ActiveSound "DreadKnight/Act"
	Obituary "%o was slain by a Slayer Knight."
	Tag "Slayer Knight"
	MeleeRange 80
	var int user_counter;
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Pet Monster Scale", 0, DND_PET_SLAYERKNIGHTID, DND_SILVER_WEAKNESS, -1)
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Pet Distance Move", 0)
			S027 PONMLKJI 3
		SpawnLoop:
			S027 A 8 A_Look
		Goto See
		See:
			S027 AABBCCDD 2 A_Chase
		Loop
		Melee:
			TNT1 A 0 A_AlertMonsters(0, AMF_TARGETNONPLAYER)
			S027 E 5 A_FaceTarget
			TNT1 A 0 A_PlaySound("dknight/swing", CHAN_WEAPON)
			S027 F 3
			S027 G 4 A_CustomMeleeAttack(ACS_NamedExecuteWithResult("DnD Spell Minion Hit", MINIONHIT_SLAYERMELEE, 0), "dknight/melee")
			S027 G 4
			S027 A 2
		Goto See
		Missile:
			TNT1 A 0 A_AlertMonsters(0, AMF_TARGETNONPLAYER)
			S027 E 8 A_FaceTarget
			TNT1 A 0 A_PlaySound("monster/dkball", CHAN_WEAPON)
			// Inferno Sword's diagonal slash, tighter, along the blade's path E to G: high on its right to low on its left. Legion r10: ghost-hitting.
			TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DnD Knight Throw Kind") & 2, "MissileLegion")
			S027 F 0 A_CustomMissile("Spell_SlayerKnight_Flame", 58, 8, -7.5)
			S027 F 0 A_CustomMissile("Spell_SlayerKnight_Flame", 51, 2, -4.5)
			S027 F 0 A_CustomMissile("Spell_SlayerKnight_Flame", 44, -4, -1.5)
			S027 F 0 A_CustomMissile("Spell_SlayerKnight_Flame", 37, -10, 1.5)
			S027 F 0 A_CustomMissile("Spell_SlayerKnight_Flame", 30, -16, 4.5)
			S027 F 4 A_CustomMissile("Spell_SlayerKnight_Flame", 23, -22, 7.5)
			S027 G 5
		Goto See
		MissileLegion:
			S027 F 0 A_CustomMissile("Spell_SlayerKnight_FlameLegion", 58, 8, -7.5)
			S027 F 0 A_CustomMissile("Spell_SlayerKnight_FlameLegion", 51, 2, -4.5)
			S027 F 0 A_CustomMissile("Spell_SlayerKnight_FlameLegion", 44, -4, -1.5)
			S027 F 0 A_CustomMissile("Spell_SlayerKnight_FlameLegion", 37, -10, 1.5)
			S027 F 0 A_CustomMissile("Spell_SlayerKnight_FlameLegion", 30, -16, 4.5)
			S027 F 4 A_CustomMissile("Spell_SlayerKnight_FlameLegion", 23, -22, 7.5)
			S027 G 5
		Goto See
		// Rank 5: "DnD Slayer Counter" points it at its attacker and sends it here.
		Counter:
			S027 Q 4 A_FaceTarget
			S027 Q 0 A_JumpIfCloser(96, "Melee")
		Goto Missile
		Pain:
			S027 H 3
			S027 H 3 A_Pain
		Goto See
		Death:
			"####" "#" 0 ACS_NamedExecuteAlways("DnD On Summon Death Check", 0, DND_PET_SLAYERKNIGHTID)
			S027 I 6 A_Scream
			S027 J 5 A_NoBlocking
			S027 KLMNO 5
			S027 P 35
			S027 P 1 A_FadeOut(0.05)
		Wait
	}
}

// Rank 10: the melee is a slashing wave over an arc in front ("DnD Minion Cleave").
ACTOR Spell_SlayerKnightWave : Spell_SlayerKnight {
	MeleeRange 128
	States {
		Melee:
			TNT1 A 0 A_AlertMonsters(0, AMF_TARGETNONPLAYER)
			S027 E 5 A_FaceTarget
			TNT1 A 0 A_PlaySound("dknight/swing", CHAN_WEAPON)
			S027 F 3
			S027 G 4 ACS_NamedExecuteWithResult("DnD Minion Cleave", MINIONHIT_SLAYERMELEE)
			S027 G 4
			S027 A 2
		Goto See
		Counter:
			S027 Q 4 A_FaceTarget
			S027 Q 0 A_JumpIfCloser(144, "Melee")
		Goto Missile
	}
}

// A dark flame: its fire blast (AMOUNT2 in RADIUS) wherever it lands, the knight's minion damage. It passes through ghosts.
Actor Spell_SlayerKnight_Flame : DnD_BaseProjectile_ForPets {
	Speed 18
	Radius 6
	Height 8
	Damage 0
	DamageType "Fire"
	RenderStyle Add
	Translation "0:255=%[0.00,0.00,0.00]:[0.80,0.30,1.60]"
	DeathSound "weapons/phoenixhit"
	+THRUGHOST
	var int user_dmg;
	States {
		SpawnState:
			DKAT ABC 3 Bright
		Loop
		Death:
			TNT1 A 0 A_SetUserVar("user_dmg", ACS_NamedExecuteWithResult("DnD Spell Minion Hit", MINIONHIT_SLAYERFLAME, DND_USETARGET))
			TNT1 A 0 A_Explode(user_dmg, 96, 0, 0, 32)
			TNT1 A 0 A_SpawnItemEx("RedParticleSpawner", 0, 0, 0, 0, 0, 0, 0, 128)
			DKAT DEFGHIJKLM 3 Bright
		Stop
	}
}

// Legion Mastery rank 10: it strikes ghosts and its blast ignores radius damage immunity.
Actor Spell_SlayerKnight_FlameLegion : Spell_SlayerKnight_Flame {
	-THRUGHOST
	+FORCERADIUSDMG
}

// Rank 10: the wave's cut across each enemy it hits (Harkimonde's red slash streak); half are mirrored.
Actor Spell_SlayerKnight_HitFX : DnD_SpecialFX {
	RenderStyle Add
	Alpha 1.0
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_Jump(128, "Mirror")
			TNT1 A 0 A_SetScale(frandom(0.24, 0.3), frandom(0.24, 0.3))
		Goto Cut
		Mirror:
			TNT1 A 0 A_SetScale(-frandom(0.24, 0.3), frandom(0.24, 0.3))
		Cut:
			VFX4 A 2 Bright
			VFX4 A 1 Bright A_FadeOut(0.12)
		Wait
	}
}

// Rank 5: untouchable for the few tics after a counter.
Actor DnD_SlayerGuard : DnD_Boolean {}
