// The beam is a line of these, strung by "DnD Holy Light FX".
Actor Spell_HolyLight_Mote : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.85
	Scale 0.3
	Translation "0:255=%[0.00,0.00,0.00]:[2.00,1.70,0.60]"
	States {
		Spawn:
			TNT1 A 0
			SPFX A 1 Bright A_FadeOut(0.06)
		Wait
	}
}

// Where the beam ends.
Actor Spell_HolyLight_Burst : DnD_SpecialFX {
	RenderStyle Add
	Alpha 0.9
	Scale 0.6
	Translation "0:255=%[0.00,0.00,0.00]:[2.00,1.70,0.60]"
	States {
		Spawn:
			TNT1 A 0
			FXPR ABCDEFGHI 2 Bright
		Stop
	}
}

// The beam: ACS aims and stretches it, HolyBeam.fp draws it; whole for 2 tics, then thinning to a thread as it fades.
Actor Spell_HolyLight_Beam {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 1.0
	States {
		Spawn:
			HLBM A 2 Bright
		Fade:
			HLBM A 1 Bright A_FadeOut(0.08)
		Loop
	}
}

// Where the beam strikes: a four-point star like the icon, its rays drawing out thin as it fades.
Actor Spell_HolyLight_Flare : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.8
	States {
		Spawn:
			HLFL ABCDEFGH 2 Bright
		Stop
	}
}

// A healed ally: a column of light rising round them, glints floating up through it. ACS sets it on the floor first.
Actor Spell_HolyLight_Heal : DnD_SpecialFX {
	+NOGRAVITY
	var int user_n;
	States {
		Spawn:
			TNT1 A 1
			TNT1 A 0 A_SpawnItemEx("Spell_HolyLight_Shaft", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
		Motes:
			TNT1 A 0 A_SpawnItemEx("Spell_HolyLight_Rise", frandom(4, 18), 0, frandom(2, 30), 0, 0, frandom(0.9, 1.7), random(0, 359), SXF_CLIENTSIDE)
			TNT1 A 0 A_SpawnItemEx("Spell_HolyLight_Rise", frandom(4, 18), 0, frandom(2, 30), 0, 0, frandom(0.9, 1.7), random(0, 359), SXF_CLIENTSIDE)
			TNT1 A 2 A_SetUserVar("user_n", user_n + 1)
			TNT1 A 0 A_JumpIf(user_n < 8, "Motes")
		Stop
	}
}

Actor Spell_HolyLight_Shaft : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.0
	Scale 0.5
	States {
		Spawn:
			HLSH A 1 Bright A_FadeIn(0.25)
			HLSH A 1 Bright A_FadeIn(0.25)
			HLSH A 1 Bright A_FadeIn(0.25)
			HLSH A 1 Bright A_FadeIn(0.25)
			HLSH A 10 Bright
		Out:
			HLSH A 1 Bright A_FadeOut(0.06)
		Loop
	}
}

Actor Spell_HolyLight_Rise : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.7
	States {
		Spawn:
			HLMT A 1 Bright A_FadeOut(0.025)
		Loop
	}
}
