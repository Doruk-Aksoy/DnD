// Holy Wrath's image of the caster in their class's form (HWI1..HWI8, DnD_Character 1..8, set by its state), flying to
// the spot facing its way. HolyImage.fp reads the alpha "DnD Holy Wrath FX" sets: 0.5..1 the build-up, under 0.5 the fade.
Actor Spell_HolyWrath_Image {
	Radius 16
	Height 56
	RenderStyle Add
	Alpha 0.5
	+NOINTERACTION
	+NOGRAVITY
	+NOBLOCKMAP
	+DONTSPLASH
	States {
		Spawn:
			HWI1 A -1 Bright
		Stop
		Class1:
			HWI1 A -1 Bright
		Stop
		Class2:
			HWI2 A -1 Bright
		Stop
		Class3:
			HWI3 A -1 Bright
		Stop
		Class4:
			HWI4 A -1 Bright
		Stop
		Class5:
			HWI5 A -1 Bright
		Stop
		Class6:
			HWI6 A -1 Bright
		Stop
		Class7:
			HWI7 A -1 Bright
		Stop
		Class8:
			HWI8 A -1 Bright
		Stop
	}
}

// The pillar of light, the pool under it, the ring of fire and its glow on the floor; "DnD Holy Wrath FX" drives them.
Actor Spell_HolyWrath_Pillar : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	States {
		Spawn:
			HWPL A -1 Bright
		Stop
	}
}

Actor Spell_HolyWrath_Pool : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.0
	States {
		Spawn:
			HWPO A -1 Bright
		Stop
	}
}

Actor Spell_HolyWrath_Ring : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	States {
		Spawn:
			HWRG A -1 Bright
		Stop
	}
}

Actor Spell_HolyWrath_Floor : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.9
	States {
		Spawn:
			HWFL A -1 Bright
		Stop
	}
}

// Light dust drifting down inside the pillar while it stands.
Actor Spell_HolyWrath_Dust : DnD_SpecialFX {
	+NOGRAVITY
	var int user_n;
	States {
		Spawn:
			TNT1 A 0
		Drift:
			TNT1 A 0 A_SpawnItemEx("Spell_HolyLight_Rise", frandom(0, 30), 0, frandom(40, 220), 0, 0, frandom(-3.0, -1.5), random(0, 359), SXF_CLIENTSIDE)
			TNT1 A 1 A_SetUserVar("user_n", user_n + 1)
			TNT1 A 0 A_JumpIf(user_n < 18, "Drift")
		Stop
	}
}

// The eruption's sunburst, flung widest to the sides, with a short quake.
Actor Spell_HolyWrath_Burst : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 1.3
	States {
		Spawn:
			TNT1 A 0
			HWBR A 0 Bright A_Quake(2, 8, 0, 640, "")
			HWBR ABCDEF 2 Bright
		Stop
	}
}

// Embers flung out with the ring and drifting up.
Actor Spell_HolyWrath_Ember : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.55
	States {
		Spawn:
			HWEM A 1 Bright A_FadeOut(0.035)
		Loop
	}
}

Actor Spell_HolyWrath_Embers : DnD_SpecialFX {
	+NOGRAVITY
	var int user_n;
	States {
		Spawn:
			TNT1 A 0
		Throw:
			TNT1 A 0 A_SpawnItemEx("Spell_HolyWrath_Ember", 20, 0, frandom(4, 30), frandom(2.5, 6), 0, frandom(1.0, 3.0), random(0, 359), SXF_CLIENTSIDE)
			TNT1 A 0 A_SpawnItemEx("Spell_HolyWrath_Ember", 20, 0, frandom(4, 30), frandom(2.5, 6), 0, frandom(1.0, 3.0), random(0, 359), SXF_CLIENTSIDE)
			TNT1 A 0 A_SpawnItemEx("Spell_HolyWrath_Ember", 20, 0, frandom(4, 30), frandom(2.5, 6), 0, frandom(1.0, 3.0), random(0, 359), SXF_CLIENTSIDE)
			TNT1 A 0 A_SetUserVar("user_n", user_n + 1)
			TNT1 A 0 A_JumpIf(user_n < 10, "Throw")
		Stop
	}
}
