// Enchant Weapon's looks (acs: CastEnchantWeapon, "DnD Enchant Linger", DrawEnchantGlow).

// While the buff lasts: a player attachment (DnD_Attachments.h); DnD_EnchantEnergy (rank 10) picks the energy runes.
Actor DnD_EnchantWeaponActive : DnD_Boolean {}
Actor DnD_EnchantEnergy : DnD_Boolean {}

Actor Spell_EnchantWeapon_FXSpawner : DnD_Activator {
	States {
		Pickup:
			TNT1 A 1 ACS_NamedExecuteWithResult("DnD Spawn Player Aura", PLAYERFX_ENCHANTWEAPON)
		Stop
	}
}

// The follower: lets off six runes 60 degrees apart (each takes its player as target) and stays while the marker holds.
Actor Spell_EnchantWeaponFX {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOTONAUTOMAP
	States {
		Spawn:
			TNT1 A 1 NoDelay A_JumpIfInTargetInventory("DnD_EnchantWeaponActive", 1, "Pick")
		Stop
		Pick:
			TNT1 A 0 A_JumpIfInTargetInventory("DnD_EnchantEnergy", 1, "RunesE")
			TNT1 A 0 A_SpawnItemEx("Spell_EnchantWeapon_Rune", 0, 0, 30, 0, 0, 0, 0, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_EnchantWeapon_Rune", 0, 0, 30, 0, 0, 0, 60, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_EnchantWeapon_Rune", 0, 0, 30, 0, 0, 0, 120, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_EnchantWeapon_Rune", 0, 0, 30, 0, 0, 0, 180, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_EnchantWeapon_Rune", 0, 0, 30, 0, 0, 0, 240, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_EnchantWeapon_Rune", 0, 0, 30, 0, 0, 0, 300, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
			Goto Hold
		RunesE:
			TNT1 A 0 A_SpawnItemEx("Spell_EnchantEnergy_Rune", 0, 0, 30, 0, 0, 0, 0, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_EnchantEnergy_Rune", 0, 0, 30, 0, 0, 0, 60, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_EnchantEnergy_Rune", 0, 0, 30, 0, 0, 0, 120, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_EnchantEnergy_Rune", 0, 0, 30, 0, 0, 0, 180, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_EnchantEnergy_Rune", 0, 0, 30, 0, 0, 0, 240, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_EnchantEnergy_Rune", 0, 0, 30, 0, 0, 0, 300, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
		Hold:
			TNT1 A 5
			TNT1 A 0 A_JumpIfInTargetInventory("DnD_EnchantWeaponActive", 1, "Hold")
		Stop
	}
}

// A rune orbiting its player at hand height from its spawn angle, bobbing a little; it fades in, and fades out once the
// marker is gone. On its own player's client it stays unseen: an arc under the eye for the whole buff.
Actor Spell_EnchantWeapon_Rune {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 0.0
	Scale 0.42
	var int user_a;
	var int user_self;
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_SetUserVar("user_a", angle)
			TNT1 A 0 A_SetUserVar("user_self", ACS_NamedExecuteWithResult("DnD Enchant Own Runes"))
			TNT1 A 0 A_Jump(256, "G1", "G2", "G3", "G4", "G5", "G6")
		G1:
			ENRS A 0 Bright
		Goto Orbit
		G2:
			ENRS B 0 Bright
		Goto Orbit
		G3:
			ENRS C 0 Bright
		Goto Orbit
		G4:
			ENRS D 0 Bright
		Goto Orbit
		G5:
			ENRS E 0 Bright
		Goto Orbit
		G6:
			ENRS F 0 Bright
		Goto Orbit
		Orbit:
			"####" "#" 1 Bright A_Warp(AAPTR_TARGET, 28, 0, 30 + 3 * sin(user_a * 3), user_a, WARPF_ABSOLUTEANGLE | WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			"####" "#" 0 A_SetUserVar("user_a", user_a + 4)
			"####" "#" 0 A_JumpIfInTargetInventory("DnD_EnchantWeaponActive", 1, "Keep")
			Goto Fade
		Keep:
			"####" "#" 0 A_JumpIf(user_self || alpha >= 1.0, "Orbit")
			"####" "#" 0 A_FadeIn(0.15)
			Goto Orbit
		Fade:
			"####" "#" 1 Bright A_Warp(AAPTR_TARGET, 28, 0, 30 + 3 * sin(user_a * 3), user_a, WARPF_ABSOLUTEANGLE | WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			"####" "#" 0 A_SetUserVar("user_a", user_a + 4)
			"####" "#" 0 A_FadeOut(0.1)
		Loop
	}
}

// Rank 10's runes: electric blue-white, the weapon's damage half energy.
Actor Spell_EnchantEnergy_Rune : Spell_EnchantWeapon_Rune {
	States {
		G1:
			ENRF A 0 Bright
		Goto Orbit
		G2:
			ENRF B 0 Bright
		Goto Orbit
		G3:
			ENRF C 0 Bright
		Goto Orbit
		G4:
			ENRF D 0 Bright
		Goto Orbit
		G5:
			ENRF E 0 Bright
		Goto Orbit
		G6:
			ENRF F 0 Bright
		Goto Orbit
	}
}
