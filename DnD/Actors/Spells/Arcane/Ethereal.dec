// Ethereal Body's looks (acs: CastEtherealBody, "DnD Ethereal Body", "DnD Ethereal Cast/Ripple/End FX").

// Pale mist: the cast's puffs flung out, and the trail the ghost leaves, lingering and thinning.
Actor Spell_Ethereal_Trail : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.5
	Scale 0.45
	States {
		Spawn:
			ETMS ABCD 6 Bright
			ETMS D 1 Bright A_FadeOut(0.04)
		Wait
	}
}

Actor Spell_Ethereal_Puff : Spell_Ethereal_Trail {
	Alpha 0.6
	Scale 0.6
}

// A projectile passing through, and the cast's opening: a pale ripple opening and fading.
Actor Spell_Ethereal_Ripple : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.9
	Scale 0.15
	States {
		Spawn:
			ETRP A 1 Bright A_SetScale(scalex + 0.05)
			TNT1 A 0 A_FadeOut(0.08)
		Loop
	}
}

// The end: a softer pulse drawing in as the body solidifies.
Actor Spell_Ethereal_Solid : Spell_Ethereal_Ripple {
	Alpha 0.7
	Scale 0.7
	States {
		Spawn:
			ETRP A 1 Bright A_SetScale(scalex - 0.04)
			TNT1 A 0 A_FadeOut(0.06)
		Loop
	}
}

// While ghostly: a player attachment (DnD_Attachments.h) letting mist off the body that lingers where it was; on its own
// player's screen it lets none (it would rise past the eye; the haze shows instead).
Actor DnD_EtherealActive : DnD_Boolean {}

Actor Spell_Ethereal_FXSpawner : DnD_Activator {
	States {
		Pickup:
			TNT1 A 1 ACS_NamedExecuteWithResult("DnD Spawn Player Aura", PLAYERFX_ETHEREAL)
		Stop
	}
}

Actor Spell_EtherealFX {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOTONAUTOMAP
	States {
		Spawn:
			TNT1 A 1 NoDelay A_JumpIfInTargetInventory("DnD_EtherealActive", 1, "Pick")
		Stop
		Pick:
			TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DnD Enchant Own Runes"), "Own")
		Mist:
			TNT1 A 4 A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_Ethereal_Trail", frandom(-6, 6), frandom(-6, 6), frandom(6, mass * 2 - 10), 0, 0, frandom(0.2, 0.5), 0, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_JumpIfInTargetInventory("DnD_EtherealActive", 1, "Mist")
		Stop
		Own:
			TNT1 A 5
			TNT1 A 0 A_JumpIfInTargetInventory("DnD_EtherealActive", 1, "Own")
		Stop
	}
}
