// Arcane Trap's looks (acs: "DnD Arcane Trap Link/Cut/Blast/Hole FX"); the trap itself is in Batch4.dec.

// A trip-wire (ATWIRE on FORKBEAM.md3, ArcWire.fp): redrawn every 20 tics, living 23, fading in and out so draws cross.
Actor Spell_ArcaneTrap_Wire : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 0
	States {
		Spawn:
			TNT1 A 0
			ATWR AAA 1 Bright A_FadeIn(0.34)
			ATWR A 17 Bright
		Cut:
			ATWR A 1 Bright A_FadeOut(0.34)
		Loop
	}
}

// A blast at the trap's spot on the floor: a flash, a short column of light and sparks; the ring is grown by ACS.
Actor Spell_ArcaneTrap_Burst : DnD_SpecialFX {
	+NOGRAVITY
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_SpawnItemEx("Spell_ArcaneTrap_Flash", 0, 0, 10, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ArcaneTrap_Column", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ArcaneTrap_Spark", 0, 0, 6, frandom(2, 5), 0, frandom(1, 4), random(0, 359), SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ArcaneTrap_Spark", 0, 0, 6, frandom(2, 5), 0, frandom(1, 4), random(0, 359), SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ArcaneTrap_Spark", 0, 0, 6, frandom(2, 5), 0, frandom(1, 4), random(0, 359), SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ArcaneTrap_Spark", 0, 0, 6, frandom(2, 5), 0, frandom(1, 4), random(0, 359), SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ArcaneTrap_Spark", 0, 0, 6, frandom(2, 5), 0, frandom(1, 4), random(0, 359), SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ArcaneTrap_Spark", 0, 0, 6, frandom(2, 5), 0, frandom(1, 4), random(0, 359), SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ArcaneTrap_Spark", 0, 0, 6, frandom(2, 5), 0, frandom(1, 4), random(0, 359), SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ArcaneTrap_Spark", 0, 0, 6, frandom(2, 5), 0, frandom(1, 4), random(0, 359), SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ArcaneTrap_Spark", 0, 0, 6, frandom(2, 5), 0, frandom(1, 4), random(0, 359), SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ArcaneTrap_Spark", 0, 0, 6, frandom(2, 5), 0, frandom(1, 4), random(0, 359), SXF_NOCHECKPOSITION)
		Stop
	}
}

Actor Spell_ArcaneTrap_Flash : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.5
	States {
		Spawn:
			ATFL A 1 Bright A_SetScale(0.9)
			ATFL A 1 Bright A_SetScale(1.1)
		Fade:
			ATFL A 1 Bright A_SetScale(scalex * 1.04)
			TNT1 A 0 A_FadeOut(0.16)
		Loop
	}
}

Actor Spell_ArcaneTrap_Column : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.6
	States {
		Spawn:
			ATCL A 1 Bright A_SetScale(1.2, 0.45)
			ATCL A 1 Bright A_SetScale(1.4, 0.6)
		Fade:
			ATCL A 1 Bright A_SetScale(scalex * 0.9, scaley * 1.04)
			TNT1 A 0 A_FadeOut(0.14)
		Loop
	}
}

Actor Spell_ArcaneTrap_Spark : DnD_SpecialFX {
	RenderStyle Add
	Alpha 1.0
	Scale 0.5
	Gravity 0.3
	States {
		Spawn:
			TNT1 A 0
			ATSP A 1 Bright A_ChangeFlag("NOGRAVITY", 0)
		Fly:
			ATSP A 1 Bright A_FadeOut(0.05)
		Loop
	}
}

// The blast's ring (ATSHOCK on flat2, ArcShock.fp), scaled out to the radius by ACS, then fading.
Actor Spell_ArcaneTrap_Shock : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.3
	States {
		Spawn:
			ATSH A 9 Bright
		Fade:
			ATSH A 1 Bright A_FadeOut(0.34)
		Loop
	}
}

// The black hole (ATHOLE on flat2, ArcHole.fp; Translucent at a low alpha so the shader's alpha drives the blend),
// sized and taken away by ACS.
Actor Spell_ArcaneTrap_Hole : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Translucent
	Alpha 0.1
	Scale 0.01
	States {
		Spawn:
			ATHL A -1
		Stop
	}
}

// A mote from the hole's rim (its mass is the rim's distance, set by ACS) spiralling in to the heart over 14 tics.
Actor Spell_ArcaneTrap_HoleMote : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.9
	Scale 0.6
	var int user_a;
	var int user_n;
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_SetUserVar("user_a", angle)
			TNT1 A 0 A_Warp(AAPTR_DEFAULT, mass * cos(user_a), mass * sin(user_a), 0, 0, WARPF_NOCHECKPOSITION | WARPF_ABSOLUTEOFFSET)
		Spiral:
			ATMT A 1 Bright A_ChangeVelocity(-cos(user_a) * mass / 16.0 - sin(user_a) * mass / 22.0, -sin(user_a) * mass / 16.0 + cos(user_a) * mass / 22.0, 0, CVF_REPLACE)
			TNT1 A 0 A_SetUserVar("user_a", user_a + 9 + user_n * 2)
			TNT1 A 0 A_SetUserVar("user_n", user_n + 1)
			TNT1 A 0 A_JumpIf(user_n < 14, "Spiral")
		Stop
	}
}

// The collapse: a flash drawing in, then a small ring kicked out.
Actor Spell_ArcaneTrap_Implode : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 1.6
	States {
		Spawn:
			ATFL A 1 Bright A_SetScale(1.2)
			ATFL A 1 Bright A_SetScale(0.8)
			ATFL A 1 Bright A_SetScale(0.45)
			ATFL A 1 Bright A_SetScale(0.25)
			TNT1 A 0 A_SpawnItemEx("Spell_ArcaneTrap_SmallShock", 0, 0, -13, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
			ATFL A 1 Bright A_SetScale(0.7)
		Fade:
			ATFL A 1 Bright A_FadeOut(0.25)
		Loop
	}
}

Actor Spell_ArcaneTrap_SmallShock : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.3
	States {
		Spawn:
			ATSH A 1 Bright A_SetScale(1.2)
			ATSH A 1 Bright A_SetScale(2.4)
			ATSH A 1 Bright A_SetScale(3.3)
			ATSH A 1 Bright A_SetScale(3.9)
		Fade:
			ATSH A 1 Bright A_FadeOut(0.34)
		Loop
	}
}
