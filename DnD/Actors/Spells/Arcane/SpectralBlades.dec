// A sword: the ripper carrying the model in the middle of a blade of five (Spell_SpectralBladePart on either side).
// ACS picks its frame with SetActorState, which reaches the clients too; its first tic keeps the old blade's life.
Actor Spell_SpectralBlade : DnD_Spell {
	PROJECTILE
	+RIPPER
	Speed 24
	Radius 6
	Height 12
	ReactionTime 6
	// ISSPELL 65536 + RIPSONCE 32768
	Stamina 98304
	RenderStyle Add
	Alpha 1.0
	Damage(ACS_NamedExecuteWithResult("DnD Spell Damage", SPELLVAL_DAMAGE))
	DamageType "Magic"
	// the four parts' tids, for the script that keeps the blade together
	var int user_p0;
	var int user_p1;
	var int user_p3;
	var int user_p4;
	States {
		SpawnState:
			TNT1 A 0
		Fly:
			TNT1 A 1
			TNT1 A 0 A_CountDown
		Loop
		FA:
			SBLD A 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FAFly:
			SBLD A 1 Bright
			SBLD A 0 A_CountDown
		Goto FAFly
		FB:
			SBLD B 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FBFly:
			SBLD B 1 Bright
			SBLD B 0 A_CountDown
		Goto FBFly
		FC:
			SBLD C 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FCFly:
			SBLD C 1 Bright
			SBLD C 0 A_CountDown
		Goto FCFly
		FD:
			SBLD D 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FDFly:
			SBLD D 1 Bright
			SBLD D 0 A_CountDown
		Goto FDFly
		FE:
			SBLD E 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FEFly:
			SBLD E 1 Bright
			SBLD E 0 A_CountDown
		Goto FEFly
		FF:
			SBLD F 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FFFly:
			SBLD F 1 Bright
			SBLD F 0 A_CountDown
		Goto FFFly
		FG:
			SBLD G 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FGFly:
			SBLD G 1 Bright
			SBLD G 0 A_CountDown
		Goto FGFly
		FH:
			SBLD H 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FHFly:
			SBLD H 1 Bright
			SBLD H 0 A_CountDown
		Goto FHFly
		FI:
			SBLD I 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FIFly:
			SBLD I 1 Bright
			SBLD I 0 A_CountDown
		Goto FIFly
		FJ:
			SBLD J 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FJFly:
			SBLD J 1 Bright
			SBLD J 0 A_CountDown
		Goto FJFly
		FK:
			SBLD K 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FKFly:
			SBLD K 1 Bright
			SBLD K 0 A_CountDown
		Goto FKFly
		FL:
			SBLD L 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FLFly:
			SBLD L 1 Bright
			SBLD L 0 A_CountDown
		Goto FLFly
		FM:
			SBLD M 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FMFly:
			SBLD M 1 Bright
			SBLD M 0 A_CountDown
		Goto FMFly
		FN:
			SBLD N 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FNFly:
			SBLD N 1 Bright
			SBLD N 0 A_CountDown
		Goto FNFly
		FO:
			SBLD O 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FOFly:
			SBLD O 1 Bright
			SBLD O 0 A_CountDown
		Goto FOFly
		FP:
			SBLD P 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FPFly:
			SBLD P 1 Bright
			SBLD P 0 A_CountDown
		Goto FPFly
		FQ:
			SBLD Q 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FQFly:
			SBLD Q 1 Bright
			SBLD Q 0 A_CountDown
		Goto FQFly
		FR:
			SBLD R 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FRFly:
			SBLD R 1 Bright
			SBLD R 0 A_CountDown
		Goto FRFly
		FS:
			SBLD S 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FSFly:
			SBLD S 1 Bright
			SBLD S 0 A_CountDown
		Goto FSFly
		FT:
			SBLD T 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FTFly:
			SBLD T 1 Bright
			SBLD T 0 A_CountDown
		Goto FTFly
		FU:
			SBLD U 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FUFly:
			SBLD U 1 Bright
			SBLD U 0 A_CountDown
		Goto FUFly
		FV:
			SBLD V 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FVFly:
			SBLD V 1 Bright
			SBLD V 0 A_CountDown
		Goto FVFly
		FW:
			SBLD W 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FWFly:
			SBLD W 1 Bright
			SBLD W 0 A_CountDown
		Goto FWFly
		FX:
			SBLD X 1 Bright ACS_NamedExecuteWithResult("DnD Projectile Checks")
		FXFly:
			SBLD X 1 Bright
			SBLD X 0 A_CountDown
		Goto FXFly
		// Keeps the sword's own frame, so it thins out as it fades.
		Death:
			"####" "#" 0 A_GiveInventory("DnD_SpectralBladeDone", 1)
			"####" "#" 1 Bright A_FadeOut(0.25)
		Wait
	}
}

// Rank 10: 20% longer, its parts spread to match.
Actor Spell_SpectralBladeWide : Spell_SpectralBlade {}

// The blade's other four hitboxes, laid along the drawn edge; they share the sword's ripper id and go when it does.
Actor Spell_SpectralBladePart : DnD_Spell {
	PROJECTILE
	+RIPPER
	Speed 24
	Radius 6
	Height 12
	ReactionTime 6
	Stamina 98304
	Damage(ACS_NamedExecuteWithResult("DnD Spell Damage", SPELLVAL_DAMAGE))
	DamageType "Magic"
	States {
		SpawnState:
			TNT1 A 0
		Fly:
			TNT1 A 1
			TNT1 A 0 A_CountDown
		Loop
		Death:
			TNT1 A 0
		Stop
	}
}

// Given to a sword as it dies, so its parts' script knows to end the blade.
Actor DnD_SpectralBladeDone : DnD_Info {}
