// Summon: Angel (the Arch-vile's frames in white and gold): a smite that splashes, its owner's Death Seeker and Purge.
ACTOR Spell_Angel : PetMonsterBase {
	Health 875
	GibHealth -1000
	Radius 20
	Height 56
	Speed 12
	PainChance 20
	Mass 500
	Stamina 1
	MeleeRange 80
	Translation "0:255=%[0.20,0.18,0.10]:[2.00,1.90,1.40]"
	SeeSound "vile/sight"
	PainSound "vile/pain"
	DeathSound "vile/death"
	ActiveSound "vile/active"
	Obituary "%o was judged by an angel."
	Tag "Angel"
	var int user_rest;
	var int user_bless;
	var int user_aura;
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Pet Monster Scale", 0, DND_PET_ANGELID, -1, -1)
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Pet Distance Move", 0)
		SpawnLoop:
			VILE AB 10 A_Look
		Goto See
		See:
			VILE AABBCCDDEEFF 2 A_Chase
		Loop
		Melee:
			TNT1 A 0 A_AlertMonsters(0, AMF_TARGETNONPLAYER)
			VILE G 5 A_FaceTarget
			VILE H 5 A_FaceTarget
			VILE I 4 Bright A_CustomMeleeAttack(ACS_NamedExecuteWithResult("DnD Spell Minion Hit", MINIONHIT_ANGEL, 0), "vile/stop", "", "Magic")
			TNT1 A 0 ACS_NamedExecuteWithResult("DnD Angel Splash")
			VILE J 4
		Goto See
		Missile:
			TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DnD Angel Cast", 1), "Cast")
		Goto See
		Cast:
			TNT1 A 0 A_AlertMonsters(0, AMF_TARGETNONPLAYER)
			VILE GH 6 Bright A_FaceTarget
			VILE I 6 Bright ACS_NamedExecuteWithResult("DnD Angel Cast", 0)
			VILE JK 5 Bright
		Goto See
		Pain:
			VILE Q 5
			VILE Q 5 A_Pain
		Goto See
		Death:
			"####" "#" 0 ACS_NamedExecuteAlways("DnD On Summon Death Check", 0, DND_PET_ANGELID)
			VILE Q 7
			VILE R 7 A_Scream
			VILE S 7 A_NoBlocking
			VILE TUVWX 7
			VILE Y 35
			VILE Y 1 A_FadeOut(0.05)
		Wait
	}
}

// Rank 5: it flies.
ACTOR Spell_AngelFlying : Spell_Angel {
	+FLOAT
	+NOGRAVITY
}

// On the Avenger while its anger lasts: quicker swings and throws.
Actor DnD_AvengerEnraged : DnD_Boolean {}

// Summon: Avenger (the Paladin's frames in gold): a melee blow, a ripping spear ("DnD Avenger Spear"), a shield ACS keeps.
ACTOR Spell_Avenger : PetMonsterBase {
	Health 1000
	GibHealth -1000
	Radius 24
	Height 60
	Speed 10
	PainChance 30
	Mass 1000
	Scale 0.9
	Stamina 1
	MeleeRange 88
	Translation "0:255=%[0.25,0.20,0.05]:[2.00,1.80,0.90]"
	SeeSound "Paladin/Sight"
	PainSound "Paladin/Pain"
	DeathSound "Paladin/Death"
	ActiveSound "Paladin/Active"
	Obituary "%o was smitten by an avenger."
	Tag "Avenger"
	var int user_shield;
	var int user_shieldback;
	var int user_enrage;
	var int user_enragecd;
	var int user_speed;
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Pet Monster Scale", 0, DND_PET_AVENGERID, -1, -1)
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Minion Life", 0, DND_PET_AVENGERID)
			TNT1 A 0 ACS_NamedExecuteAlways("DnD Pet Distance Move", 0)
		SpawnLoop:
			HPAL AB 10 A_Look
		Goto See
		See:
			HPAL AABBCCDD 3 A_Chase
		Loop
		Melee:
			TNT1 A 0 A_AlertMonsters(0, AMF_TARGETNONPLAYER)
			TNT1 A 0 A_JumpIfInventory("DnD_AvengerEnraged", 1, "MeleeFast")
			HPAL MN 6 A_FaceTarget
			HPAL O 6 A_CustomMeleeAttack(ACS_NamedExecuteWithResult("DnD Spell Minion Hit", MINIONHIT_AVENGERMELEE, 0), "weapons/vblhit", "weapons/vblswg", "Magic")
		Goto See
		MeleeFast:
			HPAL MN 4 A_FaceTarget
			HPAL O 4 A_CustomMeleeAttack(ACS_NamedExecuteWithResult("DnD Spell Minion Hit", MINIONHIT_AVENGERMELEE, 0), "weapons/vblhit", "weapons/vblswg", "Magic")
		Goto See
		Missile:
			TNT1 A 0 A_AlertMonsters(0, AMF_TARGETNONPLAYER)
			TNT1 A 0 A_Jump(160, "See")
			TNT1 A 0 A_JumpIfInventory("DnD_AvengerEnraged", 1, "MissileFast")
			HPAL I 8 A_FaceTarget
			HPAL J 6 Bright ACS_NamedExecuteWithResult("DnD Avenger Spear")
			HPAL I 6
		Goto See
		MissileFast:
			HPAL I 5 A_FaceTarget
			HPAL J 4 Bright ACS_NamedExecuteWithResult("DnD Avenger Spear")
			HPAL I 4
		Goto See
		Pain:
			HPAL P 3
			HPAL P 3 A_Pain
		Goto See
		Death:
			"####" "#" 0 ACS_NamedExecuteAlways("DnD On Summon Death Check", 0, DND_PET_AVENGERID)
			HPAL Q 7 A_Scream
			HPAL RS 7
			HPAL T 7 A_NoBlocking
			HPAL UV 7
			HPAL W 35
			HPAL W 1 A_FadeOut(0.05)
		Wait
	}
}

// The spear: through bodies to a wall; ACS strikes for it and drops its tid at its end.
Actor Spell_Avenger_Spear {
	PROJECTILE
	+THRUACTORS
	Speed 25
	Radius 6
	Height 8
	Damage 0
	RenderStyle Add
	Alpha 0.95
	Scale 0.5
	Translation "0:255=%[0.00,0.00,0.00]:[2.00,1.80,0.90]"
	States {
		Spawn:
			SPFX A 1 Bright A_SpawnItem("Spell_HolyLight_Mote")
		Loop
		Death:
			TNT1 A 0 Thing_ChangeTID(0, 0)
			TNT1 A 0 A_Stop
			SPFX A 1 Bright A_FadeOut(0.2)
		Wait
	}
}
