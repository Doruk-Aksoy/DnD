// Invigorate's looks (acs: "DnD Invigorate Surge FX", "DnD Invigorate Linger").

// One streak of the surge: ACS sends it shooting up; it thins out.
Actor Spell_Invigorate_Streak : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	XScale 0.35
	YScale 0.6
	States {
		Spawn:
			TNT1 A 0
			IVST A 1 Bright
			IVST A 1 Bright A_FadeOut(0.12)
		Wait
	}
}

// The caster's own surge: thinner, rising in an arc ahead of the eye.
Actor Spell_Invigorate_StreakThin : Spell_Invigorate_Streak {
	XScale 0.25
	YScale 0.45
}

Actor Spell_Invigorate_Sparkle : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.4
	States {
		Spawn:
			IVMT A 1 Bright A_FadeOut(0.035)
		Loop
	}
}

Actor Spell_Invigorate_Mote : Spell_Invigorate_Sparkle {
	Scale 0.28
	Alpha 0.8
}

// The pulse ring (IVRING on flat2, MODELDEF.spell): flashes out from the chest, or the caster's own feet.
Actor Spell_Invigorate_Pulse : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	States {
		Spawn:
			TNT1 A 0
		Grow:
			IVRG A 1 Bright A_SetScale(scalex + 0.356)
			TNT1 A 0 A_FadeOut(0.11)
		Loop
	}
}

// While the buff lasts: a player attachment (DnD_Attachments.h) letting faint sparkles rise from round the feet.
Actor DnD_InvigorateActive : DnD_Boolean {}

Actor Spell_Invigorate_FXSpawner : DnD_Activator {
	States {
		Pickup:
			TNT1 A 1 ACS_NamedExecuteWithResult("DnD Spawn Player Aura", PLAYERFX_INVIGORATE)
		Stop
	}
}

Actor Spell_InvigorateFX {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOTONAUTOMAP
	var int user_n;
	var int user_a;
	var int user_r;
	States {
		Spawn:
			TNT1 A 1 NoDelay A_JumpIfInTargetInventory("DnD_InvigorateActive", 1, "Active")
		Stop
		Active:
			TNT1 A 1 A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SetUserVar("user_n", user_n + 1)
			TNT1 A 0 A_JumpIf(user_n % 4, "Check")
			TNT1 A 0 A_SetUserVar("user_a", random(0, 359))
			TNT1 A 0 A_SetUserVar("user_r", random(10, 22))
			TNT1 A 0 A_SpawnItemEx("Spell_Invigorate_Mote", user_r * cos(user_a), user_r * sin(user_a), frandom(0, 6), 0, 0, frandom(0.5, 1.0), 0, SXF_ABSOLUTEPOSITION)
		Check:
			TNT1 A 0 A_JumpIfInTargetInventory("DnD_InvigorateActive", 1, "Active")
		Stop
	}
}
