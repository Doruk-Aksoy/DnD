// Ascension's looks (acs: CastAscension, "DnD Ascension Rise FX", "DnD Ascension Linger", DrawAscensionVignette).

// The column of light down onto the caster as they ascend, and its flash.
Actor Spell_Ascension_Column : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	XScale 0.9
	YScale 0.8
	States {
		Spawn:
			TNT1 A 0
		Fade:
			ASCL A 1 Bright A_SetScale(scalex * 0.9, scaley)
			TNT1 A 0 A_FadeOut(0.07)
		Loop
	}
}

Actor Spell_Ascension_Flash : Spell_HolyLight_Flare {
	Scale 0.8
	Translation "0:255=%[0.00,0.00,0.00]:[1.40,1.00,2.00]"
}

Actor Spell_Ascension_Mote : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.35
	States {
		Spawn:
			ASMT A 1 Bright A_FadeOut(0.03)
		Loop
	}
}

// While ascended: a player attachment (DnD_Attachments.h). Its follower is the glow washing the body (pulsing, letting
// off motes) and it raises the rune ring at the shoulders; on its own player's screen neither shows (the vignette does).
Actor DnD_AscensionActive : DnD_Boolean {}

Actor Spell_Ascension_FXSpawner : DnD_Activator {
	States {
		Pickup:
			TNT1 A 1 ACS_NamedExecuteWithResult("DnD Spawn Player Aura", PLAYERFX_ASCENSION)
		Stop
	}
}

Actor Spell_AscensionFX {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 0.0
	Scale 0.62
	States {
		Spawn:
			TNT1 A 1 NoDelay A_JumpIfInTargetInventory("DnD_AscensionActive", 1, "Pick")
		Stop
		Pick:
			TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DnD Enchant Own Runes"), "Own")
			TNT1 A 0 A_SpawnItemEx("Spell_Ascension_Ring", 0, 0, 0, 0, 0, 0, 0, SXF_TRANSFERPOINTERS | SXF_NOCHECKPOSITION)
		Rise:
			ASGL A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeIn(0.08)
			TNT1 A 0 A_JumpIf(alpha < 0.6, "Rise")
		Hold:
			ASGL A 2 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeOut(0.02)
			TNT1 A 0 A_SpawnItemEx("Spell_Ascension_Mote", frandom(6, 18), 0, frandom(-24, 12), 0, 0, frandom(0.8, 1.6), random(0, 359), SXF_NOCHECKPOSITION)
			ASGL A 2 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeOut(0.02)
			ASGL A 2 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeOut(0.02)
			TNT1 A 0 A_SpawnItemEx("Spell_Ascension_Mote", frandom(6, 18), 0, frandom(-24, 12), 0, 0, frandom(0.8, 1.6), random(0, 359), SXF_NOCHECKPOSITION)
			ASGL A 2 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeOut(0.02)
			ASGL A 2 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeOut(0.02)
			TNT1 A 0 A_SpawnItemEx("Spell_Ascension_Mote", frandom(6, 18), 0, frandom(-24, 12), 0, 0, frandom(0.8, 1.6), random(0, 359), SXF_NOCHECKPOSITION)
			ASGL A 2 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeOut(0.02)
			ASGL A 2 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeIn(0.02)
			TNT1 A 0 A_SpawnItemEx("Spell_Ascension_Mote", frandom(6, 18), 0, frandom(-24, 12), 0, 0, frandom(0.8, 1.6), random(0, 359), SXF_NOCHECKPOSITION)
			ASGL A 2 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeIn(0.02)
			ASGL A 2 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeIn(0.02)
			TNT1 A 0 A_SpawnItemEx("Spell_Ascension_Mote", frandom(6, 18), 0, frandom(-24, 12), 0, 0, frandom(0.8, 1.6), random(0, 359), SXF_NOCHECKPOSITION)
			ASGL A 2 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeIn(0.02)
			ASGL A 2 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeIn(0.02)
			TNT1 A 0 A_SpawnItemEx("Spell_Ascension_Mote", frandom(6, 18), 0, frandom(-24, 12), 0, 0, frandom(0.8, 1.6), random(0, 359), SXF_NOCHECKPOSITION)
			ASGL A 2 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeIn(0.02)
			TNT1 A 0 A_JumpIfInTargetInventory("DnD_AscensionActive", 1, "Hold")
		Fade:
			ASGL A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeOut(0.04)
			TNT1 A 0 A_JumpIf(alpha > 0.0, "Fade")
		Stop
		Own:
			TNT1 A 5
			TNT1 A 0 A_JumpIfInTargetInventory("DnD_AscensionActive", 1, "Own")
		Stop
	}
}

// The rune ring turning at shoulder height (ASRING on flat2, MODELDEF.spell), fading with the form.
Actor Spell_Ascension_Ring {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 0.0
	Scale 1.913
	States {
		Spawn:
			TNT1 A 0
		Rise:
			ASRG A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass * 3 / 2 + 4.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE)
			TNT1 A 0 A_SetAngle(angle + 3)
			TNT1 A 0 A_FadeIn(0.1)
			TNT1 A 0 A_JumpIf(alpha < 0.85, "Rise")
		Hold:
			ASRG A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass * 3 / 2 + 4.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE)
			TNT1 A 0 A_SetAngle(angle + 3)
			TNT1 A 0 A_JumpIfInTargetInventory("DnD_AscensionActive", 1, "Hold")
		Fade:
			ASRG A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass * 3 / 2 + 4.0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION | WARPF_USECALLERANGLE)
			TNT1 A 0 A_SetAngle(angle + 3)
			TNT1 A 0 A_FadeOut(0.05)
			TNT1 A 0 A_JumpIf(alpha > 0.0, "Fade")
		Stop
	}
}
