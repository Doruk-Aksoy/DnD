// Energized Armor's looks (acs: CastEnergizedArmor, "DnD Energized Armor", "DnD Energized Armor Burst FX").

// While it lasts: a player attachment (DnD_Attachments.h); the shell itself follows the player, its middle at half
// their height. Forms with a flash, then a steady glow. Seen from inside (its own player) it draws nothing.
Actor DnD_EnergArmorActive : DnD_Boolean {}

Actor Spell_EnergArmor_FXSpawner : DnD_Activator {
	States {
		Pickup:
			TNT1 A 1 ACS_NamedExecuteWithResult("DnD Spawn Player Aura", PLAYERFX_ENERGARMOR)
		Stop
	}
}

Actor Spell_EnergArmorFX {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 0.0
	Scale 0.53
	States {
		Spawn:
			TNT1 A 1 NoDelay A_JumpIfInTargetInventory("DnD_EnergArmorActive", 1, "Form")
		Stop
		Form:
			EASH A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeIn(0.25)
			TNT1 A 0 A_JumpIf(alpha < 1.0, "Form")
		Settle:
			EASH A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeOut(0.04)
			TNT1 A 0 A_JumpIf(alpha > 0.6, "Settle")
		Hold:
			EASH A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_JumpIfInTargetInventory("DnD_EnergArmorActive", 1, "Hold")
		Stop
	}
}

// The burst: the shell swelling away (ACS gives it the shell's spot), a flash, the shockwave (grown by ACS), sparks.
Actor Spell_EnergArmor_Pop : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.53
	States {
		Spawn:
			TNT1 A 0
		Swell:
			EASH A 1 Bright A_SetScale(scalex * 1.12)
			TNT1 A 0 A_FadeOut(0.12)
		Loop
	}
}

Actor Spell_EnergArmor_Flash : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.8
	States {
		Spawn:
			TNT1 A 0
			EAFL A 1 Bright A_SetScale(1.1)
			EAFL A 1 Bright A_SetScale(1.3)
		Fade:
			EAFL A 1 Bright A_SetScale(scalex + 0.06)
			TNT1 A 0 A_FadeOut(0.18)
		Loop
	}
}

Actor Spell_EnergArmor_Wave : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 1.5
	States {
		Spawn:
			EAWV A 12 Bright
		Fade:
			EAWV A 1 Bright A_FadeOut(0.18)
		Loop
	}
}

Actor Spell_EnergArmor_Spark : DnD_SpecialFX {
	RenderStyle Add
	Alpha 1.0
	Scale 0.55
	Gravity 0.4
	States {
		Spawn:
			TNT1 A 0
			EASP A 1 Bright A_ChangeFlag("NOGRAVITY", 0)
		Fly:
			EASP A 1 Bright A_FadeOut(0.06)
		Loop
	}
}
