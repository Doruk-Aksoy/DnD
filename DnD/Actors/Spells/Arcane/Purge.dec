// Purge's tendril: ACS aims and stretches it, PurgeRibbon.fp draws it; whole for 2 tics, then thinning out.
Actor Spell_Purge_Beam {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 1.0
	States {
		Spawn:
			PRBM A 2 Bright
		Fade:
			PRBM A 1 Bright A_FadeOut(0.08)
		Loop
	}
}

// A dark wisp driven out of an enemy it strikes, rising and thinning (soft alpha baked in).
Actor Spell_Purge_Wisp : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Translucent
	Alpha 1.0
	Scale 1.1
	States {
		Spawn:
			PRWS ABCD 5
		Stop
	}
}

// A hop that heals: the wisps rise as holy light instead.
Actor Spell_Purge_HolyWisp : Spell_Purge_Wisp {
	RenderStyle Add
	Alpha 0.7
	States {
		Spawn:
			PRWS EFGH 5 Bright
		Stop
	}
}

Actor Spell_Purge_Flare : Spell_HolyLight_Flare {
	Scale 0.55
}

// Where it strikes an enemy: a small gold flare, dark wisps driven out, glints rising.
Actor Spell_Purge_Burst : DnD_SpecialFX {
	+NOGRAVITY
	var int user_n;
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_SpawnItemEx("Spell_Purge_Flare", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
		Wisps:
			TNT1 A 0 A_SpawnItemEx("Spell_Purge_Wisp", frandom(2, 12), 0, frandom(-20, 6), frandom(0.5, 1.2), 0, frandom(1.4, 2.4), random(0, 359), SXF_CLIENTSIDE)
			TNT1 A 0 A_SpawnItemEx("Spell_HolyLight_Rise", frandom(2, 14), 0, frandom(-10, 14), frandom(0.2, 0.8), 0, frandom(0.8, 1.8), random(0, 359), SXF_CLIENTSIDE)
			TNT1 A 1 A_SetUserVar("user_n", user_n + 1)
			TNT1 A 0 A_JumpIf(user_n < 6, "Wisps")
		Stop
	}
}

// Where it heals an ally: the same, in holy light.
Actor Spell_Purge_HealBurst : Spell_Purge_Burst {
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_SpawnItemEx("Spell_Purge_Flare", 0, 0, 0, 0, 0, 0, 0, SXF_CLIENTSIDE)
		Wisps:
			TNT1 A 0 A_SpawnItemEx("Spell_Purge_HolyWisp", frandom(2, 12), 0, frandom(-20, 6), frandom(0.5, 1.2), 0, frandom(1.4, 2.4), random(0, 359), SXF_CLIENTSIDE)
			TNT1 A 0 A_SpawnItemEx("Spell_HolyLight_Rise", frandom(2, 14), 0, frandom(-10, 14), frandom(0.2, 0.8), 0, frandom(0.8, 1.8), random(0, 359), SXF_CLIENTSIDE)
			TNT1 A 1 A_SetUserVar("user_n", user_n + 1)
			TNT1 A 0 A_JumpIf(user_n < 6, "Wisps")
		Stop
	}
}
