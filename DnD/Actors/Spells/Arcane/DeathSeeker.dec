// The spirit, a flickering white-gold soul flame shedding wisps of light: ACS steers it through walls and bodies to its
// quarry and strikes from there; it only fades on its own.
Actor Spell_DeathSeeker {
	Radius 6
	Height 12
	RenderStyle Add
	Alpha 0.95
	Scale 0.5
	+NOINTERACTION
	+NOGRAVITY
	+NOBLOCKMAP
	+DONTSPLASH
	States {
		Spawn:
			TNT1 A 0
		Fly:
			DSKS A 1 Bright A_SpawnItemEx("Spell_DeathSeeker_Wisp", 0, 0, 0, frandom(-0.3, 0.3), frandom(-0.3, 0.3), frandom(-0.2, 0.3), 0, SXF_CLIENTSIDE | SXF_NOCHECKPOSITION)
			DSKS B 1 Bright A_SpawnItemEx("Spell_DeathSeeker_Wisp", 0, 0, 0, frandom(-0.3, 0.3), frandom(-0.3, 0.3), frandom(-0.2, 0.3), 0, SXF_CLIENTSIDE | SXF_NOCHECKPOSITION)
			DSKS C 1 Bright A_SpawnItemEx("Spell_DeathSeeker_Wisp", 0, 0, 0, frandom(-0.3, 0.3), frandom(-0.3, 0.3), frandom(-0.2, 0.3), 0, SXF_CLIENTSIDE | SXF_NOCHECKPOSITION)
			DSKS D 1 Bright A_SpawnItemEx("Spell_DeathSeeker_Wisp", 0, 0, 0, frandom(-0.3, 0.3), frandom(-0.3, 0.3), frandom(-0.2, 0.3), 0, SXF_CLIENTSIDE | SXF_NOCHECKPOSITION)
			DSKS E 1 Bright A_SpawnItemEx("Spell_DeathSeeker_Wisp", 0, 0, 0, frandom(-0.3, 0.3), frandom(-0.3, 0.3), frandom(-0.2, 0.3), 0, SXF_CLIENTSIDE | SXF_NOCHECKPOSITION)
			DSKS F 1 Bright A_SpawnItemEx("Spell_DeathSeeker_Wisp", 0, 0, 0, frandom(-0.3, 0.3), frandom(-0.3, 0.3), frandom(-0.2, 0.3), 0, SXF_CLIENTSIDE | SXF_NOCHECKPOSITION)
		Loop
		Fade:
			DSKS ABCDEF 1 Bright A_FadeOut(0.15)
		Loop
	}
}

Actor Spell_DeathSeeker_Wisp : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.7
	Scale 0.55
	States {
		Spawn:
			DSKT A 1 Bright A_SetScale(scalex * 0.9)
			TNT1 A 0 A_FadeOut(0.07)
		Loop
	}
}

// The strike ("DnD Death Seeker Strike FX"): a flash, an eight-point star opening, a gold ring spreading, embers falling.
Actor Spell_DeathSeeker_Flash : Spell_HolyLight_Flare {
	Scale 0.6
}

Actor Spell_DeathSeeker_Star : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.3
	States {
		Spawn:
			DSKF A 1 Bright A_SetScale(0.55)
			DSKF A 1 Bright A_SetScale(0.7)
			DSKF A 1 Bright A_SetScale(0.78)
		Fade:
			DSKF A 1 Bright A_SetScale(scalex + 0.02)
			TNT1 A 0 A_FadeOut(0.12)
		Loop
	}
}

Actor Spell_DeathSeeker_Ring : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.12
	States {
		Spawn:
			DFRG A 1 Bright A_SetScale(0.2)
			DFRG A 1 Bright A_SetScale(0.28)
		Grow:
			DFRG A 1 Bright A_SetScale(scalex + 0.04)
			TNT1 A 0 A_FadeOut(0.14)
		Loop
	}
}

Actor Spell_DeathSeeker_Ember : DnD_SpecialFX {
	RenderStyle Add
	Alpha 1.0
	Scale 0.5
	Gravity 0.35
	States {
		Spawn:
			TNT1 A 0
			HWEM A 1 Bright A_ChangeFlag("NOGRAVITY", 0)
		Fly:
			HWEM A 1 Bright A_FadeOut(0.04)
		Loop
	}
}
