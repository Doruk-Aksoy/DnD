// Purify's looks (acs: "DnD Purify Ring FX", "DnD Purify Smite FX").

// The cleansing ring (PRFYRING on flat2, MODELDEF.spell): ACS sizes it and sends it up the body; at the top it draws in
// and fades.
Actor Spell_Purify_Ring : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.0
	States {
		Spawn:
			TNT1 A 0
		Rise:
			PFRG A 1 Bright A_SetAngle(angle - 6)
			TNT1 A 0 A_JumpIf(alpha >= 1.0, "Rise")
			TNT1 A 0 A_FadeIn(0.25)
		Loop
		Out:
			PFRG A 1 Bright A_SetScale(scalex * 0.9)
			TNT1 A 0 A_FadeOut(0.16)
		Loop
	}
}

// An ailment driven out: a dark wisp rising with the ring.
Actor Spell_Purify_Wisp : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Translucent
	Alpha 1.0
	Scale 0.8
	States {
		Spawn:
			PRWS ABCD 4
		Stop
	}
}

Actor Spell_Purify_Mote : Spell_HolyLight_Rise {
	Scale 0.55
}

// The smite on a demon: the flash, white-gold flames licking up it (PFFL A-F, ACS sizes them), smoke and sparks.
Actor Spell_Purify_Flash : Spell_HolyLight_Flare {
	Scale 0.7
}

Actor Spell_Purify_Flame : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.95
	Scale 0.42
	States {
		Spawn:
			PFFL ABCDEF 2 Bright
			PFFL A 2 Bright A_FadeOut(0.3)
			PFFL B 2 Bright A_FadeOut(0.3)
			PFFL C 2 Bright A_FadeOut(0.3)
		Stop
	}
}

Actor Spell_Purify_Smoke : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Translucent
	Alpha 0.8
	Scale 0.8
	States {
		Spawn:
			PRWS ABCD 5
		Stop
	}
}

Actor Spell_Purify_Spark : Spell_HolyLight_Rise {
	Scale 0.4
}
