// ---- Conviction's mark (acs: "DnD Conviction Mark" and the FX scripts beside it) ----
// On a monster while a Conviction mark lasts, so a renewing pulse only brightens it.
Actor DnD_ConvictionFX : DnD_Info {}

// Over a marked enemy's head: stamps down from large, holds (CvBrand: a pulsing glow, a turning tick circle) and swells
// a little on each pulse that renews it. Run out: fades. Spent: gone at once, the burst draws the break.
Actor Spell_Conviction_Brand : DnD_AttachedFXBase {
	RenderStyle Add
	Alpha 1.0
	Scale 0.34
	var int user_sc;
	States {
		SpawnLoop:
			TNT1 A 0 A_SetUserVar("user_sc", scalex * 1000)
			TNT1 A 0 A_SpawnItemEx("Spell_Conviction_StampRing")
			TNT1 A 0 A_SetScale(user_sc * 0.0023)
			CVMB A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SetScale(user_sc * 0.0018)
			CVMB A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SetScale(user_sc * 0.0014)
			CVMB A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SetScale(user_sc * 0.00115)
			CVMB A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SetScale(user_sc * 0.001)
		Hold:
			CVMB A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
		Loop
		Refresh:
			TNT1 A 0 A_SetScale(user_sc * 0.0014)
			CVMB A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SetScale(user_sc * 0.00125)
			CVMB A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SetScale(user_sc * 0.0011)
			CVMB A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SetScale(user_sc * 0.001)
		Goto Hold
		Disappear:
			CVMB A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, mass, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeOut(0.12)
		Loop
		Spent:
			TNT1 A 1
		Stop
	}
}

// At a marked enemy's feet: a small turning ring of brands (CvRing on flat.md3, MODELDEF.spell), sized to it.
Actor Spell_Conviction_Ring : DnD_AttachedFXBase {
	RenderStyle Add
	Alpha 0.0
	Scale 2.4
	States {
		SpawnLoop:
			CVMR A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeIn(0.15)
			TNT1 A 0 A_JumpIf(alpha < 0.9, "SpawnLoop")
		Hold:
			CVMR A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
		Loop
		Refresh:
		Goto Hold
		Disappear:
			CVMR A 1 Bright A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_FadeOut(0.1)
		Loop
		Spent:
			TNT1 A 1
		Stop
	}
}

// The violet ring snapping outward as a brand stamps on.
Actor Spell_Conviction_StampRing : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.08
	States {
		Spawn:
			TNT1 A 0
			DFRG B 1 Bright A_SetScale(0.16)
			DFRG B 1 Bright A_SetScale(0.24)
			DFRG B 1 Bright A_SetScale(0.3)
		Grow:
			DFRG B 1 Bright A_SetScale(scalex + 0.03)
			TNT1 A 0 A_FadeOut(0.2)
		Loop
	}
}

// The burst: a violet flash at the struck enemy's middle.
Actor Spell_Conviction_Flash : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.9
	States {
		Spawn:
			TNT1 A 0
			CVMF A 1 Bright A_SetScale(1.2)
			CVMF A 1 Bright A_SetScale(1.4)
		Fade:
			CVMF A 1 Bright A_SetScale(scalex + 0.05)
			TNT1 A 0 A_FadeOut(0.2)
		Loop
	}
}

// The brand flaring and swelling as it breaks (ACS gives it the brand's scale).
Actor Spell_Conviction_BrandPop : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.34
	States {
		Spawn:
			TNT1 A 0
			CVMB A 1 Bright A_SetScale(scalex * 1.3)
			CVMB A 1 Bright A_SetScale(scalex * 1.22)
		Fade:
			CVMB A 1 Bright A_SetScale(scalex * 1.15)
			TNT1 A 0 A_FadeOut(0.3)
		Loop
	}
}

Actor Spell_Conviction_Shard : DnD_SpecialFX {
	RenderStyle Add
	Alpha 1.0
	Scale 0.45
	Gravity 0.6
	States {
		Spawn:
			TNT1 A 0
			CVMS A 1 Bright A_ChangeFlag("NOGRAVITY", 0)
		Fly:
			CVMS A 1 Bright A_FadeOut(0.05)
		Loop
	}
}

Actor Spell_Conviction_Smoke : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Translucent
	Alpha 0.9
	Scale 0.9
	States {
		Spawn:
			PRWS ABCD 5
		Stop
	}
}

// The burst's shockwave over the floor; ACS grows it to the burst's reach, then it fades.
Actor Spell_Conviction_Shock : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.5
	States {
		Spawn:
			CVMK A 12 Bright
		Fade:
			CVMK A 1 Bright A_FadeOut(0.2)
		Loop
	}
}

// Each marking pulse: a wave out across the caster's Conviction ring to its fixed 144 (10.24 of CVMSHOCK's ring).
Actor Spell_Conviction_Wave : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.6
	Scale 2.0
	var int user_n;
	States {
		Spawn:
			TNT1 A 0
		Grow:
			CVMK A 1 Bright A_SetScale(scalex + 0.82)
			TNT1 A 0 A_SetUserVar("user_n", user_n + 1)
			TNT1 A 0 A_JumpIf(user_n < 10, "Grow")
		Fade:
			CVMK A 1 Bright A_FadeOut(0.15)
		Loop
	}
}
