// On a player: whose Iron Maiden covers them (pnum + 1) and until when (level time).
Actor DnD_IronMaidenOwner : DnD_Info {}
Actor DnD_IronMaidenUntil : DnD_Info {}
// On a monster: when Iron Maiden rank 10 may stun it again; Conviction's marker (pnum + 1), its end, and rank 10's
// exposure (amount, damage category + 1, end).
Actor DnD_IronMaidenStunAt : DnD_Info {}
Actor DnD_ConvictionOwner : DnD_Info {}
Actor DnD_ConvictionUntil : DnD_Info {}
Actor DnD_ConvictionExposed : DnD_Info {}
Actor DnD_ConvictionExposedCat : DnD_Info {}
Actor DnD_ConvictionExposedUntil : DnD_Info {}

// ---- Aura rings, built like Anger's (Fire/Anger.dec): the marker's presence is the aura, the spawner raises the ring,
// which follows its owner on AURA Y (MODELDEF.aura) at the rings' fixed 144 while the marker holds ----
Actor DnD_HolyPrayersAuraActive : DnD_Boolean {}

Actor Spell_HolyPrayersAura_FXSpawner : DnD_Activator {
	States {
		Pickup:
			TNT1 A 1 ACS_NamedExecuteWithResult("DnD Spawn Player Aura", PLAYERFX_HOLYPRAYERSAURA)
		Stop
	}
}

Actor Spell_HolyPrayersAuraFX {
	RenderStyle Add
	Alpha 0.5
	Scale 10.5
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOTONAUTOMAP
	var int user_n;
	var int user_a;
	var int user_r;
	States {
		Spawn:
			TNT1 A 1 NoDelay A_JumpIfInTargetInventory("DnD_HolyPrayersAuraActive", 1, "Active")
		Stop
		Active:
			TNT1 A 0 A_JumpIf(ACS_NamedExecuteWithResult("DnD Auras Hidden"), "Hidden")
			AURA Y 1 Bright A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_INTERPOLATE | WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_SetUserVar("user_n", user_n + 1)
			TNT1 A 0 A_JumpIf(user_n % 6, "Check")
			TNT1 A 0 A_SetUserVar("user_a", random(0, 359))
			TNT1 A 0 A_SetUserVar("user_r", random(80, 132))
			TNT1 A 0 A_SpawnItemEx("Spell_HolyLight_Rise", user_r * cos(user_a), user_r * sin(user_a), frandom(2, 10), 0, 0, frandom(0.5, 1.1), 0, SXF_ABSOLUTEPOSITION)
		Check:
			TNT1 A 0 A_JumpIfInTargetInventory("DnD_HolyPrayersAuraActive", 1, "Active")
		Stop
		Hidden:
			TNT1 A 1 A_Warp(AAPTR_TARGET, 0, 0, 0, 0, WARPF_USECALLERANGLE | WARPF_NOCHECKPOSITION)
			TNT1 A 0 A_JumpIfInTargetInventory("DnD_HolyPrayersAuraActive", 1, "Active")
		Stop
	}
}

