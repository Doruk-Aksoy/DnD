// Mana Burn's looks (acs: "DnD Mana Burn Beam FX", "DnD Mana Burn Return FX").

// The drain: MBBEAM on FORKBEAM.md3 (ManaBurnBeam.fp), stretched hands to target by SpawnStretchedBeam; whole 3 tics.
Actor Spell_ManaBurn_Beam {
	+CLIENTSIDEONLY
	+NOINTERACTION
	+NOGRAVITY
	+NOTONAUTOMAP
	RenderStyle Add
	Alpha 1.0
	States {
		Spawn:
			MBBM A 3 Bright
		Fade:
			MBBM A 1 Bright A_FadeOut(0.08)
		Loop
	}
}

// The burst on the target: a soft flash, a spray of mana sparks, a little violet smoke.
Actor Spell_ManaBurn_Burst : DnD_SpecialFX {
	+NOGRAVITY
	States {
		Spawn:
			TNT1 A 0
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Flash", 0, 0, 0, 0, 0, 0, 0, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Spark", 0, 0, 0, frandom(1.5, 3.5), 0, frandom(-0.5, 2.5), 0, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Spark", 0, 0, 0, frandom(1.5, 3.5), 0, frandom(-0.5, 2.5), 36, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Spark", 0, 0, 0, frandom(1.5, 3.5), 0, frandom(-0.5, 2.5), 72, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Spark", 0, 0, 0, frandom(1.5, 3.5), 0, frandom(-0.5, 2.5), 108, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Spark", 0, 0, 0, frandom(1.5, 3.5), 0, frandom(-0.5, 2.5), 144, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Spark", 0, 0, 0, frandom(1.5, 3.5), 0, frandom(-0.5, 2.5), 180, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Spark", 0, 0, 0, frandom(1.5, 3.5), 0, frandom(-0.5, 2.5), 216, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Spark", 0, 0, 0, frandom(1.5, 3.5), 0, frandom(-0.5, 2.5), 252, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Spark", 0, 0, 0, frandom(1.5, 3.5), 0, frandom(-0.5, 2.5), 288, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Spark", 0, 0, 0, frandom(1.5, 3.5), 0, frandom(-0.5, 2.5), 324, SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Smoke", frandom(0, 8), 0, frandom(-8, 8), frandom(0.2, 0.6), 0, frandom(0.4, 0.9), random(0, 359), SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Smoke", frandom(0, 8), 0, frandom(-8, 8), frandom(0.2, 0.6), 0, frandom(0.4, 0.9), random(0, 359), SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Smoke", frandom(0, 8), 0, frandom(-8, 8), frandom(0.2, 0.6), 0, frandom(0.4, 0.9), random(0, 359), SXF_NOCHECKPOSITION)
			TNT1 A 0 A_SpawnItemEx("Spell_ManaBurn_Smoke", frandom(0, 8), 0, frandom(-8, 8), frandom(0.2, 0.6), 0, frandom(0.4, 0.9), random(0, 359), SXF_NOCHECKPOSITION)
		Stop
	}
}

Actor Spell_ManaBurn_Flash : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.9
	Scale 0.35
	States {
		Spawn:
			MBFA A 1 Bright A_SetScale(0.5)
			MBFA A 1 Bright A_SetScale(0.6)
		Fade:
			MBFA A 1 Bright A_SetScale(scalex + 0.03)
			TNT1 A 0 A_FadeOut(0.2)
		Loop
	}
}

Actor Spell_ManaBurn_Spark : DnD_SpecialFX {
	RenderStyle Add
	Alpha 1.0
	Scale 0.6
	Gravity 0.2
	States {
		Spawn:
			TNT1 A 0
			MBSP A 1 Bright A_ChangeFlag("NOGRAVITY", 0)
		Fly:
			MBSP A 1 Bright A_FadeOut(0.04)
		Loop
	}
}

Actor Spell_ManaBurn_Smoke : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 0.45
	Scale 0.5
	States {
		Spawn:
			MBSM ABCD 5 Bright
			MBSM D 1 Bright A_FadeOut(0.05)
		Wait
	}
}

// Rank 5: mana streaming back from a spellcasting enemy toward the caster's hands, shrinking away short of the eye.
Actor Spell_ManaBurn_Return : DnD_SpecialFX {
	+NOGRAVITY
	RenderStyle Add
	Alpha 1.0
	Scale 0.55
	States {
		Spawn:
			MBSP A 10 Bright
		Fade:
			MBSP A 1 Bright A_SetScale(scalex * 0.85)
			TNT1 A 0 A_FadeOut(0.18)
		Loop
	}
}
