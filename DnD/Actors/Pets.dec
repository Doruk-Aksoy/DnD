enum {
	DND_PET_ZOMBIEID,
	DND_PET_FIREDEMONID,
	DND_PET_ICEGOLEMID,
	DND_PET_ROCKGOLEMID,
	DND_PET_KNIGHTID,
	DND_PET_DEATHKNIGHTID,
	DND_PET_GHASTID,
	DND_PET_SLAYERKNIGHTID,
	DND_PET_DOOMGUARDID,
	DND_PET_DARKPORTALID,
};

// Which row a Black minion's hit reads, for "DnD Spell Minion Hit". MUST match DND_MINIONHIT_* in acs/Spells/DnD_Spells.h.
enum {
	MINIONHIT_KNIGHT,
	MINIONHIT_SLAYERMELEE,
	MINIONHIT_SLAYERFLAME,
	MINIONHIT_DOOMMELEE,
	MINIONHIT_KNIGHTAXE,
	MINIONHIT_KNIGHTREDAXE,
	MINIONHIT_DKMELEE,
	MINIONHIT_DKSKULL,
};

// Ids for "DnD Minion Cooldown". MUST match the DND_MINIONCD_* enum in acs/DnD_Skills.h, in
// order -- these are passed into ACS numerically.
enum {
	DND_MINIONCD_BURNINGGROUND,
};

Actor MovePetCooldown : PowerDamage {
	damagefactor "normal", 1.0
	powerup.duration -3
}

Actor PetTargetClear : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_ClearTarget
		Stop
	}
}

// The flag writers for "DnD Pet Reactivity". ACS cannot set an actor flag in Zandronum, so the
// window is opened and closed from a Pickup state.
Actor PetRetaliateOff : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_ChangeFlag("QUICKTORETALIATE", 0)
		Stop
	}
}

Actor PetRetaliateOn : DnD_Activator {
	States {
		Pickup:
			TNT1 A 0 A_ChangeFlag("QUICKTORETALIATE", 1)
		Stop
	}
}

Actor PetMonsterBase {
	Monster
	Species "Player"
	+USEKILLSCRIPTS
	+FLOORCLIP
	+DONTBLAST
	-COUNTKILL
	+CANPUSHWALLS
	+CANUSEWALLS
	+CANPASS
	+USEDAMAGEEVENTSCRIPT
	+THRUSPECIES
	+DONTHURTSPECIES
	-ACTIVATEMCROSS
	-NOTELEPORT
	+NOBLOCKMONST
	+NEVERRESPAWN
	+NEVERFAST
	+DONTHARMSPECIES
	// On by default so a pet answers whatever is hitting it instead of ignoring it until its
	// threshold runs out. "DnD Pet Reactivity" takes it off while the pet commits to a new target.
	+QUICKTORETALIATE
	
	// No shared Death block here -- see the note in each pet's own Death state (Spell_Zombie in Spells/Black/Zombie.dec).
}

ACTOR FodderSoul {
	+NOBLOCKMAP
	+NOGRAVITY
	+CLIENTSIDEONLY
	States {
		Spawn:
			TNT1 A 0 NoDelay A_Playsound("ZombieFodder/Soul")
			ZFSL ABC 5
			ZFSL DEFG 9
		Stop
	}
}