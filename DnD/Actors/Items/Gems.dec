// Gems: one drop actor per kind, in GetGemIndex order (acs/Inventory/DnD_Gems.h). GMDP A-P are the world
// sprites in that same order, defined in TEXTURES.inv off the GM* art.
Actor GemSoundPlayer : CustomInventory {
	States {
		Pickup:
			TNT1 A 0 A_PlaySound("Items/GemPick")
			TNT1 A 0 A_SetBlend("25 99 25", 0.6, 17)
		Stop
	}
}

Actor GemDrop : InventoryBase {
	Radius 20
	Height 24
	+FLOATBOB
	States {
		SpawnLoop:
		Idle:
			"####" "#" 1 Bright A_LookEx(LOF_NOSOUNDCHECK, 0, item_look_dist, 0, 360, "CheckPickup")
		Loop

		PickupSuccess:
			TNT1 A 8 ACS_NamedExecuteAlways("DnD Gem Item Pickup", 0, mass - 1)
		stop
	}
}

// Ruby
Actor GemDrop_0 : GemDrop {
	States {
		Spawn:
			GMDP A 0
		Goto SpawnInit
	}
}

// Greater Ruby
Actor GemDrop_1 : GemDrop {
	States {
		Spawn:
			GMDP B 0
		Goto SpawnInit
	}
}

