        Goto SpawnWait
    }
}

Actor DnD_CrackleFXSpawner : DnD_Activator {
    States {
        Pickup:
            TNT1 A 0 A_Jump(96, "Nothing")
            TNT1 AA 0 A_SpawnItemEx("DnD_CrackleFX", frandom(-radius / 2, radius / 2), frandom(-radius / 2, radius / 2), frandom(10, height - 4))
        Stop
        Nothing:
            TNT1 A 0
        Stop
    }
}

Actor DnD_CrackleFX : ThunderstruckVFX {
	Scale 0.2125
}

Actor DnD_Ultimatum_Storrmcall_Particle {
    Alpha 0.95
    Scale 0.25
    Renderstyle Add
    +CLIENTSIDEONLY
    +NOINTERACTION
    States {
        Spawn:
            OGLP CCCCCC 1 Bright A_FadeOut(0.0875)
            OGLP C 5 Bright A_JumpIf(CallACS("DnD Ultimatum Master Boolean"), "Fade")
            OGLP CCCCCC 1 Bright A_FadeIn(0.0875)
            OGLP C 5 Bright A_JumpIf(CallACS("DnD Ultimatum Master Boolean"), "Fade")
        Loop
        Fade:
            OGLP CCCCC 1 A_FadeOut(0.2)
        Stop
    }
}

Actor DnD_Ultimatum_Stormcall_Explosion {
    Alpha 0.85
    Renderstyle Add
    +MISSILE
    Stamina 34048
    +NOINTERACTION
    States {
        Spawn:
            TNT1 A 2
            TNT1 A 2 A_SpawnItemEx("DnD_Ultimatum_Stormcall_Lightning")
            TNT1 A 0 A_PlaySound("Ultimatum/StormCall/Explode")
            TNT1 A 0 A_Explode(80, 96, XF_NOTMISSILE, 0, 48)
			D2FX GHI 4 Bright
			D2FX JK 3 Bright
			D2FX L 2 Bright
        Stop
    }
}

Actor DnD_Ultimatum_Stormcall_Lightning {
	Renderstyle Add
	Alpha 0.01
	+NOINTERACTION
	+CLIENTSIDEONLY
	States {
		Spawn:
            TNT1 A 0
			LFX2 FFFF 1 Bright A_FadeIn(0.2)
            TNT1 A 0 A_PlaySound("Ultimatum/Stormcall/Strike")
            LFX2 F 1 Bright A_FadeIn(0.2)
			LFX2 GHIJ 2 Bright A_FadeOut(0.1875)
		Stop
	}
}

Actor DnD_Ultimatum_Stormcall_Tier1 {
    Scale 12.0
    Renderstyle Add
    Alpha 0.95
    Height 4
    Radius 2
    MONSTER
    -COUNTKILL
    var int user_wait;
    var int user_wait_time;
    var int user_expcount;
    const int r_prox = 192;
    +NOINTERACTION
    +LOOKALLAROUND
    States {
        Spawn:
            TNT1 A 1 NoDelay A_SetUserVar("user_wait_time", 72)
            TNT1 A 1 A_SetUserVar("user_wait", user_wait_time)
            TNT1 A 0 A_SetUserVar("user_expcount", 10)
        Goto SpawnLoop
        SpawnLoop:
            AURA IIIII 1 A_LookEx(0, 0, r_prox)
            TNT1 A 0 A_JumpIf(CallACS("DnD Is Ultimatum Complete"), "CriticalFinish")
        Loop
        See:
            AURA I 1 A_JumpIfCloser(r_prox, "Increment")
        Goto SpawnLoop
        Increment:
            TNT1 A 0 A_SetUserVar("user_wait", user_wait - 1)
            AURA I 1 A_ClearTarget
            AURA I 1 ACS_NamedExecuteWithResult("DnD Ultimatum Storm Call Particle", tid, r_prox, user_wait, user_wait_time)
            TNT1 A 0 A_JumpIf(user_wait <= 0, "Critical")
        Goto SpawnLoop
        Critical:
            TNT1 A 0 A_JumpIf(user_expcount <= 0, "CriticalFinish")
            TNT1 A 0 A_SetUserVar("user_expcount", user_expcount - 1)
            AURA I 4 A_SpawnItemEx("DnD_Ultimatum_Stormcall_Explosion", 8 * frandom(-r_prox / 8, r_prox / 8), 8 * frandom(-r_prox / 8, r_prox / 8), frandom(2, 8))
        Loop
        CriticalFinish:
            TNT1 A 0 ACS_NamedExecuteWithResult("DnD Boolean Sync")
            AURA IIIIIIIIII 1 A_FadeOut(0.0875)
            TNT1 A 35
        Stop
    }
}

Actor DnD_Ultimatum_Stormcall_Tier2 : DnD_Ultimatum_Stormcall_Tier1 {
    States {
        Spawn:
            TNT1 A 1 NoDelay A_SetUserVar("user_wait_time", 54)
            TNT1 A 1 A_SetUserVar("user_wait", user_wait_time)
            TNT1 A 0 A_SetUserVar("user_expcount", 10)
        Goto SpawnLoop
    }
}

Actor DnD_Ultimatum_Stormcall_Tier3 : DnD_Ultimatum_Stormcall_Tier2 {
    States {
        // twice as many explosions in it
        Spawn:
            TNT1 A 1 NoDelay A_SetUserVar("user_wait_time", 54)
            TNT1 A 1 A_SetUserVar("user_wait", user_wait_time)
            TNT1 A 0 A_SetUserVar("user_expcount", 10)
        Goto SpawnLoop
        Critical:
            TNT1 A 0 A_SpawnItemEx("DnD_Ultimatum_Storrmcall_Particle", r_prox, 0, 8, 0, 0, 0, 0, SXF_SETMASTER | SXF_CLIENTSIDE)
        CriticalLoop:
            TNT1 A 0 A_JumpIf(user_expcount <= 0, "CriticalFinish")
            TNT1 A 0 A_SetUserVar("user_expcount", user_expcount - 1)
            TNT1 A 0 A_SpawnItemEx("DnD_Ultimatum_Stormcall_Explosion", 8 * frandom(-r_prox / 8, r_prox / 8), 8 * frandom(-r_prox / 8, r_prox / 8), frandom(2, 8))
            AURA I 4 A_SpawnItemEx("DnD_Ultimatum_Stormcall_Explosion", 8 * frandom(-r_prox / 8, r_prox / 8), 8 * frandom(-r_prox / 8, r_prox / 8), frandom(2, 8))
        Loop
    }
}

Actor DnD_Ultimatum_Stormcall_Tier4 : DnD_Ultimatum_Stormcall_Tier3 { }

Actor DnD_RagingDead_Cooldown : PowerProtection {
    damagefactor "normal", 1.0
    powerup.duration -4
}

Actor DnD_Ultimatum_RagingDead_Tier1 {
    MONSTER
    Height 56
    Radius 20
    Speed 6
    Stamina 33824
    Obituary "%o was scorched by a Raging Spirit."
    -SOLID
    -SHOOTABLE
    -COUNTKILL
    +DONTREFLECT
    +DONTBLAST
    +LOOKALLAROUND
    +NOGRAVITY
    +FLOAT

    States {
        Spawn:
            ULT1 AABB 4 Bright A_Look
        Loop
        See:
            TNT1 A 0 A_JumpIfInventory("DnD_RagingDead_Cooldown", 1, "NoAttack")
            TNT1 A 0 A_JumpIfInventory("DnD_Boolean", 1, "Disappear")
            ULT1 AABBCCDD 2 Bright A_Chase
        Loop
        NoAttack:
            TNT1 A 0 A_JumpIfInventory("DnD_Boolean", 1, "Disappear")
            ULT1 AABBCCDD 2 Bright A_Chase("", "")
        Goto See
        Missile:
            TNT1 A 0 A_JumpIfInventory("DnD_Boolean", 1, "Disappear")
            ULT1 ST 6 Bright A_FaceTarget
            ULT1 U 6 Bright A_CustomMissile("Ultimatum_RagingDeadFire", 44)
        Goto See
        Death:
        Disappear:
            ULT1 A 0 A_NoGravity
            ULT1 I 6 Bright
            ULT1 J 5 Bright
            ULT1 KLMNOPQR 4 Bright
        Stop
    }
}

Actor DnD_Ultimatum_RagingDead_Tier2 : DnD_Ultimatum_RagingDead_Tier1 {
    States {
        Missile:
            TNT1 A 0 A_JumpIfInventory("DnD_Boolean", 1, "Disappear")
            ULT1 ST 6 Bright A_FaceTarget
            TNT1 A 0 A_CustomMissile("Ultimatum_RagingDeadFire", 44, 0, 12, CMF_AIMOFFSET)
            ULT1 U 6 Bright A_CustomMissile("Ultimatum_RagingDeadFire", 44)
        Goto See
    }
}

Actor DnD_Ultimatum_RagingDead_Tier3 : DnD_Ultimatum_RagingDead_Tier2 { }

Actor DnD_Ultimatum_RagingDead_Tier4 : DnD_Ultimatum_RagingDead_Tier3 {
    States {
        Missile:
            TNT1 A 0 A_JumpIfInventory("DnD_Boolean", 1, "Disappear")
            ULT1 ST 6 Bright A_FaceTarget
            TNT1 A 0 A_CustomMissile("Ultimatum_RagingDeadFire", 44, 0, 12, CMF_AIMOFFSET)
            TNT1 A 0 A_CustomMissile("Ultimatum_RagingDeadFire", 44, 0, -12, CMF_AIMOFFSET)
            TNT1 A 0 A_CustomMissile("Ultimatum_RagingDeadFire", 44, 0, 24, CMF_AIMOFFSET)
            ULT1 U 6 Bright A_CustomMissile("Ultimatum_RagingDeadFire", 44)
        Goto See
    }
}

Actor DnD_Ultimatum_Pustule_Tier1 {
	MONSTER
    -COUNTKILL
	Height 8
	Radius 4
	DamageType "Ice"
	Stamina 33856
    Renderstyle Translucent
    Alpha 1.0
    +NOINTERACTION
    +LOOKALLAROUND
    +NOGRAVITY
    var int user_exp_timer;
	Deathsound "MoonSatyr/MeteorExplode"
	Scale 2.0
	Speed 0
	States {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_exp_timer", 20)
        Goto SpawnLoop
        SpawnLoop:
            MSX0 AABBCC 2 A_LookEx(0, 0, 160)
            "####" "#" 0 A_JumpIf(CallACS("DnD Is Ultimatum Complete"), "Disappear")
        Loop
        See:
            "####" "#" 0 A_JumpIf(user_exp_timer <= 0, "Burst")
            "####" "#" 0 A_SetUserVar("user_exp_timer", user_exp_timer - 1)
            MSX0 AAABBBCCC 1 A_ChangeVelocity(frandom(-1, 1), frandom(-1, 1), frandom(-1, 1), CVF_REPLACE)
        Loop
        Burst:
            "####" "################" 1 A_SetScale(scalex * 1.015, scaley * 1.015)
            TNT1 A 0 A_Explode(96, 160, XF_NOTMISSILE, 0, 72)
        Goto BurstFX
        BurstFX:
			TNT1 AAAAA 0 A_CustomMissile("RocketSmoke", 0, 0, random(0, 360), 2, random(0, 180))
			TNT1 AAAAAAAA 0 A_CustomMissile("RocketSmoke", 0, 0, random(0, 360), 2, random(0, 360))
			TNT1 AAAAAAAAAAAAAAAA 0 A_SpawnItemEx("BlueParticleNoGravityFastVanish",Random(-12,12),Random(-12,12),Random(-12,12),Random(-6,6),Random(-6,6),Random(-6,6),Random(-20,20),128)
			TNT1 A 0 A_SetTranslucent(1,1)
			MSX0 DEFGHI 2 Bright
		Stop
        Disappear:
            MSX0 DDEEFFGGHHII 1 A_FadeOut(0.0875)
        Stop
	}
}

Actor DnD_Ultimatum_Pustule_Tier2 : DnD_Ultimatum_Pustule_Tier1 {
    States {
        Burst:
            "####" "################" 1 A_SetScale(scalex * 1.015, scaley * 1.015)
            TNT1 A 0 A_Explode(128, 160, XF_NOTMISSILE, 0, 72)
        Goto BurstFX
    }
}

Actor DnD_Ultimatum_Pustule_Tier3 : DnD_Ultimatum_Pustule_Tier2 {
    States {
        Spawn:
            TNT1 A 0 NoDelay A_SetUserVar("user_exp_timer", 15)
        Goto SpawnLoop
        Burst:
            "####" "############" 1 A_SetScale(scalex * 1.354, scaley * 1.354)
            TNT1 A 0 A_Explode(128, 160, XF_NOTMISSILE, 0, 72)
        Goto BurstFX
    }
}

Actor DnD_Ultimatum_Pustule_Tier4 : DnD_Ultimatum_Pustule_Tier3 { }