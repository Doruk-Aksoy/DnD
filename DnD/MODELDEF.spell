// No PITCHFROMMOMENTUM: the pulse is FLOORHUGGER and must stay level, not tip as it settles.
Model Spell_FreezingPulse {
	Path "Models/Proj"
	Model 0 "FREEZWAV.md3"

	// Skin from Graphics/ so the lump has a name; a Models/ skin is nameless and no shader binds.
	Path "Graphics/ShaderTex"
	Skin 0 "FREEZPUL.png"
	Scale 1.0 1.0 1.0

	FrameIndex FPUL A 0 0
}

// Spins about its long axis: rotation-vector 1 0 0 is GL x, which is model x.
Model Spell_GlacialSpike {
	Path "Models/Proj"
	Model 0 "GLACIAL.md3"

	// Skin from Graphics/ so the lump has a name and GLACIAL can bind to it.
	Path "Graphics/ShaderTex"
	Skin 0 "GLACIAL.png"
	Scale 1.0 1.0 1.0

	PITCHFROMMOMENTUM

	ROTATING
	rotation-vector 1.0 0.0 0.0
	rotation-speed 5.0

	FrameIndex SPIK A 0 0
}

// Ice Spear forming at the caster's side. Its pitch is fed from ACS, as A_Warp cannot copy it.
Model Spell_IceSpear_Form {
	Path "Models/Proj"
	Model 0 "ICESPEAR.md3"

	// Skin from Graphics/ so the lump has a name and ICESPEAR can bind to it.
	Path "Graphics/ShaderTex"
	Skin 0 "ICESPEAR.png"
	Scale 1.0 1.0 1.0

	INHERITACTORPITCH
	ROTATING
	rotation-vector 1.0 0.0 0.0
	rotation-speed 1.5

	FrameIndex ISPF A 0 0
	FrameIndex ISPF B 0 1
	FrameIndex ISPF C 0 2
	FrameIndex ISPF D 0 3
	FrameIndex ISPF E 0 4
	FrameIndex ISPF F 0 5
	FrameIndex ISPF G 0 6
	FrameIndex ISPF H 0 7
	FrameIndex ISPF I 0 8
	FrameIndex ISPF J 0 9
	FrameIndex ISPF K 0 10
	FrameIndex ISPF L 0 11
	FrameIndex ISPF M 0 12
	FrameIndex ISPF N 0 13
	FrameIndex ISPF O 0 14
}

// The spear in flight. Model 1 is the same md3 under the primed skin, which carries its own shader.
Model Spell_IceSpear {
	Path "Models/Proj"
	Model 0 "ICESPEAR.md3"
	Model 1 "ICESPEAR.md3"

	Path "Graphics/ShaderTex"
	Skin 0 "ICESPEAR.png"
	Skin 1 "ICESPRP.png"
	Scale 1.0 1.0 1.0

	PITCHFROMMOMENTUM
	ROTATING
	rotation-vector 1.0 0.0 0.0
	rotation-speed 4.0

	FrameIndex ISPR A 0 14
	FrameIndex ISPP A 1 15
	FrameIndex ISPP B 1 16
	FrameIndex ISPP C 1 17
	FrameIndex ISPP D 1 18
	FrameIndex ISPP E 1 19
	FrameIndex ISPP F 1 20
	FrameIndex ISPP G 1 21
	FrameIndex ISPP H 1 22
	FrameIndex ISPQ A 1 23
	FrameIndex ISPQ B 1 24
	FrameIndex ISPQ C 1 25
	FrameIndex ISPQ D 1 26
	FrameIndex ISPQ E 1 27
	FrameIndex ISPQ F 1 28
	FrameIndex ISPQ G 1 29
	FrameIndex ISPQ H 1 30
}

