// Frost Bomb's crystal. 17 baked frames, one per tic of a pulse -- the punch and the settle are
// in the GEOMETRY, so the facets flex rather than the whole thing zooming.
Model Spell_FrostBomb {
	Path "Models/Proj"
	Model 0 "FROSTBMB.md3"

	// Skin from Models/, NOT Graphics/: nameless on purpose, so GlacialSpike.fp does not bind to it.
	Skin 0 "GLACIAL.png"
	Scale 1.0 1.0 1.0

	FrameIndex FBMB A 0 0
	FrameIndex FBMB B 0 1
	FrameIndex FBMB C 0 2
	FrameIndex FBMB D 0 3
	FrameIndex FBMB E 0 4
	FrameIndex FBMB F 0 5
	FrameIndex FBMB G 0 6
	FrameIndex FBMB H 0 7
	FrameIndex FBMB I 0 8
	FrameIndex FBMB J 0 9
	FrameIndex FBMB K 0 10
	FrameIndex FBMB L 0 11
	FrameIndex FBMB M 0 12
	FrameIndex FBMB N 0 13
	FrameIndex FBMB O 0 14
	FrameIndex FBMB P 0 15
	FrameIndex FBMB Q 0 16
}

// Blizzard's icicle, Avalanche's ice and Glacial Cascade's spikes all borrow Glacial Spike's model and shader.
Model Spell_BlizzardIce {
	Path "Models/Proj"
	Model 0 "GLACIAL.md3"
	Path "Graphics/ShaderTex"
	Skin 0 "GLACIAL.png"
	// Shorter along x, the spike's length, and fatter across y and z: a shard rather than a spear.
	Scale 0.45 2.0 2.0
	PITCHFROMMOMENTUM
	ROTATING
	rotation-vector 1.0 0.0 0.0
	rotation-speed 5.0
	FrameIndex BLZI A 0 0
}

// Avalanche's ice: a needle, a shard, a chunk and a splinter as four frames, spinning along the flight.
// GCASCADE.png gives it Glacial Cascade's faceted shader; AVALICE.md3 keeps that shader's UV layout.
Model Spell_AvalancheIce {
	Path "Models/Proj"
	Model 0 "AVALICE.md3"
	Path "Graphics/ShaderTex"
	Skin 0 "GCASCADE.png"
	Scale 1.0 1.0 1.0
	// While it forms it is still, so its own pitch aims it; once it flies the momentum does. They add.
	PITCHFROMMOMENTUM
	INHERITACTORPITCH
	ROTATING
	rotation-vector 1.0 0.0 0.0
	rotation-speed 7.0
	FrameIndex AVLI A 0 0
	FrameIndex AVLI B 0 1
	FrameIndex AVLI C 0 2
	FrameIndex AVLI D 0 3
	// Each shape forming: a quarter, just over half and most of its size, in shape order.
	FrameIndex AVLF A 0 4
	FrameIndex AVLF B 0 5
	FrameIndex AVLF C 0 6
	FrameIndex AVLF D 0 7
	FrameIndex AVLF E 0 8
	FrameIndex AVLF F 0 9
	FrameIndex AVLF G 0 10
	FrameIndex AVLF H 0 11
	FrameIndex AVLF I 0 12
	FrameIndex AVLF J 0 13
	FrameIndex AVLF K 0 14
	FrameIndex AVLF L 0 15
}

// Glacial Cascade's crystals: three shapes as three frames, stood up by their own pitch.
Model Spell_GlacialCascadeSpike {
	Path "Models/Proj"
	Model 0 "GCASCADE.md3"
	// Skin from Graphics/ so the lump has a name and GlacialCascade.fp can bind to it.
	Path "Graphics/ShaderTex"
	Skin 0 "GCASCADE.png"
	Scale 1.0 1.0 1.0
	INHERITACTORPITCH
	FrameIndex GCSP A 0 0
	FrameIndex GCSP B 0 1
	FrameIndex GCSP C 0 2
}

// Glacial Cascade's floor under each burst: flat2, stretched along the wave; the ragged rim is the shader's.
Model Spell_GlacialCascadeFloor {
	Path "Models/Auras"
	Model 0 "flat2.md3"
	Path "Graphics/ShaderTex"
	Skin 0 "CSCFLOOR.png"
	// x is the wave's heading. "DnD Glacial Cascade FX" sizes it off the burst.
	Scale 1.35 1.0 1.0
	Zoffset 2
	FrameIndex CSCF A 0 0
}

// Winter Orb's sphere. ROTATING's default axis is the vertical one, so it only ever spins level.
Model Spell_WinterOrb {
	Path "Models/Proj"
	Model 0 "WINTERORB.md3"
	// Skin from Graphics/ so the lump has a name and WinterOrb.fp can bind to it.
	Path "Graphics/ShaderTex"
	Skin 0 "WNTRORB.png"
	Scale 1.0 1.0 1.0
	ROTATING
	rotation-speed 1.2
	FrameIndex WORB A 0 0
}

// A plain flat quad laid on the floor; the spiky rim is a shader mask, not geometry.
Model Spell_IceNova {
	Path "Models/Auras"
	// flat2, so the ring is visible from below as well as above.
	Model 0 "flat2.md3"

	// Skin from Graphics/ so the lump has a name and ICENOVA can bind to it.
	Path "Graphics/ShaderTex"
	Skin 0 "ICENOVA.png"
	// Scale 1: "DnD Ice Nova" rewrites it every step to track the blast.
	Scale 1.0 1.0 1.0
	Zoffset 2

	FrameIndex ICNV A 0 0
}

// A plain flat quad; the craggy edge is a shader mask, not geometry.
Model Spell_CreepingFrost_Crawl {
	Path "Models/Auras"
	// flat2, not flat: two quads back to back, so the patch is visible from underneath too.
	Model 0 "flat2.md3"

	Path "Graphics/ShaderTex"
	Skin 0 "CRPFROST.png"
	// Scale 1: "DnD Creeping Frost Size" sets it from the blast radius.
	Scale 1.0 1.0 1.0
	Zoffset 2

	FrameIndex CFRS A 0 0
}

// Pyroblast. One frame: the mesh is only a hull, and Pyroblast.fp ray-marches and animates the flames inside it.
Model Spell_Pyroblast {
	Path "Models/Proj"
	Model 0 "PYROBLAS.md3"

	// Skin from Graphics/ so the lump has a name and PYROBLAS can bind to it.
	Path "Graphics/ShaderTex"
	Skin 0 "PYROBLAS.png"
	Scale 1.35 1.35 1.35

	PITCHFROMMOMENTUM

	FrameIndex PYRB A 0 0
	FrameIndex PYRB B 0 0
	FrameIndex PYRB C 0 0
	FrameIndex PYRB D 0 0
	FrameIndex PYRB E 0 0
	FrameIndex PYRB F 0 0
	FrameIndex PYRB G 0 0
	FrameIndex PYRB H 0 0
	FrameIndex PYRB I 0 0
	FrameIndex PYRB J 0 0
	FrameIndex PYRB K 0 0
	FrameIndex PYRB L 0 0
}

// Fireball: Pyroblast's hull, with Fireball.fp drawing an opaque ball of FIREBALL.png's lava and a straight streak in it.
Model Spell_Fireball {
	Path "Models/Proj"
	Model 0 "PYROBLAS.md3"

	Path "Graphics/ShaderTex"
	Skin 0 "FIREBALL.png"
	Scale 0.8 0.8 0.8

	PITCHFROMMOMENTUM

	// Flight only: the death frames, FX14 D to H, stay sprites.
	FrameIndex FX14 A 0 0
	FrameIndex FX14 B 0 0
	FrameIndex FX14 C 0 0
}

// Models bind per class, so Pyroblast's rank 10 fragments need their own; their actor Scale 0.6 shrinks it further.
Model Spell_Pyroblast_TinyFireballs {
	Path "Models/Proj"
	Model 0 "PYROBLAS.md3"

