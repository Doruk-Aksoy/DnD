Model Spell_AngerAuraFX {
	Path "Models/Auras"   
	Model 0 "flat.md3"

	// Skin out of Graphics/, where the lump has a NAME and can therefore carry a GLDEFS shader.
	// Same split, and the same reason, as the other shaded auras.
	Path "Graphics/ShaderTex"
	Skin 0 "ANGERAUR.png"
	Scale 1.0 1.0 1.0
	// Halved: this is multiplied by the actor scale, so it lifts the ring further the bigger it
	// gets. At 1 the ring floated off the floor once the scale went up.
	Zoffset 0.5
	ROTATING
	//DONTCULLBACKFACES
	FrameIndex AURA J 0 3
}

// Hatred. Skin from Graphics/ so the lump has a name and Hatred.fp can bind to it.
Model Spell_HatredAuraFX {
	Path "Models/Auras"
	Model 0 "flat.md3"
	Path "Graphics/ShaderTex"
	Skin 0 "HATRED.png"
	Scale 1.0 1.0 1.0
	Zoffset 0.5
	ROTATING
	FrameIndex AURA K 0 3
}

Model Spell_AnnihilusAnchorFlip {
	Path "Models/Auras"
	Model 0 "flat.md3"

	Path "Graphics/ShaderTex"
	Skin 0 "ANNIHILS.png"

	// The mirror: yscale reaches GL z, which this flat quad spans (zscale moves nothing), so negating
	// it reverses the winding. The art is radially symmetric, so the mirror itself is invisible.
	Scale 1.0 -1.0 1.0

	// Back to +1: the offset is divided by ZSCALE, which is no longer negated, so this matches the
	// upright copy and keeps the two coplanar.
	Zoffset 1
	ROTATING

	FrameIndex AURA L 0 3
}

Model Spell_AnnihilusAnchor {
	Path "Models/Auras"
	Model 0 "flat.md3"

	// Skin out of Graphics/, where the lump has a NAME and can therefore carry a GLDEFS shader.
	// Same split, and the same reason, as Spell_RighteousFireFX below.
	Path "Graphics/ShaderTex"
	Skin 0 "ANNIHILS.png"
	Scale 1.0 1.0 1.0
	Zoffset 1
	ROTATING

	FrameIndex AURA L 0 3
}

Model Spell_RighteousFireFX {
	Path "Models/Auras"   
	Model 0 "flat.md3"   

	// Path re-set so the skin resolves out of Graphics/, where the lump has a NAME a shader can bind.
	// Safe to reassign: every other block sets its own Path.
	Path "Graphics/ShaderTex"
	Skin 0 "RGHTFIRE.png"
	Scale 1.0 1.0 1.0
	Zoffset 1
	ROTATING
	//DONTCULLBACKFACES
	
	FrameIndex AURA K 0 3
}